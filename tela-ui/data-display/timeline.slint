// Tela UI — TTimeline
//
// Vertical timeline: a theme-colored dot per entry joined by a rail line,
// label and optional description on the right. The rail line fills each
// row below its dot; the last entry draws none.

import { TTheme,  TThemeRole } from "../theme.slint";

export struct TTimelineItem {
    label: string,
    content: string,
    theme: TThemeRole,
}

export component TTimeline inherits VerticalLayout {
    in property <[TTimelineItem]> items;

    spacing: 0px;

    for it[i] in root.items: HorizontalLayout {
        // Rail: dot on top, connector line filling the rest of the row.
        VerticalLayout {
            width: 18px;

            Rectangle {
                height: 20px;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: TTheme.radius-round;
                    // The last entry hollows out: container fill with a
                    // themed ring instead of a solid dot.
                    background: i == root.items.length - 1 ? TTheme.bg-color-container : TTheme.theme-color(it.theme);
                    border-width: 2px;
                    border-color: TTheme.theme-color(it.theme);
                }
            }

            if i < root.items.length - 1: Rectangle {
                vertical-stretch: 1;
                width: 2px;
                x: (parent.width - self.width) / 2;
                background: TTheme.border-level-1-color;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            // Inter-entry breathing room lives here so the rail line can
            // span it; the last entry drops the padding.
            padding-bottom: i == root.items.length - 1 ? 0px : TTheme.spacing-6;
            padding-top: 2px;
            spacing: TTheme.spacing-2;

            Text {
                text: it.label;
                font-size: TTheme.font-size-m;
                font-family: TTheme.font-family;
                font-weight: TTheme.font-weight-medium;
                color: TTheme.text-color-primary;
                overflow: elide;
            }

            if it.content != "": Text {
                text: it.content;
                font-size: TTheme.font-size-s;
                font-family: TTheme.font-family;
                color: TTheme.text-color-secondary;
                wrap: word-wrap;
            }
        }
    }
}
