// Tela UI — TTable
//
// Data table: column definitions + row model, header sorting and an empty
// state. The body is a ListView, so only visible rows are instantiated.
// Rows carry plain text cells; sorting is reported through `sort-changed`
// and the host reorders `rows` (Slint has no loops, so the component cannot
// sort the model itself).
// Column widths are explicit or share the leftover space: `width: 0px` makes
// a column flexible, any positive width pins it.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";
import { TEmpty } from "empty.slint";
import { ListView } from "std-widgets.slint";

export enum TTableAlign {
    left,
    center,
    right,
}

export enum TTableSortDirection {
    none,
    ascending,
    descending,
}

export struct TTableColumn {
    title: string,
    // 0px = flexible, shares the leftover width; > 0 pins the column.
    width: length = 0px,
    // Lower bound for a flexible column.
    min-width: length = 0px,
    align: TTableAlign = TTableAlign.left,
    sortable: bool = false,
}

export struct TTableRow {
    cells: [string],
}

// One cell. The parent row positions it; width constraints come from the
// column so header and body stay aligned (both rows share the same total).
component TTableCell inherits Rectangle {
    in property <string> text;
    in property <TTableAlign> align: TTableAlign.left;
    in property <bool> header;
    in property <bool> sortable;
    in property <TTableSortDirection> direction: TTableSortDirection.none;

    callback clicked;

    HorizontalLayout {
        padding-left: TTheme.padding-lr-m;
        padding-right: TTheme.padding-lr-m;
        spacing: TTheme.spacing-2;

        TText {
            text: root.text;
            font-size: TTheme.font-size-m;
            line-height: TTheme.line-height-m;
            font-weight: root.header ? TTheme.font-weight-medium : TTheme.font-weight-regular;
            color: TTheme.text-color-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            horizontal-alignment: root.align == TTableAlign.center
                ? center
                : root.align == TTableAlign.right ? right : left;
        }

        // Sorting hint; the slot is reserved even when unsorted so the title
        // does not shift on the first click.
        if root.header && root.sortable: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.direction == TTableSortDirection.ascending ? TIconSet.ChevronUp : TIconSet.ChevronDown;
            size: TTheme.font-size-m;
            icon-color: root.direction == TTableSortDirection.none
                ? TTheme.text-color-placeholder
                : TTheme.brand-color;
        }
    }

    if root.header && root.sortable: TouchArea {
        mouse-cursor: MouseCursor.pointer;
        accessible-role: AccessibleRole.button;
        accessible-label: root.text + (root.direction == TTableSortDirection.ascending
            ? " 升序"
            : root.direction == TTableSortDirection.descending ? " 降序" : " 未排序");

        clicked => {
            root.clicked();
        }
    }
}

export component TTable inherits Rectangle {
    in property <[TTableColumn]> columns;
    in property <[TTableRow]> rows;
    // Current sort. Clicking a sortable header cycles
    // ascending -> descending -> none; the host reads the result from
    // `sort-changed` and reorders `rows`.
    in-out property <int> sort-column: -1;
    in-out property <TTableSortDirection> sort-direction: TTableSortDirection.none;
    // TDesign medium row height: 48px (height-l + spacing-4).
    in property <length> row-height: TTheme.height-l + TTheme.spacing-4;
    in property <string> empty-text: "暂无数据";

    callback sort-changed(int, TTableSortDirection);
    callback row-clicked(int);

    private property <length> header-height: root.row-height;
    // Intrinsic table width: fixed columns plus each flexible column's lower
    // bound. When it exceeds the viewport the ListView scrolls horizontally
    // and the header follows `content-x`.
    private property <length> table-width: max(header-layout.preferred-width, root.width);

    pure function cell-text(row: int, col: int) -> string {
        return row >= 0 && row < self.rows.length && col >= 0 && col < self.rows[row].cells.length
            ? self.rows[row].cells[col]
            : "";
    }

    function toggle-sort(col: int) {
        if root.sort-column != col || root.sort-direction == TTableSortDirection.none {
            root.sort-column = col;
            root.sort-direction = TTableSortDirection.ascending;
        } else if root.sort-direction == TTableSortDirection.ascending {
            root.sort-direction = TTableSortDirection.descending;
        } else {
            root.sort-column = -1;
            root.sort-direction = TTableSortDirection.none;
        }
        root.sort-changed(root.sort-column, root.sort-direction);
    }

    background: TTheme.bg-color-container;
    // Over-wide fixed columns stop at the border instead of drawing outside.
    clip: true;
    border-width: 1px;
    border-color: TTheme.component-stroke;
    // Default viewport: five rows. Hosts size the table for a different one.
    min-height: root.header-height + root.row-height;
    preferred-height: root.header-height + root.row-height * 5;

    header := Rectangle {
        x: body.content-x;
        y: 0;
        width: root.table-width;
        height: root.header-height;
        background: TTheme.bg-color-secondarycontainer;

        header-layout := HorizontalLayout {
            for col[c] in root.columns: TTableCell {
                text: col.title;
                align: col.align;
                header: true;
                sortable: col.sortable;
                direction: c == root.sort-column ? root.sort-direction : TTableSortDirection.none;
                // Fixed column: min = max = width. Flexible: min only, so the
                // layout hands it a share of the leftover space.
                horizontal-stretch: col.width > 0px ? 0 : 1;
                min-width: col.width > 0px ? col.width : col.min-width;
                preferred-width: self.min-width;
                max-width: col.width > 0px ? col.width : 100000px;

                clicked => {
                    root.toggle-sort(c);
                }
            }
        }

        Rectangle {
            y: parent.height - self.height;
            height: 1px;
            background: TTheme.component-stroke;
        }
    }

    if root.rows.length == 0: Rectangle {
        y: root.header-height;
        height: parent.height - root.header-height;
        background: TTheme.bg-color-container;

        TEmpty {
            width: parent.width;
            height: parent.height;
            description: root.empty-text;
        }
    }

    body := ListView {
        y: root.header-height;
        height: parent.height - root.header-height;
        content-width: root.table-width;

        for row[i] in root.rows: Rectangle {
            width: root.table-width;
            height: root.row-height;
            background: TTheme.bg-color-container;

            states [
                hovered when row-touch.has-hover: {
                    background: TTheme.bg-color-container-hover;
                }
            ]

            HorizontalLayout {
                for col[c] in root.columns: TTableCell {
                    text: root.cell-text(i, c);
                    align: col.align;
                    horizontal-stretch: col.width > 0px ? 0 : 1;
                    min-width: col.width > 0px ? col.width : col.min-width;
                    preferred-width: self.min-width;
                    max-width: col.width > 0px ? col.width : 100000px;
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: 1px;
                background: TTheme.component-stroke;
            }

            row-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                accessible-role: AccessibleRole.list-item;
                accessible-label: root.cell-text(i, 0);

                clicked => {
                    root.row-clicked(i);
                }
            }
        }
    }

    accessible-role: AccessibleRole.table;
}
