// Tela UI — TTag
//
// Small status descriptor. theme: TTheme (default/primary/success/warning/
// error); variant: TTagVariant (dark filled / light / outline); size: TSize.
// Closable tags emit `closed`; tags emit `clicked` when `clickable`
// styling is desired.

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet, TIconData } from "../base/icon/data.slint";
import { TThemeRole,  TSize } from "../structs/enums.slint";
export enum TTagVariant {
    dark,
    light,
    outline,
}
import { TIconSet, TIconData } from "../base/icon/data.slint";

export component TTag inherits Rectangle {
    in property <TThemeRole> theme: TThemeRole.default;
    in property <TTagVariant> variant: TTagVariant.dark;
    in property <TSize> size: TSize.medium;
    in property <string> text;
    in property <TIconData> icon;
    in property <bool> closable;
    in property <bool> disabled;
    in property <bool> clickable: false;

    callback closed();
    callback clicked();

    private property <length> h:
        size == TSize.small ? 20px
        : size == TSize.large ? 28px
        : 24px;
    private property <length> fs: TTheme.font-size-s;
    private property <length> pad-lr:
        size == TSize.small ? 6px
        : size == TSize.large ? 12px
        : 8px;

    // Per-role colors for the current theme (default renders neutral grays,
    // other themes use their color ramp) so the rest binding and `states`
    // below stay flat.
    private property <color> fill: theme == TThemeRole.default ? TTheme.bg-color-component : TTheme.theme-color(theme);
    private property <color> fill-hover: theme == TThemeRole.default ? TTheme.bg-color-component-hover : TTheme.theme-color-hover(theme);
    private property <color> tint: theme == TThemeRole.default ? TTheme.bg-color-secondarycontainer : TTheme.theme-color-light(theme);
    private property <color> tint-hover: theme == TThemeRole.default ? TTheme.bg-color-secondarycontainer-hover : TTheme.theme-color-light-hover(theme);
    private property <color> text-dark: theme == TThemeRole.default ? TTheme.text-color-primary : TTheme.text-color-anti;
    private property <color> text-tonal: theme == TThemeRole.default ? TTheme.text-color-primary : TTheme.theme-color(theme);
    private property <color> text-outline: theme == TThemeRole.default ? TTheme.text-color-secondary : TTheme.theme-color(theme);
    private property <color> border-rest: theme == TThemeRole.default ? TTheme.component-border : TTheme.theme-color(theme);

    // Rest state; overridden by the `states` below.
    private property <brush> bg:
        variant == TTagVariant.dark ? root.fill
        : variant == TTagVariant.light ? root.tint
        : transparent;
    private property <brush> content-color:
        variant == TTagVariant.dark ? root.text-dark
        : variant == TTagVariant.light ? root.text-tonal
        : root.text-outline;
    private property <brush> border-brush:
        variant == TTagVariant.outline ? root.border-rest
        : transparent;

    background: bg;
    border-width: variant == TTagVariant.outline ? 1px : 0;
    border-color: border-brush;
    border-radius: TTheme.radius-default;
    height: h;
    width: max(h, content.preferred-width + pad-lr * 2 + (closable ? 16px : 0));
    animate bg { duration: TTheme.duration-fast; }
    animate content-color { duration: TTheme.duration-fast; }
    animate border-brush { duration: TTheme.duration-fast; }

    // Later states win over earlier ones.
    states [
        hovered when touch.has-hover && root.clickable && !root.disabled: {
            bg: variant == TTagVariant.dark ? root.fill-hover
                : variant == TTagVariant.light ? root.tint-hover
                : transparent;
        }
        disabled when root.disabled: {
            bg: variant == TTagVariant.dark ? TTheme.bg-color-component-disabled : transparent;
            content-color: TTheme.text-color-disabled;
            border-brush: variant == TTagVariant.outline ? TTheme.border-level-1-color : transparent;
        }
    ]

    touch := TouchArea {
        enabled: root.clickable && !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: TTheme.spacing-1;

        if root.icon.paths.length > 0: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: 12px;
            icon-color: root.content-color;
        }

        if root.text != "": Text {
            text: root.text;
            font-size: root.fs;
            color: root.content-color;
            vertical-alignment: center;
        }

        if root.closable: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;

            TIcon {
                x: 2px;
                y: 2px;
                icon: TIconSet.X;
                size: 12px;
                icon-color: close-ta.has-hover ? root.content-color : TTheme.text-color-secondary;
                animate icon-color { duration: TTheme.duration-fast; }
            }
            close-ta := TouchArea {
                enabled: !root.disabled;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.closed();
                    root.visible = false;
                }
            }
        }
    }

    accessible-role: AccessibleRole.text;
    accessible-label: text;
}
