// Tela UI — TAvatar
//
// User/project avatar: image or text, circle or rounded square.
// size: TAvatarSize (32/40/48/64).

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";
import { TThemeRole } from "../structs/enums.slint";

export enum TAvatarSize {
    small,
    medium,
    large,
    extra-large,
}

export enum TAvatarShape {
    circle,
    square,
}
import { TIconSet } from "../base/icon/data.slint";

export component TAvatar inherits Rectangle {
    in property <TAvatarSize> size: TAvatarSize.medium;
    in property <string> text;
    in property <image> source;
    in property <TAvatarShape> shape: TAvatarShape.circle;
    in property <TThemeRole> theme: TThemeRole.primary;

    private property <length> d: size == TAvatarSize.small ? 32px
        : size == TAvatarSize.large ? 48px
        : size == TAvatarSize.extra-large ? 64px : 40px;

    width: d;
    height: d;
    border-radius: shape == TAvatarShape.circle ? self.width / 2 : TTheme.radius-medium;
    background: TTheme.theme-color-light(theme);
    clip: true;

    if source.width > 0: Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: ImageFit.cover;
    }

    if source.width == 0 && text != "": Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: parent.width / 2.8;
        font-weight: TTheme.font-weight-semibold;
        color: TTheme.theme-color(theme);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if source.width == 0 && text == "": TIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: TIconSet.User;
        size: parent.width / 2;
        icon-color: TTheme.theme-color(theme);
    }
}
