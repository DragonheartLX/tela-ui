// Tela UI — TCollapse
//
// Foldable panels. `accordion: true` keeps a single open panel tracked in
// `current-index` (-1 = none); with `accordion: false` each panel toggles
// independently (its open state is local, no external preset).

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export struct TCollapseItem {
    label: string,
    content: string,
    disabled: bool,
}

export component TCollapse inherits VerticalLayout {
    in property <[TCollapseItem]> items;
    in property <bool> accordion: false;
    // Accordion mode only: index of the open panel, -1 = all closed.
    in-out property <int> current-index: -1;

    spacing: 0px;

    for it[i] in root.items: VerticalLayout {
        private property <bool> local-open: false;
        private property <bool> open: root.accordion ? i == root.current-index : self.local-open;

        // The TouchArea overlays the whole header: inside the layout it
        // only ever received a slice of the free space, so clicks on the
        // label and chevron did nothing.
        header := Rectangle {
            height: 44px;

            HorizontalLayout {
                padding-left: TTheme.padding-lr-l;
                padding-right: TTheme.padding-lr-l;
                spacing: TTheme.spacing-4;

                Text {
                    horizontal-stretch: 1;
                    text: it.label;
                    font-size: TTheme.font-size-m;
                    font-family: TTheme.font-family;
                    font-weight: TTheme.font-weight-medium;
                    color: open ? TTheme.brand-color : TTheme.text-color-primary;
                    vertical-alignment: center;
                    overflow: elide;

                    states [
                        disabled when it.disabled: {
                            color: TTheme.text-color-disabled;
                        }
                    ]
                }

                TIcon {
                    width: 16px;
                    y: (parent.height - self.height) / 2;
                    icon: TIconSet.ChevronDown;
                    size: 16px;
                    icon-color: it.disabled ? TTheme.text-color-disabled : TTheme.text-color-secondary;
                    transform-rotation: open ? 180deg : 0deg;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    animate transform-rotation { duration: TTheme.duration-fast; }
                }
            }

            header-ta := TouchArea {
                width: 100%;
                height: 100%;
                enabled: !it.disabled;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    if (root.accordion) {
                        root.current-index = open ? -1 : i;
                    } else {
                        local-open = !local-open;
                    }
                }
            }
        }

        // Content folds by height (animated) instead of mount/unmount.
        content-wrap := Rectangle {
            height: open ? content.preferred-height + TTheme.padding-lr-l : 0px;
            clip: true;
            animate height { duration: TTheme.duration-base; }

            content := Text {
                x: TTheme.padding-lr-l;
                y: TTheme.spacing-4;
                width: parent.width - TTheme.padding-lr-l * 2;
                text: it.content;
                font-size: TTheme.font-size-m;
                font-family: TTheme.font-family;
                color: TTheme.text-color-secondary;
                wrap: word-wrap;
            }
        }

        // Hairline under every panel closes the stack visually.
        Rectangle {
            height: 1px;
            background: TTheme.border-level-1-color;
        }
    }
}
