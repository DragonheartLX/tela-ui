// Tela UI — TCard
//
// Bordered content container with optional title/subtitle header and
// footer strip. Children of the component form the card body.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";

export component TCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> footer;
    in property <bool> bordered: true;
    in property <bool> shadowed: false;
    in property <length> card-padding: TTheme.margin-l;

    background: TTheme.bg-color-container;
    border-width: bordered ? 1px : 0;
    border-color: TTheme.component-stroke;
    border-radius: TTheme.radius-large;
    drop-shadow-blur: shadowed ? TTheme.shadow-1-blur : 0px;
    drop-shadow-offset-y: shadowed ? TTheme.shadow-1-offset-y : 0px;
    drop-shadow-color: TTheme.shadow-1-color;

    VerticalLayout {
        padding: root.card-padding;
        spacing: TTheme.margin-m;

        if root.title != "" || root.subtitle != "": VerticalLayout {
            spacing: TTheme.spacing-2;

            if root.title != "": TText {
                text: root.title;
                font-size: TTheme.font-size-title-m;
                line-height: TTheme.line-height-title;
                font-weight: TTheme.font-weight-semibold;
                // Single-line header: elide a long title instead of cutting
                // it mid-glyph (Slint's Text default overflow is clip).
                overflow: elide;
            }

            if root.subtitle != "": TText {
                text: root.subtitle;
                font-size: TTheme.font-size-s;
                line-height: TTheme.line-height-s;
                color: TTheme.text-color-secondary;
                overflow: elide;
            }
        }

        @children

        if root.footer != "": VerticalLayout {
            spacing: TTheme.margin-m;

            Rectangle {
                height: 1px;
                background: TTheme.component-stroke;
            }

            TText {
                text: root.footer;
                color: TTheme.text-color-secondary;
                overflow: elide;
            }
        }
    }
}
