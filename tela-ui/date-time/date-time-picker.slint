// Tela UI — TDateTimePicker
//
// Trigger input over an anchored panel of five wheel columns: year / month /
// day / hour / minute. The wheels follow the TTimePicker scheme (full column
// rendered, animated offset, selection box on the selected row); month
// lengths and leap years reuse the TCalendar arithmetic (duplicated here
// because TCalendar's helpers are component-private).
//
// The host supplies the year range and `today` is not needed — the picker
// has no highlighted "now" (Slint exposes no public date API). `hour < 0`
// means "time not chosen"; picking any date/time column defaults the
// siblings to a valid zero, like TTimePicker.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TInput } from "../input/input.slint";
import { TPopupSurface } from "../popup-surface.slint";
import { TPopupPlacement, TSize } from "../structs/enums.slint";
import { TIconSet } from "../base/icon/data.slint";
import { TDate } from "calendar.slint";

export struct TDateTime {
    // year == 0 means "no date".
    date: TDate,
    // -1 means "no time".
    hour: int = -1,
    minute: int = 0,
}

// One numeric wheel: labels are `base + i`, zero-padded when `pad-width` is
// 2. The TPickerWheel equivalent for computed ranges (year/month/day columns
// cannot prebuild option arrays — no loops). Private.
component TNumericWheel inherits Rectangle {
    in property <int> count;
    in property <int> base: 0;
    // 0 = plain decimal label; 2 = zero-padded to two digits.
    in property <int> pad-width: 0;
    // Column caption, used in the rows' accessible labels.
    in property <string> label: "";
    in property <int> value: -1;
    in property <length> item-height: TTheme.height-m;

    callback picked(int);

    private property <int> middle: 3;
    private property <length> content-y:
        root.middle * root.item-height - max(0, root.value) * root.item-height;
    animate content-y { duration: TTheme.duration-fast; }

    width: TTheme.spacing-14;
    clip: true;

    pure function pad2(n: int) -> string {
        return n < 10 ? "0\{n}" : "\{n}";
    }

    pure function label-for(i: int) -> string {
        return root.pad-width == 2 ? root.pad2(root.base + i) : "\{root.base + i}";
    }

    function scroll-by(delta: length) {
        if (delta == 0px) {
            return;
        }
        let current = root.value >= 0
            ? root.value
            : (delta > 0px ? -1 : root.count);
        let next = max(0, min(root.count - 1, current + (delta > 0px ? 1 : -1)));
        if (next != root.value) {
            root.picked(next);
        }
    }

    Rectangle {
        y: root.content-y;
        width: parent.width;
        height: root.count * root.item-height;

        for i in root.count: Rectangle {
            y: i * root.item-height;
            width: parent.width;
            height: root.item-height;
            border-radius: TTheme.radius-default;
            background: i == root.value ? TTheme.brand-color-light : transparent;

            states [
                hovered when row-touch.has-hover && i != root.value: {
                    background: TTheme.bg-color-container-hover;
                }
            ]

            TText {
                text: root.label-for(i);
                font-size: TTheme.size-font(TSize.medium);
                line-height: TTheme.size-line-height(TSize.medium);
                color: i == root.value ? TTheme.brand-color : TTheme.text-color-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
                overflow: elide;
            }

            row-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                accessible-role: AccessibleRole.button;
                accessible-label: root.label != "" ? "\{root.label} \{root.label-for(i)}" : root.label-for(i);
                accessible-checked: i == root.value;

                scroll-event(event) => {
                    root.scroll-by(event.delta-y);
                    return accept;
                }

                clicked => {
                    if (i != root.value) {
                        root.picked(i);
                    }
                }
            }
        }
    }
}

export component TDateTimePicker inherits Rectangle {
    in property <TSize> size: TSize.medium;
    in property <TPopupPlacement> placement: TPopupPlacement.bottom-start;
    in property <string> placeholder-text: "请选择日期时间";
    in property <bool> disabled: false;
    // Year wheel range, host-supplied (kept finite: the whole column renders).
    in property <int> start-year: 2000;
    in property <int> end-year: 2100;
    in-out property <TDateTime> value: {
        date: { year: 0, month: 0, day: 0 },
        hour: -1,
        minute: 0,
    };

    // Fires on every column pick, after `value` has been updated.
    callback changed(TDateTime);

    out property <bool> is-open: surface.is-open;

    private property <length> h: TTheme.size-height(root.size);
    private property <length> item-h: TTheme.height-m;
    private property <int> visible-rows: 7;
    private property <length> pad: TTheme.spacing-2;
    private property <int> col-count: 5;
    private property <length> panel-w:
        2 * root.pad + root.col-count * TTheme.spacing-14
            + (root.col-count - 1) * TTheme.spacing-2;
    private property <length> panel-h:
        2 * root.pad + root.visible-rows * root.item-h;

    // Wheel index helpers. date.day == 0 means unset (-1 in wheel terms).
    private property <int> year-idx:
        value.date.year >= root.start-year && value.date.year <= root.end-year
            ? value.date.year - root.start-year : -1;
    private property <int> month-idx: value.date.month >= 1 ? value.date.month - 1 : -1;
    private property <int> day-idx: value.date.day >= 1 ? value.date.day - 1 : -1;

    private property <int> year-count: max(0, root.end-year - root.start-year + 1);
    // The day wheel follows the displayed month length (TCalendar math).
    private property <int> dim: root.leap(value.date.year) && value.date.month == 2 ? 29
        : value.date.month == 2 ? 28
        : value.date.month == 4 || value.date.month == 6
            || value.date.month == 9 || value.date.month == 11 ? 30
        : value.date.month >= 1 ? 31 : 31;

    pure function leap(y: int) -> bool {
        return Math.mod(y, 4) == 0 && (Math.mod(y, 100) != 0 || Math.mod(y, 400) == 0);
    }

    pure function pad2(n: int) -> string {
        return n < 10 ? "0\{n}" : "\{n}";
    }

    private property <string> display-text:
        root.value.date.year > 0
            ? "\{root.value.date.year}-\{root.pad2(root.value.date.month)}-\{root.pad2(root.value.date.day)}"
                + (root.value.hour >= 0 ? " \{root.pad2(root.value.hour)}:\{root.pad2(root.value.minute)}" : "")
            : "";

    function set-value(d: TDate, hour: int, minute: int) {
        root.value = { date: d, hour: hour, minute: minute };
        root.changed(root.value);
    }

    function pick-year(i: int) {
        // Keep day clamped to the new month length; unset stays unset.
        let day = root.day-idx >= 0 ? min(root.day-idx + 1, root.dimOf(root.start-year + i, root.value.date.month)) : 0;
        root.set-value(
            { year: root.start-year + i, month: root.value.date.month >= 1 ? root.value.date.month : 1, day: day },
            root.value.hour >= 0 ? root.value.hour : 0,
            root.value.minute >= 0 ? root.value.minute : 0,
        );
    }

    function pick-month(i: int) {
        let day = root.day-idx >= 0 ? min(root.day-idx + 1, root.dimOf(root.value.date.year, i + 1)) : 0;
        root.set-value(
            { year: root.value.date.year >= root.start-year ? root.value.date.year : root.start-year, month: i + 1, day: day },
            root.value.hour >= 0 ? root.value.hour : 0,
            root.value.minute >= 0 ? root.value.minute : 0,
        );
    }

    function pick-day(i: int) {
        root.set-value(
            {
                year: root.value.date.year > 0 ? root.value.date.year : root.start-year,
                month: root.value.date.month >= 1 ? root.value.date.month : 1,
                day: i + 1,
            },
            root.value.hour >= 0 ? root.value.hour : 0,
            root.value.minute >= 0 ? root.value.minute : 0,
        );
    }

    function pick-hour(i: int) {
        root.set-value(root.value.date, i, root.value.minute >= 0 ? root.value.minute : 0);
    }

    function pick-minute(i: int) {
        root.set-value(
            root.value.date,
            root.value.hour >= 0 ? root.value.hour : 0,
            i,
        );
    }

    pure function dimOf(y: int, m: int) -> int {
        if (m == 2) {
            return root.leap(y) ? 29 : 28;
        }
        return m == 4 || m == 6 || m == 9 || m == 11 ? 30 : 31;
    }

    height: root.h;

    changed disabled => {
        if (root.disabled) {
            surface.close();
        }
    }

    public function show() {
        surface.show();
    }

    public function close() {
        surface.close();
    }

    public function toggle() {
        surface.toggle();
    }

    TInput {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        size: root.size;
        text: root.display-text;
        placeholder-text: root.placeholder-text;
        read-only: true;
        disabled: root.disabled;
        suffix-icon: TIconSet.Clock;
        accessible-role: AccessibleRole.none;
    }

    picker-touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.pointer;
        accessible-role: AccessibleRole.button;
        accessible-label: root.display-text != "" ? root.display-text : root.placeholder-text;
        accessible-enabled: !root.disabled;

        clicked => {
            surface.toggle();
        }
    }

    surface := TPopupSurface {
        anchor-width: root.width;
        anchor-height: root.height;
        placement: root.placement;
        gap: TTheme.spacing-3;
        popup-width: root.panel-w + 2px;
        popup-height: root.panel-h + 2px;
        popup-max-width: root.panel-w + 2px;

        Rectangle {
            x: root.pad;
            y: root.pad;
            width: parent.width - 2 * root.pad;
            height: root.visible-rows * root.item-h;

            HorizontalLayout {
                spacing: TTheme.spacing-2;

                TNumericWheel {
                    label: "年";
                    count: root.year-count;
                    base: root.start-year;
                    item-height: root.item-h;
                    value: root.year-idx;
                    picked(i) => { root.pick-year(i); }
                }

                TNumericWheel {
                    label: "月";
                    count: 12;
                    base: 1;
                    pad-width: 2;
                    item-height: root.item-h;
                    value: root.month-idx;
                    picked(i) => { root.pick-month(i); }
                }

                TNumericWheel {
                    label: "日";
                    count: root.dim;
                    base: 1;
                    pad-width: 2;
                    item-height: root.item-h;
                    value: root.day-idx;
                    picked(i) => { root.pick-day(i); }
                }

                TNumericWheel {
                    label: "时";
                    count: 24;
                    base: 0;
                    pad-width: 2;
                    item-height: root.item-h;
                    value: root.value.hour;
                    picked(i) => { root.pick-hour(i); }
                }

                TNumericWheel {
                    label: "分";
                    count: 60;
                    base: 0;
                    pad-width: 2;
                    item-height: root.item-h;
                    value: root.value.minute;
                    picked(i) => { root.pick-minute(i); }
                }
            }
        }
    }
}
