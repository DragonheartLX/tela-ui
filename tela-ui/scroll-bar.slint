// Tela UI — TScrollBar
//
// Scroll container with an integrated overlay scrollbar — replaces std
// ScrollView for the library's scrolling surfaces. The fluent native
// scrollbar (2px thumb pinned off-center, border-grade color) is not
// tunable from consumer code; here one Flickable viewport drives everything:
//   * wheel & flick: native Flickable behavior,
//   * drag starting on the thumb: instant — the pressed point of the
//     thumb stays glued under the pointer (grab offset preserved),
//   * drag starting on the track: the thumb's middle centers under the
//     pointer first, then drags along,
//   * click on the track (press + release without moving): eased jump,
//     thumb's middle on the click point (`scroll-to`, a glide timer —
//     see below why not `animate`); clicking the thumb itself is a no-op.
// All interactions write one shared `content-y`, so the thumb is always an
// exact map of the page position.
//
// Vertical scrolling only, for non-virtualized content: TList / TTable keep
// their ListView row recycling and wire the internal TScrollThumb overlay
// instead. Content size defaults to the children's preferred height — pin
// `content-height` when children animate their heights (collapsed rows etc.).

import { TTheme } from "./theme.slint";

export component TScrollBar inherits Rectangle {
    // Content size along the scroll axis; defaults to the children's
    // preferred height. Pin it when children collapse / animate heights.
    in property <length> content-height: body.preferred-height;
    // Off state disables the thumb strip (wheel still reaches the viewport).
    in property <bool> enabled: true;
    // Gap between the thumb column and the component's right edge — set it
    // to the window's resize-border width when the scroller sits flush at a
    // window edge, or the native drag-resize zone swallows the thumb hits.
    in property <length> thumb-inset: 0px;

    // Current scroll offset (0 .. -(content-height - height)). Two-way:
    // hosts read it (TBackTop) or scroll programmatically.
    in-out property <length> content-y <=> flick.content-y;

    private property <length> max-scroll: Math.max(0px, content-height - root.height);
    private property <length> track-l: root.height - 2 * TTheme.spacing-1;
    private property <length> thumb-l: max-scroll <= 0px ? 0px
        : max(24px, track-l * root.height / content-height);
    private property <length> thumb-pos: max-scroll <= 0px ? TTheme.spacing-1
        : TTheme.spacing-1 + (track-l - thumb-l) * (-content-y / max-scroll);
    // A press that moves beyond a 4px jiggle becomes a drag (instant; a
    // press on the thumb keeps its grab offset); a press released in place
    // on the track is a click (eased jump via scroll-to(), thumb centered
    // on the click point).
    // Easing cannot be `animate content-y`: the Flickable removes that
    // binding on every pointer press ("Stop animation by removing the
    // binding"), so the glide is a Timer writing plain values each frame.
    // The short glide overrides other writes instead of aborting on them
    // (wheel momentum residue killed abort-on-foreign-write mid-flight);
    // an active thumb drag is the one explicit hand-over.
    private property <bool> dragging: false;
    private property <bool> gliding: false;
    private property <length> glide-from: 0px;
    private property <length> glide-to: 0px;
    private property <float> glide-pos: 1;

    glide := Timer {
        // 16ms frame step; 0.08 ≈ 16ms / duration-base(200ms).
        interval: 16ms;
        running: root.gliding;

        triggered => {
            if (root.dragging) {
                root.gliding = false;
                return;
            }
            root.glide-pos = Math.min(1, root.glide-pos + 0.08);
            // ease-out cubic
            let k = 1 - (1 - root.glide-pos) * (1 - root.glide-pos) * (1 - root.glide-pos);
            root.content-y = root.glide-from + (root.glide-to - root.glide-from) * k;
            if (root.glide-pos >= 1) {
                root.gliding = false;
            }
        }
    }

    // Eased scroll to an absolute content offset, clamped to the scroll
    // range. Instant writes stay possible through `content-y` directly.
    public function scroll-to(target: length) {
        root.glide-from = root.content-y;
        root.glide-to = Math.max(-max-scroll, Math.min(0px, target));
        root.glide-pos = 0;
        root.gliding = true;
    }

    // Offset that centers the thumb's middle under a pointer position —
    // used for track presses; presses on the thumb keep their grab offset
    // instead (see the strip's moved handler).
    pure function pointer-target(mouse: length) -> length {
        let target = mouse - TTheme.spacing-1 - thumb-l / 2;
        let ratio = max-scroll > 0px
            ? max-scroll / Math.max(1px, track-l - thumb-l) : 0;
        return -Math.max(0px, Math.min(max-scroll, target * ratio));
    }

    // Whether a strip coordinate is on the thumb itself.
    pure function on-thumb(y: length) -> bool {
        return y >= root.thumb-pos && y <= root.thumb-pos + root.thumb-l;
    }

    clip: true;

    flick := Flickable {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-drag-pan-enabled: false;

        body := VerticalLayout {
            width: parent.width;
            spacing: 0px;

            @children
        }
    }

    strip := TouchArea {
        x: parent.width - self.width - root.thumb-inset;
        y: 0;
        width: 6px;
        height: parent.height;
        enabled: root.enabled;

        // Drag baseline and press target, captured on press.
        private property <length> pressed-offset;
        private property <length> pressed-mouse;
        private property <bool> pressed-on-thumb;

        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.dragging = false;
                self.pressed-mouse = self.mouse-y;
                self.pressed-on-thumb = root.on-thumb(self.mouse-y);
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                root.dragging = false;
            }
        }

        moved => {
            if (self.pressed) {
                let delta = self.mouse-y - self.pressed-mouse;
                if (!root.dragging
                    && (delta < 0px ? -delta : delta) > TTheme.spacing-2) {
                    root.dragging = true;
                    if (!self.pressed-on-thumb) {
                        // Track press: center the thumb's middle under the
                        // pointer, then drag from there.
                        root.content-y = root.pointer-target(self.mouse-y);
                    }
                    // Thumb press: keep the grab offset — the pressed point
                    // of the thumb stays under the pointer, no reposition.
                    self.pressed-offset = -root.content-y;
                    self.pressed-mouse = self.mouse-y;
                }
                if (root.dragging) {
                    let delta2 = self.mouse-y - self.pressed-mouse;
                    let ratio = max-scroll > 0px
                        ? max-scroll / Math.max(1px, track-l - thumb-l) : 0;
                    root.content-y = -Math.max(0px, Math.min(max-scroll, pressed-offset + delta2 * ratio));
                }
            }
        }

        // Click-to-jump on the track, eased via the glide timer (see
        // above); clicking the thumb itself is a no-op. A drag release
        // skips it too (dragging is still set; it resets here).
        clicked => {
            if (!root.dragging && !self.pressed-on-thumb) {
                root.scroll-to(root.pointer-target(self.mouse-y));
            }
            root.dragging = false;
        }
    }

    thumb := Rectangle {
        x: strip.x;
        y: thumb-pos;
        width: 6px;
        height: thumb-l;
        border-radius: TTheme.radius-round;
        // Idle is the most prominent state; hover / press lighten
        // progressively so the content under the bar shows through.
        background: strip.pressed ? TTheme.gray-5
            : strip.has-hover ? TTheme.gray-6
            : TTheme.gray-7;
        animate background { duration: TTheme.duration-fast; }
    }
}
