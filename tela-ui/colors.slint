        focus: #c6f3d7,
        active: #008858,
        disabled: #92dab2,
        light: #e3f9e9,
        light-hover: #c6f3d7,
    };

    out property <TPrimaryColor> warning: {
        color-1: #fff1e9,
        color-2: #ffd9c2,
        color-3: #ffb98c,
        color-4: #fa9550,
        color-5: #e37318,
        color-6: #be5a00,
        color-7: #954500,
        color-8: #713300,
        color-9: #532300,
        color-10: #3b1700,
        color: #e37318,
        hover: #fa9550,
        focus: #ffd9c2,
        active: #be5a00,
        disabled: #ffb98c,
        light: #fff1e9,
        light-hover: #ffd9c2,
    };

    out property <TPrimaryColor> error: {
        color-1: #fff0ed,
        color-2: #ffd8d2,
        color-3: #ffb9b0,
        color-4: #ff9285,
        color-5: #f6685d,
        color-6: #d54941,
        color-7: #ad352f,
        color-8: #881f1c,
        color-9: #68070a,
        color-10: #490002,
        color: #d54941,
        hover: #f6685d,
        focus: #ffd8d2,
        active: #ad352f,
        disabled: #ffb9b0,
        light: #fff0ed,
        light-hover: #ffd8d2,
    };
}

