// Tela UI — color presets
//
// TDesign color ramps for the light and dark schemes. `TLightColors` /
// `TDarkColors` are consumed by the `TTheme` global's default presets;
// they are also exported so custom themes can derive from the original
// palettes.

import { TPrimaryColor } from "structs/theme.slint";

export global TLightColors {
    out property <TPrimaryColor> brand: {
        color-1: #f2f3ff,
        color-2: #d9e1ff,
        color-3: #b5c7ff,
        color-4: #8eabff,
        color-5: #618dff,
        color-6: #366ef4,
        color-7: #0052d9,
        color-8: #003cab,
        color-9: #002a7c,
        color-10: #001a57,
        color: #0052d9,
        hover: #366ef4,
        focus: #d9e1ff,
        active: #003cab,
        disabled: #b5c7ff,
        light: #f2f3ff,
        light-hover: #d9e1ff,
    };

    out property <TPrimaryColor> success: {
        color-1: #e3f9e9,
        color-2: #c6f3d7,
        color-3: #92dab2,
        color-4: #56c08d,
        color-5: #2ba471,
        color-6: #008858,
        color-7: #006c45,
