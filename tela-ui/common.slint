// Tela UI — common (全量兼容出口)
//
// Legacy umbrella aggregating EVERY category aggregator. Kept so existing
// consumers of "@tela-ui/common.slint" keep working; new code can import
// from the finer category files instead:
//   @tela-ui/base.slint          基础组件
//   @tela-ui/input.slint         输入
//   @tela-ui/select.slint        选择
//   @tela-ui/date-time.slint     日期时间
//   @tela-ui/display.slint       展示
//   @tela-ui/content.slint       内容
//   @tela-ui/notice.slint        提示
//   @tela-ui/overlay.slint       浮层
//   @tela-ui/navigation.slint    导航
//   @tela-ui/experimental.slint  实验性

export { TButton, TButtonVariant, TButtonShape } from "base.slint";
export { TLink } from "base.slint";
export { TIcon } from "base.slint";
export { TIconData, TIconPath, TIconSet } from "base.slint";
export { TText, THeading, TParagraph, TCaption } from "base.slint";
export { TDivider, TDividerAlign } from "base.slint";
export { TLoading, TLoadingSpinner } from "base.slint";
export { TKbd } from "base.slint";
export { TBorderlessWindow } from "base.slint";

export { TInput, TTextArea, TInputStatus } from "input.slint";
export { TInputNumber } from "input.slint";
export { TAutoComplete, TAutoCompleteItem } from "input.slint";
export { TSlider } from "input.slint";
export { TRate } from "input.slint";

export { TSelect, TSelectItem } from "select.slint";
export { TCheckBox } from "select.slint";
export { TRadio, TRadioGroup, TRadioItem } from "select.slint";
export { TSwitch } from "select.slint";
export { TSegmented } from "select.slint";

export { TCalendar, TDate, TDatePicker } from "date-time.slint";
export { TTimePicker, TTime } from "date-time.slint";

export { TTag, TTagVariant } from "display.slint";
export { TAvatar, TAvatarSize, TAvatarShape } from "display.slint";
export { TBadge } from "display.slint";
export { TCard } from "display.slint";
export { TEmpty } from "display.slint";
export { TDescriptions, TDescriptionItem } from "display.slint";
export { TTimeline, TTimelineItem } from "display.slint";
export { TStatistic } from "display.slint";

export { TCollapse, TCollapseItem } from "content.slint";
export { TCarousel, TCarouselSlide } from "content.slint";
export { TCodeBlock } from "content.slint";
export { TTable, TTableColumn, TTableRow, TTableAlign, TTableSortDirection } from "content.slint";

export { TAlert } from "notice.slint";
export { TMessageOverlay, TMessage, TMessageTheme, TMessagePlacement } from "notice.slint";
export { TNotificationOverlay, TNotification, TNotificationTheme, TNotificationPlacement, TNotificationData } from "notice.slint";
export { TProgress, TProgressVariant } from "notice.slint";
export { TResult, TResultStatus } from "notice.slint";

export { TDialog } from "overlay.slint";
export { TDialogServiceOverlay, TDialogService } from "overlay.slint";
export { TDrawer, TDrawerPlacement } from "overlay.slint";
export { TBottomSheet } from "overlay.slint";
export { TActionSheetOverlay, TActionSheetService, TActionSheetItem } from "overlay.slint";
export { TImageViewerOverlay, TImageViewerService } from "overlay.slint";
export { TCommandPaletteOverlay, TCommandPaletteService, TCommandItem } from "overlay.slint";
export { TPopconfirm } from "overlay.slint";
export { TTooltipOverlay, TTooltip, TTooltipArea, TTooltipPlacement } from "overlay.slint";
export { TLoadingServiceOverlay, TLoadingService } from "overlay.slint";

export { TTabs } from "navigation.slint";
export { TPagination } from "navigation.slint";
export { TNavBar, TNavItem } from "navigation.slint";
export { TSideNav, TSideNavItem, TSideNavFooterItem, TSideNavMode, TSideNavTogglePosition } from "navigation.slint";
export { TBreadcrumb, TCrumbItem } from "navigation.slint";
export { TSteps } from "navigation.slint";
export { TDropdownMenu, TDropdownMenuItem } from "navigation.slint";
export { TPopupPlacement } from "theme.slint";
export { TBackTop } from "navigation.slint";

export { TSkeleton } from "experimental.slint";
