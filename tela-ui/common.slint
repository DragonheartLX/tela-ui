// Tela UI — common (全量兼容出口)
//
// Legacy umbrella aggregating EVERY category aggregator. Kept so existing
// consumers of "@tela-ui/common.slint" keep working; new code can import
// from the category files instead:
//   @tela-ui/base.slint          基础组件
//   @tela-ui/data-entry.slint    数据录入
//   @tela-ui/data-display.slint  数据展示
//   @tela-ui/feedback.slint      反馈
//   @tela-ui/navigation.slint    导航
//   @tela-ui/experimental.slint  实验性

export { TButton, TButtonVariant, TButtonShape } from "base.slint";
export { TLink } from "base.slint";
export { TIcon } from "base.slint";
export { TIconData, TIconPath, TIconSet } from "base.slint";
export { THeading, TParagraph, TCaption } from "base.slint";
export { TDivider, TDividerAlign } from "base.slint";
export { TLoading, TLoadingSpinner } from "base.slint";
export { TKbd } from "base.slint";
export { TBorderlessWindow } from "base.slint";

export { TInput, TTextArea, TInputStatus } from "data-entry.slint";
export { TInputNumber } from "data-entry.slint";
export { TSelect, TSelectItem } from "data-entry.slint";
export { TCheckBox } from "data-entry.slint";
export { TRadio, TRadioGroup, TRadioItem } from "data-entry.slint";
export { TSwitch } from "data-entry.slint";
export { TSlider } from "data-entry.slint";
export { TRate } from "data-entry.slint";
export { TSegmented } from "data-entry.slint";

export { TTag, TTagVariant } from "data-display.slint";
export { TAvatar, TAvatarSize, TAvatarShape } from "data-display.slint";
