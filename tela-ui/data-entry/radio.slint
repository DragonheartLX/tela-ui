// Tela UI — TRadio & TRadioGroup
//
// TRadioGroup lays out a set of options and owns the selected `value`.
// Standalone TRadio buttons can be composed the same way via `checked`.

import { TTheme } from "../theme.slint";

export struct TRadioItem {
    text: string,
    value: string,
}

export component TRadio inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> disabled;

    callback clicked();

    // Rest state; overridden by the `states` below.
    private property <brush> ring: TTheme.component-border;
    private property <brush> dot: TTheme.brand-color;

    height: TTheme.height-m;
    width: content.preferred-width;
    animate ring { duration: TTheme.duration-fast; }
    animate dot { duration: TTheme.duration-fast; }

    // Later states win over earlier ones.
    states [
        hovered when touch.has-hover: {
            ring: TTheme.brand-color;
        }
        selected when root.selected: {
            ring: TTheme.brand-color;
        }
        disabled when root.disabled: {
            ring: TTheme.border-level-1-color;
            dot: TTheme.brand-color-disabled;
        }
    ]

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        x: 0;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        spacing: TTheme.spacing-2;

        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-color: root.ring;
            border-radius: self.width / 2;
            background: TTheme.bg-color-specialcomponent;

            if root.selected: Rectangle {
                width: 6px;
                height: 6px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.dot;
            }
        }

        if root.text != "": Text {
            text: root.text;
            font-size: TTheme.font-size-m;
            color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-primary;
            vertical-alignment: center;
        }
    }

    accessible-role: AccessibleRole.radio-button;
    accessible-label: text;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
}

export component TRadioGroup inherits HorizontalLayout {
    in property <[TRadioItem]> items;
    in-out property <string> value;
    in property <bool> disabled;

    callback changed(string);

    spacing: TTheme.margin-l;

    // Absorber: keeps radios left-packed when the group stretches wider
    // than its content (else the layout spreads the slack as extra gaps).
    for it[i] in items: TRadio {
        text: it.text;
        selected: it.value == root.value;
        disabled: root.disabled;
        clicked => {
            root.value = it.value;
            root.changed(it.value);
        }
    }

    // Absorber: keeps radios left-packed when the group stretches wider
    // than its content (an all-fixed-width layout would otherwise spread
    // the slack as extra gaps between the items).
    Rectangle { }
}
