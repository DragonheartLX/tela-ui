// Tela UI — TInput & TTextArea
//
// Single-line input with prefix/suffix icons, clearable, status colors and
// password mode; multi-line TTextArea.

import { TTheme } from "../theme.slint";
import { TSize } from "../structs/enums.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData, TIconSet } from "../base/icon/data.slint";

export enum TInputStatus {
    default,
    success,
    warning,
    error,
}

// Shared frame for TInput / TTextArea / TInputNumber: background and border
// follow the status, hover / focus / disabled override it, and clicking the
// frame focuses the text input (subclasses wire `focus-request` to theirs).
// Exported for reuse inside the library only — it is NOT part of the
// common.slint aggregator surface.
export component TInputFrame inherits Rectangle {
    in property <TInputStatus> status: TInputStatus.default;
    in property <bool> disabled;
    // Whether the subclass TextInput holds keyboard focus.
    in property <bool> focused;
    in property <length> radius: TTheme.radius-default;
    callback focus-request();
    // Subclasses can't reach `touch-bg` directly (base elements are not in
    // their scope), so the frame publishes its hover state.
    out property <bool> frame-hovered: touch-bg.has-hover;

    // Rest border follows the status color; overridden by `states`
    // (later states win over earlier ones).
    private property <brush> border-c:
        root.status == TInputStatus.error ? TTheme.error-color
        : root.status == TInputStatus.warning ? TTheme.warning-color
        : root.status == TInputStatus.success ? TTheme.success-color
        : TTheme.component-border;

    background: TTheme.bg-color-specialcomponent;
    border-width: 1px;
    border-color: border-c;
    border-radius: root.radius;
    animate border-c { duration: TTheme.duration-fast; }

    states [
        hovered when touch-bg.has-hover && root.status == TInputStatus.default && !root.disabled: {
            border-c: TTheme.border-level-2-color;
        }
        focused when root.focused && root.status == TInputStatus.default: {
            border-c: TTheme.brand-color;
        }
        disabled when root.disabled: {
            border-c: TTheme.border-level-1-color;
        }
    ]

    touch-bg := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.text;
        clicked => {
            root.focus-request();
        }
    }
}

export component TInput inherits TInputFrame {
    in property <TSize> size: TSize.medium;
    in property <string> placeholder-text;
    in-out property <string> text <=> ti.text;
    in property <bool> read-only <=> ti.read-only;
    in property <TIconData> prefix-icon;
    in property <TIconData> suffix-icon;
    in property <bool> clearable: false;
    in property <InputType> input-type: InputType.text;

    callback accepted(string);
    callback changed(string);
    callback cleared();

    private property <length> h: TTheme.size-height(size);
    private property <length> fs: TTheme.size-font(size);
    private property <length> pad:
        size == TSize.large ? TTheme.spacing-3 : TTheme.spacing-2;
    private property <length> spacing-left: TTheme.spacing-2;

    private property <bool> clear-visible:
        clearable && !root.disabled && !read-only && text != "" && root.frame-hovered;

    height: h;
    forward-focus: ti;
    focused: ti.has-focus;
    focus-request => { ti.focus(); }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: pad;
        padding-right: pad;
        spacing: TTheme.spacing-2;

        if root.prefix-icon.paths.length > 0: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.prefix-icon;
            size: root.fs + 2px;
            icon-color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-placeholder;
        }

        ti := TextInput {
            vertical-alignment: center;
            single-line: true;
            input-type: root.input-type;
            color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-primary;
            font-size: root.fs;
            font-family: TTheme.font-family;
            selection-background-color: TTheme.brand-color-light;
            selection-foreground-color: TTheme.text-color-primary;
            enabled: !root.disabled && !root.read-only;
            horizontal-stretch: 1;

            accepted => {
                root.accepted(self.text);
            }
            edited => {
                root.changed(self.text);
            }
        }

        if root.clear-visible: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;

            TIcon {
                x: 1px;
                y: 1px;
                icon: TIconSet.CircleX;
                size: 14px;
                icon-color: clear-ta.has-hover ? TTheme.text-color-secondary : TTheme.text-color-placeholder;
                animate icon-color { duration: TTheme.duration-fast; }
            }
            clear-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.text = "";
                    root.cleared();
                }
            }
        }

        if root.suffix-icon.paths.length > 0 && !root.clear-visible: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.suffix-icon;
            size: root.fs + 2px;
            icon-color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-placeholder;
        }
    }

    // Placeholder (above the background, hidden once text is entered)
    placeholder := Text {
        x: root.prefix-icon.paths.length > 0 ? pad + 16px + spacing-left : pad;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: (root.text == "" && ti.preedit-text == "") ? root.placeholder-text : "";
        font-size: root.fs;
        font-family: TTheme.font-family;
        color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-placeholder;
        overflow: elide;
        width: parent.width - self.x - pad;
    }

    accessible-role: AccessibleRole.text-input;
    accessible-label: placeholder-text;
}

export component TTextArea inherits TInputFrame {
    in property <string> placeholder-text;
    in-out property <string> text <=> ti.text;
    in property <bool> read-only <=> ti.read-only;
    // Preferred visible line count.
    in property <int> rows: 4;

    callback changed(string);

    height: rows * TTheme.line-height-m + TTheme.spacing-3 * 2;
    radius: TTheme.radius-medium;
    clip: true;
    forward-focus: ti;
    focused: ti.has-focus;
    focus-request => { ti.focus(); }

    ti := TextInput {
        x: TTheme.spacing-3;
        y: TTheme.spacing-3;
        width: parent.width - self.x * 2;
        height: parent.height - self.y * 2;
        wrap: word-wrap;
        color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-primary;
        font-size: TTheme.font-size-m;
        font-family: TTheme.font-family;
        selection-background-color: TTheme.brand-color-light;
        selection-foreground-color: TTheme.text-color-primary;
        enabled: !root.disabled && !root.read-only;

        edited => {
            root.changed(self.text);
        }
    }

    placeholder := Text {
        x: TTheme.spacing-3;
        y: TTheme.spacing-3;
        width: parent.width - self.x * 2;
        text: (root.text == "" && ti.preedit-text == "") ? root.placeholder-text : "";
        wrap: word-wrap;
        font-size: TTheme.font-size-m;
        font-family: TTheme.font-family;
        color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-placeholder;
    }

    accessible-role: AccessibleRole.text-input;
    accessible-label: placeholder-text;
}
