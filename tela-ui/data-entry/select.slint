// Tela UI — TSelect
//
// Dropdown selector. Anchored popup lists up to 6 items; the popup matches
// the trigger width (at least 120px). Keyboard support is not included yet.

import { TTheme } from "../theme.slint";
import { TSize } from "../structs/enums.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData, TIconSet } from "../base/icon/data.slint";
import { TPopupSurface } from "../popup-surface.slint";

export struct TSelectItem {
    label: string,
    value: string,
    disabled: bool = false,
}

export component TSelect inherits Rectangle {
    in property <[TSelectItem]> items;
    in-out property <int> current-index: -1;
    in-out property <string> current-value;
    in property <string> placeholder-text;
    in property <bool> disabled;
    in property <TIconData> prefix-icon;
    in property <TSize> size: TSize.medium;

    callback selected(int, string);

    private property <length> h: TTheme.size-height(size);
    private property <length> fs: TTheme.size-font(size);
    private property <length> item-h: 32px;

    private property <string> display-label:
        current-index >= 0 && current-index < items.length ? items[current-index].label : "";
    private property <bool> has-selection: current-index >= 0 && current-index < items.length;

    min-width: 160px;
    height: h;
    background: TTheme.bg-color-specialcomponent;
    border-width: 1px;
    border-color: TTheme.component-border;
    border-radius: TTheme.radius-default;
    animate border-color { duration: TTheme.duration-fast; }

    states [
        hovered when touch.has-hover && !root.disabled: {
            border-color: TTheme.border-level-2-color;
        }
        disabled when root.disabled: {
            border-color: TTheme.border-level-1-color;
        }
    ]

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            surface.show();
        }
    }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: TTheme.spacing-2;
        padding-right: TTheme.spacing-2;
        spacing: TTheme.spacing-2;

        if root.prefix-icon.paths.length > 0: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.prefix-icon;
            size: root.fs + 2px;
            icon-color: TTheme.text-color-placeholder;
        }

        Text {
            text: root.has-selection ? root.display-label : root.placeholder-text;
            font-size: root.fs;
            font-family: TTheme.font-family;
            color: TTheme.text-color-placeholder;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;

            // Later states win over earlier ones.
            states [
                selected when root.has-selection: {
                    color: TTheme.text-color-primary;
                }
                disabled when root.disabled: {
                    color: TTheme.text-color-disabled;
                }
            ]
        }

        TIcon {
            y: (parent.height - self.height) / 2;
            icon: TIconSet.ChevronDown;
            size: root.fs;
            icon-color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-secondary;
            transform-rotation: surface.is-open ? 180deg : 0deg;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            animate transform-rotation { duration: TTheme.duration-fast; }
        }
    }

    // The popup matches the trigger width (at least 120px) and shows up to
    // 6 rows before it would need scrolling.
    surface := TPopupSurface {
        anchor-width: root.width;
        anchor-height: root.height;
        gap: 4px;
        popup-width: max(root.width, 120px);
        popup-max-width: max(root.width, 120px);
        popup-height: min(root.items.length, 6) * root.item-h + 8px;

        VerticalLayout {
            padding: 4px;

            for it[i] in root.items: Rectangle {
                height: root.item-h;
                border-radius: TTheme.radius-default;
                background: transparent;
                animate background { duration: TTheme.duration-fast; }

                states [
                    hovered when item-ta.has-hover && !it.disabled: {
                        background: TTheme.bg-color-container-hover;
                    }
                    selected when i == root.current-index: {
                        background: TTheme.brand-color-light;
                    }
                ]

                HorizontalLayout {
                    padding-left: TTheme.spacing-2;
                    padding-right: TTheme.spacing-2;
                    spacing: TTheme.spacing-2;

                    Text {
                        text: it.label;
                        font-size: root.fs;
                        font-family: TTheme.font-family;
                        color: TTheme.text-color-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;

                        // Later states win over earlier ones.
                        states [
                            active when i == root.current-index: {
                                color: TTheme.brand-color;
                            }
                            disabled when it.disabled: {
                                color: TTheme.text-color-disabled;
                            }
                        ]
                    }

                    if i == root.current-index: TIcon {
                        y: (parent.height - self.height) / 2;
                        icon: TIconSet.Check;
                        size: root.fs;
                        icon-color: TTheme.brand-color;
                    }
                }

                item-ta := TouchArea {
                    enabled: !it.disabled;
                    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        root.current-index = i;
                        root.current-value = it.value;
                        root.selected(i, it.value);
                        surface.close();
                    }
                }
            }
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: display-label;
}
