// Tela UI — TSwitch
//
// Toggle switch. size: TSize (small 36×18 / medium 40×22 / large 48×24).

import { TTheme } from "../theme.slint";
import { TSize } from "../structs/enums.slint";
import { TTheme } from "../theme.slint";

export component TSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> disabled;
    in property <TSize> size: TSize.medium;

    callback changed(bool);

    private property <length> w:
        size == TSize.small ? 36px
        : size == TSize.large ? 48px
        : 40px;
    private property <length> h:
        size == TSize.small ? 18px
        : size == TSize.large ? 24px
        : 22px;
    private property <length> thumb: h - 6px;
    private property <length> inset: 3px;

    width: w;
    height: h;
    border-radius: self.height / 2;
    background: checked ? TTheme.brand-color : TTheme.bg-color-component;
    animate background { duration: TTheme.duration-fast; }

    // Later states win over earlier ones.
    states [
        on-hovered when checked && touch.has-hover: {
            background: TTheme.brand-color-hover;
        }
        on-pressed when checked && touch.pressed: {
            background: TTheme.brand-color-active;
        }
        off-hovered when !checked && touch.has-hover: {
            background: TTheme.bg-color-component-hover;
        }
        disabled when root.disabled: {
            background: checked ? TTheme.brand-color-disabled : TTheme.bg-color-component-disabled;
        }
    ]

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.checked = !root.checked;
            root.changed(root.checked);
        }
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - root.inset : root.inset;
        y: (parent.height - self.height) / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: self.width / 2;
        background: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-anti;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: rgba(0, 0, 0, 0.2);
        animate x { duration: TTheme.duration-fast; easing: ease-out; }
    }

    accessible-role: AccessibleRole.checkbox;
    accessible-checked: checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.changed(root.checked);
    }
}
