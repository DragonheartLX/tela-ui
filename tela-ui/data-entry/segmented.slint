// Tela UI — Segmented
//
// Pill-style exclusive picker (iOS segmented control). Fills the container
// width; segments split it equally. Wrap it in a width-constrained container
// when fewer/shorter options are wanted.

import { TelaTheme, Size } from "../theme.slint";

export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current-index: 0;
    in property <Size> size: Size.medium;
    in property <bool> disabled: false;

    callback changed(int);

    private property <length> fs: TelaTheme.size-font(size);

    height: TelaTheme.size-height(size);
    background: TelaTheme.bg-color-secondarycontainer;
    border-radius: TelaTheme.radius-medium;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for it[i] in root.items: Rectangle {
            horizontal-stretch: 1;
            border-radius: TelaTheme.radius-medium;
            background: i == root.current-index ? TelaTheme.bg-color-container : transparent;
            animate background { duration: TelaTheme.duration-fast; }

            states [
                elevated when i == root.current-index: {
                    drop-shadow-blur: TelaTheme.shadow-1-blur;
                    drop-shadow-offset-y: TelaTheme.shadow-1-offset-y;
                    drop-shadow-color: TelaTheme.shadow-1-color;
                }
            ]

            ta := TouchArea {
                enabled: !root.disabled;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    if (root.current-index != i) {
                        root.current-index = i;
                        root.changed(i);
                    }
                }
            }

            Text {
                text: it;
                font-size: root.fs;
                font-family: TelaTheme.font-family;
                vertical-alignment: center;
                horizontal-alignment: center;
                color: i == root.current-index ? TelaTheme.text-color-primary : TelaTheme.text-color-secondary;
                animate color { duration: TelaTheme.duration-fast; }

                states [
                    hovered when ta.has-hover && !root.disabled && i != root.current-index: {
                        color: TelaTheme.text-color-primary;
                    }
                    disabled when root.disabled: {
                        color: TelaTheme.text-color-disabled;
                    }
                ]
            }
        }
    }
}
