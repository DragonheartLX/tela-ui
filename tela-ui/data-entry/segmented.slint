// Tela UI — TSegmented
//
// Pill-style exclusive picker (iOS segmented control). Fills the container
// width; segments split it equally. Wrap it in a width-constrained container
// when fewer/shorter options are wanted.

import { TTheme,  TSize } from "../theme.slint";
import { TText } from "../base/typography.slint";

export component TSegmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current-index: 0;
    in property <TSize> size: TSize.medium;
    in property <bool> disabled: false;

    callback changed(int);

    private property <length> fs: TTheme.size-font(size);
    private property <length> line: TTheme.size-line-height(size);

    height: TTheme.size-height(size);
    background: TTheme.bg-color-secondarycontainer;
    border-radius: TTheme.radius-medium;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for it[i] in root.items: Rectangle {
            horizontal-stretch: 1;
            border-radius: TTheme.radius-medium;
            background: i == root.current-index ? TTheme.bg-color-container : transparent;
            animate background { duration: TTheme.duration-fast; }

            states [
                elevated when i == root.current-index: {
                    drop-shadow-blur: TTheme.shadow-1-blur;
                    drop-shadow-offset-y: TTheme.shadow-1-offset-y;
                    drop-shadow-color: TTheme.shadow-1-color;
                }
            ]

            // Radio-button semantics: segments are an exclusive picker.
            accessible-role: AccessibleRole.radio-button;
            accessible-label: it;
            accessible-checked: i == root.current-index;
            accessible-enabled: !root.disabled;
            accessible-action-default => {
                if (!root.disabled && root.current-index != i) {
                    root.current-index = i;
                    root.changed(i);
                }
            }

            ta := TouchArea {
                enabled: !root.disabled;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    if (root.current-index != i) {
                        root.current-index = i;
                        root.changed(i);
                    }
                }
            }

            TText {
                text: it;
                font-size: root.fs;
                line-height: root.line;
                vertical-alignment: center;
                horizontal-alignment: center;
                color: i == root.current-index ? TTheme.text-color-primary : TTheme.text-color-secondary;
                animate color { duration: TTheme.duration-fast; }

                states [
                    hovered when ta.has-hover && !root.disabled && i != root.current-index: {
                    }
                    disabled when root.disabled: {
                        color: TTheme.text-color-disabled;
                    }
                ]
            }
        }
    }
}
