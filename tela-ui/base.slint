// Tela UI — base components (基础组件)
//
// Atoms with no business semantics: controls and primitives every other
// category builds on. Import from here instead of individual files:
//   import { TButton, TIcon } from "@tela-ui/base.slint";
//
// TTheme tokens remain at "@tela-ui/theme.slint".

export { TButton, TButtonVariant, TButtonShape } from "base/button.slint";
export { TLink } from "base/link.slint";
export { TIcon } from "base/icon/icon.slint";
export { TIconData, TIconPath, TIconSet } from "base/icon/data.slint";
export { THeading, TParagraph, TCaption } from "base/typography.slint";
export { TDivider, TDividerAlign } from "base/divider.slint";
export { TLoading, TLoadingSpinner } from "base/loading.slint";
export { TKbd } from "base/kbd.slint";
export { TBorderlessWindow } from "base/borderless-window.slint";
