// Tela UI — TTreeSelect
//
// Tree select: TSelect's trigger over a popup that hosts a TTree. Nest
// `TTreeItem` / `TTreeBranch` as children — they land inside the popup's
// tree through `@children`.
//
// Selection rides the TTreeLogic global (one store serves every tree in the
// window — see content/tree.slint). The component watches the store and
// reports `selected(value)` while its popup is open, then closes it, so a
// leaf click anywhere in this popup is enough. Picking an already-selected
// leaf is a no-op inside TTreeItem and fires nothing.
//
// The trigger shows `display-text` when the host sets it, otherwise the
// selected value.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TSize, TPopupPlacement } from "../structs/enums.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData, TIconSet } from "../base/icon/data.slint";
import { TPopupSurface } from "../popup-surface.slint";
import { TScrollBar } from "../scroll-bar.slint";
import { TTree, TTreeLogic } from "../content/tree.slint";
import { ScrollView } from "std-widgets.slint";

export component TTreeSelect inherits Rectangle {
    // Host-provided label; falls back to TTreeLogic.current-value.
    in property <string> display-text: "";
    in property <string> placeholder-text;
    in property <bool> disabled;
    in property <TIconData> prefix-icon;
    in property <TSize> size: TSize.medium;
    in property <TPopupPlacement> placement: TPopupPlacement.bottom-start;
    // The popup cannot take its height from the content: the PopupWindow
    // reads the ScrollView's preferred height (not the tree's), which
    // collapses to nothing. Pin it like TSelect does; taller trees scroll.
    in property <length> panel-height: 8 * TTheme.height-m + 8px;

    callback selected(string);

    out property <bool> is-open: surface.is-open;

    public function show() {
        surface.show();
    }

    public function close() {
        surface.close();
    }

    public function toggle() {
        surface.toggle();
    }

    private property <length> h: TTheme.size-height(size);
    private property <length> fs: TTheme.size-font(size);
    private property <length> line: TTheme.size-line-height(size);
    private property <string> shown-text:
        display-text != "" ? display-text : TTreeLogic.current-value;
    // `changed` cannot attach to a global property directly; mirror it first.
    private property <string> selected-value: TTreeLogic.current-value;

    changed selected-value => {
        if (surface.is-open) {
            root.selected(selected-value);
            surface.close();
        }
    }

    height: h;
    min-width: 160px;
    background: TTheme.bg-color-specialcomponent;
    border-width: 1px;
    border-color: TTheme.component-border;
    border-radius: TTheme.radius-default;
    animate border-color { duration: TTheme.duration-fast; }

    states [
        hovered when touch.has-hover && !root.disabled: {
            border-color: TTheme.border-level-2-color;
        }
        disabled when root.disabled: {
            border-color: TTheme.border-level-1-color;
        }
    ]

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            surface.toggle();
        }
    }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: TTheme.spacing-2;
        padding-right: TTheme.spacing-2;
        spacing: TTheme.spacing-2;

        if root.prefix-icon.paths.length > 0: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.prefix-icon;
            size: root.fs + 2px;
            icon-color: TTheme.text-color-placeholder;
        }

        TText {
            text: root.shown-text != "" ? root.shown-text : root.placeholder-text;
            font-size: root.fs;
            line-height: root.line;
            color: root.shown-text != "" ? TTheme.text-color-primary : TTheme.text-color-placeholder;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;

            states [
                disabled when root.disabled: {
                    color: TTheme.text-color-disabled;
                }
            ]
        }

        TIcon {
            y: (parent.height - self.height) / 2;
            icon: TIconSet.ChevronDown;
            size: root.fs;
            icon-color: root.disabled ? TTheme.text-color-disabled : TTheme.text-color-secondary;
            transform-rotation: surface.is-open ? 180deg : 0deg;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            animate transform-rotation { duration: TTheme.duration-fast; }
        }
    }

    surface := TPopupSurface {
        anchor-width: root.width;
        anchor-height: root.height;
        placement: root.placement;
        gap: 4px;
        popup-width: max(root.width, 200px);
        popup-height: root.panel-height;

        Rectangle {
            sv := ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    padding: 4px;

                    TTree {
                        @children
                    }
                }
            }

            TScrollBar {
                width: 6px;
                x: parent.width - self.width;
                y: 0;
                height: parent.height;
                content-length: sv.content-height;
                viewport-length: sv.visible-height;
                content-offset <=> sv.content-y;
            }
        }
    }

    changed disabled => {
        if (root.disabled) {
            surface.close();
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: root.shown-text;
}
