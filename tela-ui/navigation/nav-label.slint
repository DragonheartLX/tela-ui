// Tela UI — TNavLabel (internal infrastructure)
//
// One selectable text row shared by the nav family's text-model rows
// (TNavBar / TTabs / TBreadcrumb). It carries the hover/selected color
// matrix, the pointer cursor and the TouchArea; hosts keep their own
// geometry — row size, underline, separators.
// The bg-hover row model (TSideNav's TNavRow, TPagination's TPageBtn) is a
// different visual and stays per-component.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";

export component TNavLabel inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    // Off turns the TouchArea off (breadcrumb's current crumb).
    in property <bool> disabled: false;
    in property <color> base-color: TTheme.text-color-primary;
    in property <color> selected-color: TTheme.brand-color;
    // TTabs adds weight to selection.
    in property <bool> semibold-when-selected: false;
    // Glyph alignment inside a stretched row; TNavBar centers, TTabs left
    // and top (its bare Text never had an explicit alignment).
    in property <TextHorizontalAlignment> label-align: TextHorizontalAlignment.center;
    in property <TextVerticalAlignment> label-valign: TextVerticalAlignment.center;
    // Intrinsic text width; hosts compute row and indicator width from it.
    out property <length> label-width: t.preferred-width;

    callback clicked();

    // Later states win over earlier ones, so a selected row keeps its
    // selected color while hovered.
    t := TText {
        width: 100%;
        height: 100%;
        text: root.label;
        font-weight: root.selected && root.semibold-when-selected
            ? TTheme.font-weight-semibold : TTheme.font-weight-regular;
        color: root.base-color;
        horizontal-alignment: root.label-align;
        vertical-alignment: root.label-valign;
        animate color { duration: TTheme.duration-fast; }

        states [
            hovered when ta.has-hover: {
                color: TTheme.brand-color-hover;
            }
            selected when root.selected: {
                color: root.selected-color;
            }
        ]
    }

    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}
