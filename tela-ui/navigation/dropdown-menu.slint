// Tela UI — TDropdownMenu
//
// Action menu anchored to arbitrary trigger content.
// With `auto-open` (the default) a TouchArea layered over the trigger toggles
// the popup.
// This requires non-interactive trigger content, icon, text, avatar and so on.
// The area swallows their clicks.
// For TButton triggers set `auto-open: false` and call `toggle()` from
// `clicked` instead.
// The menu closes on outside clicks and after selecting an entry.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TPopupPlacement } from "../structs/enums.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData } from "../base/icon/data.slint";
import { TPopupSurface } from "../popup-surface.slint";
import { TScrollBar } from "../scroll-bar.slint";
import { ScrollView } from "std-widgets.slint";

export struct TDropdownMenuItem {
    label: string,
    value: string,
    icon: TIconData = { paths: [] },
    disabled: bool = false,
    danger: bool = false,
    // Render a hairline separator instead of the entry.
    divider: bool = false,
}

export component TDropdownMenu inherits Rectangle {
    in property <[TDropdownMenuItem]> items;
    in property <TPopupPlacement> placement: TPopupPlacement.bottom-start;
    // Click-toggle TouchArea over the trigger content.
    // Non-interactive triggers only.
    in property <bool> auto-open: true;
    in property <length> item-height: TTheme.height-m;
    in property <int> max-visible-items: 6;
    callback selected(int, string);

    out property <bool> open: surface.is-open;

    // Divider rows are compact (hairline + spacing-1 above and below), so
    // the popup height cannot be derived from the item count alone. Every
    // row reports its height on creation; a whole-model replacement rebuilds
    // the rows, whose init re-reports over the reset total (the TAutoComplete
    // reporting pattern).
    private property <length> divider-h: TTheme.spacing-1 * 2 + 1px;
    private property <length> rows-h: 0px;
    changed items => {
        root.rows-h = 0px;
    }

    public function show() {
        // The popup rows are (re)created on every open and report their
        // heights from init, so the accumulator must start from zero.
        root.rows-h = 0px;
        surface.show();
    }

    public function close() {
        surface.close();
    }

    public function toggle() {
        if (surface.is-open) {
            surface.close();
        } else {
            root.show();
        }
    }


    // Trigger content hosted in a layout.
    // That makes the wrapper hug it in parent layouts, since a bare child
    // would not feed the preferred size.
    row := HorizontalLayout {
        @children
    }

    // Layered over the trigger content.
    // It is declared after the row, so static triggers click through to it.
    // Declaring it before would zero the wrapper's preferred size in layouts.
    // Interactive triggers set `auto-open: false`, which removes the area entirely.
    if root.auto-open: TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.toggle();
        }
    }

    surface := TPopupSurface {
        anchor-width: root.width;
        anchor-height: root.height;
        placement: root.placement;
        // Reported row heights, capped at `max-visible-items` full rows plus
        // the list layout's 2 × 4px padding.
        popup-height: min(root.rows-h, root.max-visible-items * root.item-height) + 8px;

        Rectangle {
        sv := ScrollView {
            width: parent.width;
            height: parent.height;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;

            rows := VerticalLayout {
                padding: 4px;

                for it[i] in root.items: Rectangle {
                    height: it.divider ? root.divider-h : root.item-height;
                    border-radius: TTheme.radius-default;
                    background: transparent;
                    animate background { duration: TTheme.duration-fast; }

                    init => {
                        root.rows-h = root.rows-h + self.height;
                    }

                    // Per-entry label color.
                    // Danger red beats the neutral primary.
                    // Disabled grays out both.
                    private property <color> label-c:
                        it.disabled ? TTheme.text-color-disabled
                        : it.danger ? TTheme.error-color
                        : TTheme.text-color-primary;

                    states [
                        hovered when row-ta.has-hover && !it.disabled && !it.divider && !it.danger: {
                            background: TTheme.bg-color-component-hover;
                        }
                        hovered-danger when row-ta.has-hover && !it.disabled && !it.divider && it.danger: {
                            background: TTheme.error-color-light;
                        }
                    ]

                    if !it.divider: HorizontalLayout {
                        padding-left: TTheme.spacing-2;
                        padding-right: TTheme.spacing-2;
                        spacing: TTheme.spacing-2;

                        if it.icon.paths.length > 0: TIcon {
                            y: (parent.height - self.height) / 2;
                            icon: it.icon;
                            size: TTheme.font-size-m;
                            icon-color: label-c;
                        }

                        TText {
                            text: it.label;
                            color: label-c;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    // Compact divider row: the hairline centers itself in
                    // the 9px box; entry rows stay at `item-height`.
                    if it.divider: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 1px;
                        background: TTheme.border-level-1-color;
                    }

                    row-ta := TouchArea {
                        enabled: !it.disabled && !it.divider;
                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => {
                            root.selected(i, it.value);
                            surface.close();
                        }
                    }
                }
            }
        }

        TScrollBar {
            width: 6px;
            x: parent.width - self.width;
            y: 0;
            height: parent.height;
            content-length: sv.content-height;
            viewport-length: sv.visible-height;
            content-offset <=> sv.content-y;
        }
        }
    }

    accessible-role: AccessibleRole.button;
}
