// Tela UI — TDropdownMenu
//
// Action menu anchored to arbitrary trigger content. With `auto-open` (the
// default) a TouchArea layered over the trigger toggles the popup — this
// requires non-interactive trigger content (icon, text, avatar …), because
// the area swallows their clicks. For TButton triggers set `auto-open: false`
// and call `toggle()` from `clicked` instead. The menu closes on outside
// clicks and after selecting an entry.

import { TTheme } from "../theme.slint";
import { TPopupPlacement } from "../structs/enums.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData } from "../base/icon/data.slint";
import { TPopupSurface } from "../popup-surface.slint";
import { ScrollView } from "std-widgets.slint";

export struct TDropdownMenuItem {
    label: string,
    value: string,
    icon: TIconData = { paths: [] },
    disabled: bool = false,
    danger: bool = false,
    // Render a hairline separator instead of the entry.
    divider: bool = false,
}

export component TDropdownMenu inherits Rectangle {
    in property <[TDropdownMenuItem]> items;
    in property <TPopupPlacement> placement: TPopupPlacement.bottom-start;
    // Click-toggle TouchArea over the trigger content (non-interactive
    // triggers only).
    in property <bool> auto-open: true;
    in property <length> item-height: 32px;
    // Visible rows before the popup starts scrolling.
    in property <int> max-visible-items: 6;

    callback selected(int, string);

    out property <bool> open: surface.is-open;

    public function show() {
        surface.show();
    }

    public function close() {
        surface.close();
    }

    public function toggle() {
        surface.toggle();
    }

    // Trigger content hosted in a layout so the wrapper hugs it in parent
    // layouts (a bare child would not feed the preferred size).
    row := HorizontalLayout {
        @children
    }

    // Layered OVER the trigger content (declared after the row) so static
    // triggers click through to it. Declaring it before would zero the
    // wrapper's preferred size in layouts. Interactive triggers set
    // `auto-open: false`, which removes the area entirely.
    if root.auto-open: TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.toggle();
        }
    }

    surface := TPopupSurface {
        anchor-width: root.width;
        anchor-height: root.height;
        placement: root.placement;
        // Explicit height: the row list lives inside the popup (inlined via
        // @children) and cannot be measured from here, so the clamp is
        // computed from the model — min(items, visible rows) of fixed-height
        // rows, plus the list layout's 2 × 4px padding.
        popup-height: min(root.items.length, root.max-visible-items) * root.item-height + 8px;

        ScrollView {
            rows := VerticalLayout {
                padding: 4px;

                for it[i] in root.items: Rectangle {
                    height: it.divider ? 9px : root.item-height;
                    border-radius: TTheme.radius-default;
                    background: transparent;
                    animate background { duration: TTheme.duration-fast; }

                    // Per-entry label color: danger red beats the neutral
                    // primary, disabled grays out both.
                    private property <color> label-c:
                        it.disabled ? TTheme.text-color-disabled
                        : it.danger ? TTheme.error-color
                        : TTheme.text-color-primary;

                    states [
                        hovered when row-ta.has-hover && !it.disabled && !it.divider && !it.danger: {
                            background: TTheme.bg-color-component-hover;
                        }
                        hovered-danger when row-ta.has-hover && !it.disabled && !it.divider && it.danger: {
                            background: TTheme.error-color-light;
                        }
                    ]

                    if !it.divider: HorizontalLayout {
                        padding-left: TTheme.spacing-2;
                        padding-right: TTheme.spacing-2;
                        spacing: TTheme.spacing-2;

                        if it.icon.paths.length > 0: TIcon {
                            y: (parent.height - self.height) / 2;
                            icon: it.icon;
                            size: TTheme.font-size-m;
                            icon-color: label-c;
                        }

                        Text {
                            text: it.label;
                            font-size: TTheme.font-size-m;
                            font-family: TTheme.font-family;
                            color: label-c;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    if it.divider: Rectangle {
                        y: 4px;
                        height: 1px;
                        background: TTheme.border-level-1-color;
                    }

                    row-ta := TouchArea {
                        enabled: !it.disabled && !it.divider;
                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => {
                            root.selected(i, it.value);
                            surface.close();
                        }
                    }
                }
            }
        }
    }

    accessible-role: AccessibleRole.button;
}
