// Tela UI — BackTop
//
// Round "back to top" button. Two-way bind `content-y` to a ScrollView's
// `content-y`: visibility then follows the `threshold` and clicking scrolls
// the view back to the top. Place it absolutely within the scroll area's
// container:
//   Rectangle {
//       sv := ScrollView { … }
//       BackTop { x: …; y: …; content-y <=> sv.content-y; }
//   }

import { TelaTheme } from "../theme.slint";
import { Icon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export component BackTop inherits Rectangle {
    // Two-way bind to the target ScrollView's content-y.
    in-out property <length> content-y;
    // The button appears once the view is scrolled past this offset.
    in property <length> threshold: 200px;

    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: TelaTheme.radius-round;
    background: TelaTheme.bg-color-container;
    border-width: 1px;
    border-color: TelaTheme.component-stroke;
    drop-shadow-blur: TelaTheme.shadow-2-blur;
    drop-shadow-offset-y: TelaTheme.shadow-2-offset-y;
    drop-shadow-color: TelaTheme.shadow-2-color;
    visible: root.content-y > root.threshold;

    states [
        hovered when ta.has-hover: {
            border-color: TelaTheme.brand-color;
            background: TelaTheme.bg-color-container-hover;
        }
    ]

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: TIconSet.ChevronUp;
        size: 20px;
        icon-color: ta.has-hover ? TelaTheme.brand-color : TelaTheme.text-color-secondary;
        animate icon-color { duration: TelaTheme.duration-fast; }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.content-y = 0;
            root.clicked();
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: "回到顶部";
}
