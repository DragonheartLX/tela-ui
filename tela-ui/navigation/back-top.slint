// Tela UI — TBackTop
//
// Round "back to top" button. Two-way bind `content-y` to a ScrollView's
// `content-y`: visibility then follows the `threshold` and clicking scrolls
// the view back to the top. Place it absolutely within the scroll area's
// container:
//   Rectangle {
//       sv := ScrollView { … }
//       TBackTop { x: …; y: …; content-y <=> sv.content-y; }
//   }

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export component TBackTop inherits Rectangle {
    // Two-way bind to the target ScrollView's content-y.
    in-out property <length> content-y;
    // The button appears once the view is scrolled past this offset.
    in property <length> threshold: 200px;

    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: TTheme.radius-round;
    background: TTheme.bg-color-container;
    border-width: 1px;
    border-color: TTheme.component-stroke;
    drop-shadow-blur: TTheme.shadow-2-blur;
    drop-shadow-offset-y: TTheme.shadow-2-offset-y;
    drop-shadow-color: TTheme.shadow-2-color;
    // Flickable semantics: `content-y` is 0 at the top and goes negative
    // while scrolling down, so the button shows once the view is scrolled
    // past `threshold`.
    visible: root.content-y <= -root.threshold;

    states [
        hovered when ta.has-hover: {
            border-color: TTheme.brand-color;
            background: TTheme.bg-color-container-hover;
        }
    ]

    TIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: TIconSet.ChevronUp;
        size: 20px;
        icon-color: ta.has-hover ? TTheme.brand-color : TTheme.text-color-secondary;
        animate icon-color { duration: TTheme.duration-fast; }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.content-y = 0;
            root.clicked();
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: "回到顶部";
}
