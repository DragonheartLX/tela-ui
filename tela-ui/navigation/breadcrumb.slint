// Tela UI — TBreadcrumb
//
// Navigation trail. Items whose value differs from `current-value` render
// as links and emit `changed` when clicked; the current one is plain
// primary text.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TNavLabel } from "nav-label.slint";

export struct TCrumbItem {
    label: string,
    value: string,
}

export component TBreadcrumb inherits Rectangle {
    in property <[TCrumbItem]> items;
    // The current crumb; defaults to the last item.
    in-out property <string> current-value:
        items.length > 0 ? items[items.length - 1].value : "";
    in property <string> separator: "/";
    in property <color> separator-color: TTheme.text-color-disabled;

    callback changed(string);

    height: TTheme.line-height-m;
    width: row.preferred-width;

    row := HorizontalLayout {
        x: 0;
        y: 0;
        width: self.preferred-width;
        height: parent.height;

        for it[i] in root.items: Rectangle {
            height: parent.height;
            width: crumb-row.preferred-width;

            // The current crumb is disabled: it is plain text, not a link.
            accessible-role: AccessibleRole.button;
            accessible-label: it.label;
            accessible-enabled: it.value != root.current-value;
            accessible-action-default => {
                if (it.value != root.current-value) {
                    root.changed(it.value);
                }
            }

            // Declared before the row: the label's own TouchArea stays
            // topmost so its hover recolor works, and clicks that miss the
            // label (the separator) fall through to this one.
            TouchArea {
                enabled: it.value != root.current-value;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.changed(it.value);
                }
            }

            crumb-row := HorizontalLayout {
                height: parent.height;
                spacing: TTheme.spacing-2;

                if i > 0: TText {
                    text: root.separator;
                    color: root.separator-color;
                    vertical-alignment: center;
                }

                TNavLabel {
                    width: self.label-width;
                    label: it.label;
                    base-color: TTheme.text-color-link;
                    selected-color: TTheme.text-color-primary;
                    selected: it.value == root.current-value;
                    disabled: it.value == root.current-value;
                    clicked => {
                        root.changed(it.value);
                    }
                }
            }
        }
    }
}
