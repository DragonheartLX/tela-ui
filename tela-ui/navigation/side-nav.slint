// Tela UI — TSideNav
//
// Collapsible side navigation: brand header, a vertical menu and a footer
// cluster pinned to the bottom edge (menu-style entries above the collapse
// toggle). `collapsed` folds icon+label rows down to centered icons and
// animates the width between 232px and 64px; rows keep their elements
// mounted and animate position/opacity so the fold plays smoothly instead
// of popping. The collapse toggle (TDesign's panel-fold button) lives in
// the header (`toggle-position: top`) or as the footer's last row
// (`bottom`), labeled "收起" like any menu row while expanded. `mode`:
// icon-text (collapsible, default), text, or icon (always 64px wide).

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData, TIconSet } from "../base/icon/data.slint";

export enum TSideNavMode {
    icon-text,
    text,
    icon,
}

// Where the collapse toggle lives.
export enum TSideNavTogglePosition {
    // Header row, right edge while expanded, centered once collapsed.
    top,
    // Footer row, sharing it with the footer action when one is set.
    bottom,
}

export struct TSideNavItem {
    label: string,
    value: string,
    // Optional glyph from TIconSet; items without one fall back to text.
    icon: TIconData = { paths: [] },
    disabled: bool = false,
}

// An entry pinned to the bottom of the sidebar, above the collapse toggle
// (e.g. a dark-mode switch, a settings link). A non-empty `value` makes it
// behave like a menu row — it highlights with `current-value` and fires
// `changed` — while an empty one acts as a plain button firing
// `footer-clicked`.
export struct TSideNavFooterItem {
    label: string = "",
    icon: TIconData = { paths: [] },
    value: string = "",
}

// One menu/footer row: icon slides between the expanded left slot and the
// collapsed center, the label fades with the fold, hover/active/disabled
// recolor. Selection behavior lives in the `clicked` handlers of the
// callers (menu rows select, footer rows may fire `footer-clicked`).
component TNavRow inherits Rectangle {
    in property <string> label;
    in property <TIconData> icon;
    in property <string> value;
    in property <bool> disabled: false;
    in property <bool> show-text;
    in property <bool> show-icon;
    in property <string> current-value;
    callback clicked();

    height: 40px;
    border-radius: TTheme.radius-medium;
    clip: true;
    background: transparent;
    animate background { duration: TTheme.duration-fast; }

    states [
        hovered when row-ta.has-hover && !root.disabled: {
            background: TTheme.bg-color-component-hover;
        }
        active when root.value != "" && root.value == root.current-value && !root.disabled: {
            background: TTheme.brand-color-light;
        }
    ]

    if root.show-icon && root.icon.paths.length > 0: TIcon {
        // Slides between the expanded left slot and the collapsed center;
        // stays mounted so the fold animates instead of pop.
        x: root.show-text ? TTheme.padding-lr-m
            : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: 20px;
        icon-color: TTheme.text-color-secondary;
        animate x { duration: TTheme.duration-base; easing: ease-out; }
        animate icon-color { duration: TTheme.duration-fast; }

        states [
            hovered when row-ta.has-hover && !root.disabled: {
                icon-color: TTheme.text-color-primary;
            }
            active when root.value != "" && root.value == root.current-value && !root.disabled: {
                icon-color: TTheme.brand-color;
            }
            disabled when root.disabled: {
                icon-color: TTheme.text-color-disabled;
            }
        ]
    }

    if root.label != "": Text {
        x: root.icon.paths.length > 0 && root.show-icon ? 44px : TTheme.padding-lr-m;
        y: (parent.height - self.preferred-height) / 2;
        height: self.preferred-height;
        text: root.label;
        font-size: TTheme.font-size-m;
        color: TTheme.text-color-primary;
        vertical-alignment: center;
        opacity: root.show-text ? 1 : 0;
        animate opacity { duration: TTheme.duration-base; }
        animate color { duration: TTheme.duration-fast; }

        states [
            hovered when row-ta.has-hover && !root.disabled: {
                color: TTheme.text-color-primary;
            }
            active when root.value != "" && root.value == root.current-value && !root.disabled: {
                color: TTheme.brand-color;
            }
            disabled when root.disabled: {
                color: TTheme.text-color-disabled;
            }
        ]
    }

    row-ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

export component TSideNav inherits Rectangle {
    in property <string> title;
    in property <TIconData> logo;
    in property <[TSideNavItem]> items;
    in-out property <string> current-value;
    in-out property <bool> collapsed: false;
    in property <TSideNavMode> mode: TSideNavMode.icon-text;
    in property <TSideNavTogglePosition> toggle-position: TSideNavTogglePosition.top;
    in property <bool> bordered: true;
    // Entries pinned to the sidebar's bottom edge, above the collapse
    // toggle; styled like menu rows — icon plus label while expanded,
    // centered icons once collapsed.
    in property <[TSideNavFooterItem]> footer-items;

    callback changed(string);
    // Fired by footer entries without a `value` (plain actions).
    callback footer-clicked(TSideNavFooterItem);

    private property <bool> show-text: (root.mode == TSideNavMode.icon-text && !root.collapsed) || root.mode == TSideNavMode.text;
    private property <bool> show-icon: root.mode != TSideNavMode.text;
    private property <bool> collapsible: root.mode == TSideNavMode.icon-text;
    // The header carries the brand and the top collapse toggle; a sidebar
    // with neither folds it away so the menu starts right at the top.
    private property <bool> has-header:
        root.title != "" || root.logo.paths.length > 0
        || (root.collapsible && root.toggle-position == TSideNavTogglePosition.top);
    private property <bool> footer-chevron: root.collapsible && root.toggle-position == TSideNavTogglePosition.bottom;

    width: self.show-text ? 232px : 64px;
    animate width { duration: TTheme.duration-base; easing: ease-out; }
    background: TTheme.bg-color-container;

    VerticalLayout {
        // Header ----------------------------------------------------------
        // Brand fades out when folding; the whole header folds away when
        // there is nothing to show in it.
        Rectangle {
            height: root.has-header ? 48px : 0px;
            clip: true;

            HorizontalLayout {
                x: TTheme.padding-lr-m;
                y: (parent.height - self.preferred-height) / 2;
                height: self.preferred-height;
                width: self.preferred-width;
                opacity: root.show-text ? 1 : 0;
                animate opacity { duration: TTheme.duration-base; }
                spacing: TTheme.spacing-2;

                if root.logo.paths.length > 0: TIcon {
                    y: (parent.height - self.height) / 2;
                    icon: root.logo;
                    size: 22px;
                    icon-color: TTheme.brand-color;
                }

                if root.title != "": Text {
                    text: root.title;
                    font-size: TTheme.font-size-title-m;
                    font-weight: TTheme.font-weight-semibold;
                    color: TTheme.text-color-primary;
                    vertical-alignment: center;
                }
            }

            if root.collapsible && root.toggle-position == TSideNavTogglePosition.top: Rectangle {
                width: 28px;
                height: 28px;
                // Expanded: the header's right edge. Collapsed: centered —
                // x is recomputed from the animating width every frame (no
                // tween of its own), so the button glides in naturally with
                // the fold instead of tweening across the header.
                x: !root.show-text ? (parent.width - self.width) / 2
                    : parent.width - self.width - 6px;
                y: (parent.height - self.height) / 2;
                border-radius: TTheme.radius-small;
                background: transparent;
                animate background { duration: TTheme.duration-fast; }

                states [
                    hovered when toggle-ta.has-hover: {
                        background: TTheme.bg-color-component-hover;
                    }
                ]

                TIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: TIconSet.ChevronLeft;
                    size: 16px;
                    // The 180° flip doubles as the collapsed-direction cue.
                    transform-rotation: root.show-text ? 0deg : 180deg;
                    animate transform-rotation { duration: TTheme.duration-base; easing: ease-out; }
                    icon-color: toggle-ta.has-hover ? TTheme.brand-color : TTheme.text-color-secondary;
                    animate icon-color { duration: TTheme.duration-fast; }
                }

                toggle-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.collapsed = !root.collapsed;
                    }
                }
            }
        }

        // Menu ------------------------------------------------------------
        for it in root.items: TNavRow {
            label: it.label;
            icon: it.icon;
            value: it.value;
            disabled: it.disabled;
            show-text: root.show-text;
            show-icon: root.show-icon;
            current-value: root.current-value;
            clicked => {
                if it.value != root.current-value {
                    root.current-value = it.value;
                    root.changed(it.value);
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        // Footer entries ---------------------------------------------------
        // Pinned to the bottom edge above the collapse toggle.
        for it in root.footer-items: TNavRow {
            label: it.label;
            icon: it.icon;
            value: it.value;
            show-text: root.show-text;
            show-icon: root.show-icon;
            current-value: root.current-value;
            clicked => {
                if it.value == "" {
                    root.footer-clicked(it);
                } else if it.value != root.current-value {
                    root.current-value = it.value;
                    root.changed(it.value);
                }
            }
        }

        // TCollapse toggle, bottom variant: a quiet nav row like the footer
        // entries — panel-fold glyph (arrow pointing at the divider while
        // expanded, outward once collapsed) plus a "收起" label that fades
        // with the fold, left-aligned with the menu while expanded, centered
        // after folding.
        if root.footer-chevron: TNavRow {
            label: "收起";
            icon: root.show-text ? TIconSet.PanelLeftClose : TIconSet.PanelLeftOpen;
            show-text: root.show-text;
            show-icon: root.show-icon;
            current-value: root.current-value;
            clicked => {
                root.collapsed = !root.collapsed;
            }
        }
    }

    if root.bordered: Rectangle {
        x: parent.width - self.width;
        width: 1px;
        height: 100%;
        background: TTheme.component-stroke;
    }
}
