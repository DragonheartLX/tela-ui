// Tela UI — TTabs
//
// Tab header bar with an animated underline; each tab stretches equally.
// Render page content in the host with `if current-index == i : ...`.

import { TTheme } from "../theme.slint";
import { TNavLabel } from "nav-label.slint";

export component TTabs inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current-index: 0;

    // Clamped index every visual reads; an out-of-range host value would
    // otherwise push the indicator off the bar and leave every tab
    // unselected. Writing current-index stays unclamped so the host sees
    // what it set.
    private property <int> safe-index:
        Math.max(0, Math.min(current-index, items.length - 1));

    callback changed(int);
    height: TTheme.height-l;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;

        for it[i] in root.items: Rectangle {
            height: parent.height;

            // One tab per column; the bar itself is the tab-list.
            // The current tab is disabled: activating it is a no-op.
            accessible-role: AccessibleRole.tab;
            accessible-label: it;
            accessible-enabled: i != root.safe-index;
            accessible-action-default => {
                if (root.current-index != i) {
                    root.current-index = i;
                    root.changed(i);
                }
            }

            TNavLabel {
                width: 100%;
                height: 100%;
                label: it;
                label-align: TextHorizontalAlignment.left;
                label-valign: TextVerticalAlignment.top;
                selected: i == root.safe-index;
                semibold-when-selected: true;
                clicked => {
                    if root.current-index != i {
                        root.current-index = i;
                        root.changed(i);
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        x: root.safe-index * (parent.width / max(1, root.items.length));
        width: parent.width / max(1, root.items.length);
        height: 3px;
        border-radius: TTheme.radius-small;
        background: TTheme.brand-color;
        animate x { duration: TTheme.duration-base; easing: ease-out; }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: TTheme.component-stroke;
    }

    // The bar is the container role; each column below is one tab.
    accessible-role: AccessibleRole.tab-list;
}
