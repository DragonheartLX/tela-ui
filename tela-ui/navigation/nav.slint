// Tela UI — TNavBar
//
// Top navigation bar: brand (logo + title) on the left, menu items with an
// active underline in the middle, and a trailing action slot (the default
// children) on the right.

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData } from "../base/icon/data.slint";
import { TNavLabel } from "nav-label.slint";

export struct TNavItem {
    label: string,
    value: string,
}

export component TNavBar inherits Rectangle {
    in property <string> title;
    in property <TIconData> logo;
    in property <[TNavItem]> items;
    in-out property <string> current-value;
    in property <bool> bordered: true;

    callback changed(string);

    height: 56px;
    background: TTheme.bg-color-container;

    HorizontalLayout {
        padding-left: TTheme.margin-xl;
        padding-right: TTheme.margin-xl;
        spacing: TTheme.margin-l;

        // Brand -----------------------------------------------------------
        if root.title != "" || root.logo.paths.length > 0: VerticalLayout {
            y: (parent.height - self.preferred-height) / 2;
            height: self.preferred-height;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: TTheme.spacing-2;

                if root.logo.paths.length > 0: TIcon {
                    y: (parent.height - self.height) / 2;
                    icon: root.logo;
                    size: 24px;
                    icon-color: TTheme.brand-color;
                }

                if root.title != "": Text {
                    text: root.title;
                    font-size: TTheme.font-size-title-m;
                    font-weight: TTheme.font-weight-semibold;
                    color: TTheme.text-color-primary;
                    vertical-alignment: center;
                }
            }
        }

        // Menu ------------------------------------------------------------
        for it[i] in root.items: Rectangle {
            width: nav-label.label-width + TTheme.padding-lr-m * 2;
            height: parent.height;

            nav-label := TNavLabel {
                width: 100%;
                height: 100%;
                label: it.label;
                selected: it.value == root.current-value;
                clicked => {
                    if it.value != root.current-value {
                        root.current-value = it.value;
                        root.changed(it.value);
                    }
                }
            }

            if it.value == root.current-value: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height;
                width: nav-label.label-width;
                height: 3px;
                border-radius: 2px;
                background: TTheme.brand-color;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Trailing actions (default children) ------------------------------
        VerticalLayout {
            y: (parent.height - self.preferred-height) / 2;
            height: self.preferred-height;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: TTheme.margin-s;
                @children
            }
        }
    }

    if root.bordered: Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: 1px;
        background: TTheme.component-stroke;
    }
}
