// Tela UI — TKbd
//
// Keyboard-key chip (e.g. Ctrl + C): small bordered chip with system-font
// feel. Render a single key with `text`, or a combination with `keys` —
// the chips are then joined by "+" automatically. size: TSize
// (small/medium/large).

import { TTheme } from "../theme.slint";
import { TSize } from "../structs/enums.slint";

export component TKbd inherits Rectangle {
    in property <string> text;
    in property <[string]> keys;
    in property <TSize> size: TSize.medium;

    private property <length> h:
        size == TSize.small ? 20px
        : size == TSize.large ? 28px
        : 24px;
    private property <length> fs:
        size == TSize.small ? TTheme.font-size-s
        : size == TSize.large ? TTheme.font-size-m
        : TTheme.font-size-s;
    private property <length> pad-lr:
        size == TSize.small ? 5px
        : size == TSize.large ? 9px
        : 7px;
    // A combination wins over the single `text`.
    private property <[string]> items:
        keys.length > 0 ? keys : [text];

    height: h;
    width: body.preferred-width;
    horizontal-stretch: 0;

    body := HorizontalLayout {
        spacing: TTheme.spacing-2;

        // Same spacing as `body` so the "+" sits centered between chips —
        // the outer spacing only applies between iterations.
        for k[i] in root.items: HorizontalLayout {
            spacing: TTheme.spacing-2;
            if k != "": Rectangle {
                height: root.h;
                width: cap-label.preferred-width + root.pad-lr * 2;
                background: TTheme.bg-color-secondarycontainer;
                border-width: 1px;
                border-color: TTheme.component-border;
                border-radius: TTheme.radius-small;

                cap-label := Text {
                    x: root.pad-lr;
                    width: parent.width - root.pad-lr * 2;
                    height: parent.height;
                    text: k;
                    font-size: root.fs;
                    font-family: TTheme.font-family;
                    color: TTheme.text-color-secondary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // Full-height box so `vertical-alignment` actually centers the
            // glyph against the chips — a bare Text stays at its preferred
            // height and rides the top of the row.
            if k != "" && i < root.items.length - 1: Text {
                height: root.h;
                text: "+";
                font-size: root.fs;
                font-family: TTheme.font-family;
                color: TTheme.text-color-secondary;
                vertical-alignment: center;
            }
        }
    }
}
