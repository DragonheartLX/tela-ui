// Tela UI — icon data
//
// Pure icon geometry, following the data layout of the lucide-slint project
// (https://github.com/cnlancehu/lucide-slint, MIT OR Apache-2.0): every icon
// is a set of SVG path commands on a 24×24 grid, rendered by the shared
// `TIcon` component (see icon.slint) with round caps and joins and a stroke
// width that scales with `size`.
//
// TIcon geometry © Lucide contributors (ISC license), https://lucide.dev
//
// This file holds DATA ONLY — extend TIconSet (or assign `TIcon.icon`)
// to add custom glyphs without touching the renderer.
//
// TIconSet properties (PascalCase): X, Check, Minus, Plus, Search,
// ChevronDown/Up/Left/Right, Menu, Info, CircleCheck, CircleX, CircleAlert,
// TriangleAlert, Eye, Calendar, User, LoaderCircle, Sun, Moon, Bell, House,
// Lock, Mail, Star, StarFill, Heart, Trash2, Pencil, Settings, Download,
// Upload, RefreshCw, Image, Ellipsis, Inbox, LayoutDashboard,
// PanelLeftClose/PanelLeftOpen, FlaskConical.

export struct TIconPath {
    command: string,
    has_fill: bool,
}

// A complete icon: all of its sub-paths.
