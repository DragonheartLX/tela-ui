// Tela UI — TButton
//
// TDesign button: theme × variant × size, optional icon, loading and
// disabled states, square (icon button) / round shapes, block width.
//
//   theme   : TTheme (default/primary/success/warning/error)
//   variant : TButtonVariant (base solid / outline / text)
//   size    : TSize (small / medium / large)
//   shape   : TButtonShape (rectangle / square icon button / round)

import { TTheme } from "../theme.slint";
import { TIcon } from "icon/icon.slint";
import { TLoadingSpinner } from "loading.slint";
import { TIconData } from "icon/data.slint";
import { TThemeRole,  TSize } from "../structs/enums.slint";
export enum TButtonVariant {
    base,
    outline,
    text,
}

export enum TButtonShape {
    rectangle,
    square,
    round,
}

export component TButton inherits Rectangle {
    in property <TThemeRole> theme: TThemeRole.default;
    in property <TButtonVariant> variant: TButtonVariant.base;
    in property <TSize> size: TSize.medium;
    in property <TButtonShape> shape: TButtonShape.rectangle;
    in property <bool> block: false;
    in property <string> text;
    in property <TIconData> icon;
    in property <bool> loading;
    in property <bool> disabled;

    callback clicked();

    // TSize metrics (one dispatch, shared with TSelect / TLink).
    private property <length> h: TTheme.size-height(size);
    private property <length> fs: TTheme.size-font(size);
    private property <length> pad-lr: TTheme.size-padding(size);

    // Per-role colors for the current theme: the default theme renders
    // neutral grays, any other theme uses its color ramp. Keeping each
    // dispatch here lets the rest binding and `states` below stay flat.
    private property <color> fill: theme == TThemeRole.default ? TTheme.bg-color-component : TTheme.theme-color(theme);
    private property <color> fill-hover: theme == TThemeRole.default ? TTheme.bg-color-component-hover : TTheme.theme-color-hover(theme);
    private property <color> fill-active: theme == TThemeRole.default ? TTheme.bg-color-component-active : TTheme.theme-color-active(theme);
    private property <color> fill-disabled: theme == TThemeRole.default ? TTheme.bg-color-component-disabled : TTheme.theme-color-disabled(theme);
    private property <color> on-fill: theme == TThemeRole.default ? TTheme.text-color-primary : TTheme.text-color-anti;
    private property <color> on-fill-disabled: theme == TThemeRole.default ? TTheme.text-color-disabled : TTheme.text-color-anti;

    // Subtle tinted fills for the outline / text variants.
    private property <color> tint-hover: theme == TThemeRole.default ? transparent : TTheme.theme-color-light-hover(theme);
    private property <color> tint-pressed: theme == TThemeRole.default ? transparent : TTheme.theme-color-light(theme);
    private property <color> text-fill-hover: theme == TThemeRole.default ? TTheme.bg-color-component : TTheme.theme-color-light-hover(theme);

    // Label and border colors for the outline / text variants.
    private property <color> text-rest: theme == TThemeRole.default ? TTheme.text-color-primary : TTheme.theme-color(theme);
    private property <color> text-hover: theme == TThemeRole.default ? TTheme.brand-color : TTheme.theme-color-hover(theme);
    private property <color> text-pressed: theme == TThemeRole.default ? TTheme.brand-color-active : TTheme.theme-color-active(theme);
    private property <color> text-disabled: theme == TThemeRole.default ? TTheme.text-color-disabled : TTheme.theme-color-disabled(theme);
    private property <color> border-rest: theme == TThemeRole.default ? TTheme.component-border : TTheme.theme-color(theme);
    private property <color> border-hover: theme == TThemeRole.default ? TTheme.brand-color : TTheme.theme-color-hover(theme);
    private property <color> border-pressed: theme == TThemeRole.default ? TTheme.brand-color-active : TTheme.theme-color-active(theme);
    private property <color> border-disabled: theme == TThemeRole.default ? TTheme.border-level-2-color : TTheme.theme-color-disabled(theme);

    // Rest state; overridden by the `states` below.
    private property <brush> bg: variant == TButtonVariant.base ? root.fill : transparent;
    private property <brush> content-color: variant == TButtonVariant.base ? root.on-fill : root.text-rest;
    private property <brush> border-brush: variant == TButtonVariant.outline ? root.border-rest : transparent;

    background: bg;
    border-width: variant == TButtonVariant.outline ? 1px : 0;
    border-color: border-brush;
    border-radius: shape == TButtonShape.round ? TTheme.radius-round : TTheme.radius-default;
    height: h;
    width: shape == TButtonShape.square ? h : max(h, content.preferred-width + pad-lr * 2);
    // Block buttons absorb the extra space of the surrounding layout.
    horizontal-stretch: block ? 1 : 0;
    animate bg { duration: TTheme.duration-fast; }
    animate content-color { duration: TTheme.duration-fast; }
    animate border-brush { duration: TTheme.duration-fast; }

    // Later states win over earlier ones.
    states [
        hovered when touch.has-hover: {
            bg: variant == TButtonVariant.base ? root.fill-hover
                : variant == TButtonVariant.outline ? root.tint-hover
                : root.text-fill-hover;
            content-color: variant == TButtonVariant.base ? root.on-fill : root.text-hover;
            border-brush: variant == TButtonVariant.outline ? root.border-hover : transparent;
        }

        pressed when touch.pressed: {
            bg: variant == TButtonVariant.base ? root.fill-active
                : variant == TButtonVariant.outline ? transparent
                : root.tint-pressed;
            content-color: variant == TButtonVariant.base ? root.on-fill : root.text-pressed;
            border-brush: variant == TButtonVariant.outline ? root.border-pressed : transparent;
        }

        disabled when root.disabled: {
            bg: variant == TButtonVariant.base ? root.fill-disabled : transparent;
            content-color: variant == TButtonVariant.base ? root.on-fill-disabled : root.text-disabled;
            border-brush: variant == TButtonVariant.outline ? root.border-disabled : transparent;
        }
    ]

    touch := TouchArea {
        enabled: !root.disabled && !root.loading;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: TTheme.spacing-2;

        if root.loading: TLoadingSpinner {
            y: (parent.height - self.height) / 2;
            size: root.fs + 2px;
            spinner-color: root.content-color;
        }

        if !root.loading && root.icon.paths.length > 0: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: root.fs + 2px;
            icon-color: root.content-color;
        }

        if root.text != "": Text {
            text: root.text;
            font-size: root.fs;
            font-weight: TTheme.font-weight-regular;
            color: root.content-color;
            vertical-alignment: center;
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
}
