// Tela UI — Button
//
// TDesign button: theme × variant × size, optional icon, loading and
// disabled states, square (icon button) / round shapes, block width.
//
//   theme   : Theme (default/primary/success/warning/error)
//   variant : ButtonVariant (base solid / outline / text)
//   size    : Size (small / medium / large)
//   shape   : ButtonShape (rectangle / square icon button / round)

import { TelaTheme } from "../theme.slint";
import { Icon } from "icon/icon.slint";
import { LoadingSpinner } from "loading.slint";
import { TIconData } from "icon/data.slint";
import { Theme, Size } from "../structs/enums.slint";
export enum ButtonVariant {
    base,
    outline,
    text,
}

export enum ButtonShape {
    rectangle,
    square,
    round,
}
import { TIconData } from "icon/data.slint";

export component Button inherits Rectangle {
    in property <Theme> theme: Theme.default;
    in property <ButtonVariant> variant: ButtonVariant.base;
    in property <Size> size: Size.medium;
    in property <ButtonShape> shape: ButtonShape.rectangle;
    in property <bool> block: false;
    in property <string> text;
    in property <TIconData> icon;
    in property <bool> loading;
    in property <bool> disabled;

    callback clicked();

    private property <length> h:
        size == Size.small ? TelaTheme.height-s : size == Size.large ? TelaTheme.height-l : TelaTheme.height-m;
    private property <length> fs:
        size == Size.small ? TelaTheme.font-size-s : size == Size.large ? TelaTheme.font-size-l : TelaTheme.font-size-m;
    private property <length> pad-lr:
        size == Size.small ? TelaTheme.padding-lr-s : size == Size.large ? TelaTheme.padding-lr-l : TelaTheme.padding-lr-m;

    // Rest state; overridden by the `states` below.
    private property <brush> bg:
        variant == ButtonVariant.base ? (theme == Theme.default ? TelaTheme.bg-color-component : TelaTheme.theme-color(theme))
        : transparent;
    private property <brush> content-color:
        variant == ButtonVariant.base ? (theme == Theme.default ? TelaTheme.text-color-primary : TelaTheme.text-color-anti)
        : theme == Theme.default ? TelaTheme.text-color-primary
        : TelaTheme.theme-color(theme);
    private property <brush> border-brush:
        variant == ButtonVariant.outline ? (theme == Theme.default ? TelaTheme.component-border : TelaTheme.theme-color(theme))
        : transparent;

    background: bg;
    border-width: variant == ButtonVariant.outline ? 1px : 0;
    border-color: border-brush;
    border-radius: shape == ButtonShape.round ? TelaTheme.radius-round : TelaTheme.radius-default;
    height: h;
    width: shape == ButtonShape.square ? h : max(h, content.preferred-width + pad-lr * 2);
    // Block buttons absorb the extra space of the surrounding layout.
    horizontal-stretch: block ? 1 : 0;
    animate bg { duration: TelaTheme.duration-fast; }
    animate content-color { duration: TelaTheme.duration-fast; }
    animate border-brush { duration: TelaTheme.duration-fast; }

    // Later states win over earlier ones.
    states [
        hovered when touch.has-hover: {
            bg: variant == ButtonVariant.base ? (theme == Theme.default ? TelaTheme.bg-color-component-hover : TelaTheme.theme-color-hover(theme))
                : variant == ButtonVariant.outline ? (theme == Theme.default ? transparent : TelaTheme.theme-color-light-hover(theme))
                : (theme == Theme.default ? TelaTheme.bg-color-component : TelaTheme.theme-color-light-hover(theme));
            content-color: variant == ButtonVariant.base ? (theme == Theme.default ? TelaTheme.text-color-primary : TelaTheme.text-color-anti)
                : theme == Theme.default ? TelaTheme.brand-color
                : TelaTheme.theme-color-hover(theme);
            border-brush: variant == ButtonVariant.outline ? (theme == Theme.default ? TelaTheme.brand-color : TelaTheme.theme-color-hover(theme))
                : transparent;
        }

        pressed when touch.pressed: {
            bg: variant == ButtonVariant.base ? (theme == Theme.default ? TelaTheme.bg-color-component-active : TelaTheme.theme-color-active(theme))
                : variant == ButtonVariant.outline ? transparent
                : (theme == Theme.default ? TelaTheme.bg-color-component : TelaTheme.theme-color-light(theme));
            content-color: variant == ButtonVariant.base ? (theme == Theme.default ? TelaTheme.text-color-primary : TelaTheme.text-color-anti)
                : theme == Theme.default ? TelaTheme.brand-color-active
                : TelaTheme.theme-color-active(theme);
            border-brush: variant == ButtonVariant.outline ? (theme == Theme.default ? TelaTheme.brand-color-active : TelaTheme.theme-color-active(theme))
                : transparent;
        }

        disabled when root.disabled: {
            bg: variant == ButtonVariant.base ? (theme == Theme.default ? TelaTheme.bg-color-component-disabled : TelaTheme.theme-color-disabled(theme))
                : transparent;
            content-color: variant == ButtonVariant.base && theme != Theme.default ? TelaTheme.text-color-anti
                : theme != Theme.default ? TelaTheme.theme-color-disabled(theme)
                : TelaTheme.text-color-disabled;
            border-brush: variant == ButtonVariant.outline ? (theme == Theme.default ? TelaTheme.border-level-2-color : TelaTheme.theme-color-disabled(theme))
                : transparent;
        }
    ]

    touch := TouchArea {
        enabled: !root.disabled && !root.loading;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: TelaTheme.spacing-2;

        if root.loading: LoadingSpinner {
            y: (parent.height - self.height) / 2;
            size: root.fs + 2px;
            spinner-color: root.content-color;
        }

        if !root.loading && root.icon.paths.length > 0: Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: root.fs + 2px;
            icon-color: root.content-color;
        }

        if root.text != "": Text {
            text: root.text;
            font-size: root.fs;
            font-weight: TelaTheme.font-weight-regular;
            color: root.content-color;
            vertical-alignment: center;
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
}
