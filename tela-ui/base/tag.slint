// Tela UI — Tag
//
// Small status descriptor. theme: Theme (default/primary/success/warning/
// error); variant: TagVariant (dark filled / light / outline); size: Size.
// Closable tags emit `closed`; tags emit `clicked` when `clickable`
// styling is desired.

import { TelaTheme } from "../theme.slint";
import { Icon } from "icon/icon.slint";
import { TIconSet, TIconData } from "icon/data.slint";
import { Theme, Size } from "../structs/enums.slint";
export enum TagVariant {
    dark,
    light,
    outline,
}
import { TIconSet, TIconData } from "icon/data.slint";

export component Tag inherits Rectangle {
    in property <Theme> theme: Theme.default;
    in property <TagVariant> variant: TagVariant.dark;
    in property <Size> size: Size.medium;
    in property <string> text;
    in property <TIconData> icon;
    in property <bool> closable;
    in property <bool> disabled;
    in property <bool> clickable: false;

    callback closed();
    callback clicked();

    private property <length> h: size == Size.small ? 20px : size == Size.large ? 28px : 24px;
    private property <length> fs: TelaTheme.font-size-s;
    private property <length> pad-lr: size == Size.small ? 6px : size == Size.large ? 12px : 8px;

    // Rest state; overridden by the `states` below.
    private property <brush> bg:
        variant == TagVariant.dark ? (theme == Theme.default ? TelaTheme.bg-color-component : TelaTheme.theme-color(theme))
        : variant == TagVariant.light ? (theme == Theme.default ? TelaTheme.bg-color-secondarycontainer : TelaTheme.theme-color-light(theme))
        : transparent;
    private property <brush> content-color:
        variant == TagVariant.dark ? (theme == Theme.default ? TelaTheme.text-color-primary : TelaTheme.text-color-anti)
        : variant == TagVariant.light ? (theme == Theme.default ? TelaTheme.text-color-primary : TelaTheme.theme-color(theme))
        : (theme == Theme.default ? TelaTheme.text-color-secondary : TelaTheme.theme-color(theme));
    private property <brush> border-brush:
        variant == TagVariant.outline ? (theme == Theme.default ? TelaTheme.component-border : TelaTheme.theme-color(theme))
        : transparent;

    background: bg;
    border-width: variant == TagVariant.outline ? 1px : 0;
    border-color: border-brush;
    border-radius: TelaTheme.radius-default;
    height: h;
    width: max(h, content.preferred-width + pad-lr * 2 + (closable ? 16px : 0));
    animate bg { duration: TelaTheme.duration-fast; }
    animate content-color { duration: TelaTheme.duration-fast; }
    animate border-brush { duration: TelaTheme.duration-fast; }

    // Later states win over earlier ones.
    states [
        hovered when touch.has-hover && root.clickable && !root.disabled: {
            bg: variant == TagVariant.dark ? (theme == Theme.default ? TelaTheme.bg-color-component-hover : TelaTheme.theme-color-hover(theme))
                : variant == TagVariant.light ? (theme == Theme.default ? TelaTheme.bg-color-secondarycontainer-hover : TelaTheme.theme-color-light-hover(theme))
                : transparent;
        }
        disabled when root.disabled: {
            bg: variant == TagVariant.dark ? TelaTheme.bg-color-component-disabled : transparent;
            content-color: TelaTheme.text-color-disabled;
            border-brush: variant == TagVariant.outline ? TelaTheme.border-level-1-color : transparent;
        }
    ]

    touch := TouchArea {
        enabled: root.clickable && !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: TelaTheme.spacing-1;

        if root.icon.paths.length > 0: Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: 12px;
            icon-color: root.content-color;
        }

        if root.text != "": Text {
            text: root.text;
            font-size: root.fs;
            color: root.content-color;
            vertical-alignment: center;
        }

        if root.closable: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;

            Icon {
                x: 2px;
                y: 2px;
                icon: TIconSet.X;
                size: 12px;
                icon-color: close-ta.has-hover ? root.content-color : TelaTheme.text-color-secondary;
                animate icon-color { duration: TelaTheme.duration-fast; }
            }
            close-ta := TouchArea {
                enabled: !root.disabled;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.closed();
                    root.visible = false;
                }
            }
        }
    }

    accessible-role: AccessibleRole.text;
    accessible-label: text;
}
