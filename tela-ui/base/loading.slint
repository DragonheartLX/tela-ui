// Tela UI — TLoading
//
// Spinning arc loader (indeterminate). Used by TButton and as a standalone
// indicator. Sizes: 16px default; use 24px/32px for standalone spinners.

import { TTheme } from "../theme.slint";
import { TThemeRole } from "../structs/enums.slint";

export component TLoadingSpinner inherits Rectangle {
    in property <brush> spinner-color: TTheme.brand-color;
    in-out property <length> size: 16px;
    // Stroke width in 24-grid units, scaled to `size` unless absolute.
    in-out property <float> stroke-width: 2.0;
    in property <bool> absolute-stroke-width: false;

    out property <length> computed-stroke-width:
        absolute-stroke-width ? stroke-width * 1px : size / 24 * stroke-width;

    width: size;
    height: size;

    Path {
        private property <float> start: 1 * mod(animation-tick(), 3s) / 3s;
        // One grow-and-shrink pulse per revolution: `abs(sin())` over half a
        // turn (180deg) of the argument repeats every 3s, matching the
        // rotation above, and dips to 0 between pulses (a round-cap dot for
        // a frame). The 0.9999 cap closes the ring — exactly 1.0 would make
        // start and end of the single ArcTo coincide and draw nothing; the
        // round caps hide the remaining 0.036° gap.
        private property <float> sweep:
            min(0.9999, 1 * abs(sin(180deg * animation-tick() / 3s)));

        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;

        stroke: root.spinner-color;
        stroke-width: root.computed-stroke-width;
        stroke-line-cap: round;

        MoveTo {
            x: parent.viewbox-width / 2 - (parent.viewbox-width / 2 - 2) * sin(-(parent.start - 0.001) * 360deg);
            y: parent.viewbox-height / 2 - (parent.viewbox-height / 2 - 2) * cos(-(parent.start - 0.001) * 360deg);
        }

        LineTo {
            x: parent.viewbox-width / 2 - (parent.viewbox-width / 2 - 2) * sin(-parent.start * 360deg);
            y: parent.viewbox-height / 2 - (parent.viewbox-height / 2 - 2) * cos(-parent.start * 360deg);
        }

        ArcTo {
            radius-x: parent.viewbox-width / 2 - 2;
            radius-y: parent.viewbox-height / 2 - 2;
            x: parent.viewbox-width / 2 - (parent.viewbox-width / 2 - 2) * sin(-(parent.start + parent.sweep) * 360deg);
            y: parent.viewbox-height / 2 - (parent.viewbox-height / 2 - 2) * cos(-(parent.start + parent.sweep) * 360deg);
            sweep: parent.sweep > 0;
            large-arc: parent.sweep > 0.5;
        }
    }
}

// TLoading indicator with an optional label beside the spinner. The root is
// a HorizontalLayout (like TRadioGroup) so its preferred size — spinner plus
// label — propagates to surrounding layouts correctly; a Rectangle root's
// inner row reported a zero preferred width and siblings overlapped. The
// spinner sits in a height-free Rectangle (stretching with the row) and is
// centered inside it, so ring and label keep one center line even when a
// taller row stretches the layout.
export component TLoading inherits HorizontalLayout {
    in property <string> text;
    in property <TThemeRole> theme: TThemeRole.primary;
    in-out property <length> size: 24px;

    spacing: TTheme.spacing-2;

    Rectangle {
        // Hugs the circle on the main axis so the label gap is exactly
        // `spacing`; stretches on the cross axis to center the ring.
        width: root.size;

        TLoadingSpinner {
            y: (parent.height - self.height) / 2;
            spinner-color: TTheme.theme-color(root.theme);
            size: root.size;
        }
    }

    if root.text != "": Text {
        text: root.text;
        font-size: TTheme.font-size-m;
        color: TTheme.text-color-secondary;
        vertical-alignment: center;
    }
}
