// Tela UI — Typography
//
// TDesign type scale as ready-made text components.
//   THeading   : page/section headings, level 1 (36px) .. 5 (18px), semibold
//   TParagraph : body copy (14px), optional `secondary` gray
//   TCaption   : auxiliary notes (12px, secondary)

import { TTheme } from "../theme.slint";

export component THeading inherits Text {
    // 1 = 36px, 2 = 28px, 3 = 24px, 4 = 20px, 5 = 18px
    in property <int> level: 3;

    text: "THeading";
    font-size:
        level == 1 ? TTheme.font-size-headline-l
        : level == 2 ? TTheme.font-size-headline-m
        : level == 3 ? TTheme.font-size-headline-s
        : level == 4 ? TTheme.font-size-title-xl
        : TTheme.font-size-title-l;
    font-weight: TTheme.font-weight-semibold;
    color: TTheme.text-color-primary;
    vertical-alignment: center;
}

export component TParagraph inherits Text {
    in property <bool> secondary: false;

    text: "";
    wrap: word-wrap;
    font-size: TTheme.font-size-m;
    color: secondary ? TTheme.text-color-secondary : TTheme.text-color-primary;
}

export component TCaption inherits Text {
    text: "";
    wrap: word-wrap;
    font-size: TTheme.font-size-s;
    color: TTheme.text-color-secondary;
}
