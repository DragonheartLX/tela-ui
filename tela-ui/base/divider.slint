// Tela UI — TDivider
//
// Horizontal separator with optional label (TDividerAlign) or a vertical
// rule (orientation: Orientation.vertical).

import { TTheme } from "../theme.slint";

export enum TDividerAlign {
    left,
    center,
    right,
}

export component TDivider inherits Rectangle {
    in property <Orientation> orientation: Orientation.horizontal;
    in property <string> text;
    in property <TDividerAlign> align: TDividerAlign.center;
    in property <color> line-color: TTheme.border-level-1-color;
    in property <color> text-color: TTheme.text-color-secondary;
    in property <length> content-gap: TTheme.margin-l;
    // Distance from the container edges (horizontal mode only).
    in property <length> inset: 0px;

    height: text != "" || orientation == Orientation.vertical
        ? TTheme.line-height-m : 1px;
    // Vertical rule: clamp the filled width to 1px (avoids state-set sizes).
    max-width: orientation == Orientation.vertical ? 1px : 999999px;

    if orientation == Orientation.horizontal && text == "": Rectangle {
        x: root.inset;
        y: (parent.height - self.height) / 2;
        width: parent.width - root.inset * 2;
        height: 1px;
        background: root.line-color;
    }

    if orientation == Orientation.horizontal && text != "": HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: root.content-gap;
        padding-left: root.inset;
        padding-right: root.inset;

        if root.align != TDividerAlign.left: Rectangle {
            background: root.line-color;
            height: 1px;
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 1;
        }

        Text {
            text: root.text;
            font-size: TTheme.font-size-m;
            color: root.text-color;
            vertical-alignment: center;
        }

        if root.align != TDividerAlign.right: Rectangle {
            background: root.line-color;
            height: 1px;
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 1;
        }
    }

    if orientation == Orientation.vertical: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0;
        width: 1px;
        height: parent.height;
        background: root.line-color;
    }
}
