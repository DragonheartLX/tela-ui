// Tela UI — TBorderlessWindow
//
// Frameless application window (`no-frame`) with a themed custom title bar.
// The title bar holds a drag handle plus minimize, maximize and close buttons.
//
// Dragging is handled by the built-in `WindowMoveArea` under the title-bar buttons.
// No host wiring is needed.
// `title` (the Window built-in) shows in both the taskbar and the custom header.
// Minimize, maximize and close work purely from .slint.
// They use the `minimized` / `maximized` built-ins and `hide()`.
//
// Edge-resizing: the winit backend reads the Window's `resize-border-width` on
// cursor moves and starts a native drag-resize near the edges.
// That property defaults to 0, which means disabled.
// TBorderlessWindow binds it from `resize-border`, collapsing to 0 while maximized.
//
// Rounded corners: the Window surface itself stays transparent.
// All content is clipped to a rounded rectangle.
// Consumers must set `window-background`, NOT the Window's own `background`.
// Setting the Window's own `background` would paint the corners opaque again.
// `window-radius` collapses to 0 while maximized.

import { TTheme } from "../theme.slint";
import { TText } from "typography.slint";
import { TIcon } from "icon/icon.slint";
import { TIconData, TIconSet } from "icon/data.slint";

// One title-bar control.
// It has a full-height hit target and a hover highlight.
// Danger mode is the close-style red hover with a white glyph.
// TCaption glyphs are normalized to Windows' 10px optical box.
// Lucide Minus draws 14/24 and X 12/24 of the icon size.
// Call sites pass per-glyph sizes with an absolute ~1.1px stroke.
// That matches the maximize square's 1px border.
component TWindowButton inherits Rectangle {
    in property <TIconData> icon;
    in property <length> icon-size: 14px;
    in property <float> icon-stroke: 2.0;
    in property <bool> icon-absolute-stroke: false;
    in property <bool> danger: false;
    // Assistive-tech label; the glyphs carry no meaning to a screen reader.
    in property <string> name: "";
    callback clicked();

    // No height binding.
    // The title-bar layout stretches it, and component roots cannot
    // reference `parent` anyway.
    width: 46px;

    states [
        hovered when ta.has-hover && root.danger: {
            background: TTheme.error-color;
        }
        hovered when ta.has-hover: {
            background: TTheme.bg-color-component-hover;
        }
    ]

    TIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.icon-size;
        stroke-width: root.icon-stroke;
        absolute-stroke-width: root.icon-absolute-stroke;
        icon-color: ta.has-hover && root.danger ? TTheme.text-color-anti : TTheme.text-color-secondary;
        animate icon-color { duration: TTheme.duration-fast; }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component TBorderlessWindow inherits Window {
    no-frame: true;
    // Must stay transparent.
    // The rounded rectangle below is the window's visible surface.
    // See the header comment.
    background: transparent;

    // Visible surface color of the rounded window rectangle.
    in property <brush> window-background: TTheme.bg-color-page;
    // Window corner radius. 0 while maximized.
    in property <length> window-radius: 8px;
    // Edge hit zone for frameless resizing, in logical px.
    // The winit backend reads the Window's `resize-border-width`.
    // It defaults to 0, which means resizing is disabled.
    // It starts a native drag-resize when the cursor nears an edge.
    // 0 while maximized: a maximized window must not resize.
    in property <length> resize-border: 8px;
    resize-border-width: root.maximized ? 0px : root.resize-border;

    in property <length> header-height: 40px;
    in property <brush> header-background: TTheme.bg-color-container;
    // Optional brand glyph shown before the header title.
    in property <TIconData> logo;
    // Hides the maximize/restore button (utility dialogs etc.).
    in property <bool> maximizable: true;
    // Apps that render their own brand row below the bar can hide the
    // header text (the `title` still labels the taskbar).
    in property <bool> header-title-visible: true;

    // The window's visible surface.
    // Everything is clipped to the rounded corners.
    // The hairline border replaces the native frame edge that frameless
    // windows lose.
    Rectangle {
        border-radius: root.maximized ? 0 : root.window-radius;
        clip: true;
        background: root.window-background;
        border-width: 1px;
        border-color: TTheme.component-stroke;

        VerticalLayout {
            // Title bar -------------------------------------------------------
            Rectangle {
                height: root.header-height;
                background: root.header-background;

                // Drag handle covers the whole bar.
                // It is declared first so the buttons (later siblings) stay
                // on top of it. WindowMoveArea is a bare hit area with no
                // background. The header Rectangle behind it provides the surface.
                WindowMoveArea { }

                HorizontalLayout {
                    padding-left: TTheme.padding-lr-m;
                    spacing: TTheme.spacing-2;

                    if root.logo.paths.length > 0: TIcon {
                        y: (parent.height - self.height) / 2;
                        icon: root.logo;
                        size: 20px;
                        icon-color: TTheme.brand-color;
                    }

                    TText {
                        text: root.title;
                        color: TTheme.text-color-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        visible: root.header-title-visible;
                    }

                    TWindowButton {
                        icon: TIconSet.Minus;
                        name: "最小化";
                        // 10px optical line + round caps (lucide Minus is 14/24 wide).
                        // Stroke 1.3: the centered line straddles a pixel row at
                        // 1x scale, so it needs extra ink to match the square/X.

                        icon-size: 17px;
                        icon-stroke: 1.3;
                        icon-absolute-stroke: true;
                        clicked => { root.minimized = true; }
                    }

                    if root.maximizable: Rectangle {
                        width: 46px;
                        height: parent.height;

                        accessible-role: AccessibleRole.button;
                        // Labels the toggle target, not the current state.
                        accessible-label: root.maximized ? "向下还原" : "最大化";
                        accessible-action-default => {
                            root.maximized = !root.maximized;
                        }

                        states [
                            hovered when max-ta.has-hover: {
                                background: TTheme.bg-color-component-hover;
                            }
                        ]

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-width: 1px;
                            border-color: max-ta.has-hover
                                ? TTheme.text-color-primary
                                : TTheme.text-color-secondary;
                            animate border-color { duration: TTheme.duration-fast; }
                        }

                        max-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.maximized = !root.maximized; }
                        }
                    }

                    TWindowButton {
                        icon: TIconSet.X;
                        name: "关闭";
                        // 10px optical X (lucide X is 12/24 wide).
                        icon-size: 20px;
                        icon-stroke: 1.1;
                        icon-absolute-stroke: true;
                        danger: true;
                        clicked => { root.hide(); }
                    }
                }
            }

            // Content: a stretched Rectangle absorbs the leftover height.
            // A bare @children inside the layout would only get its preferred
            // size, since nested layouts don't take part in the distribution.

            Rectangle {
                vertical-stretch: 1;

                @children
            }
        }
    }
}
