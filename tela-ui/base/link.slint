// Tela UI — TLink
//
// Hyperlink text: theme-colored, underlines on hover (or always with
// `underline`). theme: TTheme (default/primary/success/warning/error).

import { TTheme } from "../theme.slint";
import { TIcon } from "icon/icon.slint";
import { TIconData } from "icon/data.slint";
import { TThemeRole,  TSize } from "../structs/enums.slint";

export component TLink inherits Rectangle {
    in property <TThemeRole> theme: TThemeRole.default;
    in property <string> text;
    in property <TIconData> icon;
    in property <bool> disabled;
    in property <bool> underline: false;
    in property <TSize> size: TSize.medium;

    callback clicked();

    private property <length> fs: TTheme.size-font(size);

    // Per-state colors for the current theme (default uses the link/brand
    // tokens, other themes their color ramp) so the `states` stay flat.
    private property <color> content-rest: theme == TThemeRole.default ? TTheme.text-color-link : TTheme.theme-color(theme);
    private property <color> content-hover: theme == TThemeRole.default ? TTheme.brand-color-hover : TTheme.theme-color-hover(theme);
    private property <color> content-pressed: theme == TThemeRole.default ? TTheme.brand-color-active : TTheme.theme-color-active(theme);

    // Rest state; overridden by the `states` below.
    private property <brush> content-color: root.content-rest;

    animate content-color { duration: TTheme.duration-fast; }

    // Later states win over earlier ones.
    states [
        hovered when touch.has-hover && !root.disabled: {
            content-color: root.content-hover;
        }
        pressed when touch.pressed && !root.disabled: {
            content-color: root.content-pressed;
        }
        disabled when root.disabled: {
            content-color: TTheme.text-color-disabled;
        }
    ]

    height: content.preferred-height;
    width: max(content.preferred-width, underline-line.width);

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        x: 0;
        y: 0;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: TTheme.spacing-2;

        if root.icon.paths.length > 0: TIcon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: root.fs + 2px;
            icon-color: root.content-color;
        }

        Text {
            text: root.text;
            font-size: root.fs;
            color: root.content-color;
            vertical-alignment: center;
        }
    }

    underline-line := Rectangle {
        y: parent.height - 1px;
        x: 0;
        width: content.preferred-width;
        height: 1px;
        background: root.content-color;
        visible: !root.disabled;
        opacity: root.underline || (touch.has-hover && !touch.pressed) ? 1 : 0;
        animate opacity { duration: TTheme.duration-fast; }
    }

    accessible-role: AccessibleRole.text;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
}
