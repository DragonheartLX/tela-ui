// Tela UI — TSticky
//
// Sticky layout box (CSS position:sticky semantics): the content pins to
// the scroll viewport's top rail once its natural position scrolls past
// `offset-top`, and hands the pin back when the scope ends at
// `bounds-bottom`. It is an overlay sibling of the scroll container
// (TBackTop-style placement) — the scrolled document must reserve the
// box's space itself:
//   Rectangle {
//       height: 260px;
//       clip: true;
//       sv := TScrollBar { ... }               // reserves the header's row
//       TSticky {
//           width: sv.width; height: 40px;     // chrome comes from children
//           natural-y: 0px;                    // document-space top edge
//           bounds-bottom: 180px;              // document-space scope bottom
//           content-y <=> sv.content-y;
//           TText { ... }
//       }
//   }
// Flickable semantics: content-y is 0 at the top and negative below.

export component TSticky inherits Rectangle {
    // Two-way bind to the target scroller's content-y.
    in-out property <length> content-y;
    // Unpinned top edge in document space (its on-screen position is
    // natural-y + content-y).
    in property <length> natural-y: 0px;
    // Pin distance from the viewport top.
    in property <length> offset-top: 0px;
    // Document-space bottom of the sticking scope; past it the box rides
    // the scope's bottom edge instead of the top rail. The default is
    // effectively unbounded (pure top pinning).
    in property <length> bounds-bottom: 1000000000px;
    // Off releases the box back to its natural position.
    in property <bool> enabled: true;

    // True while pinned to the top rail.
    out property <bool> pinned: root.is-pinned;
    // Pin state actually changed.
    callback changed(bool);

    private property <length> y-follow: root.natural-y + root.content-y;
    private property <length> y-bound: root.bounds-bottom + root.content-y - root.height;
    private property <bool> is-pinned:
        root.enabled && root.y-follow <= root.offset-top && root.y-bound >= root.offset-top;

    x: 0;
    y: !root.enabled ? root.y-follow
        : Math.min(Math.max(root.offset-top, root.y-follow), root.y-bound);

    changed is-pinned => { root.changed(root.is-pinned); }

    @children
}
