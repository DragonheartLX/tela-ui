// Tela UI — TSortable
//
// Drag-to-reorder list. Press a row and drag: the row lifts into an
// elevated overlay following the pointer while the other rows shift to
// preview the insertion slot. On release the component reports
// `reorder(from, to)` ONLY — 1.18 has no loop statement, so the component
// cannot rewrite the model; the host reassigns `items` (whole-model
// replace, which resets the repeater).

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export struct TSortableItem {
    text: string,
    disabled: bool = false,
}

export component TSortable inherits Rectangle {
    in property <[TSortableItem]> items;
    in property <length> row-height: TTheme.height-l + TTheme.spacing-4;

    // Slot preview while dragging (target rows animate between slots).
    private property <int> dragging: -1;
    private property <int> target: -1;
    // Live pointer offset of the dragged row from its home slot.
    private property <length> drag-offset: 0px;

    // Reports (from, to); the host rebuilds the model. `from`/`to` are
    // always different.
    callback reorder(int, int);

    min-height: root.row-height;
    preferred-height: Math.max(root.items.length, 0) * root.row-height;

    // Y of row j: rows between the dragged row and the target slot yield
    // their place (pure fn lets the per-row bindings dedupe reads).
    public pure function row-y(j: int) -> length {
        if (root.dragging < 0 || j == root.dragging) {
            return j * root.row-height;
        }
        if (root.target > root.dragging && j > root.dragging && j <= root.target) {
            return j * root.row-height - root.row-height;
        }
        if (root.target < root.dragging && j >= root.target && j < root.dragging) {
            return j * root.row-height + root.row-height;
        }
        return j * root.row-height;
    }

    // The drag state machine lives in public functions (probe-drivable,
    // same code path as the row TouchArea below).
    public function begin-drag(i: int) {
        if (i < 0 || i >= root.items.length || root.items[i].disabled
            || root.items.length <= 1) {
            return;
        }
        root.dragging = i;
        root.target = i;
        root.drag-offset = 0px;
    }

    public function drag-to(offset: length) {
        if (root.dragging < 0) {
            return;
        }
        let max-up = root.dragging * root.row-height;
        let max-down = (root.items.length - 1 - root.dragging) * root.row-height;
        root.drag-offset = Math.max(-max-up, Math.min(max-down, offset));
        root.target = Math.max(0, Math.min(root.items.length - 1,
            root.dragging + Math.round(root.drag-offset / root.row-height)));
    }

    public function end-drag() {
        if (root.dragging >= 0) {
            let from = root.dragging;
            let to = root.target;
            // Reset first: the host may rebuild the model inside the
            // callback, and the overlay must not index a stale row of the
            // new model.
            root.dragging = -1;
            root.drag-offset = 0px;
            if (to != from) {
                root.reorder(from, to);
            }
        }
    }

    for it[i] in root.items: Rectangle {
        x: 0;
        y: root.row-y(i);
        // 让位动画只挂在被拖行之外 (enabled 关断时当帧直达), 且挂在 y 上
        // 而非镜像属性 — 行 y 只依赖 row-y(), resize 不经此路径。
        animate y { duration: TTheme.duration-fast; enabled: i != root.dragging; }
        width: parent.width;
        height: root.row-height;
        background: TTheme.bg-color-container;
        opacity: root.dragging == i ? 0 : 1;

        states [
            hovered when row-touch.has-hover && !it.disabled && root.dragging < 0: {
                background: TTheme.bg-color-container-hover;
            }
        ]

        HorizontalLayout {
            padding-left: TTheme.padding-lr-l;
            padding-right: TTheme.padding-lr-l;
            spacing: TTheme.spacing-3;

            TIcon {
                y: (parent.height - self.height) / 2;
                icon: TIconSet.Menu;
                size: 16px;
                icon-color: it.disabled ? TTheme.text-color-disabled : TTheme.text-color-placeholder;
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0;

                TText {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: it.text;
                    color: it.disabled ? TTheme.text-color-disabled : TTheme.text-color-primary;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            x: TTheme.padding-lr-l;
            y: parent.height - self.height;
            width: parent.width - TTheme.padding-lr-l;
            height: 1px;
            background: TTheme.component-stroke;
        }

        row-touch := TouchArea {
            enabled: !it.disabled && root.items.length > 1;
            mouse-cursor: self.enabled ? MouseCursor.grabbing : MouseCursor.default;
            accessible-role: AccessibleRole.list-item;
            accessible-label: it.text;
            accessible-enabled: !it.disabled;

            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.begin-drag(i);
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    root.end-drag();
                }
            }

            moved => {
                root.drag-to(self.mouse-y - self.pressed-y);
            }
        }
    }

    // Elevated drag ghost above all rows (declared last → on top).
    if root.dragging >= 0: Rectangle {
        x: 0;
        y: root.row-y(root.dragging) + root.drag-offset;
        width: parent.width;
        height: root.row-height;
        background: TTheme.bg-color-container;
        border-radius: TTheme.radius-medium;
        border-width: 1px;
        border-color: TTheme.component-stroke;
        drop-shadow-blur: TTheme.shadow-2-blur;
        drop-shadow-offset-y: TTheme.shadow-2-offset-y;
        drop-shadow-color: TTheme.shadow-2-color;

        HorizontalLayout {
            padding-left: TTheme.padding-lr-l;
            padding-right: TTheme.padding-lr-l;
            spacing: TTheme.spacing-3;

            TIcon {
                y: (parent.height - self.height) / 2;
                icon: TIconSet.Menu;
                size: 16px;
                icon-color: TTheme.brand-color;
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0;

                TText {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: root.items[root.dragging].text;
                    overflow: elide;
                }
            }
        }

        // Absorbs presses so they never reach the faded row underneath.
        TouchArea { }
    }

    accessible-role: AccessibleRole.list;
}
