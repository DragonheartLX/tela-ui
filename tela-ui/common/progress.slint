// Tela UI — Progress
//
// Linear or circular progress. value: 0..100.
// variant: ProgressVariant (line / circle); theme: Theme; size: Size.

import { TelaTheme } from "../theme.slint";
import { Theme, Size } from "../structs/enums.slint";

export enum ProgressVariant {
    line,
    circle,
}
import { TelaTheme } from "../theme.slint";

export component Progress inherits Rectangle {
    in property <ProgressVariant> variant: ProgressVariant.line;
    in property <float> value: 0;
    in property <Theme> theme: Theme.primary;
    in property <Size> size: Size.medium;
    in property <bool> show-label: true;

    private property <float> p: max(0, min(100, value)) / 100;
    // One animated source drives both the linear fill width and the
    // circular arc, so value changes ease in both variants.
    animate p { duration: TelaTheme.duration-base; }
    private property <length> th:
        size == Size.small ? 4px
        : size == Size.large ? 10px
        : 6px;
    private property <length> d:
        size == Size.small ? 64px
        : size == Size.large ? 96px
        : 80px;
    private property <brush> bar-color:
        theme == Theme.default ? TelaTheme.brand-color : TelaTheme.theme-color(theme);

    height: variant == ProgressVariant.line ? TelaTheme.height-m : d;
    width: d;
    // Line variant shares the surrounding layout's space; circle is fixed.
    horizontal-stretch: variant == ProgressVariant.line ? 1 : 0;

    if variant == ProgressVariant.line: HorizontalLayout {
        spacing: TelaTheme.spacing-2;

        Rectangle {
            y: (parent.height - root.th) / 2;
            height: root.th;
            horizontal-stretch: 1;
            border-radius: root.th / 2;
            background: TelaTheme.bg-color-component;

            Rectangle {
                x: 0;
                y: 0;
                width: max(self.height, root.p * parent.width);
                height: parent.height;
                border-radius: self.height / 2;
                background: root.bar-color;
            }
        }

        if root.show-label: Text {
            text: "\{Math.round(root.p * 100)}%";
            width: 40px;
            font-size: TelaTheme.font-size-s;
            color: TelaTheme.text-color-secondary;
            vertical-alignment: center;
        }
    }

    if variant == ProgressVariant.circle: Rectangle {
        width: root.d;
        height: root.d;

        // Track ring: full circle drawn as two half arcs.
        Path {
            private property <float> sw: root.th / root.d * 24;
            private property <float> r: 12 - sw / 2;

            viewbox-width: 24;
            viewbox-height: 24;
            width: 100%;
            height: 100%;

            stroke: TelaTheme.bg-color-component;
            stroke-width: sw * 1px;

            MoveTo { x: 12; y: 12 - parent.r; }
            ArcTo { x: 12; y: 12 + parent.r; radius-x: parent.r; radius-y: parent.r; sweep: true; large-arc: false; }
            ArcTo { x: 12; y: 12 - parent.r; radius-x: parent.r; radius-y: parent.r; sweep: true; large-arc: false; }
        }

        // Value arc: starts at 12 o'clock, sweeps clockwise.
        if root.p > 0.001: Path {
            private property <float> sw: root.th / root.d * 24;
            private property <float> r: 12 - sw / 2;
            private property <float> sweep: min(0.9999, root.p);

            viewbox-width: 24;
            viewbox-height: 24;
            width: 100%;
            height: 100%;

            stroke: root.bar-color;
            stroke-width: sw * 1px;
            stroke-line-cap: round;

            MoveTo {
                x: 12 - parent.r * sin(-0.0001 * 360deg);
                y: 12 - parent.r * cos(0.0001 * 360deg);
            }
            LineTo {
                x: 12 - parent.r * sin(-0.0002 * 360deg);
                y: 12 - parent.r * cos(0.0002 * 360deg);
            }
            ArcTo {
                x: 12 - parent.r * sin(-parent.sweep * 360deg);
                y: 12 - parent.r * cos(parent.sweep * 360deg);
                radius-x: parent.r;
                radius-y: parent.r;
                sweep: parent.sweep > 0;
                large-arc: parent.sweep > 0.5;
            }
        }

        if root.show-label: Text {
            width: 100%;
            y: (parent.height - self.preferred-height) / 2;
            text: Math.round(root.p * 100) + "%";
            font-size: root.d / 5;
            font-weight: TelaTheme.font-weight-semibold;
            color: TelaTheme.text-color-primary;
            horizontal-alignment: center;
        }
    }
}
