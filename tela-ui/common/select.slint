// Tela UI — Select
//
// Dropdown selector. Anchored popup lists up to 6 items; the popup matches
// the trigger width (at least 120px). Keyboard support is not included yet.

import { TelaTheme } from "../theme.slint";
import { Size } from "../structs/enums.slint";
import { Icon } from "../base/icon/icon.slint";
import { TIconData, TIconSet } from "../base/icon/data.slint";

export struct SelectItem {
    label: string,
    value: string,
    disabled: bool,
}

export component Select inherits Rectangle {
    in property <[SelectItem]> items;
    in-out property <int> current-index: -1;
    in-out property <string> current-value;
    in property <string> placeholder-text;
    in property <bool> disabled;
    in property <TIconData> prefix-icon;
    in property <Size> size: Size.medium;

    callback selected(int, string);

    private property <length> h: TelaTheme.size-height(size);
    private property <length> fs: TelaTheme.size-font(size);
    private property <length> item-h: 32px;

    private property <string> display-label:
        current-index >= 0 && current-index < items.length ? items[current-index].label : "";
    private property <bool> has-selection: current-index >= 0 && current-index < items.length;

    min-width: 160px;
    height: h;
    background: TelaTheme.bg-color-specialcomponent;
    border-width: 1px;
    border-color: TelaTheme.component-border;
    border-radius: TelaTheme.radius-default;
    animate border-color { duration: TelaTheme.duration-fast; }

    states [
        hovered when touch.has-hover && !root.disabled: {
            border-color: TelaTheme.border-level-2-color;
        }
        disabled when root.disabled: {
            border-color: TelaTheme.border-level-1-color;
        }
    ]

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            popup.show();
        }
    }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: TelaTheme.spacing-2;
        padding-right: TelaTheme.spacing-2;
        spacing: TelaTheme.spacing-2;

        if root.prefix-icon.paths.length > 0: Icon {
            y: (parent.height - self.height) / 2;
            icon: root.prefix-icon;
            size: root.fs + 2px;
            icon-color: TelaTheme.text-color-placeholder;
        }

        Text {
            text: root.has-selection ? root.display-label : root.placeholder-text;
            font-size: root.fs;
            font-family: TelaTheme.font-family;
            color: TelaTheme.text-color-placeholder;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;

            // Later states win over earlier ones.
            states [
                selected when root.has-selection: {
                    color: TelaTheme.text-color-primary;
                }
                disabled when root.disabled: {
                    color: TelaTheme.text-color-disabled;
                }
            ]
        }

        Icon {
            y: (parent.height - self.height) / 2;
            icon: TIconSet.ChevronDown;
            size: root.fs;
            icon-color: root.disabled ? TelaTheme.text-color-disabled : TelaTheme.text-color-secondary;
            transform-rotation: popup.is-open ? 180deg : 0deg;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            animate transform-rotation { duration: TelaTheme.duration-fast; }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 4px;
        width: max(root.width, 120px);
        height: min(root.items.length, 6) * root.item-h + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: TelaTheme.bg-color-container;
            border-width: 1px;
            border-color: TelaTheme.component-stroke;
            border-radius: TelaTheme.radius-medium;
            drop-shadow-blur: TelaTheme.shadow-2-blur;
            drop-shadow-offset-y: TelaTheme.shadow-2-offset-y;
            drop-shadow-color: TelaTheme.shadow-2-color;
            clip: true;

            VerticalLayout {
                padding: 4px;

                for it[i] in root.items: Rectangle {
                    height: root.item-h;
                    border-radius: TelaTheme.radius-default;
                    background: transparent;
                    animate background { duration: TelaTheme.duration-fast; }

                    states [
                        hovered when item-ta.has-hover && !it.disabled: {
                            background: TelaTheme.bg-color-container-hover;
                        }
                        selected when i == root.current-index: {
                            background: TelaTheme.brand-color-light;
                        }
                    ]

                    HorizontalLayout {
                        padding-left: TelaTheme.spacing-2;
                        padding-right: TelaTheme.spacing-2;
                        spacing: TelaTheme.spacing-2;

                        Text {
                            text: it.label;
                            font-size: root.fs;
                            font-family: TelaTheme.font-family;
                            color: TelaTheme.text-color-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;

                            // Later states win over earlier ones.
                            states [
                                active when i == root.current-index: {
                                    color: TelaTheme.brand-color;
                                }
                                disabled when it.disabled: {
                                    color: TelaTheme.text-color-disabled;
                                }
                            ]
                        }

                        if i == root.current-index: Icon {
                            y: (parent.height - self.height) / 2;
                            icon: TIconSet.Check;
                            size: root.fs;
                            icon-color: TelaTheme.brand-color;
                        }
                    }

                    item-ta := TouchArea {
                        enabled: !it.disabled;
                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => {
                            root.current-index = i;
                            root.current-value = it.value;
                            root.selected(i, it.value);
                            popup.close();
                        }
                    }
                }
            }
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: display-label;
}
