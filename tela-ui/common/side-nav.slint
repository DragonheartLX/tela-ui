// Tela UI — SideNav
//
// Collapsible side navigation: brand header, a vertical menu and a footer
// cluster pinned to the bottom edge (menu-style entries above the collapse
// toggle). `collapsed` folds icon+label rows down to centered icons and
// animates the width between 232px and 64px; rows keep their elements
// mounted and animate position/opacity so the fold plays smoothly instead
// of popping. The collapse toggle (TDesign's panel-fold button) lives in
// the header (`toggle-position: top`) or as the footer's last row
// (`bottom`). `mode`: icon-text (collapsible, default), text, or icon
// (always 64px wide).

import { TelaTheme } from "../theme.slint";
import { Icon } from "../base/icon/icon.slint";
import { TIconData, TIconSet } from "../base/icon/data.slint";

export enum SideNavMode {
    icon-text,
    text,
    icon,
}

// Where the collapse toggle lives.
export enum SideNavTogglePosition {
    // Header row, right edge while expanded, centered once collapsed.
    top,
    // Footer row, sharing it with the footer action when one is set.
    bottom,
}

export struct SideNavItem {
    label: string,
    value: string,
    // Optional glyph from TIconSet; items without one fall back to text.
    icon: TIconData = { paths: [] },
    disabled: bool = false,
}

// An entry pinned to the bottom of the sidebar, above the collapse toggle
// (e.g. a dark-mode switch, a settings link). A non-empty `value` makes it
// behave like a menu row — it highlights with `current-value` and fires
// `changed` — while an empty one acts as a plain button firing
// `footer-clicked`.
export struct SideNavFooterItem {
    label: string = "",
    icon: TIconData = { paths: [] },
    value: string = "",
}

export component SideNav inherits Rectangle {
    in property <string> title;
    in property <TIconData> logo;
    in property <[SideNavItem]> items;
    in-out property <string> current-value;
    in-out property <bool> collapsed: false;
    in property <SideNavMode> mode: SideNavMode.icon-text;
    in property <SideNavTogglePosition> toggle-position: SideNavTogglePosition.top;
    in property <bool> bordered: true;
    // Entries pinned to the sidebar's bottom edge, above the collapse
    // toggle; styled like menu rows — icon plus label while expanded,
    // centered icons once collapsed.
    in property <[SideNavFooterItem]> footer-items;

    callback changed(string);
    // Fired by footer entries without a `value` (plain actions).
    callback footer-clicked(SideNavFooterItem);

    private property <bool> show-text: (root.mode == SideNavMode.icon-text && !root.collapsed) || root.mode == SideNavMode.text;
    private property <bool> show-icon: root.mode != SideNavMode.text;
    private property <bool> collapsible: root.mode == SideNavMode.icon-text;
    // The header carries the brand and the top collapse toggle; a sidebar
    // with neither folds it away so the menu starts right at the top.
    private property <bool> has-header:
        root.title != "" || root.logo.paths.length > 0
        || (root.collapsible && root.toggle-position == SideNavTogglePosition.top);
    private property <bool> footer-chevron: root.collapsible && root.toggle-position == SideNavTogglePosition.bottom;

    width: self.show-text ? 232px : 64px;
    animate width { duration: TelaTheme.duration-base; easing: ease-out; }
    background: TelaTheme.bg-color-container;

    VerticalLayout {
        // Header ----------------------------------------------------------
        // Brand fades out when folding; the whole header folds away when
        // there is nothing to show in it.
        Rectangle {
            height: root.has-header ? 48px : 0px;
            clip: true;

            HorizontalLayout {
                x: TelaTheme.padding-lr-m;
                y: (parent.height - self.preferred-height) / 2;
                height: self.preferred-height;
                width: self.preferred-width;
                opacity: root.show-text ? 1 : 0;
                animate opacity { duration: TelaTheme.duration-base; }
                spacing: TelaTheme.spacing-2;

                if root.logo.paths.length > 0: Icon {
                    y: (parent.height - self.height) / 2;
                    icon: root.logo;
                    size: 22px;
                    icon-color: TelaTheme.brand-color;
                }

                if root.title != "": Text {
                    text: root.title;
                    font-size: TelaTheme.font-size-title-m;
                    font-weight: TelaTheme.font-weight-semibold;
                    color: TelaTheme.text-color-primary;
                    vertical-alignment: center;
                }
            }

            if root.collapsible && root.toggle-position == SideNavTogglePosition.top: Rectangle {
                width: 28px;
                height: 28px;
                // Expanded: the header's right edge. Collapsed: centered —
                // x is recomputed from the animating width every frame (no
                // tween of its own), so the button glides in naturally with
                // the fold instead of tweening across the header.
                x: !root.show-text ? (parent.width - self.width) / 2
                    : parent.width - self.width - 6px;
                y: (parent.height - self.height) / 2;
                border-radius: TelaTheme.radius-small;
                background: transparent;
                animate background { duration: TelaTheme.duration-fast; }

                states [
                    hovered when toggle-ta.has-hover: {
                        background: TelaTheme.bg-color-component-hover;
                    }
                ]

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: TIconSet.ChevronLeft;
                    size: 16px;
                    // The 180° flip doubles as the collapsed-direction cue.
                    transform-rotation: root.show-text ? 0deg : 180deg;
                    animate transform-rotation { duration: TelaTheme.duration-base; easing: ease-out; }
                    icon-color: toggle-ta.has-hover ? TelaTheme.brand-color : TelaTheme.text-color-secondary;
                    animate icon-color { duration: TelaTheme.duration-fast; }
                }

                toggle-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.collapsed = !root.collapsed;
                    }
                }
            }
        }

        // Menu ------------------------------------------------------------
        for it[i] in root.items: Rectangle {
            height: 40px;
            border-radius: TelaTheme.radius-medium;
            clip: true;
            background: transparent;
            animate background { duration: TelaTheme.duration-fast; }

            states [
                hovered when item-ta.has-hover && !it.disabled: {
                    background: TelaTheme.bg-color-component-hover;
                }
                active when it.value == root.current-value && !it.disabled: {
                    background: TelaTheme.brand-color-light;
                }
                disabled when it.disabled: {
                    background: transparent;
                }
            ]

            if root.show-icon && it.icon.paths.length > 0: Icon {
                // Slides between the expanded left slot and the collapsed
                // center; stays mounted so the fold animates instead of pop.
                x: root.show-text ? TelaTheme.padding-lr-m
                    : (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: it.icon;
                size: 20px;
                icon-color: TelaTheme.text-color-secondary;
                animate x { duration: TelaTheme.duration-base; easing: ease-out; }
                animate icon-color { duration: TelaTheme.duration-fast; }

                states [
                    hovered when item-ta.has-hover && !it.disabled: {
                        icon-color: TelaTheme.text-color-primary;
                    }
                    active when it.value == root.current-value && !it.disabled: {
                        icon-color: TelaTheme.brand-color;
                    }
                    disabled when it.disabled: {
                        icon-color: TelaTheme.text-color-disabled;
                    }
                ]
            }

            if it.label != "": Text {
                x: it.icon.paths.length > 0 && root.show-icon ? 44px : TelaTheme.padding-lr-m;
                y: (parent.height - self.preferred-height) / 2;
                height: self.preferred-height;
                text: it.label;
                font-size: TelaTheme.font-size-m;
                color: TelaTheme.text-color-primary;
                vertical-alignment: center;
                opacity: root.show-text ? 1 : 0;
                animate opacity { duration: TelaTheme.duration-base; }
                animate color { duration: TelaTheme.duration-fast; }

                states [
                    hovered when item-ta.has-hover && !it.disabled: {
                        color: TelaTheme.text-color-primary;
                    }
                    active when it.value == root.current-value && !it.disabled: {
                        color: TelaTheme.brand-color;
                    }
                    disabled when it.disabled: {
                        color: TelaTheme.text-color-disabled;
                    }
                ]
            }

            item-ta := TouchArea {
                enabled: !it.disabled;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    if it.value != root.current-value {
                        root.current-value = it.value;
                        root.changed(it.value);
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        // Footer entries ---------------------------------------------------
        // Pinned to the bottom edge above the collapse toggle; styled like
        // menu rows — icon plus label while expanded, a centered icon once
        // collapsed.
        for it in root.footer-items: Rectangle {
            height: 40px;
            border-radius: TelaTheme.radius-medium;
            clip: true;
            background: transparent;
            animate background { duration: TelaTheme.duration-fast; }

            states [
                hovered when footer-ta.has-hover: {
                    background: TelaTheme.bg-color-component-hover;
                }
                active when it.value != "" && it.value == root.current-value: {
                    background: TelaTheme.brand-color-light;
                }
            ]

            if root.show-icon && it.icon.paths.length > 0: Icon {
                x: root.show-text ? TelaTheme.padding-lr-m
                    : (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: it.icon;
                size: 20px;
                icon-color: TelaTheme.text-color-secondary;
                animate x { duration: TelaTheme.duration-base; easing: ease-out; }
                animate icon-color { duration: TelaTheme.duration-fast; }

                states [
                    hovered when footer-ta.has-hover: {
                        icon-color: TelaTheme.text-color-primary;
                    }
                    active when it.value != "" && it.value == root.current-value: {
                        icon-color: TelaTheme.brand-color;
                    }
                ]
            }

            if it.label != "": Text {
                x: it.icon.paths.length > 0 && root.show-icon ? 44px : TelaTheme.padding-lr-m;
                y: (parent.height - self.preferred-height) / 2;
                height: self.preferred-height;
                text: it.label;
                font-size: TelaTheme.font-size-m;
                color: TelaTheme.text-color-primary;
                vertical-alignment: center;
                opacity: root.show-text ? 1 : 0;
                animate opacity { duration: TelaTheme.duration-base; }
                animate color { duration: TelaTheme.duration-fast; }

                states [
                    hovered when footer-ta.has-hover: {
                        color: TelaTheme.text-color-primary;
                    }
                    active when it.value != "" && it.value == root.current-value: {
                        color: TelaTheme.brand-color;
                    }
                ]
            }

            footer-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    if it.value != "" {
                        if it.value != root.current-value {
                            root.current-value = it.value;
                            root.changed(it.value);
                        }
                    } else {
                        root.footer-clicked(it);
                    }
                }
            }
        }

        // Collapse toggle, bottom variant: TDesign's fold button — a quiet
        // row with the panel-fold glyph (arrow pointing at the divider while
        // expanded, outward once collapsed), left-aligned with the menu
        // while expanded, centered after folding.
        if root.footer-chevron: Rectangle {
            height: 40px;
            border-radius: TelaTheme.radius-medium;
            background: transparent;
            animate background { duration: TelaTheme.duration-fast; }

            states [
                hovered when collapse-ta.has-hover: {
                    background: TelaTheme.bg-color-component-hover;
                }
            ]

            Icon {
                x: root.show-text ? TelaTheme.padding-lr-m
                    : (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: root.show-text ? TIconSet.PanelLeftClose : TIconSet.PanelLeftOpen;
                size: 20px;
                icon-color: collapse-ta.has-hover ? TelaTheme.brand-color : TelaTheme.text-color-secondary;
                animate x { duration: TelaTheme.duration-base; easing: ease-out; }
                animate icon-color { duration: TelaTheme.duration-fast; }
            }

            collapse-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.collapsed = !root.collapsed;
                }
            }
        }
    }

    if root.bordered: Rectangle {
        x: parent.width - self.width;
        width: 1px;
        height: 100%;
        background: TelaTheme.component-stroke;
    }
}
