// Tela UI — Drawer
//
// Side panel over a dimmed backdrop. `open` toggles it; the panel slides
// in from the right (side: 0) or left (side: 1) edge. Overlay clicks close
// it when `close-on-overlay` is set. Children of the component form the
// body below the title.

import { TelaTheme } from "../theme.slint";
import { Icon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export component Drawer inherits Rectangle {
    in-out property <bool> open: false;
    in property <string> title;
    // 0 = slide in from the right edge, 1 = from the left edge.
    in property <int> side: 0;
    in property <length> drawer-width: 320px;
    in property <bool> close-on-overlay: true;

    callback closed();

    visible: open;
    background: TelaTheme.mask-active;

    public function close() {
        open = false;
        root.closed();
    }

    TouchArea {
        enabled: root.open && root.close-on-overlay;
        clicked => {
            root.close();
        }
    }

    panel := Rectangle {
        y: 0;
        height: parent.height;
        width: min(root.drawer-width, parent.width - 48px);
        x: root.side == 1
            ? (root.open ? 0px : -self.width)
            : (root.open ? parent.width - self.width : parent.width);
        background: TelaTheme.bg-color-container;
        drop-shadow-blur: TelaTheme.shadow-3-blur;
        drop-shadow-offset-y: TelaTheme.shadow-3-offset-y;
        drop-shadow-color: TelaTheme.shadow-3-color;
        animate x { duration: TelaTheme.duration-base; easing: ease-out; }

        VerticalLayout {
            padding: TelaTheme.margin-l;
            spacing: TelaTheme.margin-m;

            HorizontalLayout {
                spacing: TelaTheme.margin-s;

                Text {
                    text: root.title;
                    font-size: TelaTheme.font-size-title-m;
                    font-weight: TelaTheme.font-weight-semibold;
                    color: TelaTheme.text-color-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 24px;
                    height: 24px;

                    Icon {
                        x: 5px;
                        y: 5px;
                        icon: TIconSet.X;
                        size: 14px;
                        icon-color: close-ta.has-hover ? TelaTheme.text-color-primary : TelaTheme.text-color-secondary;
                        animate icon-color { duration: TelaTheme.duration-fast; }
                    }
                    close-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            @children
        }
    }
}
