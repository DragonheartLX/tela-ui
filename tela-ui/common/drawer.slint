// Tela UI — Drawer
//
// Side panel over a dimmed backdrop. `placement` picks the edge the panel
// slides in from (right/bottom sized by width & height, left/top mirrored);
// the panel stays mounted and fades via animated opacity so the close
// animation is actually visible. Overlay clicks close it when
// `close-on-overlay` is set. Children of the component form the body below
// the title.

import { TelaTheme } from "../theme.slint";
import { Icon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export enum DrawerPlacement {
    top,
    right,
    bottom,
    left,
}

export component Drawer inherits Rectangle {
    in-out property <bool> open: false;
    in property <string> title;
    in property <DrawerPlacement> placement: DrawerPlacement.right;
    // Width for left/right drawers, height for top/bottom drawers.
    in property <length> drawer-width: 320px;
    in property <length> drawer-height: 280px;
    in property <bool> close-on-overlay: true;

    callback closed();

    private property <bool> horizontal:
        root.placement == DrawerPlacement.left || root.placement == DrawerPlacement.right;

    // Stays mounted and fades via animated opacity so the panel's slide-out
    // is actually visible; binding `visible: open` would drop the whole
    // subtree the instant `open` flips and no close animation would show.
    // Input stays safe: the backdrop TouchArea is only enabled while open,
    // and the panel rests fully off-window when closed.
    opacity: root.open ? 1 : 0;
    animate opacity { duration: TelaTheme.duration-base; easing: ease-out; }
    background: TelaTheme.mask-active;

    public function close() {
        open = false;
        root.closed();
    }

    TouchArea {
        enabled: root.open && root.close-on-overlay;
        clicked => {
            root.close();
        }
    }

    panel := Rectangle {
        width: root.horizontal ? min(root.drawer-width, parent.width - 48px) : parent.width;
        height: root.horizontal ? parent.height : min(root.drawer-height, parent.height - 48px);
        x: !root.horizontal ? 0
            : root.placement == DrawerPlacement.left
                ? (root.open ? 0px : -self.width)
                : (root.open ? parent.width - self.width : parent.width);
        y: root.horizontal ? 0
            : root.placement == DrawerPlacement.top
                ? (root.open ? 0px : -self.height)
                : (root.open ? parent.height - self.height : parent.height);
        background: TelaTheme.bg-color-container;
        drop-shadow-blur: TelaTheme.shadow-3-blur;
        drop-shadow-offset-y: TelaTheme.shadow-3-offset-y;
        drop-shadow-color: TelaTheme.shadow-3-color;
        animate x { duration: TelaTheme.duration-base; easing: ease-out; }
        animate y { duration: TelaTheme.duration-base; easing: ease-out; }

        VerticalLayout {
            padding: TelaTheme.margin-l;
            spacing: TelaTheme.margin-m;

            HorizontalLayout {
                spacing: TelaTheme.margin-s;

                Text {
                    text: root.title;
                    font-size: TelaTheme.font-size-title-m;
                    font-weight: TelaTheme.font-weight-semibold;
                    color: TelaTheme.text-color-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 24px;
                    height: 24px;

                    Icon {
                        x: 5px;
                        y: 5px;
                        icon: TIconSet.X;
                        size: 14px;
                        icon-color: close-ta.has-hover ? TelaTheme.text-color-primary : TelaTheme.text-color-secondary;
                        animate icon-color { duration: TelaTheme.duration-fast; }
                    }
                    close-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            @children
        }
    }
}
