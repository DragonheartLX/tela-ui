// Tela UI — Slider
//
// Draggable single-value slider with keyboard support (arrow keys,
// Home/End) once focused. Emits `changed` while dragging and `released`
// on pointer up / key release.

import { TelaTheme } from "../theme.slint";

export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> disabled;
    in-out property <float> value: minimum;

    callback changed(float);
    callback released(float);

    private property <length> track-h: 6px;
    private property <length> handle-d: 16px;
    private property <float> t: (value - minimum) / max(0.0001, maximum - minimum);

    height: TelaTheme.height-m;

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if root.disabled || root.step <= 0 {
                return reject;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.set-value(root.value + root.step);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.set-value(root.value - root.step);
                return accept;
            }
            if event.text == Key.Home {
                root.set-value(root.minimum);
                return accept;
            }
            if event.text == Key.End {
                root.set-value(root.maximum);
                return accept;
            }
            reject
        }
        key-released(event) => {
            if !root.disabled {
                root.released(root.value);
            }
            accept
        }
    }

    // Track
    Rectangle {
        y: (parent.height - root.track-h) / 2;
        width: parent.width;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: root.disabled ? TelaTheme.bg-color-component-disabled : TelaTheme.bg-color-component;
    }

    // Filled portion: ends at the handle center (t * width), so 0% shows no
    // fill and 100% fills the whole track. x must be bound: outside a layout
    // an unbound x centers the element, growing the fill from the middle.
    Rectangle {
        x: 0;
        y: (parent.height - root.track-h) / 2;
        width: root.t * parent.width;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: root.disabled ? TelaTheme.brand-color-disabled : TelaTheme.brand-color;
    }

    // Handle: center travels from the track start (0%) to its end (100%).
    Rectangle {
        x: root.t * parent.width - root.handle-d / 2;
        y: (parent.height - root.handle-d) / 2;
        width: root.handle-d;
        height: root.handle-d;
        border-radius: self.width / 2;
        background: TelaTheme.text-color-anti;
        border-width: 1px;
        border-color: TelaTheme.brand-color;
        animate border-color { duration: TelaTheme.duration-fast; }
        animate border-width { duration: TelaTheme.duration-fast; }
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: TelaTheme.shadow-1-color;

        // Later states win over earlier ones.
        states [
            hovered when touch.has-hover: {
                border-width: 2px;
            }
            pressed when touch.pressed: {
                border-width: 2px;
                border-color: TelaTheme.brand-color-active;
            }
            disabled when root.disabled: {
                border-color: TelaTheme.border-level-1-color;
            }
        ]
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.set-value(root.map-position(self.mouse-x));
                focus-scope.focus();
            }
            if event.kind == PointerEventKind.up {
                root.released(root.value);
            }
        }
        moved => {
            root.set-value(root.map-position(self.mouse-x));
        }
    }

    pure function map-position(x: length) -> float {
        minimum + (x / max(1px, root.width)) * (maximum - minimum)
    }

    public function set-value(raw: float) {
        let clamped = max(minimum, min(maximum, raw));
        let snapped = minimum + Math.round((clamped - minimum) / step) * step;
        if value == snapped {
            return;
        }
        value = snapped;
        root.changed(snapped);
    }
}
