// Tela UI — Card
//
// Bordered content container with optional title/subtitle header and
// footer strip. Children of the component form the card body.

import { TelaTheme } from "../theme.slint";

export component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> footer;
    in property <bool> bordered: true;
    in property <bool> shadowed: false;
    in property <length> card-padding: TelaTheme.margin-l;

    background: TelaTheme.bg-color-container;
    border-width: bordered ? 1px : 0;
    border-color: TelaTheme.component-stroke;
    border-radius: TelaTheme.radius-large;
    drop-shadow-blur: shadowed ? TelaTheme.shadow-1-blur : 0px;
    drop-shadow-offset-y: shadowed ? TelaTheme.shadow-1-offset-y : 0px;
    drop-shadow-color: TelaTheme.shadow-1-color;

    VerticalLayout {
        padding: root.card-padding;
        spacing: TelaTheme.margin-m;

        if root.title != "" || root.subtitle != "": VerticalLayout {
            spacing: TelaTheme.spacing-2;

            if root.title != "": Text {
                text: root.title;
                font-size: TelaTheme.font-size-title-m;
                font-weight: TelaTheme.font-weight-semibold;
                color: TelaTheme.text-color-primary;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: TelaTheme.font-size-s;
                color: TelaTheme.text-color-secondary;
            }
        }

        @children

        if root.footer != "": VerticalLayout {
            spacing: TelaTheme.margin-m;

            Rectangle {
                height: 1px;
                background: TelaTheme.component-stroke;
            }

            Text {
                text: root.footer;
                font-size: TelaTheme.font-size-m;
                color: TelaTheme.text-color-secondary;
            }
        }
    }
}
