// Tela UI — Avatar
//
// User/project avatar: image or text, circle or rounded square.
// size: AvatarSize (32/40/48/64).

import { TelaTheme } from "../theme.slint";
import { Icon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";
import { Theme } from "../structs/enums.slint";

export enum AvatarSize {
    small,
    medium,
    large,
    extra-large,
}

export enum AvatarShape {
    circle,
    square,
}
import { TIconSet } from "../base/icon/data.slint";

export component Avatar inherits Rectangle {
    in property <AvatarSize> size: AvatarSize.medium;
    in property <string> text;
    in property <image> source;
    in property <AvatarShape> shape: AvatarShape.circle;
    in property <Theme> theme: Theme.primary;

    private property <length> d: size == AvatarSize.small ? 32px
        : size == AvatarSize.large ? 48px
        : size == AvatarSize.extra-large ? 64px : 40px;

    width: d;
    height: d;
    border-radius: shape == AvatarShape.circle ? self.width / 2 : TelaTheme.radius-medium;
    background: TelaTheme.theme-color-light(theme);
    clip: true;

    if source.width > 0: Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: ImageFit.cover;
    }

    if source.width == 0 && text != "": Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: parent.width / 2.8;
        font-weight: TelaTheme.font-weight-semibold;
        color: TelaTheme.theme-color(theme);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if source.width == 0 && text == "": Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: TIconSet.User;
        size: parent.width / 2;
        icon-color: TelaTheme.theme-color(theme);
    }
}
