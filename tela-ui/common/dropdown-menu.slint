// Tela UI — DropdownMenu
//
// Action menu anchored to arbitrary trigger content. With `auto-open` (the
// default) a TouchArea layered over the trigger toggles the popup — this
// requires non-interactive trigger content (icon, text, avatar …), because
// the area swallows their clicks. For Button triggers set `auto-open: false`
// and call `toggle()` from `clicked` instead. The menu closes on outside
// clicks and after selecting an entry.

import { TelaTheme } from "../theme.slint";
import { Icon } from "../base/icon/icon.slint";
import { TIconData } from "../base/icon/data.slint";
import { ScrollView } from "std-widgets.slint";

export struct DropdownMenuItem {
    label: string,
    value: string,
    icon: TIconData = { paths: [] },
    disabled: bool,
    danger: bool,
    // Render a hairline separator instead of the entry.
    divider: bool,
}

// Anchoring of trigger-attached popups, shared with Popconfirm.
export enum PopupPlacement {
    bottom-start,
    bottom-end,
    top-start,
    top-end,
}

export component DropdownMenu inherits Rectangle {
    in property <[DropdownMenuItem]> items;
    in property <PopupPlacement> placement: PopupPlacement.bottom-start;
    // Click-toggle TouchArea over the trigger content (non-interactive
    // triggers only).
    in property <bool> auto-open: true;
    in property <length> item-height: 32px;
    // Visible rows before the popup starts scrolling.
    in property <int> max-visible-items: 6;

    callback selected(int, string);

    out property <bool> open: popup.is-open;

    public function show() {
        popup.show();
    }

    public function close() {
        popup.close();
    }

    public function toggle() {
        if (popup.is-open) {
            popup.close();
        } else {
            popup.show();
        }
    }

    private property <bool> to-end:
        placement == PopupPlacement.bottom-end || placement == PopupPlacement.top-end;
    private property <bool> to-top:
        placement == PopupPlacement.top-start || placement == PopupPlacement.top-end;

    // Trigger content hosted in a layout so the wrapper hugs it in parent
    // layouts (a bare child would not feed the preferred size).
    row := HorizontalLayout {
        @children
    }

    // Layered OVER the trigger content (declared after the row) so static
    // triggers click through to it. Declaring it before would zero the
    // wrapper's preferred size in layouts. Interactive triggers set
    // `auto-open: false`, which removes the area entirely.
    if root.auto-open: TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.toggle();
        }
    }

    // Zero-clamped host: keeps the popup out of the wrapper's preferred
    // size computation (a PopupWindow would inflate it) while pinning the
    // popup coordinate system to the wrapper origin.
    Rectangle {
        x: 0;
        y: 0;
        max-width: 0px;
        max-height: 0px;

        popup := PopupWindow {
            x: root.to-end ? root.width - self.width : 0;
            y: root.to-top ? -self.height - 6px : root.height + 6px;
            width: max(140px, content.preferred-width);
            height: min(rows.preferred-height, root.max-visible-items * root.item-height + 8px);
            close-policy: close-on-click-outside;

            content := Rectangle {
                max-width: 280px;
                background: TelaTheme.bg-color-container;
                border-width: 1px;
                border-color: TelaTheme.component-stroke;
                border-radius: TelaTheme.radius-medium;
                drop-shadow-blur: TelaTheme.shadow-2-blur;
                drop-shadow-offset-y: TelaTheme.shadow-2-offset-y;
                drop-shadow-color: TelaTheme.shadow-2-color;
                clip: true;

                ScrollView {
                    rows := VerticalLayout {
                        padding: 4px;

                    for it[i] in root.items: Rectangle {
                        height: it.divider ? 9px : root.item-height;
                        border-radius: TelaTheme.radius-default;
                        background: transparent;
                        animate background { duration: TelaTheme.duration-fast; }

                        // Per-entry label color: danger red beats the neutral
                        // primary, disabled grays out both.
                        private property <color> label-c:
                            it.disabled ? TelaTheme.text-color-disabled
                            : it.danger ? TelaTheme.error-color
                            : TelaTheme.text-color-primary;

                        states [
                            hovered when row-ta.has-hover && !it.disabled && !it.divider && !it.danger: {
                                background: TelaTheme.bg-color-container-hover;
                            }
                            hovered-danger when row-ta.has-hover && !it.disabled && !it.divider && it.danger: {
                                background: TelaTheme.error-color-light;
                            }
                        ]

                        if !it.divider: HorizontalLayout {
                            padding-left: TelaTheme.spacing-2;
                            padding-right: TelaTheme.spacing-2;
                            spacing: TelaTheme.spacing-2;

                            if it.icon.paths.length > 0: Icon {
                                y: (parent.height - self.height) / 2;
                                icon: it.icon;
                                size: TelaTheme.font-size-m;
                                icon-color: label-c;
                            }

                            Text {
                                text: it.label;
                                font-size: TelaTheme.font-size-m;
                                font-family: TelaTheme.font-family;
                                color: label-c;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }

                        if it.divider: Rectangle {
                            y: 4px;
                            height: 1px;
                            background: TelaTheme.border-level-1-color;
                        }

                        row-ta := TouchArea {
                            enabled: !it.disabled && !it.divider;
                            mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                            clicked => {
                                root.selected(i, it.value);
                                popup.close();
                            }
                        }
                    }
                }
                }
            }
        }
    }

    accessible-role: AccessibleRole.button;
}
