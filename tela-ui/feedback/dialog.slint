// Tela UI — Dialog
//
// Modal dialog. Place it anywhere in an overlay layer covering the window;
// it renders a dimmed backdrop and a centered card. `open` toggles it,
// overlay clicks close it when `close-on-overlay` is set. Children of the
// component are rendered below the content text as custom body content.

import { TelaTheme } from "../theme.slint";
import { Theme } from "../structs/enums.slint";
import { Button, ButtonVariant } from "../base/button.slint";

export component Dialog inherits Rectangle {
    in-out property <bool> open: false;
    in property <string> title;
    in property <string> content;
    in property <string> confirm-text: "确认";
    in property <string> cancel-text: "取消";
    in property <bool> close-on-overlay: true;
    in property <length> dialog-width: 480px;

    callback accepted();
    callback canceled();
    callback closed();

    visible: open;
    background: TelaTheme.mask-active;
    clip: false;

    public function close() {
        open = false;
        root.closed();
    }

    TouchArea {
        enabled: root.open && root.close-on-overlay;
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.open ? 0px : 12px);
        width: min(root.dialog-width, parent.width - 48px);
        height: card.preferred-height;
        border-radius: TelaTheme.radius-large;
        background: TelaTheme.bg-color-container;
        opacity: root.open ? 1 : 0;
        drop-shadow-blur: TelaTheme.shadow-3-blur;
        drop-shadow-offset-y: TelaTheme.shadow-3-offset-y;
        drop-shadow-color: TelaTheme.shadow-3-color;
        animate opacity { duration: TelaTheme.duration-base; }
        animate y { duration: TelaTheme.duration-base; }

        card := VerticalLayout {
            padding: TelaTheme.margin-xxl;
            spacing: TelaTheme.margin-m;

            if root.title != "": Text {
                text: root.title;
                font-size: TelaTheme.font-size-title-xl;
                font-weight: TelaTheme.font-weight-semibold;
                color: TelaTheme.text-color-primary;
            }

            if root.content != "": Text {
                text: root.content;
                font-size: TelaTheme.font-size-m;
                color: TelaTheme.text-color-secondary;
                wrap: word-wrap;
            }

            @children

            HorizontalLayout {
                spacing: TelaTheme.margin-s;

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: root.cancel-text;
                    variant: ButtonVariant.outline;
                    clicked => {
                        root.canceled();
                        root.close();
                    }
                }

                Button {
                    text: root.confirm-text;
                    theme: Theme.primary;
                    clicked => {
                        root.accepted();
                        root.close();
                    }
                }
            }
        }
    }

    accessible-role: AccessibleRole.groupbox;
    accessible-label: title;
}
