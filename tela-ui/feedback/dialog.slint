// Tela UI — TDialog
//
// Modal dialog with a dimmed backdrop and a centered card.
// Place it in an overlay layer covering the window.
// `open` toggles it.
// Overlay clicks close it when `close-on-overlay` is set.
// Children render below the content text as custom body content.
// Backdrop, ESC and stack bookkeeping come from TModalSurface.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TThemeRole } from "../structs/enums.slint";
import { TButton, TButtonVariant } from "../base/button.slint";
import { TModalSurface } from "../modal-surface.slint";

export component TDialog inherits TModalSurface {
    in property <string> title;
    in property <string> content;
    in property <string> confirm-text: "确认";
    in property <string> cancel-text: "取消";
    // false hides the cancel button (alert-style single-action dialogs).
    in property <bool> show-cancel: true;
    in property <length> dialog-width: 480px;

    callback accepted();
    callback canceled();

    // Rows the card spends on chrome: vertical padding, the title line when
    // present, one gap per child boundary and the button row.
    private property <length> card-chrome:
        TTheme.margin-xxl * 2 + TTheme.height-m
        + (root.title != "" ? TTheme.line-height-title : 0px)
        + TTheme.margin-m * (root.title != "" ? 2 : 1);
    // Body cap: 48px of window inset plus the chrome above. Without it a long
    // body would outgrow the window and push the button row off-screen.
    private property <length> max-content-h: root.height - 48px - root.card-chrome;

    Rectangle {
        x: (parent.width - self.width) / 2;
        // When closed the card rests fully off-window below the overlay.
        // A fading card is invisible but still mounted.
        // Left centred it would keep its content clickable at the screen
        // middle — nothing gates a subtree's children on `open`.
        // The slide doubles as the exit animation.
        y: (parent.height - self.height) / 2 + (root.open ? 0px : self.height + 24px);
        width: min(root.dialog-width, parent.width - 48px);
        height: card.preferred-height;
        border-radius: TTheme.radius-large;
        background: TTheme.bg-color-container;
        drop-shadow-blur: TTheme.shadow-3-blur;
        drop-shadow-offset-y: TTheme.shadow-3-offset-y;
        drop-shadow-color: TTheme.shadow-3-color;
        animate y { duration: TTheme.duration-base; }

        // Absorbs clicks on the card body so they cannot reach the backdrop.
        // Declared before the layout: traversal is front-to-back and starts
        // at the last declared sibling, so the buttons still get theirs.
        // Disabled while closed — an invisible card would still sit at the
        // screen centre and eat the clicks underneath it.
        TouchArea {
            enabled: root.open;
            width: parent.width;
            height: parent.height;
        }

        card := VerticalLayout {
            padding: TTheme.margin-xxl;
            spacing: TTheme.margin-m;

            if root.title != "": TText {
                text: root.title;
                font-size: TTheme.font-size-title-xl;
                line-height: TTheme.line-height-title;
                font-weight: TTheme.font-weight-semibold;
            }

            if root.content != "": Rectangle {
                // Bounded box + clip, the TCollapse fold pattern: a wrapping
                // Text keeps its full wrapped height inside a layout (Slint
                // only shrinks its min-width, and ignores max-height), so the
                // cap has to sit on a clipping wrapper.
                clip: true;
                height: min(body-text.preferred-height, root.max-content-h);

                body-text := TText {
                    width: 100%;
                    text: root.content;
                    color: TTheme.text-color-secondary;
                    wrap: word-wrap;
                }
            }

            @children

            HorizontalLayout {
                spacing: TTheme.margin-s;

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.show-cancel: TButton {
                    text: root.cancel-text;
                    variant: TButtonVariant.outline;
                    clicked => {
                        root.canceled();
                        root.close();
                    }
                }

                TButton {
                    text: root.confirm-text;
                    theme: TThemeRole.primary;
                    clicked => {
                        root.accepted();
                        root.close();
                    }
                }
            }
        }
    }

    accessible-role: AccessibleRole.groupbox;
    accessible-label: title;
}
