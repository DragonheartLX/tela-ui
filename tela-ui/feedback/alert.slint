// Tela UI — TAlert
//
// Inline feedback banner. theme: TTheme (default/primary/success/warning/
// error). Title is styled in the theme color, description in primary
// text; optionally closable (sets `open = false`).

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";
import { TThemeRole } from "../structs/enums.slint";
import { TIconSet } from "../base/icon/data.slint";

export component TAlert inherits Rectangle {
    in property <TThemeRole> theme: TThemeRole.default;
    in property <string> title;
    in property <string> description;
    in property <bool> closable: false;
    in-out property <bool> open: true;

    callback closed();

    background: TTheme.theme-color-light(theme);
    border-radius: TTheme.radius-medium;
    visible: open;

    HorizontalLayout {
        padding-left: TTheme.margin-l;
        padding-right: TTheme.margin-s;
        padding-top: TTheme.margin-m;
        padding-bottom: TTheme.margin-m;
        spacing: TTheme.margin-s;

        TIcon {
            y: root.description == "" ? (parent.height - self.height) / 2 : 3px;
            icon: root.theme == TThemeRole.success ? TIconSet.CircleCheck
                : root.theme == TThemeRole.warning ? TIconSet.CircleAlert
                : root.theme == TThemeRole.error ? TIconSet.CircleX
                : TIconSet.Info;
            size: 20px;
            icon-color: TTheme.theme-color(root.theme);
        }

        VerticalLayout {
            spacing: TTheme.spacing-1;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-size: TTheme.font-size-m;
                font-weight: TTheme.font-weight-semibold;
                color: TTheme.theme-color(root.theme);
                wrap: word-wrap;
            }

            if root.description != "": Text {
                text: root.description;
                font-size: TTheme.font-size-m;
                color: TTheme.text-color-primary;
                wrap: word-wrap;
            }
        }

        if root.closable: Rectangle {
            width: 24px;
            height: 24px;
            y: root.description == "" ? (parent.height - self.height) / 2 : 0px;

            TIcon {
                x: 5px;
                y: 5px;
                icon: TIconSet.X;
                size: 14px;
                icon-color: close-ta.has-hover ? TTheme.theme-color(root.theme) : TTheme.text-color-secondary;
                animate icon-color { duration: TTheme.duration-fast; }
            }
            close-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.open = false;
                    root.closed();
                }
            }
        }
    }

    accessible-role: AccessibleRole.text;
    accessible-label: title;
}
