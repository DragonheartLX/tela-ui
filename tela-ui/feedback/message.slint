// Tela UI — Message
//
// Global toast. Any code (Slint or Rust) can call:
//   TMessage.info("Saved");     TMessage.success("..."),
//   TMessage.warning("..."),    TMessage.error("...")
// Then place one `TMessageOverlay` near the top of the window.
// It renders the current message and auto-hides after 3 seconds.
// Set `TMessage.placement` to move it to any window corner.
// Default: centered at the top.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export enum TMessageTheme {
    info,
    success,
    warning,
    error,
}

// Where the overlay pins the message pill.
export enum TMessagePlacement {
    top-left,
    top-center,
    top-right,
    bottom-left,
    bottom-center,
    bottom-right,
}

export global TMessage {
    in-out property <string> text;
    in-out property <TMessageTheme> theme: TMessageTheme.info;
    in-out property <bool> visible: false;
    // Defaults to centered at the top of the window.
    in-out property <TMessagePlacement> placement: TMessagePlacement.top-center;
    // Monotonic sequence bumped on every show().
    // It lets the overlay restart its 3s timer.
    // Without it a stale timer would fire and swallow a follow-up message.
    out property <int> seq: 0;

    public function show(t: string, th: TMessageTheme) {
        text = t;
        theme = th;
        visible = true;
        seq += 1;
    }

    public function info(t: string) {
        root.show(t, TMessageTheme.info);
    }

    public function success(t: string) {
        root.show(t, TMessageTheme.success);
    }

    public function warning(t: string) {
        root.show(t, TMessageTheme.warning);
    }

    public function error(t: string) {
        root.show(t, TMessageTheme.error);
    }
}

export component TMessageOverlay inherits Rectangle {
    // A passive full-window overlay.
    // No explicit size, so it fills the window it is dropped into.
    // No TouchArea, so it never blocks input.
    // The pill pins to a window edge per TMessage.placement.
    // A former `height: 0px` collapsed this strip to zero and centered it
    // in the window, landing messages mid-screen.
    z: TTheme.z-message;

    private property <bool> to-left:
        TMessage.placement == TMessagePlacement.top-left
        || TMessage.placement == TMessagePlacement.bottom-left;
    private property <bool> to-right:
        TMessage.placement == TMessagePlacement.top-right
        || TMessage.placement == TMessagePlacement.bottom-right;
    private property <bool> to-bottom:
        TMessage.placement == TMessagePlacement.bottom-left
        || TMessage.placement == TMessagePlacement.bottom-center
        || TMessage.placement == TMessagePlacement.bottom-right;

    timer := Timer {
        interval: 3s;
        running: TMessage.visible;
        triggered => {
            TMessage.visible = false;
        }
    }

    // A follow-up show() while the pill is up leaves `visible` unchanged.
    // Only `seq` moves. Restarting on it re-arms the full 3s for the new
    // text, instead of letting the old countdown expire mid-message.
    private property <int> seq: TMessage.seq;
    changed seq => {
        timer.restart();
    }

    pill := Rectangle {
        // Gap to the window edge.
        // It tucks closer while animating in and rests further once visible.
        property <length> edge-gap: TMessage.visible ? 24px : 12px;

        x: root.to-left ? 24px
            : root.to-right ? parent.width - self.width - 24px
            : (parent.width - self.width) / 2;
        y: root.to-bottom
            ? parent.height - self.height - self.edge-gap
            : self.edge-gap;
        // 48px of window inset, as TDialog: a long message elides instead of
        // running the pill off the window edge.
        width: min(row.preferred-width + TTheme.padding-lr-m * 2, parent.width - 48px);
        height: TTheme.height-m + 8px;
        border-radius: TTheme.radius-medium;
        background: TTheme.bg-color-container;
        border-width: 1px;
        border-color: TTheme.component-stroke;
        drop-shadow-blur: TTheme.shadow-2-blur;
        drop-shadow-offset-y: TTheme.shadow-2-offset-y;
        drop-shadow-color: TTheme.shadow-2-color;
        opacity: TMessage.visible ? 1 : 0;
        animate opacity { duration: TTheme.duration-base; }
        animate y { duration: TTheme.duration-base; }
        animate x { duration: TTheme.duration-base; }

        row := HorizontalLayout {
            x: TTheme.padding-lr-m;
            y: (parent.height - self.height) / 2;
            // Capped with the pill: the label can only elide once the row
            // itself is narrower than the text.
            width: min(self.preferred-width, parent.width - TTheme.padding-lr-m * 2);
            height: self.preferred-height;
            spacing: TTheme.spacing-2;

            TIcon {
                y: (parent.height - self.height) / 2;
                icon: TMessage.theme == TMessageTheme.success ? TIconSet.CircleCheck
                    : TMessage.theme == TMessageTheme.warning ? TIconSet.CircleAlert
                    : TMessage.theme == TMessageTheme.error ? TIconSet.CircleX
                    : TIconSet.Info;
                size: 16px;
                icon-color: TMessage.theme == TMessageTheme.success ? TTheme.success-color
                    : TMessage.theme == TMessageTheme.warning ? TTheme.warning-color
                    : TMessage.theme == TMessageTheme.error ? TTheme.error-color
                    : TTheme.brand-color;
            }

            TText {
                text: TMessage.text;
                vertical-alignment: center;
                // Single-line pill: elide when the width cap bites.
                overflow: elide;
                // Live region: assistive tech announces each new message.
                accessible-live-region: AccessibleLiveness.polite;
            }
        }
    }
}
