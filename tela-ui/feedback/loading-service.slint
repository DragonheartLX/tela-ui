// Tela UI — TLoadingService
//
// Global fullscreen loading mask, the TMessage pattern.
// Deep code — or Rust — flips a blocking loading layer without any wiring:
//   TLoadingService.show("保存中…");
//   … await the work …
//   TLoadingService.hide();
// One `TLoadingServiceOverlay` near the window root renders it.
//
// The mask blocks pointer input while visible.
// It is deliberately not a TPopupStack layer — loading is a state, not
// something ESC dismisses.

import { TTheme } from "../theme.slint";
import { TLoading } from "../base/loading.slint";

export global TLoadingService {
    in-out property <bool> visible: false;
    out property <string> text: "加载中…";

    public function show(text: string) {
        self.text = text;
        self.visible = true;
    }

    public function hide() {
        self.visible = false;
    }
}

// Place one near the window root, after the main content.
// It sits above the modal tier so it also covers open dialogs.
export component TLoadingServiceOverlay inherits Rectangle {
    z: TTheme.z-message;
    background: TTheme.mask-active;
    // `visible` stays true so the fade is seen — binding it to the flag
    // would drop the subtree the instant it flips.
    // The TouchArea below is only enabled while visible, so the hidden mask
    // never eats input.
    opacity: TLoadingService.visible ? 1 : 0;
    animate opacity { duration: TTheme.duration-fast; }

    // Swallows clicks while the mask is up.
    // No wait cursor: 1.18 only re-pushes the OS cursor during pointer
    // event processing, so a busy cursor would linger after hide until the
    // mouse moves. The spinner and card already carry the loading signal.
    TouchArea {
        enabled <=> TLoadingService.visible;
    }

    // The spinner and label sit on an opaque card, the TDialog card look.
    // Bare on the mask, the secondary-gray label dissolved into the dimmed
    // page in light mode; the card gives both themes one high-contrast focal
    // object.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: loading.preferred-width + TTheme.margin-xl * 2;
        height: loading.preferred-height + TTheme.margin-xl * 2;
        border-radius: TTheme.radius-large;
        background: TTheme.bg-color-container;
        drop-shadow-blur: TTheme.shadow-3-blur;
        drop-shadow-offset-y: TTheme.shadow-3-offset-y;
        drop-shadow-color: TTheme.shadow-3-color;

        // TLoading's root is a HorizontalLayout; without locked width/height
        // the parent stretch would drag it to the card's full bounds, and
        // the spinner would render at the bottom of the stretched cell.
        // Locking both to preferred keeps it a compact box we can center.
        loading := TLoading {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            text: TLoadingService.text;
        }
    }
}
