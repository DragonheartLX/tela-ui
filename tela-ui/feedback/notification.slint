// Tela UI — Notification
//
// Stacked corner notifications. Any code (Slint or Rust) calls TNotification:
//   TNotification.info("标题", "内容");
//   TNotification.success(...) / warning(...) / error(...)
// then place ONE `TNotificationOverlay` near the top of the window. Up to 4
// notifications stack in a column (oldest drops off when full); each card
// auto-dismisses after 4.5 s and can be closed manually.

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";

export enum TNotificationTheme {
    info,
    success,
    warning,
    error,
}

// Which window corner the overlay pins the stack to.
export enum TNotificationPlacement {
    top-left,
    top-right,
    bottom-left,
    bottom-right,
}

export struct TNotificationData {
    title: string,
    content: string,
    theme: TNotificationTheme,
    // Slot occupancy: slots are pre-allocated, hidden ones are empty.
    visible: bool,
}

export global TNotification {
    // Fixed capacity in declaration order: index 0 is the oldest. Struct
    // fields are assigned in place (Slint models have no push/remove).
    in-out property <[TNotificationData]> items: [
        { title: "", content: "", theme: TNotificationTheme.info, visible: false },
        { title: "", content: "", theme: TNotificationTheme.info, visible: false },
        { title: "", content: "", theme: TNotificationTheme.info, visible: false },
        { title: "", content: "", theme: TNotificationTheme.info, visible: false },
    ];
    in-out property <TNotificationPlacement> placement: TNotificationPlacement.top-right;

    public function show(title: string, content: string, th: TNotificationTheme) {
        if (!items[0].visible) {
            items[0] = { title: title, content: content, theme: th, visible: true };
        } else if (!items[1].visible) {
            items[1] = { title: title, content: content, theme: th, visible: true };
        } else if (!items[2].visible) {
            items[2] = { title: title, content: content, theme: th, visible: true };
        } else {
            // Full: drop the oldest, shift the rest.
            items[0] = items[1];
            items[1] = items[2];
            items[2] = items[3];
            items[3] = { title: title, content: content, theme: th, visible: true };
        }
    }

    public function info(title: string, content: string) {
        root.show(title, content, TNotificationTheme.info);
    }

    public function success(title: string, content: string) {
        root.show(title, content, TNotificationTheme.success);
    }

    public function warning(title: string, content: string) {
        root.show(title, content, TNotificationTheme.warning);
    }

    public function error(title: string, content: string) {
        root.show(title, content, TNotificationTheme.error);
    }

    public function close(i: int) {
        items[i].visible = false;
    }

    public function clear() {
        items[0].visible = false;
        items[1].visible = false;
        items[2].visible = false;
        items[3].visible = false;
    }
}

export component TNotificationOverlay inherits Rectangle {
    // A passive full-window overlay: no TouchArea, so it never blocks input.
    private property <bool> to-left:
        TNotification.placement == TNotificationPlacement.top-left
        || TNotification.placement == TNotificationPlacement.bottom-left;
    private property <bool> to-bottom:
        TNotification.placement == TNotificationPlacement.bottom-left
        || TNotification.placement == TNotificationPlacement.bottom-right;

    column := VerticalLayout {
        width: 320px;
        x: root.to-left ? 24px : parent.width - self.width - 24px;
        y: root.to-bottom ? parent.height - self.preferred-height - 12px : 12px;
        // Slot spacing is baked into each wrapper's height so hidden slots
        // collapse to zero without leaving layout gaps behind.
        spacing: 0px;

        for it[i] in TNotification.items: Rectangle {
            private property <length> card-h: row.preferred-height + TTheme.padding-lr-m * 2;
            height: it.visible ? card-h + TTheme.spacing-5 : 0px;
            clip: true;

            card := Rectangle {
                y: 0;
                width: parent.width;
                height: max(0px, parent.height - TTheme.spacing-5);
                background: TTheme.bg-color-container;
                border-width: 1px;
                border-color: TTheme.component-stroke;
                border-radius: TTheme.radius-medium;
                drop-shadow-blur: TTheme.shadow-2-blur;
                drop-shadow-offset-y: TTheme.shadow-2-offset-y;
                drop-shadow-color: TTheme.shadow-2-color;
                clip: true;

                row := HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: TTheme.padding-lr-m;
                    spacing: TTheme.spacing-4;

                    TIcon {
                        y: (parent.height - self.height) / 2;
                        icon: it.theme == TNotificationTheme.success ? TIconSet.CircleCheck
                            : it.theme == TNotificationTheme.warning ? TIconSet.CircleAlert
                            : it.theme == TNotificationTheme.error ? TIconSet.CircleX
                            : TIconSet.Info;
                        size: 20px;
                        icon-color: it.theme == TNotificationTheme.success ? TTheme.success-color
                            : it.theme == TNotificationTheme.warning ? TTheme.warning-color
                            : it.theme == TNotificationTheme.error ? TTheme.error-color
                            : TTheme.brand-color;
                    }

                    VerticalLayout {
                        width: 228px;
                        spacing: TTheme.spacing-2;

                        Text {
                            text: it.title;
                            font-size: TTheme.font-size-m;
                            font-family: TTheme.font-family;
                            font-weight: TTheme.font-weight-medium;
                            color: TTheme.text-color-primary;
                            overflow: elide;
                        }

                        Text {
                            // Wraps to the fixed 228px column; the card
                            // height follows the wrapped line count.
                            text: it.content;
                            font-size: TTheme.font-size-s;
                            font-family: TTheme.font-family;
                            color: TTheme.text-color-secondary;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;

                        TIcon {
                            x: 1px;
                            y: 1px;
                            icon: TIconSet.X;
                            size: 14px;
                            icon-color: close-ta.has-hover ? TTheme.text-color-secondary : TTheme.text-color-placeholder;
                            animate icon-color { duration: TTheme.duration-fast; }
                        }
                        close-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                TNotification.close(i);
                            }
                        }
                    }
                }
            }

            // Per-slot auto-dismiss; the Timer remounts whenever the slot is
            // refilled, so the 4.5 s window restarts from the refill.
            timer := Timer {
                interval: 4.5s;
                running: it.visible;
                triggered => {
                    TNotification.close(i);
                }
            }
        }
    }
}
