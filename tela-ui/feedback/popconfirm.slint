// Tela UI — TPopconfirm
//
// Confirmation bubble anchored to a trigger. Same anchoring as TDropdownMenu:
// `auto-open` (default) layers a TouchArea over the trigger content and
// toggles on click — for non-interactive triggers; TButton triggers set
// `auto-open: false` and call `toggle()` from `clicked`. Fires `confirm` /
// `cancel` and closes on either button or on outside clicks.

import { TTheme,  TThemeRole,  TSize } from "../theme.slint";
import { TButton, TButtonVariant } from "../base/button.slint";
import { TPopupPlacement } from "../structs/enums.slint";
import { TPopupSurface } from "../popup-surface.slint";

export component TPopconfirm inherits Rectangle {
    in property <string> text;
    in property <string> confirm-text: "确定";
    in property <string> cancel-text: "取消";
    in property <TPopupPlacement> placement: TPopupPlacement.top-start;
    in property <bool> auto-open: true;

    callback confirm();
    callback cancel();

    out property <bool> open: surface.is-open;

    public function show() {
        surface.show();
    }

    public function close() {
        surface.close();
    }

    public function toggle() {
        surface.toggle();
    }

    // Trigger content hosted in a layout so the wrapper hugs it in parent
    // layouts (a bare child would not feed the preferred size).
    row := HorizontalLayout {
        @children
    }

    // Layered OVER the trigger content (declared after the row) so static
    // triggers click through to it; interactive triggers set
    // `auto-open: false`, which removes the area entirely.
    if root.auto-open: TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.toggle();
        }
    }

    surface := TPopupSurface {
        anchor-width: root.width;
        anchor-height: root.height;
        placement: root.placement;
        popup-min-width: 180px;

        VerticalLayout {
            padding: TTheme.padding-lr-l;
            padding-top: TTheme.padding-lr-m;
            padding-bottom: TTheme.padding-lr-m;
            spacing: TTheme.spacing-4;

            Text {
                text: root.text;
                font-size: TTheme.font-size-m;
                font-family: TTheme.font-family;
                color: TTheme.text-color-primary;
                wrap: word-wrap;
                width: min(self.preferred-width, 232px);
            }

            HorizontalLayout {
                spacing: TTheme.spacing-2;

                // Absorbs the leftover row space so the buttons stay
                // right-packed.
                Rectangle { }

                TButton {
                    size: TSize.small;
                    variant: TButtonVariant.outline;
                    text: root.cancel-text;
                    clicked => {
                        root.cancel();
                        surface.close();
                    }
                }

                TButton {
                    size: TSize.small;
                    theme: TThemeRole.primary;
                    text: root.confirm-text;
                    clicked => {
                        root.confirm();
                        surface.close();
                    }
                }
            }
        }
    }

    accessible-role: AccessibleRole.button;
}
