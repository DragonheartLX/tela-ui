// Tela UI — TDrawer
//
// Side panel over a dimmed backdrop.
// `placement` picks the edge the panel slides in from.
// Right and bottom are sized by width and height, left and top mirror them.
// The panel stays mounted and fades via animated opacity so the close
// animation is visible.
// Overlay clicks close it when `close-on-overlay` is set.
// Children form the body below the title.

import { TTheme } from "../theme.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconSet } from "../base/icon/data.slint";
import { TPopupStackLayer } from "../popup-stack.slint";

export enum TDrawerPlacement {
    top,
    right,
    bottom,
    left,
}

export component TDrawer inherits Rectangle {
    in-out property <bool> open: false;
    in property <string> title;
    in property <TDrawerPlacement> placement: TDrawerPlacement.right;
    // Width for left/right drawers, height for top/bottom drawers.
    in property <length> drawer-width: 320px;
    in property <length> drawer-height: 280px;
    in property <bool> close-on-overlay: true;

    callback closed();

    private property <bool> horizontal:
        root.placement == TDrawerPlacement.left || root.placement == TDrawerPlacement.right;

    // Fades instead of `visible: open`, which would drop the subtree the
    // instant `open` flips and leave no close animation to see.
    // `TInput` stays safe.
    // The backdrop TouchArea is only enabled while open.
    // The panel rests fully off-window when closed.
    opacity: root.open ? 1 : 0;
    z: TTheme.z-modal;
    animate opacity { duration: TTheme.duration-base; easing: ease-out; }
    background: TTheme.mask-active;

    public function close() {
        open = false;
        root.closed();
    }

    // Stack bookkeeping and ESC.
    // ESC closes the topmost open layer.
    TPopupStackLayer {
        active: root.open;
        close-requested => {
            root.close();
        }
    }

    TouchArea {
        enabled: root.open && root.close-on-overlay;
        clicked => {
            root.close();
        }
    }

    panel := Rectangle {
        width: root.horizontal ? min(root.drawer-width, parent.width - 48px) : parent.width;
        height: root.horizontal ? parent.height : min(root.drawer-height, parent.height - 48px);
        // Slide targets per edge, named so the x/y bindings stay flat.
        // Left and top rest just off-window, right and bottom just past it.
        property <length> left-x: root.open ? 0px : -self.width;
        property <length> right-x: root.open ? parent.width - self.width : parent.width;
        property <length> top-y: root.open ? 0px : -self.height;
        property <length> bottom-y: root.open ? parent.height - self.height : parent.height;
        x: !root.horizontal ? 0
            : root.placement == TDrawerPlacement.left ? self.left-x : self.right-x;
        y: root.horizontal ? 0
            : root.placement == TDrawerPlacement.top ? self.top-y : self.bottom-y;
        background: TTheme.bg-color-container;
        drop-shadow-blur: TTheme.shadow-3-blur;
        drop-shadow-offset-y: TTheme.shadow-3-offset-y;
        drop-shadow-color: TTheme.shadow-3-color;
        animate x { duration: TTheme.duration-base; easing: ease-out; }
        animate y { duration: TTheme.duration-base; easing: ease-out; }

        // Absorbs clicks on the panel body so they cannot reach the backdrop.
        // Declared before the layout: traversal is front-to-back and starts
        // at the last declared sibling, so the close button still gets its.
        // Disabled while closed — during the slide-out the panel still sweeps
        // across the window and would eat those clicks.
        TouchArea {
            enabled: root.open;
            width: parent.width;
            height: parent.height;
        }

        VerticalLayout {
            padding: TTheme.margin-l;
            spacing: TTheme.margin-m;

            HorizontalLayout {
                spacing: TTheme.margin-s;

                Text {
                    text: root.title;
                    font-size: TTheme.font-size-title-m;
                    font-weight: TTheme.font-weight-semibold;
                    color: TTheme.text-color-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 24px;
                    height: 24px;

                    TIcon {
                        x: 5px;
                        y: 5px;
                        icon: TIconSet.X;
                        size: 14px;
                        icon-color: close-ta.has-hover ? TTheme.text-color-primary : TTheme.text-color-secondary;
                        animate icon-color { duration: TTheme.duration-fast; }
                    }
                    close-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            @children
        }
    }
}
