// Tela UI — TImageViewer (TImageViewerService + TImageViewerOverlay)
//
// Global full-screen image preview, the TDialogService pattern.
// Any code — Slint or Rust — opens the viewer with one call:
//   TImageViewerService.open([url-a, url-b], 0);
// One `TImageViewerOverlay` near the window root renders it.
//
// Interaction:
//   * at 1x the image is fitted into the inset box and centred;
//   * drag sideways on the image to switch (edge resistance at both ends,
//     same gesture mechanics as TCarousel);
//   * wheel to zoom around the pointer, double-click toggles fit / 2x,
//     pan by dragging while zoomed — dragging switches again once back at fit;
//   * zoomed, the image may cover the whole window: the clip area is the
//     window, only the *fit* box is inset;
//   * the thumbnail strip jumps to any image;
//   * arrows, the close button, a click outside the image and ESC close.
//
// Every floating control sits on the TLoadingServiceOverlay card skin
// (`TViewerChip`): zoomed, the picture runs underneath them and white glyphs
// would dissolve into a white image.
//
// Navigation reporting: `change-seq` bumps on every index change.
// Watch it with a mirrored property:
//   private property <int> n: TImageViewerService.change-seq;
//   changed n => { … TImageViewerService.current-index … }
//
// Zoom is view state and stays local to the overlay: it resets whenever the
// shown image changes or the viewer closes.

import { TTheme } from "../theme.slint";
import { TText } from "../base/typography.slint";
import { TIcon } from "../base/icon/icon.slint";
import { TIconData, TIconSet } from "../base/icon/data.slint";
import { TModalSurface } from "../modal-surface.slint";

export global TImageViewerService {
    // Two-way so the overlay's `open` drives it.
    in-out property <bool> visible: false;
    out property <[image]> urls: [];
    out property <int> current-index: 0;
    // Bumped once per navigation (previous / next / go-to) that really moves
    // the index. `open()` reports the index it was given (clamped) without
    // bumping — a fresh open is not a navigation step.
    out property <int> change-seq: 0;

    // `index` is clamped, so a bad call cannot open the viewer empty.
    public function open(urls: [image], index: int) {
        self.urls = urls;
        self.current-index = root.clamp-index(index);
        self.visible = true;
    }

    public function close() {
        self.visible = false;
    }

    public function previous() {
        root.go-to(self.current-index - 1);
    }

    public function next() {
        root.go-to(self.current-index + 1);
    }

    // Same index (and a clamped one) reports nothing.
    public function go-to(index: int) {
        if (self.urls.length > 0) {
            let target = root.clamp-index(index);
            if (target != self.current-index) {
                self.current-index = target;
                self.change-seq += 1;
            }
        }
    }

    pure function clamp-index(index: int) -> int {
        return max(0, min(index, self.urls.length - 1));
    }
}

// Opaque card behind the floating controls, the TLoadingServiceOverlay card
// skin. Zoomed, the picture runs underneath the controls.
component TViewerChip inherits Rectangle {
    background: TTheme.bg-color-container;
    border-radius: TTheme.radius-large;
    drop-shadow-blur: TTheme.shadow-3-blur;
    drop-shadow-offset-y: TTheme.shadow-3-offset-y;
    drop-shadow-color: TTheme.shadow-3-color;

    @children
}

// Round icon button. `card: true` gives it the chip skin for standalone use
// (the arrows, the close button); inside a chip it stays bare so the card does
// not stack.
component TViewerButton inherits Rectangle {
    in property <TIconData> glyph;
    in property <string> label;
    // false dims the glyph and blocks the callback (ends of the image list,
    // zoom limits).
    in property <bool> active: true;
    // Pointer gate, separate from `active`: an inactive button still swallows
    // its clicks. Letting them through would reach the backdrop and dismiss
    // the viewer, which is not what "this control is unavailable" should do.
    in property <bool> enabled: true;
    in property <length> icon-size: 20px;
    in property <bool> card: true;

    callback go();

    width: TTheme.height-l;
    height: TTheme.height-l;
    border-radius: TTheme.radius-round;
    background: root.card ? TTheme.bg-color-container : transparent;
    drop-shadow-blur: root.card ? TTheme.shadow-3-blur : 0px;
    drop-shadow-offset-y: root.card ? TTheme.shadow-3-offset-y : 0px;
    drop-shadow-color: root.card ? TTheme.shadow-3-color : transparent;

    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.active;
    accessible-action-default => {
        if (root.active) {
            root.go();
        }
    }

    TIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.glyph;
        size: root.icon-size;
        icon-color: ta.has-hover && root.active ? TTheme.brand-color : TTheme.text-color-primary;
        animate icon-color { duration: TTheme.duration-fast; }
        opacity: root.active ? 1 : 0.4;
        animate opacity { duration: TTheme.duration-fast; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled && root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.active) {
                root.go();
            }
        }
    }
}

// Place one near the window root, after the main content.
// Registering with TPopupStack (inside TModalSurface) lets ESC close it.
export component TImageViewerOverlay inherits TModalSurface {
    open <=> TImageViewerService.visible;

    // Upper zoom bound; the lower bound is always "fitted to the viewport".
    in property <float> max-zoom: 4;
    in property <bool> thumbnails: true;

    private property <int> count: TImageViewerService.urls.length;
    // Spelled out rather than trusting `current-index` to be in range.
    private property <int> index: max(0, min(TImageViewerService.current-index, root.count - 1));
    // No image loaded: a null image is 0x0, which zeroes every fit box below.
    private property <image> none;
    private property <image> frame:
        root.count > 0 ? TImageViewerService.urls[root.index] : root.none;
    private property <bool> has-strip: root.thumbnails && root.count > 1;
    // The strip's Flickable consumes wheels whenever it has something to
    // scroll, and `interactive: false` does not gate the wheel path — so the
    // strip is dropped instead. It waits for the close fade to finish, or the
    // thumbnails would vanish while the rest is still fading.
    private property <bool> strip-visible: false;

    // ------------------------------------------------------------------
    // Layout metrics: toolbar row, fit box, thumbnail strip. The clip area is
    // the whole window; only the box an image is fitted into is inset.
    // ------------------------------------------------------------------
    private property <length> inset: TTheme.spacing-13;
    private property <length> bar: TTheme.height-l;
    private property <length> strip-h: TTheme.spacing-14;
    private property <length> strip-y: root.height - TTheme.spacing-6 - root.strip-h;
    private property <length> fit-x: root.inset;
    private property <length> fit-w: max(1px, root.width - root.inset * 2);
    private property <length> fit-y: TTheme.spacing-8 + root.bar;
    private property <length> fit-h: max(1px,
        (root.has-strip ? root.strip-y : root.height) - root.fit-y - TTheme.spacing-4);
    private property <length> fit-cx: root.inset + root.fit-w / 2;
    private property <length> fit-cy: root.fit-y + root.fit-h / 2;

    // ------------------------------------------------------------------
    // View state: slide mirror, live drag offset, zoom and pan.
    // ------------------------------------------------------------------
    // Animating the float mirror (not the track's x) keeps window resizes
    // instant — an `animate x` would replay the whole slide on every resize
    // (TCarousel's `slide-pos` trick).
    private property <float> slide-pos: root.index;
    animate slide-pos { duration: TTheme.duration-base; }
    // Live finger offset; released drags fold back to 0 with the same duration
    // so the track glides from wherever the finger left it.
    private property <length> drag-x: 0;
    private property <bool> dragging: false;
    // Any pointer movement during the press: separates a drag from a click.
    private property <bool> dragged: false;
    private property <float> zoom: 1;
    private property <length> pan-x: 0;
    private property <length> pan-y: 0;
    // Pan at press time; the live pan is recomputed from it, so drags never
    // compound.
    private property <length> start-pan-x: 0;
    private property <length> start-pan-y: 0;
    animate drag-x {
        duration: TTheme.duration-base;
        enabled: !root.dragging;
    }

    // Box of the current image at the current zoom. The slots recompute their
    // own fit; these copies drive the pan clamp and the click hit test.
    private property <float> frame-fit: min(
        root.fit-w / 1px / max(1, root.frame.width),
        root.fit-h / 1px / max(1, root.frame.height));
    private property <length> frame-w: root.frame.width * root.frame-fit * root.zoom * 1px;
    private property <length> frame-h: root.frame.height * root.frame-fit * root.zoom * 1px;

    // A new image always starts fitted — and so does a fresh open: reopening
    // at the same index does not fire `changed index`, so the view state is
    // reset here as well.
    changed index => {
        root.reset-view();
    }

    changed open => {
        if (root.open) {
            root.strip-visible = true;
        }
        root.reset-view();
    }

    function reset-view() {
        root.zoom = 1;
        root.pan-x = 0;
        root.pan-y = 0;
        root.drag-x = 0;
    }

    // A zoomed frame may travel until its edges reach the window edges; a
    // frame smaller than the window stays centred on the fit box.
    pure function clamp-pan(value: length, frame: length, window: length, centre: length) -> length {
        let half = frame / 2;
        let low = window - centre - half;
        let high = half - centre;
        return low > high ? 0px : max(low, min(high, value));
    }

    // `anchor-x`/`anchor-y` are the zoom centre in window coordinates: the
    // point under the pointer stays put.
    function zoom-to(target: float, anchor-x: length, anchor-y: length) {
        let z = max(1, min(root.max-zoom, target));
        if (z != root.zoom) {
            let k = z / root.zoom;
            root.zoom = z;
            root.pan-x = root.clamp-pan((root.pan-x - anchor-x) * k + anchor-x, root.frame-w, root.width, root.fit-cx);
            root.pan-y = root.clamp-pan((root.pan-y - anchor-y) * k + anchor-y, root.frame-h, root.height, root.fit-cy);
        }
    }

    // Pointer coordinates are relative to the gesture layer, which covers the
    // window.
    pure function inside-frame(x: length, y: length) -> bool {
        let left = root.fit-x + (root.fit-w - root.frame-w) / 2 + root.pan-x;
        let top = root.fit-y + (root.fit-h - root.frame-h) / 2 + root.pan-y;
        return x >= left && x <= left + root.frame-w && y >= top && y <= top + root.frame-h;
    }

    accessible-role: AccessibleRole.groupbox;
    accessible-label: "图片预览";

    // ------------------------------------------------------------------
    // Image layer: a track of window-sized slots over the whole window, so a
    // zoomed picture is clipped by the window and nothing else.
    // ------------------------------------------------------------------
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        Rectangle {
            x: -root.slide-pos * parent.width + root.drag-x;
            y: 0;
            width: parent.width;
            height: parent.height;

            for u[j] in TImageViewerService.urls: Rectangle {
                x: j * root.width;
                y: 0;
                width: root.width;
                height: root.height;
                // While zoomed the neighbours stay out of the way (a pan can
                // be wider than the window, which would drag them in).
                visible: root.zoom <= 1 || j == root.index;

                private property <float> fit: min(
                    root.fit-w / 1px / max(1, u.width),
                    root.fit-h / 1px / max(1, u.height));
                private property <float> slot-zoom: j == root.index ? root.zoom : 1;
                private property <length> img-w: u.width * fit * slot-zoom * 1px;
                private property <length> img-h: u.height * fit * slot-zoom * 1px;

                Image {
                    x: root.fit-x + (root.fit-w - img-w) / 2 + (j == root.index ? root.pan-x : 0px);
                    y: root.fit-y + (root.fit-h - img-h) / 2 + (j == root.index ? root.pan-y : 0px);
                    width: img-w;
                    height: img-h;
                    source: u;
                    image-fit: fill;
                }
            }
        }

        // Gesture layer: covers the window, so everything that is not the
        // picture itself is a click-to-close surface (see `inside-frame`).
        // Declared after the track, on top of it.
        gesture := TouchArea {
            // Gated: the overlay stays mounted while closed, and an ungated
            // layer would eat every click in the window.
            enabled: root.open;
            // `pressed-x/y` are the press origin, so no manual bookkeeping is
            // needed for the drag deltas.
            moved => {
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                if (Math.abs(dx) > 3px || Math.abs(dy) > 3px) {
                    root.dragged = true;
                }
                if (root.zoom > 1) {
                    root.pan-x = root.clamp-pan(root.start-pan-x + dx, root.frame-w, root.width, root.fit-cx);
                    root.pan-y = root.clamp-pan(root.start-pan-y + dy, root.frame-h, root.height, root.fit-cy);
                } else {
                    // Beyond the first/last image only a third of the movement
                    // applies, recomputed from the press point each move.
                    root.drag-x = (root.index == 0 && dx > 0)
                        || (root.index == root.count - 1 && dx < 0)
                        ? dx / 3 : dx;
                }
            }

            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.dragging = true;
                    root.dragged = false;
                    root.start-pan-x = root.pan-x;
                    root.start-pan-y = root.pan-y;
                } else if (ev.kind == PointerEventKind.cancel) {
                    root.dragging = false;
                    root.drag-x = 0;
                } else if (ev.kind == PointerEventKind.up) {
                    root.dragging = false;
                    if (root.zoom <= 1) {
                        // Switch only when the drag passed the threshold;
                        // otherwise glide back to the image it started from.
                        let step = root.drag-x != 0px
                            && Math.abs(root.drag-x) >= Math.min(80px, root.fit-w / 3)
                            ? (root.drag-x < 0 ? 1 : -1) : 0;
                        if (step > 0) {
                            TImageViewerService.next();
                        } else if (step < 0) {
                            TImageViewerService.previous();
                        }
                        root.drag-x = 0;
                    }
                    // A click — no movement — outside the image closes.
                    if (!root.dragged
                        && !root.inside-frame(self.mouse-x, self.mouse-y)) {
                        root.close();
                    }
                }
            }

            // Wheel zoom, anchored at the pointer. Wheel down zooms in.
            scroll-event(ev) => {
                if (ev.delta-y != 0) {
                    let anchor-x = self.mouse-x - root.fit-cx;
                    let anchor-y = self.mouse-y - root.fit-cy;
                    root.zoom-to(root.zoom * (ev.delta-y > 0 ? 1.25 : 0.8), anchor-x, anchor-y);
                    return accept;
                }
                reject
            }

            // Fit / 2x toggle.
            double-clicked => {
                if (!root.dragged) {
                    root.zoom-to(root.zoom > 1 ? 1 : Math.min(2, root.max-zoom), 0px, 0px);
                }
            }
        }
    }

    if root.count > 1: TViewerButton {
        x: TTheme.spacing-4;
        y: root.fit-y + (root.fit-h - self.height) / 2;
        glyph: TIconSet.ChevronLeft;
        label: "上一张";
        enabled: root.open;
        active: root.index > 0 && root.open;
        go => { TImageViewerService.previous(); }
    }

    if root.count > 1: TViewerButton {
        x: root.width - root.inset - self.width - TTheme.spacing-4;
        y: root.fit-y + (root.fit-h - self.height) / 2;
        glyph: TIconSet.ChevronRight;
        label: "下一张";
        enabled: root.open;
        active: root.index < root.count - 1 && root.open;
        go => { TImageViewerService.next(); }
    }

    // ------------------------------------------------------------------
    // Toolbar chips: counter (left), zoom cluster and close (right). Each chip
    // has a computable width, so every x comes from known boxes — a
    // content-sized container positioned by its own width mispaints its
    // `Text` children (docs/slint-semantics.md 第 22 条).
    // ------------------------------------------------------------------
    private property <length> btn: TTheme.height-l;
    private property <length> gap: TTheme.spacing-2;
    private property <length> chip-pad: TTheme.spacing-2;
    private property <length> close-chip-w: root.btn + root.chip-pad * 2;
    private property <length> zoom-chip-w:
        root.chip-pad * 2 + root.btn * 3 + root.zoom-pct-w + root.gap * 3;
    private property <length> zoom-pct-w: TTheme.spacing-13;
    private property <string> zoom-text: Math.round(root.zoom * 100) + "%";

    TViewerChip {
        x: root.inset;
        y: TTheme.spacing-4;
        width: root.zoom-pct-w + root.chip-pad * 2;
        height: root.bar;

        TText {
            x: root.chip-pad;
            y: (parent.height - self.height) / 2;
            width: root.zoom-pct-w;
            text: (root.index + 1) + " / " + root.count;
            font-size: TTheme.font-size-m;
            color: TTheme.text-color-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            // Read out as the user steps through the list.
            accessible-live-region: AccessibleLiveness.polite;
        }
    }

    TViewerChip {
        // zoom cluster: 缩小 · 百分比 · 放大 · 适应窗口
        x: root.width - root.inset - root.close-chip-w - root.gap - root.zoom-chip-w;
        y: TTheme.spacing-4;
        width: root.zoom-chip-w;
        height: root.bar;

        HorizontalLayout {
            x: root.chip-pad;
            y: (parent.height - root.btn) / 2;
            width: parent.width - root.chip-pad * 2;
            height: root.btn;
            spacing: root.gap;

            TViewerButton {
                icon-size: 16px;
                glyph: TIconSet.Minus;
                label: "缩小";
                card: false;
                enabled: root.open;
                active: root.open && root.zoom > 1;
                go => { root.zoom-to(root.zoom * 0.8, 0px, 0px); }
            }

            TText {
                y: (parent.height - self.height) / 2;
                width: root.zoom-pct-w;
                text: root.zoom-text;
                font-size: TTheme.font-size-s;
                line-height: TTheme.line-height-s;
                color: TTheme.text-color-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-live-region: AccessibleLiveness.polite;
            }

            TViewerButton {
                icon-size: 16px;
                glyph: TIconSet.Plus;
                label: "放大";
                card: false;
                enabled: root.open;
                active: root.open && root.zoom < root.max-zoom;
                go => { root.zoom-to(root.zoom * 1.25, 0px, 0px); }
            }

            TViewerButton {
                icon-size: 16px;
                glyph: TIconSet.RefreshCw;
                label: "适应窗口";
                card: false;
                enabled: root.open;
                active: root.open && root.zoom > 1;
                go => { root.zoom-to(1, 0px, 0px); }
            }
        }
    }

    TViewerChip {
        x: root.width - root.inset - root.close-chip-w;
        y: TTheme.spacing-4;
        width: root.close-chip-w;
        height: root.bar;

        TViewerButton {
            x: root.chip-pad;
            y: root.chip-pad;
            icon-size: 16px;
            glyph: TIconSet.X;
            label: "关闭";
            card: false;
            enabled: root.open;
            active: root.open;
            go => { root.close(); }
        }
    }

    // ------------------------------------------------------------------
    // Thumbnail strip: a flickable row of covers on its own chip, the current
    // one outlined.
    // ------------------------------------------------------------------
    private property <length> thumb-w: 72px;
    private property <length> thumb-h: 48px;
    private property <length> thumb-gap: TTheme.spacing-4;
    private property <length> strip-w:
        root.count * (root.thumb-w + root.thumb-gap) - root.thumb-gap;

    // Drops the thumbnail strip once the close fade is over; the
    // `strip-visible` term makes it one-shot (a declarative Timer repeats).
    Timer {
        running: !root.open && root.strip-visible;
        interval: TTheme.duration-base;
        triggered => {
            root.strip-visible = false;
        }
    }

    if root.has-strip: TViewerChip {
        x: root.inset;
        y: root.strip-y;
        width: root.fit-w;
        height: root.strip-h;

        Flickable {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            visible: root.strip-visible;
            // Same gate as the gesture layer: a closed viewer forwards
            // drags and clicks; the wheel path is gated by `visible`.
            interactive: root.open;

            HorizontalLayout {
                // Centred while the strip fits the window; from the left edge
                // once it overflows, where the flickable takes over.
                x: root.strip-w < root.fit-w ? (root.fit-w - root.strip-w) / 2 : 0px;
                y: (root.strip-h - root.thumb-h) / 2;
                width: root.strip-w;
                height: root.thumb-h;
                spacing: root.thumb-gap;

                for u[j] in TImageViewerService.urls: Rectangle {
                    width: root.thumb-w;
                    height: root.thumb-h;
                    border-radius: TTheme.radius-medium;
                    border-width: j == root.index ? 2px : 0px;
                    border-color: TTheme.brand-color;
                    opacity: j == root.index || thumb-ta.has-hover ? 1 : 0.6;
                    clip: true;
                    animate opacity { duration: TTheme.duration-fast; }

                    accessible-role: AccessibleRole.button;
                    accessible-label: "第 " + (j + 1) + " 张";
                    accessible-enabled: j != root.index;
                    accessible-action-default => {
                        if (j != root.index) {
                            TImageViewerService.go-to(j);
                        }
                    }

                    Image {
                        width: 100%;
                        height: 100%;
                        source: u;
                        image-fit: cover;
                    }

                    thumb-ta := TouchArea {
                        enabled: root.open;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            TImageViewerService.go-to(j);
                        }
                    }
                }
            }
        }
    }
}
