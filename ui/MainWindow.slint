// Tela UI component gallery — showcases the whole tela-ui library.
// The gallery itself runs on TBorderlessWindow: its branded title bar
// (logo + title at the top-left, min/max/close at the right) owns the top
// edge; the collapsible TSideNav below switches pages and carries the
// dark-mode toggle at its bottom edge.

import { TTheme } from "@tela-ui/theme.slint";
import { Palette } from "std-widgets.slint";
import { TBorderlessWindow, TIconSet, TParagraph, TButton, TButtonVariant } from "@tela-ui/base.slint";
import { TTooltipOverlay, TDialog, TDialogService, TDialogServiceOverlay, TDrawer, TDrawerPlacement, TBottomSheet, TActionSheetOverlay, TActionSheetService, TImageViewerOverlay, TImageViewerService, TCommandPaletteOverlay, TCommandPaletteService, TLoadingService, TLoadingServiceOverlay } from "@tela-ui/overlay.slint";
import { TMessageOverlay, TMessage, TNotificationOverlay } from "@tela-ui/notice.slint";
import { TSideNav, TSideNavItem, TSideNavTogglePosition, TBackTop } from "@tela-ui/navigation.slint";
import { TScrollBar } from "@tela-ui/scroll-bar.slint";

import { BasicsSection } from "pages/basics.slint";
import { InputSection } from "pages/input-section.slint";
import { SelectSection } from "pages/select-section.slint";
import { DateTimeSection } from "pages/date-time-section.slint";
import { DisplaySection } from "pages/display-section.slint";
import { ContentSection } from "pages/content-section.slint";
import { NoticeSection } from "pages/notice-section.slint";
import { OverlaySection } from "pages/overlay-section.slint";
import { NavigationSection } from "pages/navigation.slint";
import { ExperimentalSection } from "pages/experimental.slint";
import { SettingsSection } from "pages/settings.slint";

export component MainWindow inherits TBorderlessWindow {
    title: "Tela UI";
    // OS-level window icon (taskbar etc.): the exported LayoutDashboard logo.
    icon: @image-url("assets/logo.svg");
    logo: TIconSet.LayoutDashboard;
    preferred-width: 1200px;
    preferred-height: 800px;
    // Below this the page content overflows and the ScrollView grows a
    // horizontal scrollbar.
    min-width: 960px;
    min-height: 600px;
    window-background: TTheme.bg-color-page;
    // 4px native resize strip: the page scrollbar sits flush at the right
    // edge and would otherwise fight the drag-resize hit zone (default 8px).
    resize-border: 4px;

    // ------------------------------------------------------------------
    // Gallery state
    // ------------------------------------------------------------------
    in property <[TSideNavItem]> group-items: [
        { label: "基础组件", value: "basics", icon: TIconSet.LayoutDashboard },
        { label: "输入", value: "input", icon: TIconSet.Pencil },
        { label: "选择", value: "select", icon: TIconSet.Check },
        { label: "日期时间", value: "date-time", icon: TIconSet.Calendar },
        { label: "展示", value: "display", icon: TIconSet.Image },
        { label: "内容", value: "content", icon: TIconSet.Inbox },
        { label: "提示", value: "notice", icon: TIconSet.Bell },
        { label: "浮层", value: "overlay", icon: TIconSet.Copy },
        { label: "导航", value: "navigation", icon: TIconSet.Menu },
        { label: "实验性", value: "experimental", icon: TIconSet.FlaskConical },
    ];
    in-out property <string> group-value: "basics";
    // Current page scroll offset, exposed read-only for hosts and probes
    // (element ids are not part of the compiled API).
    out property <length> page-scroll-y: page-scroll.content-y;
    // Per-page scroll memory: switching pages stores the outgoing offset and
    // restores the incoming one, so every page keeps its own position.
    // Index order matches group-items plus settings (11 entries).
    in-out property <[length]> page-y: [0px, 0px, 0px, 0px, 0px, 0px, 0px, 0px, 0px, 0px, 0px];
    private property <string> last-page: "basics";

    pure function page-index(name: string) -> int {
        name == "input" ? 1
        : name == "select" ? 2
        : name == "date-time" ? 3
        : name == "display" ? 4
        : name == "content" ? 5
        : name == "notice" ? 6
        : name == "overlay" ? 7
        : name == "navigation" ? 8
        : name == "experimental" ? 9
        : name == "settings" ? 10
        : 0;
    }

    // Per-page scroll memory: a 100ms cadence timer snapshots the live
    // offset into page-y[current], suspended while a switch is settling.
    // Saving at the switch moment is unreliable: the if-flip's collapse
    // can clamp content-y BEFORE the deferred changed callback runs (the
    // display page's unmount pulled -1200 to -1047 mid-trajectory and
    // the handler then saved the clamped value — real-app diag log), so
    // the saved value must predate the click entirely.
    save-timer := Timer {
        interval: 100ms;
        running: true;

        triggered => {
            if (!root.restore-armed) {
                root.page-y[root.page-index(root.last-page)] = page-scroll.content-y;
            }
        }
    }

    changed group-value => {
        page-scroll.content-y = root.page-y[root.page-index(root.group-value)];
        // The if-flip collapses the viewport content for a few layout
        // rounds; the Flickable's in-bound clamp eats the restored offset
        // written above (slint-semantics #39). Heavy pages materialize
        // slower than any fixed re-assert window (real-app probe: with a
        // UIA client attached, the content page came back at 0), so the
        // timer asserts the offset until the layout has stopped churning
        // and the value is observed in place (see restore-timer).
        root.restore-target = root.page-y[root.page-index(root.group-value)];
        root.restore-count = 0;
        root.restore-writes = 0;
        root.restore-sticks = 0;
        root.restore-armed = true;
        root.last-page = root.group-value;
    }

    // 32ms ticks. The page's content-height churns non-monotonically
    // while it materializes (the display page grows, then shrinks as
    // images settle — a late in-bound clamp pulled a restored offset up
    // and an early 2-tick "stable" verdict ratified the wrong value), so
    // any height change resets the stability count. Disarm after 8
    // stable ticks (~256ms), >8 unanswered corrective writes (a user
    // wheeling the fresh page) — stability refunds the budget — or the
    // ~1.3s lifetime cap.
    restore-timer := Timer {
        interval: 32ms;
        running: root.restore-armed;

        triggered => {
            if (page-scroll.content-height != root.restore-height) {
                root.restore-height = page-scroll.content-height;
                root.restore-sticks = 0;
            }
            if (-root.restore-target + page-scroll.height <= page-scroll.content-height) {
                if (page-scroll.content-y != root.restore-target) {
                    page-scroll.content-y = root.restore-target;
                    root.restore-writes += 1;
                } else {
                    root.restore-sticks += 1;
                    root.restore-writes = 0;
                }
            }
            if (root.restore-sticks >= 8 || root.restore-writes > 8
                || root.restore-count >= 40) {
                root.restore-armed = false;
                root.restore-count = 0;
                root.restore-writes = 0;
                root.restore-sticks = 0;
            } else {
                root.restore-count += 1;
            }
        }
    }
    private property <bool> restore-armed: false;
    private property <length> restore-target: 0px;
    private property <length> restore-height: 0px;
    private property <int> restore-count: 0;
    private property <int> restore-writes: 0;
    private property <int> restore-sticks: 0;
    in-out property <bool> dialog-open: false;
    in-out property <bool> drawer-open: false;
    in-out property <bool> sheet-open: false;
    in-out property <TDrawerPlacement> drawer-placement: TDrawerPlacement.right;

    VerticalLayout {
        HorizontalLayout {
            // Left: collapsible page navigation. The footer stacks the
            // dark-mode switch above the settings entry, with TDesign's fold
            // button at the very bottom; the switch's label names the mode
            // clicking moves to (moon → dark, sun → light).
            TSideNav {
                toggle-position: TSideNavTogglePosition.bottom;
                footer-items: [
                    {
                        icon: TTheme.is-dark ? TIconSet.Sun : TIconSet.Moon,
                        label: TTheme.is-dark ? "浅色模式" : "深色模式",
                    },
                    { icon: TIconSet.Settings, label: "设置", value: "settings" },
                ];
                footer-clicked(item) => {
                    Palette.color-scheme = TTheme.is-dark
                        ? ColorScheme.light
                        : ColorScheme.dark;
                }
                items: root.group-items;
                current-value <=> root.group-value;
            }

            // Content -----------------------------------------------------
            Rectangle {
                vertical-stretch: 1;

                page-scroll := TScrollBar {
                    // Thumb inset clears the 4px native resize strip.
                    thumb-inset: TTheme.spacing-2;

                    VerticalLayout {
                        // Top is 16px, tighter than the 32px page gutters —
                        // the window header already separates the content.
                        padding-top: 16px;
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-bottom: 32px;
                        spacing: 28px;

                        if root.group-value == "basics": BasicsSection { vertical-stretch: 0; }
                        if root.group-value == "input": InputSection { vertical-stretch: 0; }
                        if root.group-value == "select": SelectSection { vertical-stretch: 0; }
                        if root.group-value == "date-time": DateTimeSection { vertical-stretch: 0; }
                        if root.group-value == "display": DisplaySection { vertical-stretch: 0; }
                        if root.group-value == "content": ContentSection { vertical-stretch: 0; }
                        if root.group-value == "notice": NoticeSection { vertical-stretch: 0; }
                        if root.group-value == "overlay": OverlaySection {
                            vertical-stretch: 0;
                            dialog-open <=> root.dialog-open;
                            drawer-open <=> root.drawer-open;
                            sheet-open <=> root.sheet-open;
                            drawer-placement <=> root.drawer-placement;
                        }
                        if root.group-value == "navigation": NavigationSection { vertical-stretch: 0; }
                        if root.group-value == "experimental": ExperimentalSection { vertical-stretch: 0; }
                        if root.group-value == "settings": SettingsSection { vertical-stretch: 0; }

                        // Spacer: keep sections at their natural height when the
                        // viewport is taller than the content.
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Page-level back-to-top: appears once the gallery page is
                // scrolled past the threshold.
                TBackTop {
                    x: parent.width - self.width - 24px;
                    y: parent.height - self.height - 24px;
                    content-y <=> page-scroll.content-y;
                }
            }
        }
    }

    TDialog {
        open <=> root.dialog-open;
        title: "对话框标题";
        content: "这是 Tela UI 的对话框组件,用于确认操作或展示重要信息。点击遮罩层可关闭。";
        accepted => { TMessage.success("已确认操作"); }
        canceled => { TMessage.info("已取消操作"); }
    }

    TDrawer {
        open <=> root.drawer-open;
        placement <=> root.drawer-placement;
        title: "抽屉标题";

        TParagraph { text: "这是 Tela UI 的抽屉组件,从窗口边缘滑出,适合放置表单、详情等较大面积的临时内容。"; }
        TButton {
            variant: TButtonVariant.outline;
            text: "关闭抽屉";
            clicked => { root.drawer-open = false; }
        }
    }

    TBottomSheet {
        open <=> root.sheet-open;
        title: "底部弹层标题";

        TParagraph { text: "TBottomSheet 从窗口底边滑出,高度随内容,由 TModalSurface 提供遮罩、ESC 与点击遮罩关闭。"; }
        TButton {
            variant: TButtonVariant.outline;
            text: "关闭弹层";
            clicked => { root.sheet-open = false; }
        }
    }

    TActionSheetOverlay { }

    TImageViewerOverlay { }

    TCommandPaletteOverlay { }

    TDialogServiceOverlay { }

    TLoadingServiceOverlay { }

    TMessageOverlay { }

    TNotificationOverlay { }

    TTooltipOverlay { }
}

// Re-export the theme surface so hosts can control it from Rust:
//   Palette::get(ui).set_color_scheme(ColorScheme::Dark);
//   TTheme::get(ui) — is-dark reads and the token presets.
// TLoadingService rides along so Rust can show/hide the fullscreen loading.
// The P5 services ride along too: every global-driven overlay is drivable
// from Rust only when the global is exported from the main .slint.
export { TTheme, TLoadingService, TDialogService, TActionSheetService, TImageViewerService, TCommandPaletteService }
export { Palette } from "std-widgets.slint";
