// Tela UI component gallery — showcases the whole tela-ui library.
// The gallery itself runs on TBorderlessWindow: its branded title bar
// (logo + title at the top-left, min/max/close at the right) owns the top
// edge; the collapsible TSideNav below switches pages and carries the
// dark-mode toggle at its bottom edge.

import { TTheme,  TThemePreference } from "@tela-ui/theme.slint";
import { TBorderlessWindow, TIconSet, TParagraph, TButton, TButtonVariant } from "@tela-ui/base.slint";
import { TTooltipOverlay } from "@tela-ui/data-display.slint";
import { TDialog, TDialogService, TDialogServiceOverlay, TDrawer, TDrawerPlacement, TBottomSheet, TActionSheetOverlay, TActionSheetService, TImageViewerOverlay, TImageViewerService, TCommandPaletteOverlay, TCommandPaletteService, TMessageOverlay, TMessage, TNotificationOverlay, TLoadingService, TLoadingServiceOverlay } from "@tela-ui/feedback.slint";
import { TSideNav, TSideNavItem, TSideNavTogglePosition, TBackTop } from "@tela-ui/navigation.slint";
import { ScrollView } from "std-widgets.slint";

import { BasicsSection } from "pages/basics.slint";
import { DataDisplaySection } from "pages/data-display.slint";
import { FormSection } from "pages/form-section.slint";
import { FeedbackSection } from "pages/feedback.slint";
import { NavigationSection } from "pages/navigation.slint";
import { ExperimentalSection } from "pages/experimental.slint";
import { SettingsSection } from "pages/settings.slint";

export component MainWindow inherits TBorderlessWindow {
    title: "Tela UI";
    // OS-level window icon (taskbar etc.): the exported LayoutDashboard logo.
    icon: @image-url("assets/logo.svg");
    logo: TIconSet.LayoutDashboard;
    preferred-width: 1200px;
    preferred-height: 800px;
    // Below this the page content overflows and the ScrollView grows a
    // horizontal scrollbar.
    min-width: 960px;
    min-height: 600px;
    window-background: TTheme.bg-color-page;

    // ------------------------------------------------------------------
    // Gallery state
    // ------------------------------------------------------------------
    in property <[TSideNavItem]> group-items: [
        { label: "基础组件", value: "basics", icon: TIconSet.LayoutDashboard },
        { label: "数据展示", value: "display", icon: TIconSet.Image },
        { label: "数据录入", value: "form", icon: TIconSet.Pencil },
        { label: "反馈", value: "feedback", icon: TIconSet.Bell },
        { label: "导航", value: "navigation", icon: TIconSet.Menu },
        { label: "实验性", value: "experimental", icon: TIconSet.FlaskConical },
    ];
    in-out property <string> group-value: "basics";
    in-out property <bool> dialog-open: false;
    in-out property <bool> drawer-open: false;
    in-out property <bool> sheet-open: false;
    in-out property <TDrawerPlacement> drawer-placement: TDrawerPlacement.right;

    VerticalLayout {
        HorizontalLayout {
            // Left: collapsible page navigation. The footer stacks the
            // dark-mode switch above the settings entry, with TDesign's fold
            // button at the very bottom; the switch's label names the mode
            // clicking moves to (moon → dark, sun → light).
            TSideNav {
                toggle-position: TSideNavTogglePosition.bottom;
                footer-items: [
                    {
                        icon: TTheme.is-dark ? TIconSet.Sun : TIconSet.Moon,
                        label: TTheme.is-dark ? "浅色模式" : "深色模式",
                    },
                    { icon: TIconSet.Settings, label: "设置", value: "settings" },
                ];
                footer-clicked(item) => {
                    TTheme.preference = TTheme.is-dark
                        ? TThemePreference.light
                        : TThemePreference.dark;
                }
                items: root.group-items;
                current-value <=> root.group-value;
            }

            // Content -----------------------------------------------------
            Rectangle {
                vertical-stretch: 1;

                page-scroll := ScrollView {
                    VerticalLayout {
                        // Top is 16px, tighter than the 32px page gutters —
                        // the window header already separates the content.
                        padding-top: 16px;
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-bottom: 32px;
                        spacing: 28px;

                        if root.group-value == "basics": BasicsSection { vertical-stretch: 0; }
                        if root.group-value == "display": DataDisplaySection { vertical-stretch: 0; }
                        if root.group-value == "form": FormSection { vertical-stretch: 0; }
                        if root.group-value == "feedback": FeedbackSection {
                            vertical-stretch: 0;
                            dialog-open <=> root.dialog-open;
                            drawer-open <=> root.drawer-open;
                            sheet-open <=> root.sheet-open;
                            drawer-placement <=> root.drawer-placement;
                        }
                        if root.group-value == "navigation": NavigationSection { vertical-stretch: 0; }
                        if root.group-value == "experimental": ExperimentalSection { vertical-stretch: 0; }
                        if root.group-value == "settings": SettingsSection { vertical-stretch: 0; }

                        // Spacer: keep sections at their natural height when the
                        // viewport is taller than the content.
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Page-level back-to-top: appears once the gallery page is
                // scrolled past the threshold.
                TBackTop {
                    x: parent.width - self.width - 24px;
                    y: parent.height - self.height - 24px;
                    content-y <=> page-scroll.content-y;
                }
            }
        }
    }

    TDialog {
        open <=> root.dialog-open;
        title: "对话框标题";
        content: "这是 Tela UI 的对话框组件,用于确认操作或展示重要信息。点击遮罩层可关闭。";
        accepted => { TMessage.success("已确认操作"); }
        canceled => { TMessage.info("已取消操作"); }
    }

    TDrawer {
        open <=> root.drawer-open;
        placement <=> root.drawer-placement;
        title: "抽屉标题";

        TParagraph { text: "这是 Tela UI 的抽屉组件,从窗口边缘滑出,适合放置表单、详情等较大面积的临时内容。"; }
        TButton {
            variant: TButtonVariant.outline;
            text: "关闭抽屉";
            clicked => { root.drawer-open = false; }
        }
    }

    TBottomSheet {
        open <=> root.sheet-open;
        title: "底部弹层标题";

        TParagraph { text: "TBottomSheet 从窗口底边滑出,高度随内容,由 TModalSurface 提供遮罩、ESC 与点击遮罩关闭。"; }
        TButton {
            variant: TButtonVariant.outline;
            text: "关闭弹层";
            clicked => { root.sheet-open = false; }
        }
    }

    TActionSheetOverlay { }

    TImageViewerOverlay { }

    TCommandPaletteOverlay { }

    TDialogServiceOverlay { }

    TLoadingServiceOverlay { }

    TMessageOverlay { }

    TNotificationOverlay { }

    TTooltipOverlay { }
}

// Re-export the theme global so hosts can control it from Rust:
//   TTheme::get(ui).set_preference(TThemePreference::Dark);
// TLoadingService rides along so Rust can show/hide the fullscreen loading.
// The P5 services ride along too: every global-driven overlay is drivable
// from Rust only when the global is exported from the main .slint.
export { TTheme, TThemePreference, TLoadingService, TDialogService, TActionSheetService, TImageViewerService, TCommandPaletteService }
