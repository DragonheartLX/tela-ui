// Demo section: 数据展示 (Tag/Badge/Avatar/Loading / Divider / Progress).

import { TelaTheme } from "@tela-ui/theme.slint";
import { Icon, TIconSet, Divider, Tag, Loading } from "@tela-ui/base.slint";
import { Badge, Avatar, Card, Progress, Slider } from "@tela-ui/common.slint";
import { CodeBlock } from "code-block.slint";

export component DataDisplaySection inherits VerticalLayout {
    spacing: 28px;

    // Own state: the slider drives both progress variants.
    in-out property <float> progress-value: 40;

    // ============= Tag / Badge / Avatar / Loading =========
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "标签、徽标、头像与加载";

            VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 8px;
                    Tag { text: "默认"; }
                    Tag { theme: 1; text: "主要"; }
                    Tag { theme: 2; text: "成功"; }
                    Tag { theme: 3; text: "警告"; }
                    Tag { theme: 4; text: "危险"; }
                    Tag { theme: 1; variant: 0; text: "深色"; }
                    Tag { theme: 1; variant: 2; text: "描边"; }
                    Tag { theme: 1; text: "可关闭"; closable: true; }
                    Tag { theme: 1; size: 0; text: "小"; }
                    Tag { theme: 1; size: 2; text: "大"; }
                }

                HorizontalLayout {
                    spacing: 28px;

                    Badge {
                        count: 6;
                        Icon { icon: TIconSet.Bell; size: 24px; icon-color: TelaTheme.text-color-primary; }
                    }
                    Badge {
                        count: 128;
                        Icon { icon: TIconSet.Mail; size: 24px; icon-color: TelaTheme.text-color-primary; }
                    }
                    Badge {
                        dot: true;
                        Icon { icon: TIconSet.Settings; size: 24px; icon-color: TelaTheme.text-color-primary; }
                    }

                    Divider { orientation: Orientation.vertical; }

                    Avatar { text: "T"; }
                    Avatar { size: 0; text: "TD"; }
                    Avatar { size: 2; text: "龙"; }
                    Avatar { size: 3; shape: 1; text: ""; }
                }

                HorizontalLayout {
                    spacing: 28px;
                    Loading { size: 16px; }
                    Loading { size: 24px; text: "加载中…"; }
                    Loading { size: 32px; theme: 2; text: "上传中…"; }
                }
            }
        }

        CodeBlock { code: "import { Tag, Loading } from \"@tela-ui/base.slint\";\nimport { Badge, Avatar } from \"@tela-ui/common.slint\";\n\nTag { text: \"主要\"; theme: 1; closable: true; }\nBadge { count: 6; Icon { icon: TIconSet.Bell; } }\nAvatar { text: \"T\"; }\nLoading { size: 24px; text: \"加载中…\"; }"; }
    }

    // ======================= Divider =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "分割线 Divider";

            VerticalLayout {
                spacing: 4px;

                Divider { text: "居中文字"; }
                Divider { text: "左方文字"; align: 0; }
                Divider { text: "右方文字"; align: 2; }
                Divider { }
            }
        }

        CodeBlock { code: "import { Divider } from \"@tela-ui/base.slint\";\n\nDivider { text: \"居中文字\"; }\nDivider { text: \"左方文字\"; align: 0; }\nDivider { orientation: Orientation.vertical; }"; }
    }

    // ====================== Progress =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "进度 Progress（拖动滑块实时变化）";

            VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 32px;

                    Progress { value: root.progress-value; theme: 1; horizontal-stretch: 1; }
                    Progress { value: 66; theme: 2; horizontal-stretch: 1; }
                    Progress { value: 30; theme: 3; horizontal-stretch: 1; }
                    Progress { value: 90; theme: 4; horizontal-stretch: 1; show-label: false; }
                }

                HorizontalLayout {
                    spacing: 32px;
                    Progress { variant: 1; value: root.progress-value; theme: 1; }
                    Progress { variant: 1; value: 66; theme: 2; }
                    Progress { variant: 1; value: 30; theme: 3; }
                    Progress { variant: 1; value: 100; theme: 4; }
                }

                Slider {
                    value <=> root.progress-value;
                }
            }
        }

        CodeBlock { code: "import { Progress } from \"@tela-ui/common.slint\";\n\nProgress { value: 40; theme: 1; }\nProgress { value: 66; theme: 2; variant: 1; }\nProgress { value: 90; theme: 4; show-label: false; }"; }
    }
}
