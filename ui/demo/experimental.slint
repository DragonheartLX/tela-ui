// Demo section: 实验性 (Skeleton). APIs here are unstable.

import { Skeleton } from "@tela-ui/experimental.slint";
import { Card } from "@tela-ui/common.slint";
import { CodeBlock } from "code-block.slint";

export component ExperimentalSection inherits VerticalLayout {
    spacing: 28px;

    Card {
        title: "实验性 Experimental(Skeleton)";

        HorizontalLayout {
            spacing: 16px;

            Skeleton { width: 48px; height: 48px; circle: true; }

            VerticalLayout {
                spacing: 8px;

                Skeleton { height: 14px; width: 260px; }
                Skeleton { height: 14px; width: 220px; }
                Skeleton { height: 14px; width: 180px; }
            }

            Skeleton { width: 120px; height: 80px; }
        }
    }

    CodeBlock { code: "import { Skeleton } from \"@tela-ui/experimental.slint\";\n\nSkeleton { width: 240px; height: 14px; }\nSkeleton { width: 48px; height: 48px; circle: true; }"; }
}
