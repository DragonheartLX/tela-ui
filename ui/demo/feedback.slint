// Demo section: 反馈 (Alert / Message / Dialog / Drawer). The dialog and
// drawer overlays live at window level in MainWindow; this section only
// hosts the trigger buttons via two-way bound properties.

import { TelaTheme } from "@tela-ui/theme.slint";
import { Button } from "@tela-ui/base.slint";
import { Alert, Select, SelectItem, TelaMessage, MessagePlacement, Card } from "@tela-ui/common.slint";
import { CodeBlock } from "code-block.slint";

export component FeedbackSection inherits VerticalLayout {
    spacing: 28px;

    // Overlays owned by MainWindow.
    in-out property <bool> dialog-open: false;
    in-out property <bool> drawer-open: false;

    in property <[SelectItem]> placement-items: [
        { label: "顶部居中", value: "top-center", disabled: false },
        { label: "顶部居左", value: "top-left", disabled: false },
        { label: "顶部居右", value: "top-right", disabled: false },
        { label: "底部居中", value: "bottom-center", disabled: false },
        { label: "底部居左", value: "bottom-left", disabled: false },
        { label: "底部居右", value: "bottom-right", disabled: false },
    ];
    in-out property <int> placement-index: 0;

    Card {
        title: "反馈 Alert & Message & Dialog";

        VerticalLayout {
            spacing: 12px;

            Alert { theme: 0; title: "信息提示"; description: "这是一条普通的信息提示，用于展示需要用户关注的内容。"; closable: true; }
            Alert { theme: 2; title: "操作成功"; description: "表单已成功提交。"; closable: true; }
            Alert { theme: 3; title: "警告提示"; description: "磁盘剩余空间不足 10%，请及时清理。"; closable: true; }
            Alert { theme: 4; title: "错误提示"; description: "网络连接失败，请检查网络后重试。"; closable: true; }

            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: "消息位置";
                    font-size: TelaTheme.font-size-m;
                    color: TelaTheme.text-color-secondary;
                    vertical-alignment: center;
                }

                Select {
                    width: 160px;
                    items: root.placement-items;
                    current-index <=> root.placement-index;
                    selected(i, v) => {
                        TelaMessage.placement = i == 0 ? MessagePlacement.top-center
                            : i == 1 ? MessagePlacement.top-left
                            : i == 2 ? MessagePlacement.top-right
                            : i == 3 ? MessagePlacement.bottom-center
                            : i == 4 ? MessagePlacement.bottom-left
                            : MessagePlacement.bottom-right;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;

                Button { text: "信息"; clicked => { TelaMessage.info("这是一条信息消息"); } }
                Button { theme: 2; text: "成功"; clicked => { TelaMessage.success("保存成功"); } }
                Button { theme: 3; text: "警告"; clicked => { TelaMessage.warning("请注意潜在风险"); } }
                Button { theme: 4; text: "错误"; clicked => { TelaMessage.error("操作失败，请重试"); } }
                Button { variant: 1; theme: 1; text: "打开对话框"; clicked => { root.dialog-open = true; } }
                Button { variant: 1; theme: 1; text: "打开抽屉"; clicked => { root.drawer-open = true; } }
            }
        }
    }

    CodeBlock { code: "import { Alert, TelaMessage, MessagePlacement } from \"@tela-ui/common.slint\";\n\nAlert { theme: 2; title: \"操作成功\"; closable: true; }\nTelaMessage.success(\"保存成功\");\nTelaMessage.placement = MessagePlacement.bottom-right;"; }
}
