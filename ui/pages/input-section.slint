// Gallery section: 输入 (TInput / TTextArea / TInputNumber / TAutoComplete /
// TSearch / TInputAdornment / TForm / TSlider / TRate / TTagInput /
// TRangeInput / TOtpInput / TMention), 一个组件一张卡.

import { TThemeRole, TSize } from "@tela-ui/theme.slint";
import { TIconSet, TCaption } from "@tela-ui/base.slint";
import { TMessage } from "@tela-ui/notice.slint";
import { TInput, TTextArea, TInputNumber, TAutoComplete, TAutoCompleteItem, TSearch, TInputAdornment, TForm, TFormItem, TSlider, TRate, TTagInput, TRangeInput, TOtpInput, TMention } from "@tela-ui/input.slint";
import { GallerySection } from "../gallery-section.slint";

export component InputSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> input-text: "";
    in-out property <string> textarea-text: "";
    in-out property <float> num-value: 1;
    in-out property <float> slider-value: 40;
    in-out property <float> rate-value: 3;
    in-out property <string> auto-text: "";
    in-out property <string> auto-value: "";
    in-out property <string> search-text: "";
    in-out property <string> search-result: "";
    in-out property <[string]> tag-values: ["Slint", "TDesign"];
    in-out property <float> range-min: 10;
    in-out property <float> range-max: 80;
    in-out property <[string]> otp-values: ["", "", "", "", "", ""];
    in-out property <string> mention-text: "";
    in property <[TAutoCompleteItem]> auto-items: [
        { label: "北京", value: "bj", disabled: false },
        { label: "上海", value: "sh", disabled: false },
        { label: "广州", value: "gz", disabled: false },
        { label: "深圳", value: "sz", disabled: false },
        { label: "杭州", value: "hz", disabled: false },
        { label: "成都", value: "cd", disabled: false },
        { label: "重庆", value: "cq", disabled: false },
        { label: "武汉", value: "wh", disabled: false },
        { label: "南京", value: "nj", disabled: false },
        { label: "西安", value: "xa", disabled: true },
    ];

    // ======================== TInput ========================
    GallerySection {
        title: "输入框 TInput";
        code: "import { TInput } from \"@tela-ui/input.slint\";\n\nTInput { placeholder-text: \"请输入内容\"; clearable: true; prefix-icon: TIconSet.Search; text <=> v; }\nTInput { placeholder-text: \"密码\"; input-type: password; }\nTInput { placeholder-text: \"验证码\"; suffix-text: \"发送验证码\"; suffix-clickable: true; suffix-clicked => { … } }";

        VerticalLayout {
            spacing: 16px;

            TInput {
                placeholder-text: "请输入内容";
                clearable: true;
                prefix-icon: TIconSet.Search;
                text <=> root.input-text;
            }

            HorizontalLayout {
                spacing: 24px;

                TInput {
                    width: 170px;
                    placeholder-text: "密码";
                    input-type: password;
                    clearable: false;
                }
                TInput {
                    width: 210px;
                    placeholder-text: "验证码";
                    suffix-text: "发送验证码";
                    suffix-clickable: true;
                    suffix-clicked => {
                        TMessage.info("验证码已发送");
                    }
                }
                TInput { width: 170px; placeholder-text: "禁用状态"; disabled: true; }
                TInput { width: 170px; text: "只读状态"; read-only: true; }
                Rectangle { }
            }
        }
    }

    // ======================= TTextArea ======================
    GallerySection {
        title: "多行输入 TTextArea";
        code: "import { TTextArea } from \"@tela-ui/input.slint\";\n\nTTextArea { rows: 3; placeholder-text: \"请输入描述…\"; text <=> v; }";

        TTextArea {
            rows: 3;
            placeholder-text: "请输入描述…";
            text <=> root.textarea-text;
        }
    }

    // ====================== TInputNumber ====================
    GallerySection {
        title: "数字输入框 TInputNumber";
        code: "import { TInputNumber } from \"@tela-ui/input.slint\";\n\nTInputNumber { min: 0; max: 10; step: 1; value <=> n; }\n// 文本框内 Up/Down 方向键也可步进; 到达边界时对应按钮禁用。";

        HorizontalLayout {
            spacing: 24px;

            TInputNumber {
                width: 160px;
                min: 0;
                max: 10;
                value <=> root.num-value;
            }
            TInputNumber { width: 160px; value: 3.5; min: 0; max: 10; step: 0.5; editable: false; }
            TInputNumber { width: 160px; value: 2; disabled: true; }
            TCaption { text: "当前值: \{root.num-value}"; vertical-alignment: center; }
            Rectangle { }
        }
    }

    // ======================== TAutoComplete =================
    GallerySection {
        title: "自动补全 TAutoComplete";
        code: "import { TAutoComplete, TAutoCompleteItem } from \"@tela-ui/input.slint\";\n\nTAutoComplete {\n    items: [{ label: \"北京\", value: \"bj\" }, …];\n    placeholder-text: \"输入城市名称\";\n    text <=> city-text;\n    selected(i, value) => { picked = value; }\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TAutoComplete {
                    width: 240px;
                    clearable: true;
                    placeholder-text: "输入城市名称, 如 北";
                    items: root.auto-items;
                    text <=> root.auto-text;

                    selected(i, value) => {
                        root.auto-value = value;
                    }
                }

                TAutoComplete {
                    width: 240px;
                    placeholder-text: "禁用状态";
                    items: root.auto-items;
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption {
                text: root.auto-value == ""
                    ? "输入即过滤 (标签子串匹配, 不区分大小写); 高亮首条匹配, 回车或点击选中; 输入框为空时列出全部。"
                    : "已选:" + root.auto-value;
                wrap: word-wrap;
            }
        }
    }

    // ======================== TSearch ========================
    GallerySection {
        title: "搜索框 TSearch";
        code: "import { TSearch } from \"@tela-ui/input.slint\";\n\n// TInput 预设: 内置搜索图标 + 默认可清空, 右缘 x 即清空/取消。\nTSearch {\n    width: 280px;\n    placeholder-text: \"搜索组件\";\n    text <=> q;\n    accepted(q) => { /* 回车触发 */ }\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TSearch {
                    width: 300px;
                    placeholder-text: "搜索组件";
                    text <=> root.search-text;

                    accepted(q) => {
                        root.search-result = "已搜索: " + q;
                    }
                }

                TSearch {
                    width: 240px;
                    placeholder-text: "禁用状态";
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption {
                text: root.search-result + " 悬停输入框显示右缘 x 图标, 点击即清空 (取消); 回车触发搜索。";
                wrap: word-wrap;
            }
        }
    }

    // ===================== TInputAdornment ===================
    GallerySection {
        title: "输入装饰 TInputAdornment";
        code: "import { TInputAdornment } from \"@tela-ui/input.slint\";\n\nTInputAdornment {\n    width: 320px;\n    addon-before: \"https://\";  // 前置附着段, 空串不渲染\n    addon-after: \".com\";       // 后置附着段\n    placeholder-text: \"your-org\";\n    text <=> v;\n}\n// 框内文字装饰在 TInput 上: prefix-text / suffix-text /\n// suffix-clickable + suffix-clicked";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TInputAdornment {
                    width: 340px;
                    addon-before: "https://";
                    addon-after: ".com";
                    placeholder-text: "your-org";
                    clearable: true;
                }

                TInputAdornment {
                    width: 200px;
                    addon-after: "元";
                    placeholder-text: "金额";
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption {
                text: "附着段与输入框共用一套状态边框 (悬停/聚焦/禁用); 框内前后缀文字与可点击后缀按钮直接用 TInput 的 prefix-text / suffix-text / suffix-clickable。";
                wrap: word-wrap;
            }
        }
    }

    // ========================= TForm =========================
    GallerySection {
        title: "轻量表单 TForm / TFormItem";
        code: "import { TForm, TFormItem } from \"@tela-ui/input.slint\";\n\nTForm {\n    TFormItem { label: \"名称\"; required: true; help-text: \"不超过 20 个字符\";\n        TInput { width: 240px; }\n    }\n    TFormItem { label: \"备注\"; error-text: \"备注不能为空\";\n        TTextArea { width: 320px; rows: 2; }\n    }\n}\n// 无校验引擎: 错误由 Rust 侧写入 error-text 呈现";

        TForm {
            TFormItem {
                label: "名称";
                required: true;
                help-text: "不超过 20 个字符";
                label-width: 80px;

                TInput {
                    width: 280px;
                    placeholder-text: "请输入名称";
                    text <=> root.input-text;
                }
            }

            TFormItem {
                label: "链接";
                label-width: 80px;

                TInputAdornment {
                    width: 340px;
                    addon-before: "https://";
                    placeholder-text: "域名";
                }
            }

            TFormItem {
                label: "备注";
                label-width: 80px;
                error-text: "备注不能为空";

                TTextArea {
                    width: 340px;
                    rows: 2;
                    placeholder-text: "请输入备注";
                }
            }
        }
    }

    // ======================== TSlider =======================
    GallerySection {
        title: "滑块 TSlider";
        code: "import { TSlider } from \"@tela-ui/input.slint\";\n\nTSlider { value <=> v; }";

        TSlider {
            value <=> root.slider-value;
        }
    }

    // ========================= TRate ========================
    GallerySection {
        title: "评分 TRate";
        code: "import { TRate } from \"@tela-ui/input.slint\";\n\nTRate { value <=> score; }\nTRate { value: 2; read-only: true; }\nTRate { theme: TThemeRole.primary; size: TSize.small; }";

        HorizontalLayout {
            spacing: 24px;

            TRate { value <=> root.rate-value; }
            TRate { value: 2; read-only: true; }
            TRate { size: TSize.small; theme: TThemeRole.primary; value: 4; }
            TRate { value: 3; disabled: true; }
            Rectangle { }
        }
    }

    // ======================== TTagInput =====================
    GallerySection {
        title: "标签输入 TTagInput";
        code: "import { TTagInput } from \"@tela-ui/input.slint\";\n\nTTagInput {\n    tags <=> model;            // 宿主模型, 组件只发事件\n    placeholder-text: \"回车添加标签\";\n    tag-added(t) => { model.push(t); }\n    tag-removed(i, t) => { model.remove(i); }\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TTagInput {
                    width: 320px;
                    tags <=> root.tag-values;
                    placeholder-text: "回车添加标签";

                    tag-added(t) => {
                        root.tag-values.push(t);
                    }
                    tag-removed(i, t) => {
                        root.tag-values.remove(i);
                    }
                }

                TTagInput {
                    width: 240px;
                    tags: ["只读", "禁用"];
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption { text: "回车添加, 空文本退格删除末位; 点标签 x 删除 (索引与标签一起上报, 模型由宿主删除); 标签不换行, 重复校验在宿主侧做。"; wrap: word-wrap; }
        }
    }

    // ======================= TRangeInput ====================
    GallerySection {
        title: "区间输入 TRangeInput";
        code: "import { TRangeInput } from \"@tela-ui/input.slint\";\n\nTRangeInput {\n    min: 0; max: 100; step: 1;\n    min-value <=> lo;   // 一侧变更会把另一侧夹进新区间\n    max-value <=> hi;\n    changed(lo, hi) => { … }\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TRangeInput {
                    width: 240px;
                    placeholder-min-text: "最低价";
                    placeholder-max-text: "最高价";
                    min: 0;
                    max: 100;
                    min-value <=> root.range-min;
                    max-value <=> root.range-max;
                }

                TRangeInput {
                    width: 240px;
                    min: 0;
                    max: 100;
                    disabled: true;
                    min-value: 20;
                    max-value: 60;
                }

                Rectangle { }
            }

            TCaption { text: "两侧数值区间 (当前 \{round(root.range-min)} ~ \{round(root.range-max)}); 一侧变更会拖动另一侧保持有序, 空缓冲视为未输入不触发 changed, 失焦按存值重排文本。"; wrap: word-wrap; }
        }
    }

    // ======================== TOtpInput =====================
    GallerySection {
        title: "分段输入 TOtpInput";
        code: "import { TOtpInput } from \"@tela-ui/input.slint\";\n\nTOtpInput {\n    length: 6;\n    masked: false;\n    values <=> codes;   // 每段全文上报\n    changed(i, text) => { … }\n    completed() => { … }\n}\n// 已知限制: 无 max-length, 段内溢出与整段粘贴分发由宿主处理";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TOtpInput {
                    length: 6;
                    values <=> root.otp-values;
                }

                TOtpInput {
                    length: 4;
                    masked: true;
                }

                Rectangle { }
            }

            TCaption { text: "输完一段自动跳下一格, 空段退格回上一格; 全部填满触发 completed。每段缓冲全文上报 changed(i, text), 溢出/粘贴分发由宿主改写 values。"; wrap: word-wrap; }
        }
    }

    // ========================= TMention =====================
    GallerySection {
        title: "提及输入 TMention";
        code: "import { TMention, TAutoCompleteItem } from \"@tela-ui/input.slint\";\n\nTMention {\n    text <=> content;\n    suggestions <=> candidates;   // 宿主解析 @ 后填充\n    changed(t) => { if (t == \"@\") { mention.show-suggestions(); } }\n    selected(i, value) => { /* 宿主把 value 拼回文本 */ }\n}";

        VerticalLayout {
            spacing: 16px;

            mention-input := TMention {
                width: 320px;
                text <=> root.mention-text;
                suggestions: [
                    { label: "张三", value: "zhangsan" },
                    { label: "李四", value: "lisi" },
                    { label: "王五", value: "wangwu" },
                ];

                changed(t) => {
                    // 触发符解析在宿主: 组件侧没有字符串切片; 演示里
                    // 键入单独一个 @ 即触发。
                    if (t == "@") {
                        mention-input.show-suggestions();
                    }
                }

                selected(i, value) => {
                    // 拼接在宿主: 把选中值替换 @ 后的占位。
                    mention-input.text = "@" + value + " ";
                    mention-input.move-caret-to-end();
                }
            }

            TCaption { text: "输入 @ 触发建议 (演示为示意): 触发解析、建议填充 (suggestions) 与选中文本拼接都在宿主侧; 面板锚输入框而非光标 (TextInput 不暴露光标几何)。"; wrap: word-wrap; }
        }
    }
}
