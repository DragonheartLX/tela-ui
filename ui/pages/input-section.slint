// Gallery section: 输入 (TInput / TTextArea / TInputNumber / TAutoComplete /
// TSearch / TInputAdornment / TForm / TSlider / TRate / TTagInput /
// TRangeInput / TOtpInput / TMention), 一个组件一张卡.

import { TThemeRole, TSize } from "@tela-ui/theme.slint";
import { TIconSet, TCaption } from "@tela-ui/base.slint";
import { TMessage } from "@tela-ui/notice.slint";
import { TInput, TTextArea, TInputNumber, TAutoComplete, TAutoCompleteItem, TSearch, TInputAdornment, TForm, TFormItem, TSlider, TRate, TTagInput, TRangeInput, TOtpInput, TMention } from "@tela-ui/input.slint";
import { GallerySection } from "../gallery-section.slint";

export component InputSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> input-text: "";
    in-out property <string> textarea-text: "";
    in-out property <float> num-value: 1;
    in-out property <float> slider-value: 40;
    in-out property <float> rate-value: 3;
    in-out property <string> auto-text: "";
    in-out property <string> auto-value: "";
    in-out property <string> search-text: "";
    in-out property <string> search-result: "";
    in-out property <[string]> tag-values: ["Slint", "TDesign"];
    in-out property <float> range-min: 10;
    in-out property <float> range-max: 80;
    in-out property <[string]> otp-values: ["", "", "", "", "", ""];
    in-out property <string> mention-text: "";
    in property <[TAutoCompleteItem]> auto-items: [
        { label: "北京", value: "bj", disabled: false },
        { label: "上海", value: "sh", disabled: false },
        { label: "广州", value: "gz", disabled: false },
        { label: "深圳", value: "sz", disabled: false },
        { label: "杭州", value: "hz", disabled: false },
        { label: "成都", value: "cd", disabled: false },
        { label: "重庆", value: "cq", disabled: false },
        { label: "武汉", value: "wh", disabled: false },
        { label: "南京", value: "nj", disabled: false },
        { label: "西安", value: "xa", disabled: true },
    ];

    // ======================== TInput ========================
    GallerySection {
        title: "输入框 TInput";
        code: "import { TInput } from \"@tela-ui/input.slint\";\n\nTInput {\n    placeholder-text: \"请输入内容\";\n    clearable: true;\n    prefix-icon: TIconSet.Search;\n    text <=> root.input-text;\n}\n\nTInput {\n    width: 170px;\n    placeholder-text: \"密码\";\n    input-type: password;\n    clearable: false;\n}\nTInput {\n    width: 210px;\n    placeholder-text: \"验证码\";\n    suffix-text: \"发送验证码\";\n    suffix-clickable: true;\n\n    suffix-clicked => {\n        TMessage.info(\"验证码已发送\");\n    }\n}\nTInput { width: 170px; placeholder-text: \"禁用状态\"; disabled: true; }\nTInput { width: 170px; text: \"只读状态\"; read-only: true; }";

        VerticalLayout {
            spacing: 16px;

            TInput {
                placeholder-text: "请输入内容";
                clearable: true;
                prefix-icon: TIconSet.Search;
                text <=> root.input-text;
            }

            HorizontalLayout {
                spacing: 24px;

                TInput {
                    width: 170px;
                    placeholder-text: "密码";
                    input-type: password;
                    clearable: false;
                }
                TInput {
                    width: 210px;
                    placeholder-text: "验证码";
                    suffix-text: "发送验证码";
                    suffix-clickable: true;
                    suffix-clicked => {
                        TMessage.info("验证码已发送");
                    }
                }
                TInput { width: 170px; placeholder-text: "禁用状态"; disabled: true; }
                TInput { width: 170px; text: "只读状态"; read-only: true; }
                Rectangle { }
            }
        }
    }

    // ======================= TTextArea ======================
    GallerySection {
        title: "多行输入 TTextArea";
        code: "import { TTextArea } from \"@tela-ui/input.slint\";\n\nTTextArea { rows: 3; placeholder-text: \"请输入描述…\"; text <=> v; }";

        TTextArea {
            rows: 3;
            placeholder-text: "请输入描述…";
            text <=> root.textarea-text;
        }
    }

    // ====================== TInputNumber ====================
    GallerySection {
        title: "数字输入框 TInputNumber";
        code: "import { TInputNumber } from \"@tela-ui/input.slint\";\n\nTInputNumber {\n    width: 160px;\n    min: 0;\n    max: 10;\n    value <=> root.num-value;\n}\nTInputNumber { width: 160px; value: 3.5; min: 0; max: 10; step: 0.5; editable: false; }\nTInputNumber { width: 160px; value: 2; disabled: true; }";

        HorizontalLayout {
            spacing: 24px;

            TInputNumber {
                width: 160px;
                min: 0;
                max: 10;
                value <=> root.num-value;
            }
            TInputNumber { width: 160px; value: 3.5; min: 0; max: 10; step: 0.5; editable: false; }
            TInputNumber { width: 160px; value: 2; disabled: true; }
            TCaption { text: "当前值: \{root.num-value}"; vertical-alignment: center; }
            Rectangle { }
        }
    }

    // ======================== TAutoComplete =================
    GallerySection {
        title: "自动补全 TAutoComplete";
        code: "import { TAutoComplete } from \"@tela-ui/input.slint\";\n\nTAutoComplete {\n    width: 240px;\n    clearable: true;\n    placeholder-text: \"输入城市名称, 如 北\";\n    items: root.auto-items;\n    text <=> root.auto-text;\n\n    selected(i, value) => { root.auto-value = value; }\n}\n\nTAutoComplete {\n    width: 240px;\n    placeholder-text: \"禁用状态\";\n    items: root.auto-items;\n    disabled: true;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TAutoComplete {
                    width: 240px;
                    clearable: true;
                    placeholder-text: "输入城市名称, 如 北";
                    items: root.auto-items;
                    text <=> root.auto-text;

                    selected(i, value) => {
                        root.auto-value = value;
                    }
                }

                TAutoComplete {
                    width: 240px;
                    placeholder-text: "禁用状态";
                    items: root.auto-items;
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption {
                text: root.auto-value == ""
                    ? "输入即过滤 (标签子串匹配, 不区分大小写); 高亮首条匹配, 回车或点击选中; 输入框为空时列出全部。"
                    : "已选:" + root.auto-value;
                wrap: word-wrap;
            }
        }
    }

    // ======================== TSearch ========================
    GallerySection {
        title: "搜索框 TSearch";
        code: "import { TSearch } from \"@tela-ui/input.slint\";\n\nTSearch {\n    width: 300px;\n    placeholder-text: \"搜索组件\";\n    text <=> root.search-text;\n\n    accepted(q) => { root.search-result = \"已搜索: \" + q; }\n}\n\nTSearch { width: 240px; placeholder-text: \"禁用状态\"; disabled: true; }";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TSearch {
                    width: 300px;
                    placeholder-text: "搜索组件";
                    text <=> root.search-text;

                    accepted(q) => {
                        root.search-result = "已搜索: " + q;
                    }
                }

                TSearch {
                    width: 240px;
                    placeholder-text: "禁用状态";
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption {
                text: root.search-result + " 悬停输入框显示右缘 x 图标, 点击即清空 (取消); 回车触发搜索。";
                wrap: word-wrap;
            }
        }
    }

    // ===================== TInputAdornment ===================
    GallerySection {
        title: "输入装饰 TInputAdornment";
        code: "import { TInputAdornment } from \"@tela-ui/input.slint\";\n\nTInputAdornment {\n    width: 340px;\n    addon-before: \"https://\";\n    addon-after: \".com\";\n    placeholder-text: \"your-org\";\n    clearable: true;\n}\n\nTInputAdornment {\n    width: 200px;\n    addon-after: \"元\";\n    placeholder-text: \"金额\";\n    disabled: true;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TInputAdornment {
                    width: 340px;
                    addon-before: "https://";
                    addon-after: ".com";
                    placeholder-text: "your-org";
                    clearable: true;
                }

                TInputAdornment {
                    width: 200px;
                    addon-after: "元";
                    placeholder-text: "金额";
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption {
                text: "附着段与输入框共用一套状态边框 (悬停/聚焦/禁用); 框内前后缀文字与可点击后缀按钮直接用 TInput 的 prefix-text / suffix-text / suffix-clickable。";
                wrap: word-wrap;
            }
        }
    }

    // ========================= TForm =========================
    GallerySection {
        title: "轻量表单 TForm / TFormItem";
        code: "import { TForm, TFormItem } from \"@tela-ui/input.slint\";\n\nTForm {\n    TFormItem {\n        label: \"名称\";\n        required: true;\n        help-text: \"不超过 20 个字符\";\n        label-width: 80px;\n\n        TInput {\n            width: 280px;\n            placeholder-text: \"请输入名称\";\n            text <=> root.input-text;\n        }\n    }\n\n    TFormItem {\n        label: \"链接\";\n        label-width: 80px;\n\n        TInputAdornment {\n            width: 340px;\n            addon-before: \"https://\";\n            placeholder-text: \"域名\";\n        }\n    }\n\n    TFormItem {\n        label: \"备注\";\n        label-width: 80px;\n        error-text: \"备注不能为空\";\n\n        TTextArea {\n            width: 340px;\n            rows: 2;\n            placeholder-text: \"请输入备注\";\n        }\n    }\n}";

        TForm {
            TFormItem {
                label: "名称";
                required: true;
                help-text: "不超过 20 个字符";
                label-width: 80px;

                TInput {
                    width: 280px;
                    placeholder-text: "请输入名称";
                    text <=> root.input-text;
                }
            }

            TFormItem {
                label: "链接";
                label-width: 80px;

                TInputAdornment {
                    width: 340px;
                    addon-before: "https://";
                    placeholder-text: "域名";
                }
            }

            TFormItem {
                label: "备注";
                label-width: 80px;
                error-text: "备注不能为空";

                TTextArea {
                    width: 340px;
                    rows: 2;
                    placeholder-text: "请输入备注";
                }
            }
        }
    }

    // ======================== TSlider =======================
    GallerySection {
        title: "滑块 TSlider";
        code: "import { TSlider } from \"@tela-ui/input.slint\";\n\nTSlider { value <=> v; }";

        TSlider {
            value <=> root.slider-value;
        }
    }

    // ========================= TRate ========================
    GallerySection {
        title: "评分 TRate";
        code: "import { TRate } from \"@tela-ui/input.slint\";\n\nTRate { value <=> root.rate-value; }\nTRate { value: 2; read-only: true; }\nTRate { size: TSize.small; theme: TThemeRole.primary; value: 4; }\nTRate { value: 3; disabled: true; }";

        HorizontalLayout {
            spacing: 24px;

            TRate { value <=> root.rate-value; }
            TRate { value: 2; read-only: true; }
            TRate { size: TSize.small; theme: TThemeRole.primary; value: 4; }
            TRate { value: 3; disabled: true; }
            Rectangle { }
        }
    }

    // ======================== TTagInput =====================
    GallerySection {
        title: "标签输入 TTagInput";
        code: "import { TTagInput } from \"@tela-ui/input.slint\";\n\nTTagInput {\n    width: 320px;\n    tags <=> root.tag-values;\n    placeholder-text: \"回车添加标签\";\n\n    tag-added(t) => { root.tag-values.push(t); }\n    tag-removed(i, t) => { root.tag-values.remove(i); }\n}\n\nTTagInput {\n    width: 240px;\n    tags: [\"只读\", \"禁用\"];\n    disabled: true;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TTagInput {
                    width: 320px;
                    tags <=> root.tag-values;
                    placeholder-text: "回车添加标签";

                    tag-added(t) => {
                        root.tag-values.push(t);
                    }
                    tag-removed(i, t) => {
                        root.tag-values.remove(i);
                    }
                }

                TTagInput {
                    width: 240px;
                    tags: ["只读", "禁用"];
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption { text: "回车添加, 空文本退格删除末位; 点标签 x 删除 (索引与标签一起上报, 模型由宿主删除); 标签不换行, 重复校验在宿主侧做。"; wrap: word-wrap; }
        }
    }

    // ======================= TRangeInput ====================
    GallerySection {
        title: "区间输入 TRangeInput";
        code: "import { TRangeInput } from \"@tela-ui/input.slint\";\n\nTRangeInput {\n    width: 240px;\n    placeholder-min-text: \"最低价\";\n    placeholder-max-text: \"最高价\";\n    min: 0;\n    max: 100;\n    min-value <=> root.range-min;\n    max-value <=> root.range-max;\n}\n\nTRangeInput {\n    width: 240px;\n    min: 0;\n    max: 100;\n    disabled: true;\n    min-value: 20;\n    max-value: 60;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TRangeInput {
                    width: 240px;
                    placeholder-min-text: "最低价";
                    placeholder-max-text: "最高价";
                    min: 0;
                    max: 100;
                    min-value <=> root.range-min;
                    max-value <=> root.range-max;
                }

                TRangeInput {
                    width: 240px;
                    min: 0;
                    max: 100;
                    disabled: true;
                    min-value: 20;
                    max-value: 60;
                }

                Rectangle { }
            }

            TCaption { text: "两侧数值区间 (当前 \{round(root.range-min)} ~ \{round(root.range-max)}); 一侧变更会拖动另一侧保持有序, 空缓冲视为未输入不触发 changed, 失焦按存值重排文本。"; wrap: word-wrap; }
        }
    }

    // ======================== TOtpInput =====================
    GallerySection {
        title: "分段输入 TOtpInput";
        code: "import { TOtpInput } from \"@tela-ui/input.slint\";\n\nTOtpInput {\n    length: 6;\n    values <=> root.otp-values;\n}\n\nTOtpInput {\n    length: 4;\n    masked: true;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TOtpInput {
                    length: 6;
                    values <=> root.otp-values;
                }

                TOtpInput {
                    length: 4;
                    masked: true;
                }

                Rectangle { }
            }

            TCaption { text: "输完一段自动跳下一格, 空段退格回上一格; 全部填满触发 completed。每段缓冲全文上报 changed(i, text), 溢出/粘贴分发由宿主改写 values。"; wrap: word-wrap; }
        }
    }

    // ========================= TMention =====================
    GallerySection {
        title: "提及输入 TMention";
        code: "import { TMention } from \"@tela-ui/input.slint\";\n\nmention-input := TMention {\n    width: 320px;\n    text <=> root.mention-text;\n    suggestions: [\n        { label: \"张三\", value: \"zhangsan\" },\n        { label: \"李四\", value: \"lisi\" },\n        { label: \"王五\", value: \"wangwu\" },\n    ];\n\n    changed(t) => {\n        // 触发符解析在宿主: 键入单独一个 @ 即触发。\n        if (t == \"@\") {\n            mention-input.show-suggestions();\n        }\n    }\n\n    selected(i, value) => {\n        // 拼接在宿主: 把选中值替换 @ 后的占位。\n        mention-input.text = \"@\" + value + \" \";\n        mention-input.move-caret-to-end();\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            mention-input := TMention {
                width: 320px;
                text <=> root.mention-text;
                suggestions: [
                    { label: "张三", value: "zhangsan" },
                    { label: "李四", value: "lisi" },
                    { label: "王五", value: "wangwu" },
                ];

                changed(t) => {
                    // 触发符解析在宿主: 组件侧没有字符串切片; 演示里
                    // 键入单独一个 @ 即触发。
                    if (t == "@") {
                        mention-input.show-suggestions();
                    }
                }

                selected(i, value) => {
                    // 拼接在宿主: 把选中值替换 @ 后的占位。
                    mention-input.text = "@" + value + " ";
                    mention-input.move-caret-to-end();
                }
            }

            TCaption { text: "输入 @ 触发建议 (演示为示意): 触发解析、建议填充 (suggestions) 与选中文本拼接都在宿主侧; 面板锚输入框而非光标 (TextInput 不暴露光标几何)。"; wrap: word-wrap; }
        }
    }
}
