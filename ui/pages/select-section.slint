// Gallery section: 选择 (TSelect / TCheckBox / TRadio / TSwitch / TSegmented /
// TSelectInput / TTreeSelect / TCascader), 一个组件一张卡.

import { TSize } from "@tela-ui/theme.slint";
import { TCaption } from "@tela-ui/base.slint";
import { TSelect, TSelectItem, TCheckBox, TRadioGroup, TRadioItem, TSwitch, TSegmented, TSelectInput, TTreeSelect, TCascader, TCascaderItem, TCascaderBranch, TCascaderLogic } from "@tela-ui/select.slint";
import { TTreeItem, TTreeBranch } from "@tela-ui/content.slint";
import { GallerySection } from "../gallery-section.slint";

export component SelectSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> city-value: "sh";
    in property <[TSelectItem]> city-items: [
        { label: "北京", value: "bj", disabled: false },
        { label: "上海", value: "sh", disabled: false },
        { label: "广州", value: "gz", disabled: false },
        { label: "深圳", value: "sz", disabled: false },
        { label: "杭州", value: "hz", disabled: true },
        { label: "成都", value: "cd", disabled: false },
    ];
    in-out property <bool> check-a: true;
    in-out property <bool> check-b: false;
    in-out property <string> radio-value: "bj";
    in property <[TRadioItem]> radio-items: [
        { text: "北京", value: "bj" },
        { text: "上海", value: "sh" },
        { text: "广州", value: "gz" },
    ];
    in-out property <bool> switch-on: true;
    in-out property <int> seg-index: 1;
    in-out property <int> select-input-index: -1;
    in-out property <string> select-input-text: "";
    in-out property <string> tree-select-value: "";
    in-out property <string> cascader-value: "";

    // ======================== TSelect =======================
    GallerySection {
        title: "选择器 TSelect";
        code: "import { TSelect, TSelectItem } from \"@tela-ui/select.slint\";\n\nproperty <string> current-value: \"sh\";\nproperty <[TSelectItem]> items: [\n    { label: \"北京\", value: \"bj\", disabled: false },\n    { label: \"上海\", value: \"sh\", disabled: false },\n    { label: \"广州\", value: \"gz\", disabled: false },\n    { label: \"深圳\", value: \"sz\", disabled: false },\n    { label: \"杭州\", value: \"hz\", disabled: true },\n    { label: \"成都\", value: \"cd\", disabled: false },\n];\n\nTSelect {\n    width: 240px;\n    placeholder-text: \"请选择城市\";\n    items: root.items;\n    current-value <=> root.current-value;\n}";

        HorizontalLayout {
            spacing: 24px;

            TSelect {
                width: 240px;
                placeholder-text: "请选择城市";
                items: root.city-items;
                current-value <=> root.city-value;
            }

            TCaption { text: "选中: \{root.city-value}"; vertical-alignment: center; }
            Rectangle { }
        }
    }

    // ======================= TCheckBox ======================
    GallerySection {
        title: "复选框 TCheckBox";
        code: "import { TCheckBox } from \"@tela-ui/select.slint\";\n\nproperty <bool> checked-a: true;\nproperty <bool> checked-b: false;\n\nTCheckBox {\n    text: \"全选\";\n    indeterminate: root.checked-a != root.checked-b;\n    checked: root.checked-a && root.checked-b;\n\n    changed(c) => { root.checked-a = c; root.checked-b = c; }\n}\nTCheckBox { text: \"选项 A\"; checked <=> root.checked-a; }\nTCheckBox { text: \"选项 B\"; checked <=> root.checked-b; }\nTCheckBox { text: \"禁用\"; disabled: true; }\nTCheckBox { text: \"选中禁用\"; checked: true; disabled: true; }";

        HorizontalLayout {
            spacing: 24px;

            TCheckBox { text: "全选"; indeterminate: root.check-a != root.check-b; checked: root.check-a && root.check-b;
                changed(c) => { root.check-a = c; root.check-b = c; } }
            TCheckBox { text: "选项 A"; checked <=> root.check-a; }
            TCheckBox { text: "选项 B"; checked <=> root.check-b; }
            TCheckBox { text: "禁用"; disabled: true; }
            TCheckBox { text: "选中禁用"; checked: true; disabled: true; }
            // Absorbs the leftover row space: with only fixed-width
            // children the layout spreads the slack between the items
            // and shoves the row against the card edge.
            Rectangle { }
        }
    }

    // ======================== TRadio ========================
    GallerySection {
        title: "单选框 TRadio";
        code: "import { TRadioGroup } from \"@tela-ui/select.slint\";\n\nproperty <string> value: \"bj\";\n\nTRadioGroup {\n    items: [\n        { text: \"北京\", value: \"bj\" },\n        { text: \"上海\", value: \"sh\" },\n        { text: \"广州\", value: \"gz\" },\n    ];\n    value <=> root.value;\n}";

        TRadioGroup {
            items: root.radio-items;
            value <=> root.radio-value;
        }
    }

    // ======================== TSwitch =======================
    GallerySection {
        title: "开关 TSwitch";
        code: "import { TSwitch } from \"@tela-ui/select.slint\";\nimport { TSize } from \"@tela-ui/theme.slint\";\n\nproperty <bool> on: true;\n\nTSwitch { checked <=> root.on; }\nTSwitch { size: TSize.small; checked: true; }\nTSwitch { disabled: true; }";

        HorizontalLayout {
            spacing: 24px;

            TSwitch { checked <=> root.switch-on; }
            TSwitch { checked: false; }
            TSwitch { checked: true; disabled: true; }
            TSwitch { checked: false; disabled: true; }
            TSwitch { size: TSize.small; checked: true; }
            TSwitch { size: TSize.large; checked: false; }
            Rectangle { }
        }
    }

    // ====================== TSegmented =====================
    GallerySection {
        title: "分段控制器 TSegmented";
        code: "import { TSegmented } from \"@tela-ui/select.slint\";\n\nproperty <int> current-index: 1;\n\nRectangle {\n    max-width: 480px;\n\n    TSegmented { items: [\"日\", \"周\", \"月\", \"年\"]; current-index <=> root.current-index; }\n}";

        VerticalLayout {
            spacing: 12px;

            Rectangle {
                max-width: 480px;

                TSegmented {
                    items: ["日", "周", "月", "年"];
                    current-index <=> root.seg-index;
                }
            }

            TCaption { text: "当前选中下标: \{root.seg-index}"; }
        }
    }

    // ====================== TSelectInput ====================
    GallerySection {
        title: "可输入筛选选择 TSelectInput";
        code: "import { TSelectInput, TSelectItem } from \"@tela-ui/select.slint\";\n\nproperty <int> current-index: -1;\nproperty <string> text: \"\";\nproperty <[TSelectItem]> items: [\n    { label: \"北京\", value: \"bj\", disabled: false },\n    { label: \"上海\", value: \"sh\", disabled: false },\n    { label: \"广州\", value: \"gz\", disabled: false },\n    { label: \"深圳\", value: \"sz\", disabled: false },\n    { label: \"杭州\", value: \"hz\", disabled: true },\n    { label: \"成都\", value: \"cd\", disabled: false },\n];\n\nTSelectInput {\n    width: 240px;\n    placeholder-text: \"输入或选择城市\";\n    items: root.items;\n    text <=> root.text;\n    current-index <=> root.current-index;\n}\n\nTSelectInput {\n    width: 240px;\n    placeholder-text: \"禁用状态\";\n    items: root.items;\n    disabled: true;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TSelectInput {
                    width: 240px;
                    placeholder-text: "输入或选择城市";
                    items: root.city-items;
                    text <=> root.select-input-text;
                    current-index <=> root.select-input-index;
                }

                TSelectInput {
                    width: 240px;
                    placeholder-text: "禁用状态";
                    items: root.city-items;
                    disabled: true;
                }

                Rectangle { }
            }

            TCaption { text: "聚焦即列出全部, 键入按标签子串过滤 (不区分大小写); 选中项带 ✓, 回车或点击选中; 再次键入继续过滤, 不清空已选。"; wrap: word-wrap; }
        }
    }

    // ======================= TTreeSelect ====================
    GallerySection {
        title: "树选择 TTreeSelect";
        code: "import { TTreeSelect } from \"@tela-ui/select.slint\";\nimport { TTreeItem, TTreeBranch } from \"@tela-ui/content.slint\";\n\nproperty <string> value: \"\";\n\nTTreeSelect {\n    width: 240px;\n    placeholder-text: \"请选择节点\";\n\n    selected(v) => { root.value = v; }\n\n    TTreeItem { label: \"概览\"; value: \"overview\"; }\n    TTreeItem { label: \"统计\"; value: \"stats\"; }\n\n    TTreeBranch {\n        label: \"文件\";\n        opened: true;\n        TTreeItem { label: \"文件 1.txt\"; value: \"file-1\"; }\n        TTreeItem { label: \"文件 2.txt\"; value: \"file-2\"; }\n    }\n\n    TTreeBranch {\n        label: \"设置\";\n        TTreeItem { label: \"外观\"; value: \"appearance\"; }\n        TTreeItem { label: \"禁用项\"; value: \"disabled-node\"; enabled: false; }\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            TTreeSelect {
                width: 240px;
                placeholder-text: "请选择节点";

                selected(v) => {
                    root.tree-select-value = v;
                }

                TTreeItem { label: "概览"; value: "overview"; }
                TTreeItem { label: "统计"; value: "stats"; }

                TTreeBranch {
                    label: "文件";
                    opened: true;
                    TTreeItem { label: "文件 1.txt"; value: "file-1"; }
                    TTreeItem { label: "文件 2.txt"; value: "file-2"; }
                }

                TTreeBranch {
                    label: "设置";
                    TTreeItem { label: "外观"; value: "appearance"; }
                    TTreeItem { label: "禁用项"; value: "disabled-node"; enabled: false; }
                }
            }

            TCaption { text: "选中值: \{root.tree-select-value} — 树节点嵌套声明, 经 @children 进入下拉; 选中值经 TTreeLogic 全局共享, 点叶子选中并回填触发器。"; wrap: word-wrap; }
        }
    }

    // ======================== TCascader =====================
    GallerySection {
        title: "级联选择 TCascader";
        code: "import { TCascader, TCascaderItem, TCascaderBranch } from \"@tela-ui/select.slint\";\n\nproperty <string> value: \"\";\n\nTCascader {\n    width: 240px;\n    placeholder-text: \"请选择地区\";\n\n    selected(v) => { root.value = v; }\n\n    TCascaderBranch {\n        label: \"浙江省\";\n        opened: true;\n\n        TCascaderBranch {\n            label: \"杭州市\";\n            TCascaderItem { label: \"西湖区\"; value: \"xihu\"; }\n            TCascaderItem { label: \"余杭区\"; value: \"yuhang\"; }\n        }\n\n        TCascaderBranch {\n            label: \"宁波市\";\n            TCascaderItem { label: \"海曙区\"; value: \"haishu\"; }\n        }\n    }\n\n    TCascaderBranch {\n        label: \"江苏省\";\n        TCascaderItem { label: \"南京市\"; value: \"nanjing\"; }\n        TCascaderItem { label: \"苏州市\"; value: \"suzhou\"; }\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            TCascader {
                width: 240px;
                placeholder-text: "请选择地区";

                selected(v) => {
                    root.cascader-value = v;
                }

                TCascaderBranch {
                    label: "浙江省";
                    opened: true;

                    TCascaderBranch {
                        label: "杭州市";
                        TCascaderItem { label: "西湖区"; value: "xihu"; }
                        TCascaderItem { label: "余杭区"; value: "yuhang"; }
                    }

                    TCascaderBranch {
                        label: "宁波市";
                        TCascaderItem { label: "海曙区"; value: "haishu"; }
                    }
                }

                TCascaderBranch {
                    label: "江苏省";
                    TCascaderItem { label: "南京市"; value: "nanjing"; }
                    TCascaderItem { label: "苏州市"; value: "suzhou"; }
                }
            }

            TCaption { text: "选中值: \{root.cascader-value} — 单列逐级展开 (点分支行折叠/展开), 点叶子选中并关闭面板; 触发器回显叶子 label, 完整路径回显暂不支持 (见已知限制)。"; wrap: word-wrap; }
        }
    }
}
