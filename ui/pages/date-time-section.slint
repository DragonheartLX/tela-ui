// Gallery section: 日期时间 (TCalendar / TDatePicker / TTimePicker / TPicker /
// TDateTimePicker), 一个组件一张卡.

import { TCaption } from "@tela-ui/base.slint";
import { TCalendar, TDate, TDatePicker, TTimePicker, TTime, TPicker, TDateTimePicker, TDateTime } from "@tela-ui/date-time.slint";
import { GallerySection } from "../gallery-section.slint";

export component DateTimeSection inherits VerticalLayout {
    spacing: 28px;

    in property <TDate> demo-today: { year: 2026, month: 10, day: 20 };
    in-out property <TDate> calendar-date: { year: 2026, month: 10, day: 20 };
    in-out property <TDate> calendar-range-start: { year: 2026, month: 10, day: 6 };
    in-out property <TDate> calendar-range-end: { year: 2026, month: 10, day: 16 };
    in-out property <TDate> picker-date: { year: 2026, month: 10, day: 20 };
    in-out property <TDate> picker-range-start: { year: 2026, month: 10, day: 6 };
    in-out property <TDate> picker-range-end: { year: 2026, month: 10, day: 16 };
    in-out property <TTime> time-value: { hour: 9, minute: 30, second: 0 };
    in-out property <TTime> time-seconds-value: { hour: 18, minute: 5, second: 42 };
    in-out property <[int]> picker-values: [0, 1, 2];
    in-out property <TDateTime> datetime-value: {
        date: { year: 2026, month: 10, day: 20 },
        hour: 9,
        minute: 30,
    };

    // ========================= TCalendar ====================
    GallerySection {
        title: "日历 TCalendar";
        code: "import { TCalendar, TDate } from \"@tela-ui/date-time.slint\";\n\nTCalendar {\n    year: 2026; month: 10;\n    today: { year: 2026, month: 10, day: 20 };\n    value <=> date;\n}\n// 区间: range: true, range-start / range-end";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TCalendar {
                    year: 2026;
                    month: 10;
                    today: root.demo-today;
                    value <=> root.calendar-date;
                }

                TCalendar {
                    year: 2026;
                    month: 10;
                    range: true;
                    today: root.demo-today;
                    range-start <=> root.calendar-range-start;
                    range-end <=> root.calendar-range-end;
                }

                Rectangle { }
            }

            TCaption { text: "左右箭头切换月份; 单选点击即回调, 区间选第二次点击完成。灰色日期属于相邻月份, 同样可选。"; wrap: word-wrap; }
        }
    }

    // ======================== TDatePicker ===================
    GallerySection {
        title: "日期选择 TDatePicker";
        code: "import { TDatePicker } from \"@tela-ui/date-time.slint\";\n\nTDatePicker {\n    width: 240px;\n    today: root.demo-today;\n    value <=> root.picker-date;\n}\n\nTDatePicker {\n    width: 280px;\n    range: true;\n    today: root.demo-today;\n    range-start <=> root.picker-range-start;\n    range-end <=> root.picker-range-end;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TDatePicker {
                    width: 240px;
                    today: root.demo-today;
                    value <=> root.picker-date;
                }

                TDatePicker {
                    width: 280px;
                    range: true;
                    today: root.demo-today;
                    range-start <=> root.picker-range-start;
                    range-end <=> root.picker-range-end;
                }

                Rectangle { }
            }

            TCaption { text: "触发器只读; 点击展开日历, 单选即关, 区间选完结束关。"; wrap: word-wrap; }
        }
    }

    // ======================== TTimePicker ===================
    GallerySection {
        title: "时间选择 TTimePicker";
        code: "import { TTimePicker, TTime } from \"@tela-ui/date-time.slint\";\n\nTTimePicker { width: 220px; value <=> time; }\nTTimePicker { width: 240px; show-seconds: true; value <=> precise; }";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TTimePicker {
                    width: 220px;
                    value <=> root.time-value;
                }

                TTimePicker {
                    width: 240px;
                    show-seconds: true;
                    value <=> root.time-seconds-value;
                }

                Rectangle { }
            }

            TCaption { text: "触发器只读; 整列数据带动画滚动, 选中框随选中行移动; 点击行或滚轮逐格改值, 无确认按钮。"; wrap: word-wrap; }
        }
    }

    // ========================= TPicker ======================
    GallerySection {
        title: "滚轮选择面板 TPicker";
        code: "import { TPicker } from \"@tela-ui/date-time.slint\";\n\nTPicker {\n    columns: [\n        { label: \"省\", options: [\"浙江省\", \"江苏省\", \"广东省\"] },\n        { label: \"市\", options: [\"杭州市\", \"宁波市\", \"南京市\", \"苏州市\"] },\n        { label: \"运营商\", options: [\"移动\", \"联通\", \"电信\"] },\n    ];\n    value <=> root.picker-values;\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TPicker {
                    columns: [
                        { label: "省", options: ["浙江省", "江苏省", "广东省"] },
                        { label: "市", options: ["杭州市", "宁波市", "南京市", "苏州市"] },
                        { label: "运营商", options: ["移动", "联通", "电信"] },
                    ];
                    value <=> root.picker-values;
                }

                Rectangle { }
            }

            TCaption { text: "每列独立取值, 点行或滚轮逐格滚动; 选中下标存于 value 数组, 请初始化成与列数等长 (短模型只有恰好填到末位的拾取能追加, 中间留空的列写不进); 无触发器与确认按钮, 联动列由宿主在 changed 里重建 options。"; wrap: word-wrap; }
        }
    }

    // ====================== TDateTimePicker =================
    GallerySection {
        title: "日期时间选择 TDateTimePicker";
        code: "import { TDateTimePicker } from \"@tela-ui/date-time.slint\";\n\nTDateTimePicker {\n    width: 300px;\n    value <=> root.datetime-value;\n}\n\nTDateTimePicker {\n    width: 300px;\n    disabled: true;\n    value: {\n        date: { year: 2026, month: 10, day: 20 },\n        hour: 9,\n        minute: 30,\n    };\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TDateTimePicker {
                    width: 300px;
                    value <=> root.datetime-value;
                }

                TDateTimePicker {
                    width: 300px;
                    disabled: true;
                    value: {
                        date: { year: 2026, month: 10, day: 20 },
                        hour: 9,
                        minute: 30,
                    };
                }

                Rectangle { }
            }

            TCaption { text: "年/月/日/时/分五列滚轮; 日列随年月自动收放 (闰月长度用 TCalendar 同款运算); hour < 0 表示未选时间, 拾取任一列会把其余列补成有效零值。"; wrap: word-wrap; }
        }
    }
}
