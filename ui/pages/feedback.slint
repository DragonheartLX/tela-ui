// Demo section: 反馈 (TAlert / Message / TDialog / TDrawer / Notification /
// TPopconfirm / TProgress / TResult), 一个组件一张卡. The dialog and drawer
// overlays live at window level in MainWindow; this section only hosts the
// trigger buttons via two-way bound properties.

import { TTheme,  TThemeRole, TPopupPlacement } from "@tela-ui/theme.slint";
import { TText, TButton, TButtonVariant, TCaption } from "@tela-ui/base.slint";
import { TSelect, TSelectItem, TSlider, TSwitch } from "@tela-ui/data-entry.slint";
import { TAlert, TMessage, TMessagePlacement, TDrawerPlacement, TNotification, TPopconfirm, TResult, TResultStatus, TProgress, TProgressVariant, TDialogService, TLoadingService } from "@tela-ui/feedback.slint";
import { DemoSection } from "../demo-section.slint";

export component FeedbackSection inherits VerticalLayout {
    spacing: 28px;

    // Overlays owned by MainWindow.
    in-out property <bool> dialog-open: false;
    in-out property <bool> drawer-open: false;
    in-out property <TDrawerPlacement> drawer-placement: TDrawerPlacement.right;
    in-out property <float> progress-value: 40;
    // Defaults to the component's own default (no easing), so the slider
    // reads as the "live value" case until the switch is flipped.
    in-out property <bool> progress-animated: false;
    // The two selects store their current value on a surviving location —
    // TMessage.placement is a global, drawer-placement lives on
    // MainWindow — while the section itself is rebuilt on every page
    // switch. So the select indices are derived from those values, not
    // stored: a rebuilt section reads the same value back into the same
    // index, and the label can never fall out of sync with the actual
    // placement.
    private property <int> drawer-side-index:
        root.drawer-placement == TDrawerPlacement.right ? 0
        : root.drawer-placement == TDrawerPlacement.left ? 1
        : root.drawer-placement == TDrawerPlacement.top ? 2
        : 3;
    private property <int> placement-index:
        TMessage.placement == TMessagePlacement.top-center ? 0
        : TMessage.placement == TMessagePlacement.top-left ? 1
        : TMessage.placement == TMessagePlacement.top-right ? 2
        : TMessage.placement == TMessagePlacement.bottom-center ? 3
        : TMessage.placement == TMessagePlacement.bottom-left ? 4
        : 5;

    in property <[TSelectItem]> drawer-side-items: [
        { label: "右侧", value: "right", disabled: false },
        { label: "左侧", value: "left", disabled: false },
        { label: "顶部", value: "top", disabled: false },
        { label: "底部", value: "bottom", disabled: false },
    ];
    // Same order as `drawer-side-items`, so the TSelect index picks directly.
    in property <[TDrawerPlacement]> drawer-placements: [
        TDrawerPlacement.right,
        TDrawerPlacement.left,
        TDrawerPlacement.top,
        TDrawerPlacement.bottom,
    ];

    in property <[TSelectItem]> placement-items: [
        { label: "顶部居中", value: "top-center", disabled: false },
        { label: "顶部居左", value: "top-left", disabled: false },
        { label: "顶部居右", value: "top-right", disabled: false },
        { label: "底部居中", value: "bottom-center", disabled: false },
        { label: "底部居左", value: "bottom-left", disabled: false },
        { label: "底部居右", value: "bottom-right", disabled: false },
    ];
    // Same order as `placement-items`.
    in property <[TMessagePlacement]> message-placements: [
        TMessagePlacement.top-center,
        TMessagePlacement.top-left,
        TMessagePlacement.top-right,
        TMessagePlacement.bottom-center,
        TMessagePlacement.bottom-left,
        TMessagePlacement.bottom-right,
    ];

    // Service dialog outcome → toast, demonstrating result-seq listening.
    private property <int> svc-dialog-result: TDialogService.result-seq;
    changed svc-dialog-result => {
        TMessage.info(TDialogService.accepted ? "服务框: 已确认" : "服务框: 已取消/关闭");
    }

    // ======================== TAlert ========================
    DemoSection {
        title: "警告提示 TAlert";
        code: "import { TAlert } from \"@tela-ui/feedback.slint\";\n\nTAlert { theme: TThemeRole.success; title: \"操作成功\"; description: \"表单已成功提交。\"; closable: true; }";

        VerticalLayout {
            spacing: 12px;

            TAlert { theme: TThemeRole.default; title: "信息提示"; description: "这是一条普通的信息提示,用于展示需要用户关注的内容。"; closable: true; }
            TAlert { theme: TThemeRole.success; title: "操作成功"; description: "表单已成功提交。"; closable: true; }
            TAlert { theme: TThemeRole.warning; title: "警告提示"; description: "磁盘剩余空间不足 10%,请及时清理。"; closable: true; }
            TAlert { theme: TThemeRole.error; title: "错误提示"; description: "网络连接失败,请检查网络后重试。"; closable: true; }
        }
    }

    // ======================== Message ======================
    DemoSection {
        title: "全局消息 Message";
        code: "import { TMessage, TMessagePlacement } from \"@tela-ui/feedback.slint\";\n\nTMessage.success(\"保存成功\");\nTMessage.placement = TMessagePlacement.bottom-right;";

        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;

                TText {
                    text: "消息位置";
                    font-size: TTheme.font-size-m;
                    color: TTheme.text-color-secondary;
                    vertical-alignment: center;
                }

                TSelect {
                    width: 160px;
                    items: root.placement-items;
                    current-index <=> root.placement-index;
                    selected(i, v) => {
                        TMessage.placement = root.message-placements[i];
                    }
                }

                // Absorbs the leftover row space.
                Rectangle { }
            }

            HorizontalLayout {
                spacing: 12px;

                TButton { text: "信息"; clicked => { TMessage.info("这是一条信息消息"); } }
                TButton { theme: TThemeRole.success; text: "成功"; clicked => { TMessage.success("保存成功"); } }
                TButton { theme: TThemeRole.warning; text: "警告"; clicked => { TMessage.warning("请注意潜在风险"); } }
                TButton { theme: TThemeRole.error; text: "错误"; clicked => { TMessage.error("操作失败,请重试"); } }
                Rectangle { }
            }
        }
    }

    // ======================= Notification ==================
    DemoSection {
        title: "通知 Notification";
        code: "import { TNotification, TNotificationOverlay } from \"@tela-ui/feedback.slint\";\n\n// 窗口根部放置一次:\nTNotificationOverlay { }\n\n// 任意代码调用:\nTNotification.info(\"提示\", \"这是一条信息通知\");\nTNotification.success(\"操作成功\", \"数据已保存\");";

        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;

                TButton { text: "信息通知"; clicked => { TNotification.info("提示", "这是一条信息通知,右上角堆叠展示"); } }
                TButton { theme: TThemeRole.success; text: "成功通知"; clicked => { TNotification.success("操作成功", "数据已保存"); } }
                TButton { theme: TThemeRole.warning; text: "警告通知"; clicked => { TNotification.warning("空间不足", "磁盘剩余空间不足 10%,请及时清理,或考虑升级更大容量的磁盘以获得更好的使用体验。"); } }
                TButton { theme: TThemeRole.error; text: "错误通知"; clicked => { TNotification.error("操作失败", "网络连接失败,请重试"); } }

                // Absorbs the leftover row space.
                Rectangle { }
            }

            TCaption { text: "通知显示在窗口右上角, 多条自动堆叠 (最多 4 条, 满员时挤掉最旧一条), 4.5 秒后自动消失, 也可点击关闭。窗口根部需要一个 TNotificationOverlay。"; wrap: word-wrap; }
        }
    }

    // ======================== TDialog =======================
    DemoSection {
        title: "对话框 TDialog";
        code: "import { TDialog } from \"@tela-ui/feedback.slint\";\n\n// 窗口根部:\nTDialog {\n    open <=> open;\n    title: \"对话框标题\";\n    content: \"这是内容\";\n    accepted => { … }\n    canceled => { … }\n}";

        HorizontalLayout {
            spacing: 12px;

            TButton { variant: TButtonVariant.outline; theme: TThemeRole.primary; text: "打开对话框"; clicked => { root.dialog-open = true; } }
            TCaption { text: "对话框本体挂载在窗口根部 (MainWindow), 点击遮罩或按钮关闭。"; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }

    // ==================== TDialogService ====================
    DemoSection {
        title: "对话框服务 TDialogService";
        code: "import { TDialogService, TDialogServiceOverlay } from \"@tela-ui/feedback.slint\";\n\n// 窗口根部放置一次:\nTDialogServiceOverlay { }\n\n// 任意代码调用:\nTDialogService.confirm(\"删除\", \"确认删除该项?\");\nTDialogService.alert(\"提示\", \"仅确认按钮\");\n\n// 结果监听 (result-seq + accepted):\nprivate property <int> r: TDialogService.result-seq;\nchanged r => { if (TDialogService.accepted) { /* 已确认 */ } }";

        HorizontalLayout {
            spacing: 12px;

            TButton { variant: TButtonVariant.outline; theme: TThemeRole.primary; text: "服务式 confirm"; clicked => { TDialogService.confirm("服务式确认框", "深层组件代码或 Rust 皆可免接线直接调用, 结果经 result-seq 广播。"); } }
            TButton { variant: TButtonVariant.outline; text: "服务式 alert"; clicked => { TDialogService.alert("服务式警示框", "alert() 只有确认按钮, 适合纯告知场景。"); } }
            TCaption { text: "ESC / 遮罩 / 按钮三条关闭路径都算一次结果, 右上角 toast 展示结果。"; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }

    // ==================== TLoadingService ====================
    DemoSection {
        title: "加载服务 TLoadingService";
        code: "import { TLoadingService, TLoadingServiceOverlay } from \"@tela-ui/feedback.slint\";\n\n// 窗口根部放置一次:\nTLoadingServiceOverlay { }\n\n// 任意代码调用:\nTLoadingService.show(\"保存中…\");\nTLoadingService.hide();";

        HorizontalLayout {
            spacing: 12px;

            TButton { variant: TButtonVariant.outline; theme: TThemeRole.primary; text: "全屏加载 2 秒"; clicked => { TLoadingService.show("拼命加载中…"); load-timer.start(); } }
            TCaption { text: "全屏遮罩阻断指针输入; 是状态而非浮层, ESC 不关闭。"; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }

    // ======================== TDrawer =======================
    DemoSection {
        title: "抽屉 TDrawer";
        code: "import { TDrawer } from \"@tela-ui/feedback.slint\";\n\n// 窗口根部:\nTDrawer {\n    open <=> open;\n    placement: TDrawerPlacement.right;\n    title: \"抽屉标题\";\n    TParagraph { text: \"面板主体由子元素提供\"; }\n}";

        HorizontalLayout {
            spacing: 12px;

            TSelect {
                width: 120px;
                items: root.drawer-side-items;
                current-index <=> root.drawer-side-index;
                selected(i, v) => {
                    root.drawer-placement = root.drawer-placements[i];
                }
            }

            TButton { variant: TButtonVariant.outline; theme: TThemeRole.primary; text: "打开抽屉"; clicked => { root.drawer-open = true; } }
            TCaption { text: "抽屉本体挂载在窗口根部, 从指定边缘滑出。"; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }

    // ======================= TPopconfirm ====================
    DemoSection {
        title: "气泡确认 TPopconfirm";
        code: "import { TPopconfirm } from \"@tela-ui/feedback.slint\";\n\nTPopconfirm {\n    text: \"确定删除吗?\";\n    confirm => { … }\n    TButton { text: \"删除\"; clicked => pc.toggle(); } // auto-open: false\n}";

        HorizontalLayout {
            spacing: 24px;

            // TPopconfirm on a TButton trigger: auto-open off, toggle from
            // the button's clicked handler.
            pc := TPopconfirm {
                auto-open: false;
                text: "确定删除这条数据吗?";
                confirm => { TMessage.success("已删除"); }
                cancel => { TMessage.info("已取消"); }

                TButton {
                    theme: TThemeRole.error;
                    variant: TButtonVariant.outline;
                    text: "删除";
                    clicked => { pc.toggle(); }
                }
            }

            // TPopconfirm on a static trigger: auto-open handles it.
            TPopconfirm {
                text: "确认提交表单吗?";
                placement: TPopupPlacement.bottom-start;

                Rectangle {
                    width: 120px;
                    height: TTheme.height-m;
                    background: TTheme.bg-color-secondarycontainer;
                    border-radius: TTheme.radius-default;

                    TText {
                        text: "点击确认";
                        font-size: TTheme.font-size-m;
                        color: TTheme.text-color-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { }
        }
    }

    // ======================== TProgress =====================
    DemoSection {
        title: "进度 TProgress(拖动滑块实时变化)";
        code: "import { TProgress } from \"@tela-ui/feedback.slint\";\n\nTProgress { value: 40; theme: TThemeRole.primary; }\nTProgress { value: 66; theme: TThemeRole.success; variant: TProgressVariant.circle; }\nTProgress { value: 90; theme: TThemeRole.error; show-label: false; }\n// 默认数值直通; 一次性跳变想要缓动就打开:\nTProgress { value: v; animated: true; }";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 32px;

                TProgress { value: root.progress-value; theme: TThemeRole.primary; horizontal-stretch: 1; animated: root.progress-animated; }
                TProgress { value: 66; theme: TThemeRole.success; horizontal-stretch: 1; }
                TProgress { value: 30; theme: TThemeRole.warning; horizontal-stretch: 1; }
                TProgress { value: 90; theme: TThemeRole.error; horizontal-stretch: 1; show-label: false; }
            }

            HorizontalLayout {
                spacing: 32px;
                TProgress { variant: TProgressVariant.circle; value: root.progress-value; theme: TThemeRole.primary; animated: root.progress-animated; }
                TProgress { variant: TProgressVariant.circle; value: 66; theme: TThemeRole.success; }
                TProgress { variant: TProgressVariant.circle; value: 30; theme: TThemeRole.warning; }
                TProgress { variant: TProgressVariant.circle; value: 100; theme: TThemeRole.error; }
                // Absorbs the leftover row space.
                Rectangle { }
            }

            TSlider {
                value <=> root.progress-value;
            }

            HorizontalLayout {
                spacing: TTheme.spacing-4;

                TSwitch {
                    checked <=> root.progress-animated;
                }

                TCaption {
                    vertical-alignment: center;
                    text: "缓动动画 — 关 (默认) 时滑块拖到哪数值就到哪; 开时那两根进度按 200ms 缓动追上去。";
                }
            }
        }
    }

    // ========================= TResult ======================
    DemoSection {
        title: "结果页 TResult";
        code: "import { TResult } from \"@tela-ui/feedback.slint\";\n\nTResult {\n    status: TResultStatus.success;\n    title: \"提交成功\";\n    description: \"表单已提交。\";\n    TButton { text: \"查看详情\"; } // 子元素作为操作区\n}";

        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                width: 380px;
                height: 260px;

                TResult {
                    status: TResultStatus.success;
                    title: "提交成功";
                    description: "表单已提交,审核结果将以消息通知。";

                    TButton { text: "继续填写"; }
                    TButton { theme: TThemeRole.primary; text: "查看详情"; }
                }
            }

            Rectangle {
                width: 380px;
                height: 260px;

                TResult {
                    status: TResultStatus.error;
                    title: "提交失败";
                    description: "网络连接失败,请检查网络后重试。";

                    TButton { variant: TButtonVariant.outline; text: "返回修改"; }
                    TButton { theme: TThemeRole.error; text: "重新提交"; }
                }
            }

            Rectangle { }
        }
    }

    // Auto-hide for the loading demo: 2s after show.
    // A bare Timer sits directly in the layout — it is layout-invisible in
    // 1.18 (no slot, no spacing; probe-measured 40+28+40 with a Timer
    // between), so placement does not affect the page.
    load-timer := Timer {
        interval: 2s;
        // Default-running would keep the timer armed forever and burn
        // cycles; restart() alone only restarts a previously started
        // timer, so the click handler must start() it explicitly.
        running: false;
        triggered => {
            TLoadingService.hide();
        }
    }
}
