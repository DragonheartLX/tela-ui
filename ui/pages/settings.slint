// Page: 设置 (Settings) — theme-mode preferences, written straight to the
// TTheme global so the whole gallery (light and dark) switches live.
// Standalone TRadio buttons (not TRadioGroup) so `selected` stays a reactive
// binding to `TTheme.preference` instead of the group's internal value.

import { TTheme,  TThemePreference } from "@tela-ui/theme.slint";
import { TCaption, TParagraph } from "@tela-ui/base.slint";
import { TCard, TCodeBlock, TRadio } from "@tela-ui/common.slint";

export component SettingsSection inherits VerticalLayout {
    spacing: 28px;

    TCard {
        title: "主题模式 TTheme mode";

        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: TTheme.margin-l;

                TRadio {
                    text: "浅色";
                    selected: TTheme.preference == TThemePreference.light;
                    clicked => {
                        TTheme.preference = TThemePreference.light;
                    }
                }
                TRadio {
                    text: "深色";
                    selected: TTheme.preference == TThemePreference.dark;
                    clicked => {
                        TTheme.preference = TThemePreference.dark;
                    }
                }
                TRadio {
                    text: "跟随系统";
                    selected: TTheme.preference == TThemePreference.system;
                    clicked => {
                        TTheme.preference = TThemePreference.system;
                    }
                }
            }

            TCaption { text: "选择即时写入 TTheme.preference; 跟随系统时实际模式由操作系统的深浅色设置决定, 侧边栏底部的按钮仍是亮暗快捷切换。"; }
        }
    }

    TCodeBlock { code: "import { TTheme, TThemePreference } from \"@tela-ui/theme.slint\";\n\nTTheme.preference = TThemePreference.dark;\n// TTheme.is-dark 是实际生效的模式 (system 已按系统解析)"; }

    TCard {
        title: "关于 About";

        VerticalLayout {
            spacing: 8px;

            TParagraph { text: "Tela UI — TDesign 风格的 Slint 组件库。所有 token 都在 TTheme 单例上, 此页的修改即时作用于整个演示应用。"; }
        }
    }
}
