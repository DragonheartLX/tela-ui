// Gallery section: 内容 (TCollapse / TTable / TCarousel / TTree / TList /
// TSplitter), 一个组件一张卡.

import { TTheme, TThemeRole } from "@tela-ui/theme.slint";
import { TIconSet, TCaption, TText } from "@tela-ui/base.slint";
import { TCollapse, TCarousel, TTable, TTree, TTreeItem, TTreeBranch, TSplitter, TSplitterVertical, TSplitterPane, TSplitterPanePrimary, TSplitterPanePrimaryVertical, TTableAlign, TList, TListItem } from "@tela-ui/content.slint";
import { GallerySection } from "../gallery-section.slint";

export component ContentSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> pane-size: "240px";
    in-out property <int> list-index: -1;

    // ======================== TCollapse =====================
    GallerySection {
        title: "折叠面板 TCollapse";
        code: "import { TCollapse } from \"@tela-ui/content.slint\";\n\n// 手风琴: accordion: true, current-index 记录展开项\nTCollapse { accordion: true; items: [{ label: \"面板一\", content: \"…\" }, …]; }";

        HorizontalLayout {
            spacing: 24px;

            TCollapse {
                horizontal-stretch: 1;
                accordion: true;
                items: [
                    { label: "什么是 Tela UI?", content: "TDesign 风格的 Slint 第三方组件库,提供主题令牌、基础与常用组件,支持亮暗双主题。" },
                    { label: "如何自定义主题?", content: "通过 TTheme.light / TTheme.dark 预设逐项修改,或整体替换 theme 配置。" },
                    { label: "是否支持暗色模式?", content: "支持,preference 设为 dark 或直接跟随系统。" },
                ];
            }

            TCollapse {
                horizontal-stretch: 1;
                items: [
                    { label: "面板一", content: "非手风琴模式下多个面板可同时展开。" },
                    { label: "面板二", content: "每个面板独立开关,展开收起带高度过渡动画。" },
                    { label: "禁用面板", content: "这一项不可展开。", disabled: true },
                ];
            }
        }
    }

    // ========================= TTable =======================
    GallerySection {
        title: "表格 TTable";
        code: "import { TTable, TTableAlign } from \"@tela-ui/content.slint\";\n\nTTable {\n    height: 340px;\n    columns: [\n        { title: \"组件\", width: 200px },\n        { title: \"类别\", width: 140px },\n        { title: \"代码行数\", width: 180px, align: TTableAlign.right, sortable: true },\n        { title: \"说明\", width: 520px },\n        { title: \"维护\", width: 160px },\n    ];\n    rows: [\n        { cells: [\"TButton\", \"基础\", \"155\", \"主要操作按钮\", \"基础组\"] },\n        { cells: [\"TSelect\", \"选择\", \"195\", \"下拉选择器\", \"选择组\"] },\n        { cells: [\"TTable\", \"内容\", \"240\", \"列定义 + 行模型, 表头排序\", \"内容组\"] },\n        { cells: [\"TDialog\", \"浮层\", \"125\", \"模态对话框\", \"浮层组\"] },\n        { cells: [\"TCarousel\", \"内容\", \"152\", \"走马灯\", \"内容组\"] },\n        { cells: [\"TTooltipArea\", \"浮层\", \"194\", \"悬停气泡\", \"浮层组\"] },\n    ];\n}\n\nTTable {\n    height: 160px;\n    columns: [\n        { title: \"任务\", width: 0px },\n        { title: \"负责人\", width: 120px },\n        { title: \"状态\", width: 100px },\n    ];\n    empty-text: \"暂无任务\";\n}";

        VerticalLayout {
            spacing: 16px;

            TTable {
                height: 340px;
                columns: [
                    { title: "组件", width: 200px },
                    { title: "类别", width: 140px },
                    { title: "代码行数", width: 180px, align: TTableAlign.right, sortable: true },
                    { title: "说明", width: 520px },
                    { title: "维护", width: 160px },
                ];
                rows: [
                    { cells: ["TButton", "基础", "155", "主要操作按钮", "基础组"] },
                    { cells: ["TSelect", "选择", "195", "下拉选择器", "选择组"] },
                    { cells: ["TTable", "内容", "240", "列定义 + 行模型, 表头排序", "内容组"] },
                    { cells: ["TDialog", "浮层", "125", "模态对话框", "浮层组"] },
                    { cells: ["TCarousel", "内容", "152", "走马灯", "内容组"] },
                    { cells: ["TTooltipArea", "浮层", "194", "悬停气泡", "浮层组"] },
                ];
            }

            TTable {
                height: 160px;
                columns: [
                    { title: "任务", width: 0px },
                    { title: "负责人", width: 120px },
                    { title: "状态", width: 100px },
                ];
                empty-text: "暂无任务";
            }

            TCaption {
                text: "点击可排序列切换升序 / 降序 / 取消, 行重排由宿主在 sort-changed 里完成; 列宽超出时拖动底部滚动条或横向滚轮, 表头同步。第二张表演示空态。";
                wrap: word-wrap;
            }
        }
    }

    // ======================== TCarousel =====================
    GallerySection {
        title: "走马灯 TCarousel";
        code: "import { TCarousel } from \"@tela-ui/content.slint\";\n\nTCarousel {\n    height: 240px;\n    autoplay: true;\n    interval: 3s;\n    items: [\n        { image: @image-url(\"../assets/slide-1.svg\") },\n        { image: @image-url(\"../assets/slide-2.svg\") },\n        { image: @image-url(\"../assets/slide-3.svg\") },\n    ];\n}";

        TCarousel {
            height: 240px;
            autoplay: true;
            interval: 3s;
            items: [
                { image: @image-url("../assets/slide-1.svg") },
                { image: @image-url("../assets/slide-2.svg") },
                { image: @image-url("../assets/slide-3.svg") },
            ];
        }
    }
    // ========================= TTree ========================
    GallerySection {
        title: "树形控件 TTree";
        code: "import { TTree, TTreeItem, TTreeBranch } from \"@tela-ui/content.slint\";\n\nTTree {\n    width: 220px;\n\n    TTreeItem { label: \"概览\"; value: \"overview\"; }\n    TTreeItem { label: \"统计\"; value: \"stats\"; }\n\n    TTreeBranch {\n        label: \"文件\";\n        opened: true;\n        TTreeItem { label: \"文件 1.txt\"; value: \"file-1\"; icon: TIconSet.File; }\n        TTreeItem { label: \"文件 2.txt\"; value: \"file-2\"; icon: TIconSet.File; }\n\n        TTreeBranch {\n            label: \"子文件夹\";\n            opened: true;\n            TTreeItem { label: \"文件 3.txt\"; value: \"file-3\"; icon: TIconSet.File; }\n        }\n    }\n\n    TTreeBranch {\n        label: \"设置\";\n        TTreeItem { label: \"外观\"; value: \"appearance\"; }\n        TTreeItem { label: \"禁用项\"; value: \"disabled-node\"; enabled: false; }\n    }\n\n    TTreeItem { label: \"关于\"; value: \"about\"; }\n}";

        HorizontalLayout {
            spacing: 24px;

            TTree {
                width: 220px;

                TTreeItem { label: "概览"; value: "overview"; }
                TTreeItem { label: "统计"; value: "stats"; }

                TTreeBranch {
                    label: "文件";
                    opened: true;
                    TTreeItem { label: "文件 1.txt"; value: "file-1"; icon: TIconSet.File; }
                    TTreeItem { label: "文件 2.txt"; value: "file-2"; icon: TIconSet.File; }

                    TTreeBranch {
                        label: "子文件夹";
                        opened: true;
                        TTreeItem { label: "文件 3.txt"; value: "file-3"; icon: TIconSet.File; }
                    }
                }

                TTreeBranch {
                    label: "设置";
                    TTreeItem { label: "外观"; value: "appearance"; }
                    TTreeItem { label: "禁用项"; value: "disabled-node"; enabled: false; }
                }

                TTreeItem { label: "关于"; value: "about"; }
            }
        }

        TCaption {
            text: "节点嵌套声明, 深度不限 (分支用 @children 承载子节点); 点分支行折叠/展开, 折叠靠裁剪高度并带动画; 点叶子节点选中, 选中值经 TTreeLogic 全局共享 (一个窗口只维护一份选中态); disabled 节点不响应点击且不高亮。";
            wrap: word-wrap;
        }
    }

    // ========================= TList ========================
    GallerySection {
        title: "列表 TList";
        code: "import { TList } from \"@tela-ui/content.slint\";\n\nTList {\n    width: 320px;\n    height: 240px;\n    selectable: true;\n    current-index <=> root.list-index;\n    items: [\n        { text: \"收件箱\", description: \"12 封未读\" },\n        { text: \"已加星标\", description: \"3 封\" },\n        { text: \"已发送\", icon: TIconSet.Mail },\n        { text: \"草稿箱\", description: \"1 封\", disabled: true },\n        { text: \"垃圾邮件\" },\n        { text: \"已删除\" },\n        { text: \"归档\" },\n    ];\n}\n\nTList {\n    width: 320px;\n    height: 144px;\n    items: [\n        { text: \"暂无描述的列表\" },\n        { text: \"只有标题也可以\" },\n        { text: \"空态看另一个\" },\n    ];\n    empty-text: \"列表为空\";\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TList {
                    width: 320px;
                    height: 240px;
                    selectable: true;
                    current-index <=> root.list-index;
                    items: [
                        { text: "收件箱", description: "12 封未读" },
                        { text: "已加星标", description: "3 封" },
                        { text: "已发送", icon: TIconSet.Mail },
                        { text: "草稿箱", description: "1 封", disabled: true },
                        { text: "垃圾邮件" },
                        { text: "已删除" },
                        { text: "归档" },
                    ];
                }

                TList {
                    width: 320px;
                    height: 144px;
                    items: [
                        { text: "暂无描述的列表" },
                        { text: "只有标题也可以" },
                        { text: "空态看另一个" },
                    ];
                    empty-text: "列表为空";
                }

                Rectangle { }
            }

            TCaption { text: "行虚拟化由 ListView 提供 (只实例化可见行); selectable 时点行高亮并回调 changed, row-clicked 每次点击都报; 行高默认 48px 可覆盖。"; wrap: word-wrap; }
        }
    }

    // ======================= TSplitter =======================
    GallerySection {
        title: "分栏 TSplitter";
        code: "import { TSplitter, TSplitterVertical, TSplitterPane,\n    TSplitterPanePrimary, TSplitterPanePrimaryVertical } from \"@tela-ui/content.slint\";\n\nTSplitter {\n    horizontal-stretch: 1;\n\n    TSplitterPanePrimary {\n        size: 240px;\n        min-size: 120px;\n        collapsible: true;\n\n        changed(s) => {\n            root.pane-size = \"\\{round(s / 1px)}px\";\n        }\n\n        Rectangle {\n            background: TTheme.bg-color-secondarycontainer;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"第一栏\\n拖边缘 / 点圆钮折叠\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n                wrap: word-wrap;\n            }\n        }\n    }\n\n    TSplitterPane {\n        Rectangle {\n            background: TTheme.bg-color-container;\n            border-width: 1px;\n            border-color: TTheme.component-stroke;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"第二栏 (填满剩余)\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n            }\n        }\n    }\n}\n\nTSplitterVertical {\n    width: 180px;\n\n    TSplitterPanePrimaryVertical {\n        size: 96px;\n        min-size: 48px;\n        collapsible: true;\n\n        Rectangle {\n            background: TTheme.bg-color-secondarycontainer;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"垂直第一栏\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n            }\n        }\n    }\n\n    TSplitterPane {\n        Rectangle {\n            background: TTheme.bg-color-container;\n            border-width: 1px;\n            border-color: TTheme.component-stroke;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"垂直第二栏\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n            }\n        }\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                height: 220px;
                spacing: 24px;

                TSplitter {
                    horizontal-stretch: 1;

                    TSplitterPanePrimary {
                        size: 240px;
                        min-size: 120px;
                        collapsible: true;

                        changed(s) => {
                            root.pane-size = "\{round(s / 1px)}px";
                        }

                        Rectangle {
                            background: TTheme.bg-color-secondarycontainer;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "第一栏\n拖边缘 / 点圆钮折叠";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    TSplitterPane {
                        Rectangle {
                            background: TTheme.bg-color-container;
                            border-width: 1px;
                            border-color: TTheme.component-stroke;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "第二栏 (填满剩余)";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                TSplitterVertical {
                    width: 180px;

                    TSplitterPanePrimaryVertical {
                        size: 96px;
                        min-size: 48px;
                        collapsible: true;

                        Rectangle {
                            background: TTheme.bg-color-secondarycontainer;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "垂直第一栏";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TSplitterPane {
                        Rectangle {
                            background: TTheme.bg-color-container;
                            border-width: 1px;
                            border-color: TTheme.component-stroke;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "垂直第二栏";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            TCaption {
                text: "第一栏宽度随拖拽变化 (当前 \{root.pane-size}, 下限 min-size), 圆形按钮折叠/展开, 尺寸由组件自己维护, 一个窗口可放多个分栏; 第二栏无下限, 可被拖到 0。";
                wrap: word-wrap;
            }
        }
    }
}
