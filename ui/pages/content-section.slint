// Gallery section: 内容 (TCollapse / TTable / TCarousel / TTree / TList /
// TCell / TSortable / TSplitter / TSticky / TSwipeCell / TPullDownRefresh /
// TFooter), 一个组件一张卡.

import { TTheme, TThemeRole } from "@tela-ui/theme.slint";
import { TIconSet, TCaption, TText, TButton } from "@tela-ui/base.slint";
import {
    TCollapse,
    TCarousel,
    TTable,
    TTree,
    TTreeItem,
    TTreeBranch,
    TSplitter,
    TSplitterVertical,
    TSplitterPane,
    TSplitterPanePrimary,
    TSplitterPanePrimaryVertical,
    TTableAlign,
    TList,
    TListItem,
    TCell,
    TCellGroup,
    TSortable,
    TSortableItem,
    TSticky,
    TSwipeCell,
    TSwipeSide,
    TPullDownRefresh,
    TFooter,
} from "@tela-ui/content.slint";
import { TScrollBar } from "@tela-ui/display.slint";
import { TMessage } from "@tela-ui/notice.slint";
import { GallerySection } from "../gallery-section.slint";

export component ContentSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> pane-size: "240px";
    in-out property <[TSortableItem]> sort-items: [
        { text: "晨间例会" },
        { text: "需求评审" },
        { text: "设计走查" },
        { text: "代码回审" },
        { text: "发布窗口" },
    ];
    in-out property <int> list-index: -1;
    in-out property <int> refresh-count: 0;

    // ======================== TCollapse =====================
    GallerySection {
        title: "折叠面板 TCollapse";
        code: "import { TCollapse } from \"@tela-ui/content.slint\";\n\n// 手风琴: accordion: true 时同时只展开一项\nTCollapse {\n    width: 420px;\n    accordion: true;\n    items: [\n        { label: \"什么是 Tela UI?\", content: \"TDesign 风格的 Slint 第三方组件库,提供主题令牌、基础与常用组件,支持亮暗双主题。\" },\n        { label: \"如何自定义主题?\", content: \"通过 TTheme.light / TTheme.dark 预设逐项修改,或整体替换 theme 配置。\" },\n        { label: \"是否支持暗色模式?\", content: \"支持,preference 设为 dark 或直接跟随系统。\" },\n    ];\n}";

        HorizontalLayout {
            spacing: 24px;

            TCollapse {
                horizontal-stretch: 1;
                accordion: true;
                items: [
                    {
                        label: "什么是 Tela UI?",
                        content: "TDesign 风格的 Slint 第三方组件库,提供主题令牌、基础与常用组件,支持亮暗双主题。"
                    },
                    {
                        label: "如何自定义主题?",
                        content: "通过 TTheme.light / TTheme.dark 预设逐项修改,或整体替换 theme 配置。"
                    },
                    {
                        label: "是否支持暗色模式?",
                        content: "支持,preference 设为 dark 或直接跟随系统。"
                    },
                ];
            }

            TCollapse {
                horizontal-stretch: 1;
                items: [
                    { label: "面板一", content: "非手风琴模式下多个面板可同时展开。" },
                    {
                        label: "面板二",
                        content: "每个面板独立开关,展开收起带高度过渡动画。"
                    },
                    { label: "禁用面板", content: "这一项不可展开。", disabled: true },
                ];
            }
        }
    }

    // ========================= TTable =======================
    GallerySection {
        title: "表格 TTable";
        code: "import { TTable, TTableAlign } from \"@tela-ui/content.slint\";\n\nTTable {\n    height: 340px;\n    columns: [\n        { title: \"组件\", width: 200px },\n        { title: \"类别\", width: 140px },\n        { title: \"代码行数\", width: 180px, align: TTableAlign.right, sortable: true },\n        { title: \"说明\", width: 520px },\n        { title: \"维护\", width: 160px },\n    ];\n    rows: [\n        { cells: [\"TButton\", \"基础\", \"155\", \"主要操作按钮\", \"基础组\"] },\n        { cells: [\"TSelect\", \"选择\", \"195\", \"下拉选择器\", \"选择组\"] },\n        { cells: [\"TTable\", \"内容\", \"240\", \"列定义 + 行模型, 表头排序\", \"内容组\"] },\n        { cells: [\"TDialog\", \"浮层\", \"125\", \"模态对话框\", \"浮层组\"] },\n        { cells: [\"TCarousel\", \"内容\", \"152\", \"走马灯\", \"内容组\"] },\n        { cells: [\"TTooltipArea\", \"浮层\", \"194\", \"悬停气泡\", \"浮层组\"] },\n    ];\n}\n\nTTable {\n    height: 160px;\n    columns: [\n        { title: \"任务\", width: 0px },\n        { title: \"负责人\", width: 120px },\n        { title: \"状态\", width: 100px },\n    ];\n    empty-text: \"暂无任务\";\n}";

        VerticalLayout {
            spacing: 16px;

            TTable {
                height: 340px;
                columns: [
                    { title: "组件", width: 200px },
                    { title: "类别", width: 140px },
                    { title: "代码行数", width: 180px, align: TTableAlign.right, sortable: true },
                    { title: "说明", width: 520px },
                    { title: "维护", width: 160px },
                ];
                rows: [
                    { cells: ["TButton", "基础", "155", "主要操作按钮", "基础组"] },
                    { cells: ["TSelect", "选择", "195", "下拉选择器", "选择组"] },
                    {
                        cells: ["TTable", "内容", "240", "列定义 + 行模型, 表头排序", "内容组"]
                    },
                    { cells: ["TDialog", "浮层", "125", "模态对话框", "浮层组"] },
                    { cells: ["TCarousel", "内容", "152", "走马灯", "内容组"] },
                    { cells: ["TTooltipArea", "浮层", "194", "悬停气泡", "浮层组"] },
                ];
            }

            TCaption {
                text: "点击可排序列切换升序 / 降序 / 取消, 行重排由宿主在 sort-changed 里完成; 列宽超出时拖动底部滚动条或横向滚轮, 表头同步。";
                wrap: word-wrap;
            }
        }
    }

    // ======================== TCarousel =====================
    GallerySection {
        title: "走马灯 TCarousel";
        code: "import { TCarousel } from \"@tela-ui/content.slint\";\n\nTCarousel {\n    height: 240px;\n    autoplay: true;\n    interval: 3s;\n    items: [\n        { image: @image-url(\"../assets/slide-1.svg\") },\n        { image: @image-url(\"../assets/slide-2.svg\") },\n        { image: @image-url(\"../assets/slide-3.svg\") },\n    ];\n}";

        TCarousel {
            height: 240px;
            autoplay: true;
            interval: 3s;
            items: [
                { image: @image-url("../assets/slide-1.svg") },
                { image: @image-url("../assets/slide-2.svg") },
                { image: @image-url("../assets/slide-3.svg") },
            ];
        }
    }
    // ========================= TTree ========================
    GallerySection {
        title: "树形控件 TTree";
        code: "import { TTree, TTreeItem, TTreeBranch } from \"@tela-ui/content.slint\";\nimport { TIconSet } from \"@tela-ui/base.slint\";\n\nTTree {\n    width: 220px;\n\n    TTreeItem { label: \"概览\"; value: \"overview\"; }\n    TTreeItem { label: \"统计\"; value: \"stats\"; }\n\n    TTreeBranch {\n        label: \"文件\";\n        opened: true;\n        TTreeItem { label: \"文件 1.txt\"; value: \"file-1\"; icon: TIconSet.File; }\n        TTreeItem { label: \"文件 2.txt\"; value: \"file-2\"; icon: TIconSet.File; }\n\n        TTreeBranch {\n            label: \"子文件夹\";\n            opened: true;\n            TTreeItem { label: \"文件 3.txt\"; value: \"file-3\"; icon: TIconSet.File; }\n        }\n    }\n\n    TTreeBranch {\n        label: \"设置\";\n        TTreeItem { label: \"外观\"; value: \"appearance\"; }\n        TTreeItem { label: \"禁用项\"; value: \"disabled-node\"; enabled: false; }\n    }\n\n    TTreeItem { label: \"关于\"; value: \"about\"; }\n}";

        HorizontalLayout {
            spacing: 24px;

            TTree {
                width: 220px;

                TTreeItem {
                    label: "概览";
                    value: "overview";
                }

                TTreeItem {
                    label: "统计";
                    value: "stats";
                }

                TTreeBranch {
                    label: "文件";
                    opened: true;
                    TTreeItem {
                        label: "文件 1.txt";
                        value: "file-1";
                        icon: TIconSet.File;
                    }

                    TTreeItem {
                        label: "文件 2.txt";
                        value: "file-2";
                        icon: TIconSet.File;
                    }

                    TTreeBranch {
                        label: "子文件夹";
                        opened: true;
                        TTreeItem {
                            label: "文件 3.txt";
                            value: "file-3";
                            icon: TIconSet.File;
                        }
                    }
                }

                TTreeBranch {
                    label: "设置";
                    TTreeItem {
                        label: "外观";
                        value: "appearance";
                    }

                    TTreeItem {
                        label: "禁用项";
                        value: "disabled-node";
                        enabled: false;
                    }
                }

                TTreeItem {
                    label: "关于";
                    value: "about";
                }
            }
        }

        TCaption {
            text: "节点嵌套声明, 深度不限 (分支用 @children 承载子节点); 点分支行折叠/展开, 折叠靠裁剪高度并带动画; 点叶子节点选中, 选中值经 TTreeLogic 全局共享 (一个窗口只维护一份选中态); disabled 节点不响应点击且不高亮。";
            wrap: word-wrap;
        }
    }

    // ========================= TList ========================
    GallerySection {
        title: "列表 TList";
        code: "import { TList } from \"@tela-ui/content.slint\";\nimport { TIconSet } from \"@tela-ui/base.slint\";\n\nproperty <int> current-index: -1;\n\nTList {\n    width: 320px;\n    height: 240px;\n    selectable: true;\n    current-index <=> root.current-index;\n    items: [\n        { text: \"收件箱\", description: \"12 封未读\" },\n        { text: \"已加星标\", description: \"3 封\" },\n        { text: \"已发送\", icon: TIconSet.Mail },\n        { text: \"草稿箱\", description: \"1 封\", disabled: true },\n        { text: \"垃圾邮件\" },\n        { text: \"已删除\" },\n        { text: \"归档\" },\n    ];\n}\n\nTList {\n    width: 320px;\n    height: 144px;\n    items: [\n        { text: \"暂无描述的列表\" },\n        { text: \"只有标题也可以\" },\n        { text: \"空态看另一个\" },\n    ];\n    empty-text: \"列表为空\";\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TList {
                    width: 320px;
                    height: 240px;
                    selectable: true;
                    current-index <=> root.list-index;
                    items: [
                        { text: "收件箱", description: "12 封未读" },
                        { text: "已加星标", description: "3 封" },
                        { text: "已发送", icon: TIconSet.Mail },
                        { text: "草稿箱", description: "1 封", disabled: true },
                        { text: "垃圾邮件" },
                        { text: "已删除" },
                        { text: "归档" },
                    ];
                }

                TList {
                    width: 320px;
                    height: 144px;
                    items: [
                        { text: "暂无描述的列表" },
                        { text: "只有标题也可以" },
                        { text: "空态看另一个" },
                    ];
                    empty-text: "列表为空";
                }

                Rectangle { }
            }

            TCaption {
                text: "行虚拟化由 ListView 提供 (只实例化可见行); selectable 时点行高亮并回调 changed, row-clicked 每次点击都报; 行高默认 48px 可覆盖。";
                wrap: word-wrap;
            }
        }
    }

    // ======================= TSplitter =======================
    GallerySection {
        title: "分栏 TSplitter";
        code: "import { TSplitter, TSplitterVertical, TSplitterPane, TSplitterPanePrimary, TSplitterPanePrimaryVertical } from \"@tela-ui/content.slint\";\nimport { TText } from \"@tela-ui/base.slint\";\nimport { TTheme } from \"@tela-ui/theme.slint\";\n\nproperty <string> pane-size: \"240px\";\n\nTSplitter {\n    height: 220px;\n\n    TSplitterPanePrimary {\n        size: 240px;\n        min-size: 120px;\n        collapsible: true;\n\n        changed(s) => {\n            root.pane-size = \"\\{round(s / 1px)}px\";\n        }\n\n        Rectangle {\n            background: TTheme.bg-color-secondarycontainer;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"第一栏\\n拖边缘 / 点圆钮折叠\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n                wrap: word-wrap;\n            }\n        }\n    }\n\n    TSplitterPane {\n        Rectangle {\n            background: TTheme.bg-color-container;\n            border-width: 1px;\n            border-color: TTheme.component-stroke;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"第二栏 (填满剩余)\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n            }\n        }\n    }\n}\n\nTSplitterVertical {\n    width: 180px;\n\n    TSplitterPanePrimaryVertical {\n        size: 96px;\n        min-size: 48px;\n        collapsible: true;\n\n        Rectangle {\n            background: TTheme.bg-color-secondarycontainer;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"垂直第一栏\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n            }\n        }\n    }\n\n    TSplitterPane {\n        Rectangle {\n            background: TTheme.bg-color-container;\n            border-width: 1px;\n            border-color: TTheme.component-stroke;\n            border-radius: TTheme.radius-medium;\n\n            TText {\n                text: \"垂直第二栏\";\n                color: TTheme.text-color-secondary;\n                horizontal-alignment: center;\n                vertical-alignment: center;\n            }\n        }\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                height: 220px;
                spacing: 24px;

                TSplitter {
                    horizontal-stretch: 1;

                    TSplitterPanePrimary {
                        size: 240px;
                        min-size: 120px;
                        collapsible: true;

                        changed(s) => {
                            root.pane-size = "\{round(s / 1px)}px";
                        }

                        Rectangle {
                            background: TTheme.bg-color-secondarycontainer;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "第一栏\n拖边缘 / 点圆钮折叠";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    TSplitterPane {
                        Rectangle {
                            background: TTheme.bg-color-container;
                            border-width: 1px;
                            border-color: TTheme.component-stroke;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "第二栏 (填满剩余)";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                TSplitterVertical {
                    width: 180px;

                    TSplitterPanePrimaryVertical {
                        size: 96px;
                        min-size: 48px;
                        collapsible: true;

                        Rectangle {
                            background: TTheme.bg-color-secondarycontainer;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "垂直第一栏";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TSplitterPane {
                        Rectangle {
                            background: TTheme.bg-color-container;
                            border-width: 1px;
                            border-color: TTheme.component-stroke;
                            border-radius: TTheme.radius-medium;

                            TText {
                                text: "垂直第二栏";
                                color: TTheme.text-color-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            TCaption {
                text: "第一栏宽度随拖拽变化 (当前 \{root.pane-size}, 下限 min-size), 圆形按钮折叠/展开, 尺寸由组件自己维护, 一个窗口可放多个分栏; 第二栏无下限, 可被拖到 0。";
                wrap: word-wrap;
            }
        }
    }

    // ========================= TCell =========================
    GallerySection {
        title: "单元行 TCell";
        code: "import { TCell, TCellGroup } from \"@tela-ui/content.slint\";\nimport { TIconSet } from \"@tela-ui/base.slint\";\nimport { TMessage } from \"@tela-ui/notice.slint\";\n\nTCellGroup {\n    title: \"设置\";\n\n    TCell {\n        icon: TIconSet.Bell;\n        title: \"消息通知\";\n        description: \"应用内提醒与红点\";\n        arrow: true;\n\n        clicked => { TMessage.info(\"打开通知设置\"); }\n    }\n\n    TCell {\n        icon: TIconSet.Lock;\n        title: \"隐私\";\n\n        clicked => { }\n    }\n\n    TCell {\n        title: \"退出登录\";\n        note: \"v1.0.0\";\n        divider: false; // 组内末行\n    }\n}\n\n// 不分组的裸行:\nTCell { title: \"独立一行\"; note: \"可点击\"; }";

        VerticalLayout {
            spacing: 16px;

            TCellGroup {
                title: "设置";

                TCell {
                    icon: TIconSet.Bell;
                    title: "消息通知";
                    description: "应用内提醒与红点";
                    arrow: true;

                    clicked => {
                        TMessage.info("打开通知设置");
                    }
                }

                TCell {
                    icon: TIconSet.Lock;
                    title: "隐私";
                    note: "已开启";

                    clicked => {
                        TMessage.info("打开隐私设置");
                    }
                }

                TCell {
                    icon: TIconSet.Info;
                    title: "关于";
                    note: "v1.0.0";
                    divider: false;
                }
            }

            TCellGroup {
                bordered: false;

                TCell {
                    title: "退出登录";
                    divider: false;
                }
            }

            TCaption {
                text: "行高随说明文字自适应, 分隔线由每行自绘 — 组内末行设 divider: false; 点击只上报 clicked, 状态由宿主维护。";
                wrap: word-wrap;
            }
        }
    }

    // ======================= TSortable =======================
    GallerySection {
        title: "拖拽排序 TSortable";
        code: "import { TSortable, TSortableItem } from \"@tela-ui/content.slint\";\n\nproperty <[TSortableItem]> sort-items: [\n    { text: \"晨间例会\" },\n    { text: \"需求评审\" },\n    { text: \"设计走查\" },\n    { text: \"代码回审\" },\n    { text: \"发布窗口\" },\n];\n\nTSortable {\n    height: 240px;\n    items: root.sort-items;\n\n    reorder(from, to) => {\n        // 组件只上报, 宿主重建模型:\n        let it = root.sort-items[from];\n        root.sort-items.remove(from);\n        root.sort-items.insert(to, it);\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            TSortable {
                // 与 TList/TTable 演示同款: 固定视口高度。模型长度绑定的首选
                // 高度在整页首帧布局里不可靠 (实例化链耗尽时不重排)。
                height: 240px;
                items: root.sort-items;

                reorder(from, to) => {
                    let it = root.sort-items[from];
                    root.sort-items.remove(from);
                    root.sort-items.insert(to, it);
                }
            }

            TCaption {
                text: "按住任意行拖动, 其余行实时让位预览插入位置, 松手上报 reorder(from, to) — 1.18 语言内没有循环语句, 行序由宿主重建模型完成; 拖拽中列表不滚动。";
                wrap: word-wrap;
            }
        }
    }

    // ========================= TSticky =========================
    GallerySection {
        title: "粘性布局 TSticky";
        code: "import { TSticky } from \"@tela-ui/content.slint\";\nimport { TScrollBar } from \"@tela-ui/display.slint\";\nimport { TText } from \"@tela-ui/base.slint\";\nimport { TTheme } from \"@tela-ui/theme.slint\";\n\nRectangle {\n    height: 260px;\n    clip: true;\n\n    sv := TScrollBar {\n        content-height: 540px; // 3 节 × 180px, 文档里为标题留出 40px\n\n        VerticalLayout {\n            for s in 3: Rectangle {\n                height: 180px;\n                background: TTheme.bg-color-secondarycontainer;\n\n                TText {\n                    x: 16px;\n                    y: 56px;\n                    width: parent.width - 32px;\n                    text: \"第 \\{s + 1} 节正文\";\n                    color: TTheme.text-color-secondary;\n                }\n            }\n        }\n    }\n\n    // 吸顶标题: 与滚动容器同父绝对定位, 声明在 sv 之后盖住正文\n    for i in 3: TSticky {\n        width: sv.width;\n        height: 40px;\n        natural-y: i * 180px;           // 未吸附时标题在文档里的位置\n        bounds-bottom: (i + 1) * 180px; // 本节滚完即释放, 让位给下一节\n        content-y <=> sv.content-y;\n        background: TTheme.bg-color-container;\n\n        TText {\n            x: 16px;\n            width: parent.width - 32px;\n            height: parent.height;\n            text: \"第 \\{i + 1} 节标题 (吸顶)\";\n            vertical-alignment: center;\n            font-weight: TTheme.font-weight-medium;\n        }\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            Rectangle {
                height: 260px;
                border-radius: TTheme.radius-medium;
                clip: true;

                st-sv := TScrollBar {
                    content-height: 540px;

                    VerticalLayout {
                        for s in 3: Rectangle {
                            height: 180px;
                            background: TTheme.bg-color-secondarycontainer;

                            TText {
                                x: 16px;
                                y: 56px;
                                width: parent.width - 32px;
                                text: "第 \{s + 1} 节正文 — 下滚后标题吸附在顶部, 本节滚完释放回文档, 下一节标题滑入接棒。";
                                color: TTheme.text-color-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }

                for i in 3: TSticky {
                    width: st-sv.width;
                    height: 40px;
                    natural-y: i * 180px;
                    bounds-bottom: (i + 1) * 180px;
                    content-y <=> st-sv.content-y;
                    background: TTheme.bg-color-container;

                    TText {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        text: "第 \{i + 1} 节标题 (吸顶)";
                        vertical-alignment: center;
                        font-weight: TTheme.font-weight-medium;
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: TTheme.component-stroke;
                    }
                }
            }

            TCaption {
                text: "CSS position:sticky 语义: natural-y 是标题在文档里的位置, 滚动越过 offset-top 后钉在视口顶, bounds-bottom (文档坐标) 越过后释放; 组件是滚动容器的覆盖层兄弟, 文档里的 40px 由宿主自己预留。pinned / changed(bool) 上报吸附态。";
                wrap: word-wrap;
            }
        }
    }

    // ======================= TSwipeCell =======================
    GallerySection {
        title: "滑动单元格 TSwipeCell";
        code: "import { TSwipeCell, TSwipeSide } from \"@tela-ui/content.slint\";\nimport { TThemeRole, TTheme } from \"@tela-ui/theme.slint\";\nimport { TText } from \"@tela-ui/base.slint\";\nimport { TMessage } from \"@tela-ui/notice.slint\";\n\nTSwipeCell {\n    height: 56px; // 行高由宿主钉住\n    // 底部分隔线默认开, 固定在行上不随内容滑动; 连续列表末行设 divider: false\n    right-actions: [\n        { text: \"编辑\", theme: TThemeRole.primary },\n        { text: \"删除\", theme: TThemeRole.error },\n    ];\n\n    // 内容自备背景与排版 (手势层在内容之下, 不挡子元素自己的点击)\n    Rectangle {\n        background: TTheme.bg-color-container;\n\n        TText {\n            x: TTheme.padding-lr-l;\n            width: parent.width - 2 * TTheme.padding-lr-l;\n            height: parent.height;\n            text: \"左滑查看操作\";\n            vertical-alignment: center;\n        }\n    }\n\n    action-clicked(side, i) => {\n        TMessage.info(side == TSwipeSide.left ? \"左侧操作 \\{i}\" : \"右侧操作 \\{i}\");\n    }\n}";

        VerticalLayout {
            spacing: 0;

            TSwipeCell {
                height: 56px;
                left-actions: [{ text: "选择" }];
                right-actions: [
                    { text: "编辑" },
                    { text: "删除", theme: TThemeRole.error },
                ];

                Rectangle {
                    background: TTheme.bg-color-container;

                    TText {
                        x: TTheme.padding-lr-l;
                        width: parent.width - 2 * TTheme.padding-lr-l;
                        height: parent.height;
                        text: "双向滑动 · 左滑露出编辑/删除, 右滑露出选择";
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                action-clicked(side, i) => {
                    TMessage.info(side == TSwipeSide.left ? "左侧操作 \{i} — 已收起" : "右侧操作 \{i} — 已收起");
                }
            }

            TSwipeCell {
                height: 56px;
                right-actions: [
                    { text: "标记已读" },
                    { text: "删除", theme: TThemeRole.error },
                ];

                Rectangle {
                    background: TTheme.bg-color-container;

                    TText {
                        x: TTheme.padding-lr-l;
                        width: parent.width - 2 * TTheme.padding-lr-l;
                        height: parent.height;
                        text: "仅右侧操作 · 拖过半个操作列松手即吸附展开";
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                action-clicked(side, i) => {
                    TMessage.info("操作 \{i}");
                }
            }

            TSwipeCell {
                height: 56px;
                disabled: true;
                divider: false;
                right-actions: [{ text: "删除", theme: TThemeRole.error }];

                Rectangle {
                    background: TTheme.bg-color-container;

                    TText {
                        x: TTheme.padding-lr-l;
                        width: parent.width - 2 * TTheme.padding-lr-l;
                        height: parent.height;
                        text: "禁用滑动 disabled: true";
                        color: TTheme.text-color-disabled;
                        vertical-alignment: center;
                    }
                }
            }

            TCaption {
                text: "拖动锁定横轴 (纵向手势不触发滑动); 松手时越过操作列一半宽度吸附展开, 否则弹回; 展开态点内容即收起; 点操作按钮先收起再回调 action-clicked(侧, 下标)。左右互斥, left-opened / right-opened 可双向绑定由宿主控制, 吸附结果经 changed(侧, 开合) 上报。底部分隔线 divider 默认开, 固定在行上不随内容滑动 (压住操作列底边, 行高读起来一致), 左侧操作列与线条同起点; 组内末行设 false。";
                wrap: word-wrap;
            }
        }
    }

    // ===================== TPullDownRefresh ====================
    GallerySection {
        title: "下拉刷新 TPullDownRefresh";
        code: "import { TPullDownRefresh } from \"@tela-ui/content.slint\";\nimport { TText } from \"@tela-ui/base.slint\";\nimport { TTheme } from \"@tela-ui/theme.slint\";\n\nproperty <int> refresh-count: 0;\n\nRectangle {\n    height: 240px;\n    clip: true;\n\n    pd := TPullDownRefresh {\n        width: parent.width;\n        height: parent.height;\n        content-height: 8 * 48px; // repeater-only body 钉内容高\n\n        refresh => { root.refresh-count += 1; }\n        // 宿主完成后写 pd.refreshing = false 收起;\n        // 不写则 refresh-timeout (默认 3s) 后自动收起并报 timeout()\n\n        VerticalLayout {\n            for i in 8: Rectangle {\n                height: 48px;\n\n                TText {\n                    x: 16px;\n                    width: parent.width - 32px;\n                    height: parent.height;\n                    text: \"条目 \\{i + 1}\";\n                    vertical-alignment: center;\n                }\n            }\n        }\n    }\n}";

        VerticalLayout {
            spacing: 16px;

            Rectangle {
                height: 260px;
                border-radius: TTheme.radius-medium;
                clip: true;

                pd := TPullDownRefresh {
                    width: parent.width;
                    height: parent.height;
                    // repeater-only 的 body 量不出内容高, 钉死 (12 × 48px)
                    content-height: 12 * 48px;

                    refresh => {
                        root.refresh-count += 1;
                    }

                    VerticalLayout {
                        for i in 12: Rectangle {
                            height: 48px;
                            background: TTheme.bg-color-container;

                            TText {
                                x: TTheme.padding-lr-l;
                                width: parent.width - 2 * TTheme.padding-lr-l;
                                height: parent.height;
                                text: "条目 \{i + 1} — 在列表顶部按住向下拖";
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if i < 11: Rectangle {
                                x: TTheme.padding-lr-l;
                                y: parent.height - self.height;
                                width: parent.width - 2 * TTheme.padding-lr-l;
                                height: 1px;
                                background: TTheme.component-stroke;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;

                TButton {
                    text: "提前完成刷新";

                    clicked => { pd.refreshing = false; }
                }

                TCaption {
                    text: "已刷新 \{root.refresh-count} 次";
                    vertical-alignment: center;
                }

                Rectangle { }
            }

            TCaption {
                text: "顶部按住下拉或滚轮向上滚, 箭头随拉动量翻转, 过阈值 (loading-bar-height) 松手触发 refresh 并锁定加载条 (滚轮没有松手, 越过阈值当次即触发); 宿主写 refreshing: false 收起并短暂显示完成语, 超时 refresh-timeout 自动收起并报 timeout; 向上拖或滚轮向下先把拉动量收回去, 收到底转为滚动列表。拉动量带 0.5 阻尼, 上限 max-bar-height。";
                wrap: word-wrap;
            }
        }
    }

    // ========================= TFooter =========================
    GallerySection {
        title: "页脚 TFooter";
        code: "import { TFooter } from \"@tela-ui/content.slint\";\nimport { TIconSet } from \"@tela-ui/base.slint\";\nimport { TMessage } from \"@tela-ui/notice.slint\";\n\nTFooter {\n    logo: { icon: TIconSet.Star, title: \"Tela UI\" };\n    links: [\n        { name: \"组件总览\" },\n        { name: \"主题定制\" },\n        { name: \"更新日志\" },\n    ];\n    text: \"Copyright © 2026 Tela UI\";\n\n    logo-clicked() => { /* 回到首页 */ }\n    link-clicked(i) => { TMessage.info(\"打开链接 \\{i}\"); }\n}";

        VerticalLayout {
            spacing: 16px;

            TFooter {
                logo: { icon: TIconSet.Star, title: "Tela UI" };
                links: [
                    { name: "组件总览" },
                    { name: "主题定制" },
                    { name: "更新日志" },
                ];
                text: "Copyright © 2026 Tela UI";

                link-clicked(i) => {
                    TMessage.info("打开链接 \{i}");
                }
            }

            TFooter {
                links: [
                    { name: "用户协议" },
                    { name: "隐私政策" },
                ];
                text: "仅链接与版权的精简页脚";
            }

            TCaption {
                text: "logo (图标 + 标题, 可只给其一) / links / text 三段都可省略, 竖排居中; 链接用 TLink 渲染 (悬停下划线), 点击上报 link-clicked(下标), logo 点击上报 logo-clicked(); 跳转由宿主处理。";
                wrap: word-wrap;
            }
        }
    }
}
