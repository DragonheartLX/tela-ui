// Demo section: 基础组件 (Button / Icon / Link / Typography / Divider /
// Loading / Kbd), 一个组件一张卡.

import { TelaTheme, Theme, Size } from "@tela-ui/theme.slint";
import { Button, ButtonVariant, ButtonShape, Link, Icon, TIconSet, Heading, Paragraph, Caption, Kbd, Divider, DividerAlign, Loading } from "@tela-ui/base.slint";
import { Card , CodeBlock} from "@tela-ui/common.slint";

export component BasicsSection inherits VerticalLayout {
    spacing: 28px;

    // ======================= Button =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "按钮 Button";

            VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;
                    Button { text: "默认按钮"; }
                    Button { theme: Theme.primary; text: "主要按钮"; }
                    Button { theme: Theme.success; text: "成功按钮"; }
                    Button { theme: Theme.warning; text: "警告按钮"; }
                    Button { theme: Theme.error; text: "危险按钮"; }
                    // Absorbs the leftover row space.
                    Rectangle { }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Button { variant: ButtonVariant.outline; text: "描边按钮"; }
                    Button { variant: ButtonVariant.outline; theme: Theme.primary; text: "描边按钮"; }
                    Button { variant: ButtonVariant.outline; theme: Theme.error; text: "描边按钮"; }
                    Button { variant: ButtonVariant.text; text: "文字按钮"; }
                    Button { variant: ButtonVariant.text; theme: Theme.primary; text: "文字按钮"; }
                    Button { variant: ButtonVariant.text; theme: Theme.error; text: "文字按钮"; }
                    Rectangle { }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Button { size: Size.small; theme: Theme.primary; text: "小按钮"; }
                    Button { size: Size.medium; theme: Theme.primary; text: "中按钮"; }
                    Button { size: Size.large; theme: Theme.primary; text: "大按钮"; }
                    Button { shape: ButtonShape.square; theme: Theme.primary; icon: TIconSet.Search; }
                    Button { shape: ButtonShape.round; theme: Theme.primary; icon: TIconSet.Pencil; text: "圆形"; }
                    Button { theme: Theme.primary; icon: TIconSet.Download; text: "下载"; }
                    Button { theme: Theme.primary; text: "加载中"; loading: true; }
                    Button { theme: Theme.primary; text: "禁用状态"; disabled: true; }
                    Button { variant: ButtonVariant.outline; text: "禁用状态"; disabled: true; }
                    Rectangle { }
                }
            }
        }

        CodeBlock { code: "import { Button } from \"@tela-ui/base.slint\";\n\nButton { text: \"主要按钮\"; theme: Theme.primary; }\nButton { text: \"描边按钮\"; variant: ButtonVariant.outline; }\nButton { text: \"下载\"; theme: Theme.primary; icon: TIconSet.Download; }\nButton { text: \"加载中\"; theme: Theme.primary; loading: true; }"; }
    }

    // ======================== Icon ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "图标 Icon";

            FlexboxLayout {
                spacing: 20px;

                for ic in [
                    TIconSet.Search, TIconSet.Plus, TIconSet.Minus,
                    TIconSet.X, TIconSet.Check, TIconSet.Menu,
                    TIconSet.Info, TIconSet.CircleCheck, TIconSet.CircleX,
                    TIconSet.CircleAlert, TIconSet.TriangleAlert,
                    TIconSet.Eye, TIconSet.Calendar, TIconSet.User,
                    TIconSet.Bell, TIconSet.Star, TIconSet.Heart,
                    TIconSet.Trash2, TIconSet.Pencil, TIconSet.Settings,
                    TIconSet.Download, TIconSet.Upload, TIconSet.RefreshCw,
                    TIconSet.Image, TIconSet.House, TIconSet.Lock,
                    TIconSet.Mail, TIconSet.Ellipsis, TIconSet.Moon,
                    TIconSet.Sun, TIconSet.StarFill, TIconSet.Inbox,
                ]: Icon {
                    icon: ic;
                    size: 20px;
                    icon-color: TelaTheme.text-color-primary;
                }
            }
        }

        CodeBlock { code: "import { Icon, TIconSet } from \"@tela-ui/base.slint\";\n\nIcon { icon: TIconSet.Search; size: 20px; }\n// 图标是数据 (TIconData): 传 TIconSet 的内置字形或自构 TIconData。"; }
    }

    // ========================= Link =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "链接 Link";

            HorizontalLayout {
                spacing: 24px;
                Link { text: "默认链接"; }
                Link { theme: Theme.success; text: "成功链接"; underline: true; }
                Link { theme: Theme.warning; text: "警告链接"; }
                Link { theme: Theme.error; text: "危险链接"; }
                Link { text: "禁用链接"; disabled: true; }
                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Link } from \"@tela-ui/base.slint\";\n\nLink { text: \"默认链接\"; }\nLink { text: \"成功链接\"; theme: Theme.success; underline: true; }"; }
    }

    // ==================== Typography ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "排版 Typography";

            VerticalLayout {
                spacing: 8px;

                Heading { level: 1; text: "一级标题 Heading 1"; }
                Heading { level: 2; text: "二级标题 Heading 2"; }
                Heading { level: 3; text: "三级标题 Heading 3"; }
                Heading { level: 4; text: "四级标题 Heading 4"; }
                Heading { level: 5; text: "五级标题 Heading 5"; }
                Paragraph {
                    width: 640px;
                    text: "Tela UI 是一套参考 TDesign 设计规范的 Slint 第三方组件库,提供主题令牌、基础组件与常用组件,支持亮暗双主题实时切换。";
                }
                Caption { text: "这是辅助说明文字(Caption)。"; }
            }
        }

        CodeBlock { code: "import { Heading, Paragraph, Caption } from \"@tela-ui/base.slint\";\n\nHeading { level: 1; text: \"一级标题\"; }\nParagraph { text: \"正文内容,wrap: word-wrap 自动换行。\"; }\nCaption { text: \"辅助说明文字\"; }"; }
    }

    // ======================= Divider ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "分割线 Divider";

            VerticalLayout {
                spacing: 4px;

                Divider { text: "居中文字"; }
                Divider { text: "左方文字"; align: DividerAlign.left; }
                Divider { text: "右方文字"; align: DividerAlign.right; }
                Divider { }
            }
        }

        CodeBlock { code: "import { Divider } from \"@tela-ui/base.slint\";\n\nDivider { text: \"居中文字\"; }\nDivider { text: \"左方文字\"; align: DividerAlign.left; }\nDivider { orientation: Orientation.vertical; }"; }
    }

    // ======================= Loading ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "加载 Loading";

            HorizontalLayout {
                spacing: 28px;
                // stretch: 0 — the label's Text leaves the layout's max
                // width unbounded, so the row would otherwise stretch them.
                Loading { size: 16px; horizontal-stretch: 0; }
                Loading { size: 24px; text: "加载中…"; horizontal-stretch: 0; }
                Loading { size: 32px; theme: Theme.success; text: "上传中…"; horizontal-stretch: 0; }
                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Loading } from \"@tela-ui/base.slint\";\n\nLoading { size: 24px; text: \"加载中…\"; }\nLoading { size: 32px; theme: Theme.success; }"; }
    }

    // ========================= Kbd ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "键位 Kbd";

            HorizontalLayout {
                spacing: 8px;

                Text { text: "复制"; font-size: TelaTheme.font-size-m; color: TelaTheme.text-color-secondary; vertical-alignment: center; }
                Kbd { text: "Ctrl"; horizontal-stretch: 0; }
                Text { text: "+"; font-size: TelaTheme.font-size-m; color: TelaTheme.text-color-secondary; vertical-alignment: center; }
                Kbd { text: "C"; horizontal-stretch: 0; }
                Text { text: "粘贴"; font-size: TelaTheme.font-size-m; color: TelaTheme.text-color-secondary; vertical-alignment: center; }
                Kbd { text: "Ctrl"; horizontal-stretch: 0; }
                Text { text: "+"; font-size: TelaTheme.font-size-m; color: TelaTheme.text-color-secondary; vertical-alignment: center; }
                Kbd { text: "V"; horizontal-stretch: 0; }
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Kbd } from \"@tela-ui/base.slint\";\n\nText { text: \"复制\"; }\nKbd { text: \"Ctrl\"; }\nKbd { text: \"C\"; }"; }
    }
}
