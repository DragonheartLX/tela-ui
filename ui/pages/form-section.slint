// Demo section: 数据录入 (Input / Select / TextArea / CheckBox / Radio /
// Switch / Slider / InputNumber / Rate), 一个组件一张卡.

import { TelaTheme, Theme, Size } from "@tela-ui/theme.slint";
import { TIconSet, Caption } from "@tela-ui/base.slint";
import { Input, TextArea, Select, SelectItem, CheckBox, RadioGroup, RadioItem, Switch, Slider, InputNumber, Rate, Card , CodeBlock} from "@tela-ui/common.slint";

export component FormSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> input-text: "";
    in-out property <string> textarea-text: "";
    in-out property <string> city-value: "sh";
    in property <[SelectItem]> city-items: [
        { label: "北京", value: "bj", disabled: false },
        { label: "上海", value: "sh", disabled: false },
        { label: "广州", value: "gz", disabled: false },
        { label: "深圳", value: "sz", disabled: false },
        { label: "杭州", value: "hz", disabled: true },
        { label: "成都", value: "cd", disabled: false },
    ];
    in-out property <bool> check-a: true;
    in-out property <bool> check-b: false;
    in-out property <string> radio-value: "bj";
    in property <[RadioItem]> radio-items: [
        { text: "北京", value: "bj" },
        { text: "上海", value: "sh" },
        { text: "广州", value: "gz" },
    ];
    in-out property <bool> switch-on: true;
    in-out property <float> slider-value: 40;
    in-out property <float> num-value: 1;
    in-out property <float> rate-value: 3;

    // ======================== Input ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "输入框 Input";

            VerticalLayout {
                spacing: 16px;

                Input {
                    placeholder-text: "请输入内容";
                    clearable: true;
                    prefix-icon: TIconSet.Search;
                    text <=> root.input-text;
                }

                HorizontalLayout {
                    spacing: 24px;

                    Input {
                        width: 240px;
                        placeholder-text: "密码";
                        input-type: password;
                        clearable: false;
                    }
                    Input { width: 240px; placeholder-text: "禁用状态"; disabled: true; }
                    Input { width: 240px; text: "只读状态"; read-only: true; }
                    Rectangle { }
                }
            }
        }

        CodeBlock { code: "import { Input } from \"@tela-ui/common.slint\";\n\nInput { placeholder-text: \"请输入内容\"; clearable: true; prefix-icon: TIconSet.Search; text <=> v; }\nInput { placeholder-text: \"密码\"; input-type: password; }"; }
    }

    // ======================== Select =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "选择器 Select";

            HorizontalLayout {
                spacing: 24px;

                Select {
                    width: 240px;
                    placeholder-text: "请选择城市";
                    items: root.city-items;
                    current-value <=> root.city-value;
                }

                Caption { text: "选中: \{root.city-value}"; vertical-alignment: center; }
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Select } from \"@tela-ui/common.slint\";\n\nSelect {\n    items: [{ label: \"北京\", value: \"bj\" }, …];\n    placeholder-text: \"请选择城市\";\n    current-value <=> city;\n}"; }
    }

    // ======================= TextArea ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "多行输入 TextArea";

            TextArea {
                rows: 3;
                placeholder-text: "请输入描述…";
                text <=> root.textarea-text;
            }
        }

        CodeBlock { code: "import { TextArea } from \"@tela-ui/common.slint\";\n\nTextArea { rows: 3; placeholder-text: \"请输入描述…\"; text <=> v; }"; }
    }

    // ======================= CheckBox ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "复选框 CheckBox";

            HorizontalLayout {
                spacing: 24px;

                CheckBox { text: "全选"; indeterminate: root.check-a != root.check-b; checked: root.check-a && root.check-b;
                    changed(c) => { root.check-a = c; root.check-b = c; } }
                CheckBox { text: "选项 A"; checked <=> root.check-a; }
                CheckBox { text: "选项 B"; checked <=> root.check-b; }
                CheckBox { text: "禁用"; disabled: true; }
                CheckBox { text: "选中禁用"; checked: true; disabled: true; }
                // Absorbs the leftover row space: with only fixed-width
                // children the layout spreads the slack between the items
                // and shoves the row against the card edge.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { CheckBox } from \"@tela-ui/common.slint\";\n\nCheckBox { text: \"选项 A\"; checked <=> a; }\nCheckBox { text: \"全选\"; indeterminate: a != b; }"; }
    }

    // ======================== Radio ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "单选框 Radio";

            RadioGroup {
                items: root.radio-items;
                value <=> root.radio-value;
            }
        }

        CodeBlock { code: "import { RadioGroup } from \"@tela-ui/common.slint\";\n\nRadioGroup {\n    items: [{ text: \"北京\", value: \"bj\" }, …];\n    value <=> city;\n}"; }
    }

    // ======================== Switch =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "开关 Switch";

            HorizontalLayout {
                spacing: 24px;

                Switch { checked <=> root.switch-on; }
                Switch { checked: false; }
                Switch { checked: true; disabled: true; }
                Switch { checked: false; disabled: true; }
                Switch { size: Size.small; checked: true; }
                Switch { size: Size.large; checked: false; }
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Switch } from \"@tela-ui/common.slint\";\n\nSwitch { checked <=> on; }\nSwitch { size: Size.small; checked: true; }\nSwitch { disabled: true; }"; }
    }

    // ======================== Slider =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "滑块 Slider";

            Slider {
                value <=> root.slider-value;
            }
        }

        CodeBlock { code: "import { Slider } from \"@tela-ui/common.slint\";\n\nSlider { value <=> v; }"; }
    }

    // ====================== InputNumber ====================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "数字输入框 InputNumber";

            HorizontalLayout {
                spacing: 24px;

                InputNumber {
                    width: 160px;
                    min: 0;
                    max: 10;
                    value <=> root.num-value;
                }
                InputNumber { width: 160px; value: 3.5; min: 0; max: 10; step: 0.5; editable: false; }
                InputNumber { width: 160px; value: 2; disabled: true; }
                Caption { text: "当前值: \{root.num-value}"; vertical-alignment: center; }
                Rectangle { }
            }
        }

        CodeBlock { code: "import { InputNumber } from \"@tela-ui/common.slint\";\n\nInputNumber { min: 0; max: 10; step: 1; value <=> n; }\n// 文本框内 Up/Down 方向键也可步进; 到达边界时对应按钮禁用。"; }
    }

    // ========================= Rate ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "评分 Rate";

            HorizontalLayout {
                spacing: 24px;

                Rate { value <=> root.rate-value; }
                Rate { value: 2; read-only: true; }
                Rate { size: Size.small; theme: Theme.primary; value: 4; }
                Rate { value: 3; disabled: true; }
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Rate } from \"@tela-ui/common.slint\";\n\nRate { value <=> score; }\nRate { value: 2; read-only: true; }\nRate { theme: Theme.primary; size: Size.small; }"; }
    }
}
