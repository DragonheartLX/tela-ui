// Demo section: 数据录入 (TInput / TSelect / TTextArea / TCheckBox / TRadio /
// TSwitch / TSlider / TInputNumber / TRate), 一个组件一张卡.

import { TTheme,  TThemeRole,  TSize } from "@tela-ui/theme.slint";
import { TIconSet, TCaption } from "@tela-ui/base.slint";
import { TInput, TTextArea, TSelect, TSelectItem, TCheckBox, TRadioGroup, TRadioItem, TSwitch, TSlider, TInputNumber, TRate, TSegmented, TCard , TCodeBlock} from "@tela-ui/common.slint";

export component FormSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> input-text: "";
    in-out property <string> textarea-text: "";
    in-out property <string> city-value: "sh";
    in property <[TSelectItem]> city-items: [
        { label: "北京", value: "bj", disabled: false },
        { label: "上海", value: "sh", disabled: false },
        { label: "广州", value: "gz", disabled: false },
        { label: "深圳", value: "sz", disabled: false },
        { label: "杭州", value: "hz", disabled: true },
        { label: "成都", value: "cd", disabled: false },
    ];
    in-out property <bool> check-a: true;
    in-out property <bool> check-b: false;
    in-out property <string> radio-value: "bj";
    in property <[TRadioItem]> radio-items: [
        { text: "北京", value: "bj" },
        { text: "上海", value: "sh" },
        { text: "广州", value: "gz" },
    ];
    in-out property <bool> switch-on: true;
    in-out property <float> slider-value: 40;
    in-out property <float> num-value: 1;
    in-out property <float> rate-value: 3;
    in-out property <int> seg-index: 1;

    // ======================== TInput ========================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "输入框 TInput";

            VerticalLayout {
                spacing: 16px;

                TInput {
                    placeholder-text: "请输入内容";
                    clearable: true;
                    prefix-icon: TIconSet.Search;
                    text <=> root.input-text;
                }

                HorizontalLayout {
                    spacing: 24px;

                    TInput {
                        width: 240px;
                        placeholder-text: "密码";
                        input-type: password;
                        clearable: false;
                    }
                    TInput { width: 240px; placeholder-text: "禁用状态"; disabled: true; }
                    TInput { width: 240px; text: "只读状态"; read-only: true; }
                    Rectangle { }
                }
            }
        }

        TCodeBlock { code: "import { TInput } from \"@tela-ui/common.slint\";\n\nTInput { placeholder-text: \"请输入内容\"; clearable: true; prefix-icon: TIconSet.Search; text <=> v; }\nTInput { placeholder-text: \"密码\"; input-type: password; }"; }
    }

    // ======================== TSelect =======================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "选择器 TSelect";

            HorizontalLayout {
                spacing: 24px;

                TSelect {
                    width: 240px;
                    placeholder-text: "请选择城市";
                    items: root.city-items;
                    current-value <=> root.city-value;
                }

                TCaption { text: "选中: \{root.city-value}"; vertical-alignment: center; }
                Rectangle { }
            }
        }

        TCodeBlock { code: "import { TSelect } from \"@tela-ui/common.slint\";\n\nTSelect {\n    items: [{ label: \"北京\", value: \"bj\" }, …];\n    placeholder-text: \"请选择城市\";\n    current-value <=> city;\n}"; }
    }

    // ======================= TTextArea ======================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "多行输入 TTextArea";

            TTextArea {
                rows: 3;
                placeholder-text: "请输入描述…";
                text <=> root.textarea-text;
            }
        }

        TCodeBlock { code: "import { TTextArea } from \"@tela-ui/common.slint\";\n\nTTextArea { rows: 3; placeholder-text: \"请输入描述…\"; text <=> v; }"; }
    }

    // ======================= TCheckBox ======================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "复选框 TCheckBox";

            HorizontalLayout {
                spacing: 24px;

                TCheckBox { text: "全选"; indeterminate: root.check-a != root.check-b; checked: root.check-a && root.check-b;
                    changed(c) => { root.check-a = c; root.check-b = c; } }
                TCheckBox { text: "选项 A"; checked <=> root.check-a; }
                TCheckBox { text: "选项 B"; checked <=> root.check-b; }
                TCheckBox { text: "禁用"; disabled: true; }
                TCheckBox { text: "选中禁用"; checked: true; disabled: true; }
                // Absorbs the leftover row space: with only fixed-width
                // children the layout spreads the slack between the items
                // and shoves the row against the card edge.
                Rectangle { }
            }
        }

        TCodeBlock { code: "import { TCheckBox } from \"@tela-ui/common.slint\";\n\nTCheckBox { text: \"选项 A\"; checked <=> a; }\nTCheckBox { text: \"全选\"; indeterminate: a != b; }"; }
    }

    // ======================== TRadio ========================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "单选框 TRadio";

            TRadioGroup {
                items: root.radio-items;
                value <=> root.radio-value;
            }
        }

        TCodeBlock { code: "import { TRadioGroup } from \"@tela-ui/common.slint\";\n\nTRadioGroup {\n    items: [{ text: \"北京\", value: \"bj\" }, …];\n    value <=> city;\n}"; }
    }

    // ======================== TSwitch =======================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "开关 TSwitch";

            HorizontalLayout {
                spacing: 24px;

                TSwitch { checked <=> root.switch-on; }
                TSwitch { checked: false; }
                TSwitch { checked: true; disabled: true; }
                TSwitch { checked: false; disabled: true; }
                TSwitch { size: TSize.small; checked: true; }
                TSwitch { size: TSize.large; checked: false; }
                Rectangle { }
            }
        }

        TCodeBlock { code: "import { TSwitch } from \"@tela-ui/common.slint\";\n\nTSwitch { checked <=> on; }\nTSwitch { size: TSize.small; checked: true; }\nTSwitch { disabled: true; }"; }
    }

    // ======================== TSlider =======================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "滑块 TSlider";

            TSlider {
                value <=> root.slider-value;
            }
        }

        TCodeBlock { code: "import { TSlider } from \"@tela-ui/common.slint\";\n\nTSlider { value <=> v; }"; }
    }

    // ====================== TInputNumber ====================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "数字输入框 TInputNumber";

            HorizontalLayout {
                spacing: 24px;

                TInputNumber {
                    width: 160px;
                    min: 0;
                    max: 10;
                    value <=> root.num-value;
                }
                TInputNumber { width: 160px; value: 3.5; min: 0; max: 10; step: 0.5; editable: false; }
                TInputNumber { width: 160px; value: 2; disabled: true; }
                TCaption { text: "当前值: \{root.num-value}"; vertical-alignment: center; }
                Rectangle { }
            }
        }

        TCodeBlock { code: "import { TInputNumber } from \"@tela-ui/common.slint\";\n\nTInputNumber { min: 0; max: 10; step: 1; value <=> n; }\n// 文本框内 Up/Down 方向键也可步进; 到达边界时对应按钮禁用。"; }
    }

    // ========================= TRate ========================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "评分 TRate";

            HorizontalLayout {
                spacing: 24px;

                TRate { value <=> root.rate-value; }
                TRate { value: 2; read-only: true; }
                TRate { size: TSize.small; theme: TThemeRole.primary; value: 4; }
                TRate { value: 3; disabled: true; }
                Rectangle { }
            }
        }

        TCodeBlock { code: "import { TRate } from \"@tela-ui/common.slint\";\n\nTRate { value <=> score; }\nTRate { value: 2; read-only: true; }\nTRate { theme: TThemeRole.primary; size: TSize.small; }"; }
    }
    // ====================== TSegmented =====================
    VerticalLayout {
        spacing: 8px;

        TCard {
            title: "分段控制器 TSegmented";

            VerticalLayout {
                spacing: 12px;

                Rectangle {
                    width: 480px;

                    TSegmented {
                        items: ["日", "周", "月", "年"];
                        current-index <=> root.seg-index;
                    }
                }

                TCaption { text: "当前选中下标: \{root.seg-index}"; }
            }
        }

        TCodeBlock { code: "import { TSegmented } from \"@tela-ui/common.slint\";\n\nRectangle {\n    width: 480px;\n    TSegmented { items: [\"日\", \"周\", \"月\", \"年\"]; current-index <=> i; }\n}"; }
    }

}
