// Gallery section: 数据录入 (TInput / TSelect / TTextArea / TCheckBox / TRadio /
// TSwitch / TSlider / TInputNumber / TRate), 一个组件一张卡.

import { TThemeRole,  TSize } from "@tela-ui/theme.slint";
import { TIconSet, TCaption } from "@tela-ui/base.slint";
import { TInput, TTextArea, TSelect, TSelectItem, TCheckBox, TRadioGroup, TRadioItem, TSwitch, TSlider, TInputNumber, TRate, TSegmented } from "@tela-ui/data-entry.slint";
import { GallerySection } from "../gallery-section.slint";

export component FormSection inherits VerticalLayout {
    spacing: 28px;

    in-out property <string> input-text: "";
    in-out property <string> textarea-text: "";
    in-out property <string> city-value: "sh";
    in property <[TSelectItem]> city-items: [
        { label: "北京", value: "bj", disabled: false },
        { label: "上海", value: "sh", disabled: false },
        { label: "广州", value: "gz", disabled: false },
        { label: "深圳", value: "sz", disabled: false },
        { label: "杭州", value: "hz", disabled: true },
        { label: "成都", value: "cd", disabled: false },
    ];
    in-out property <bool> check-a: true;
    in-out property <bool> check-b: false;
    in-out property <string> radio-value: "bj";
    in property <[TRadioItem]> radio-items: [
        { text: "北京", value: "bj" },
        { text: "上海", value: "sh" },
        { text: "广州", value: "gz" },
    ];
    in-out property <bool> switch-on: true;
    in-out property <float> slider-value: 40;
    in-out property <float> num-value: 1;
    in-out property <float> rate-value: 3;
    in-out property <int> seg-index: 1;

    // ======================== TInput ========================
    GallerySection {
        title: "输入框 TInput";
        code: "import { TInput } from \"@tela-ui/data-entry.slint\";\n\nTInput { placeholder-text: \"请输入内容\"; clearable: true; prefix-icon: TIconSet.Search; text <=> v; }\nTInput { placeholder-text: \"密码\"; input-type: password; }";

        VerticalLayout {
            spacing: 16px;

            TInput {
                placeholder-text: "请输入内容";
                clearable: true;
                prefix-icon: TIconSet.Search;
                text <=> root.input-text;
            }

            HorizontalLayout {
                spacing: 24px;

                TInput {
                    width: 240px;
                    placeholder-text: "密码";
                    input-type: password;
                    clearable: false;
                }
                TInput { width: 240px; placeholder-text: "禁用状态"; disabled: true; }
                TInput { width: 240px; text: "只读状态"; read-only: true; }
                Rectangle { }
            }
        }
    }

    // ======================== TSelect =======================
    GallerySection {
        title: "选择器 TSelect";
        code: "import { TSelect } from \"@tela-ui/data-entry.slint\";\n\nTSelect {\n    items: [{ label: \"北京\", value: \"bj\" }, …];\n    placeholder-text: \"请选择城市\";\n    current-value <=> city;\n}";

        HorizontalLayout {
            spacing: 24px;

            TSelect {
                width: 240px;
                placeholder-text: "请选择城市";
                items: root.city-items;
                current-value <=> root.city-value;
            }

            TCaption { text: "选中: \{root.city-value}"; vertical-alignment: center; }
            Rectangle { }
        }
    }

    // ======================= TTextArea ======================
    GallerySection {
        title: "多行输入 TTextArea";
        code: "import { TTextArea } from \"@tela-ui/data-entry.slint\";\n\nTTextArea { rows: 3; placeholder-text: \"请输入描述…\"; text <=> v; }";

        TTextArea {
            rows: 3;
            placeholder-text: "请输入描述…";
            text <=> root.textarea-text;
        }
    }

    // ======================= TCheckBox ======================
    GallerySection {
        title: "复选框 TCheckBox";
        code: "import { TCheckBox } from \"@tela-ui/data-entry.slint\";\n\nTCheckBox { text: \"选项 A\"; checked <=> a; }\nTCheckBox { text: \"全选\"; indeterminate: a != b; }";

        HorizontalLayout {
            spacing: 24px;

            TCheckBox { text: "全选"; indeterminate: root.check-a != root.check-b; checked: root.check-a && root.check-b;
                changed(c) => { root.check-a = c; root.check-b = c; } }
            TCheckBox { text: "选项 A"; checked <=> root.check-a; }
            TCheckBox { text: "选项 B"; checked <=> root.check-b; }
            TCheckBox { text: "禁用"; disabled: true; }
            TCheckBox { text: "选中禁用"; checked: true; disabled: true; }
            // Absorbs the leftover row space: with only fixed-width
            // children the layout spreads the slack between the items
            // and shoves the row against the card edge.
            Rectangle { }
        }
    }

    // ======================== TRadio ========================
    GallerySection {
        title: "单选框 TRadio";
        code: "import { TRadioGroup } from \"@tela-ui/data-entry.slint\";\n\nTRadioGroup {\n    items: [{ text: \"北京\", value: \"bj\" }, …];\n    value <=> city;\n}";

        TRadioGroup {
            items: root.radio-items;
            value <=> root.radio-value;
        }
    }

    // ======================== TSwitch =======================
    GallerySection {
        title: "开关 TSwitch";
        code: "import { TSwitch } from \"@tela-ui/data-entry.slint\";\n\nTSwitch { checked <=> on; }\nTSwitch { size: TSize.small; checked: true; }\nTSwitch { disabled: true; }";

        HorizontalLayout {
            spacing: 24px;

            TSwitch { checked <=> root.switch-on; }
            TSwitch { checked: false; }
            TSwitch { checked: true; disabled: true; }
            TSwitch { checked: false; disabled: true; }
            TSwitch { size: TSize.small; checked: true; }
            TSwitch { size: TSize.large; checked: false; }
            Rectangle { }
        }
    }

    // ======================== TSlider =======================
    GallerySection {
        title: "滑块 TSlider";
        code: "import { TSlider } from \"@tela-ui/data-entry.slint\";\n\nTSlider { value <=> v; }";

        TSlider {
            value <=> root.slider-value;
        }
    }

    // ====================== TInputNumber ====================
    GallerySection {
        title: "数字输入框 TInputNumber";
        code: "import { TInputNumber } from \"@tela-ui/data-entry.slint\";\n\nTInputNumber { min: 0; max: 10; step: 1; value <=> n; }\n// 文本框内 Up/Down 方向键也可步进; 到达边界时对应按钮禁用。";

        HorizontalLayout {
            spacing: 24px;

            TInputNumber {
                width: 160px;
                min: 0;
                max: 10;
                value <=> root.num-value;
            }
            TInputNumber { width: 160px; value: 3.5; min: 0; max: 10; step: 0.5; editable: false; }
            TInputNumber { width: 160px; value: 2; disabled: true; }
            TCaption { text: "当前值: \{root.num-value}"; vertical-alignment: center; }
            Rectangle { }
        }
    }

    // ========================= TRate ========================
    GallerySection {
        title: "评分 TRate";
        code: "import { TRate } from \"@tela-ui/data-entry.slint\";\n\nTRate { value <=> score; }\nTRate { value: 2; read-only: true; }\nTRate { theme: TThemeRole.primary; size: TSize.small; }";

        HorizontalLayout {
            spacing: 24px;

            TRate { value <=> root.rate-value; }
            TRate { value: 2; read-only: true; }
            TRate { size: TSize.small; theme: TThemeRole.primary; value: 4; }
            TRate { value: 3; disabled: true; }
            Rectangle { }
        }
    }
    // ====================== TSegmented =====================
    GallerySection {
        title: "分段控制器 TSegmented";
        code: "import { TSegmented } from \"@tela-ui/data-entry.slint\";\n\nRectangle {\n    max-width: 480px;\n    TSegmented { items: [\"日\", \"周\", \"月\", \"年\"]; current-index <=> i; }\n}";

        VerticalLayout {
            spacing: 12px;

            Rectangle {
                max-width: 480px;

                TSegmented {
                    items: ["日", "周", "月", "年"];
                    current-index <=> root.seg-index;
                }
            }

            TCaption { text: "当前选中下标: \{root.seg-index}"; }
        }
    }

}
