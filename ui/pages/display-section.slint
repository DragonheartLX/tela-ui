// Gallery section: 展示 (TTag / TBadge / TAvatar / TAvatarGroup / TEmpty /
// TTimeline / TDescriptions / TStatistic / TScrollBar / TComment /
// TCountDown), 一个组件一张卡.

import { TTheme, TThemeRole, TSize } from "@tela-ui/theme.slint";
import { TText, TIcon, TIconSet, TButton, TCaption } from "@tela-ui/base.slint";
import { TTag, TTagVariant, TBadge, TAvatar, TAvatarSize, TAvatarShape, TAvatarGroup, TAvatarGroupItem, TEmpty, TTimeline, TDescriptions, TStatistic, TComment, TCountDown } from "@tela-ui/display.slint";
import { TMessage } from "@tela-ui/notice.slint";
import { TScrollBar } from "@tela-ui/display.slint";
import { TParagraph } from "@tela-ui/base.slint";
import { GallerySection } from "../gallery-section.slint";

export component DisplaySection inherits VerticalLayout {
    spacing: 28px;

    // TComment demo feedback as plain text.
    in-out property <string> comment-status: "暂无操作";

    // ========================= TTag =========================
    GallerySection {
        title: "标签 TTag";
        code: "import { TTag, TTagVariant } from \"@tela-ui/display.slint\";\nimport { TThemeRole } from \"@tela-ui/theme.slint\";\n\nTTag { text: \"主要\"; theme: TThemeRole.primary; }\nTTag { text: \"可关闭\"; theme: TThemeRole.primary; closable: true; }\nTTag { text: \"描边\"; variant: TTagVariant.outline; }";

        HorizontalLayout {
            spacing: 8px;
            TTag { text: "默认"; }
            TTag { theme: TThemeRole.primary; text: "主要"; }
            TTag { theme: TThemeRole.success; text: "成功"; }
            TTag { theme: TThemeRole.warning; text: "警告"; }
            TTag { theme: TThemeRole.error; text: "危险"; }
            TTag { theme: TThemeRole.primary; variant: TTagVariant.dark; text: "深色"; }
            TTag { theme: TThemeRole.primary; variant: TTagVariant.outline; text: "描边"; }
            TTag { theme: TThemeRole.primary; text: "可关闭"; closable: true; }
            TTag { theme: TThemeRole.primary; size: TSize.small; text: "小"; }
            TTag { theme: TThemeRole.primary; size: TSize.large; text: "大"; }
            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ======================== TBadge ========================
    GallerySection {
        title: "徽标 TBadge";
        code: "import { TBadge } from \"@tela-ui/display.slint\";\nimport { TIcon, TIconSet } from \"@tela-ui/base.slint\";\nimport { TTheme } from \"@tela-ui/theme.slint\";\n\nTBadge {\n    count: 6;\n    TIcon { icon: TIconSet.Bell; size: 24px; icon-color: TTheme.text-color-primary; }\n}\nTBadge {\n    count: 128;\n    TIcon { icon: TIconSet.Mail; size: 24px; icon-color: TTheme.text-color-primary; }\n}\nTBadge {\n    dot: true;\n    TIcon { icon: TIconSet.Settings; size: 24px; icon-color: TTheme.text-color-primary; }\n}";

        HorizontalLayout {
            spacing: 28px;

            TBadge {
                count: 6;
                TIcon { icon: TIconSet.Bell; size: 24px; icon-color: TTheme.text-color-primary; }
            }
            TBadge {
                count: 128;
                TIcon { icon: TIconSet.Mail; size: 24px; icon-color: TTheme.text-color-primary; }
            }
            TBadge {
                dot: true;
                TIcon { icon: TIconSet.Settings; size: 24px; icon-color: TTheme.text-color-primary; }
            }

            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ======================== TAvatar =======================
    GallerySection {
        title: "头像 TAvatar";
        code: "import { TAvatar, TAvatarSize, TAvatarShape } from \"@tela-ui/display.slint\";\n\nTAvatar { text: \"T\"; }\nTAvatar { size: TAvatarSize.small; text: \"TD\"; }\nTAvatar { size: TAvatarSize.large; text: \"龙\"; }\nTAvatar { size: TAvatarSize.extra-large; shape: TAvatarShape.square; text: \"\"; }";

        HorizontalLayout {
            spacing: 24px;

            TAvatar { text: "T"; }
            TAvatar { size: TAvatarSize.small; text: "TD"; }
            TAvatar { size: TAvatarSize.large; text: "龙"; }
            TAvatar { size: TAvatarSize.extra-large; shape: TAvatarShape.square; text: ""; }

            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ====================== TAvatarGroup ====================
    GallerySection {
        title: "头像组 TAvatarGroup";
        code: "import { TAvatarGroup, TAvatarSize, TAvatarShape } from \"@tela-ui/display.slint\";\nimport { TMessage } from \"@tela-ui/notice.slint\";\n\nTAvatarGroup {\n    items: [\n        { text: \"龙\" },\n        { text: \"T\" },\n        { text: \"UI\" },\n        { text: \"D\" },\n    ];\n}\n\nTAvatarGroup {\n    max-count: 3;\n    items: [\n        { text: \"A\" },\n        { text: \"B\" },\n        { text: \"C\" },\n        { text: \"D\" },\n        { text: \"E\" },\n        { text: \"F\" },\n    ];\n\n    overflow-clicked => {\n        TMessage.info(\"还有 3 个成员\");\n    }\n}\n\nTAvatarGroup {\n    size: TAvatarSize.small;\n    shape: TAvatarShape.square;\n    items: [\n        { text: \"S\" },\n        { text: \"Q\" },\n        { text: \"R\" },\n    ];\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TAvatarGroup {
                    items: [
                        { text: "龙" },
                        { text: "T" },
                        { text: "UI" },
                        { text: "D" },
                    ];
                }

                TAvatarGroup {
                    max-count: 3;
                    items: [
                        { text: "A" },
                        { text: "B" },
                        { text: "C" },
                        { text: "D" },
                        { text: "E" },
                        { text: "F" },
                    ];

                    overflow-clicked => {
                        TMessage.info("还有 3 个成员");
                    }
                }

                TAvatarGroup {
                    size: TAvatarSize.small;
                    shape: TAvatarShape.square;
                    items: [
                        { text: "S" },
                        { text: "Q" },
                        { text: "R" },
                    ];
                }

                Rectangle { }
            }

            TCaption { text: "成员按声明顺序叠放 (后者在上), 重叠量固定 spacing-4; max-count 截断并渲染 +N 尾像。"; wrap: word-wrap; }
        }
    }

    // ======================== TEmpty ========================
    GallerySection {
        title: "空状态 TEmpty";
        code: "import { TEmpty } from \"@tela-ui/display.slint\";\nimport { TButton, TIconSet } from \"@tela-ui/base.slint\";\nimport { TSize } from \"@tela-ui/theme.slint\";\n\nRectangle {\n    width: 240px;\n    height: 180px;\n    TEmpty { }\n}\n\nRectangle {\n    width: 240px;\n    height: 180px;\n    TEmpty {\n        description: \"暂无订单数据\";\n\n        TButton {\n            size: TSize.small;\n            text: \"立即创建\";\n        }\n    }\n}\n\nRectangle {\n    width: 240px;\n    height: 180px;\n    TEmpty {\n        icon: TIconSet.Search;\n        description: \"未找到相关结果\";\n    }\n}";

        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                width: 240px;
                height: 180px;
                TEmpty { }
            }

            Rectangle {
                width: 240px;
                height: 180px;
                TEmpty {
                    description: "暂无订单数据";

                    TButton {
                        size: TSize.small;
                        text: "立即创建";
                    }
                }
            }

            Rectangle {
                width: 240px;
                height: 180px;
                TEmpty {
                    icon: TIconSet.Search;
                    description: "未找到相关结果";
                }
            }

            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ======================= TTimeline ======================
    GallerySection {
        title: "时间线 TTimeline";
        code: "import { TTimeline } from \"@tela-ui/display.slint\";\nimport { TThemeRole } from \"@tela-ui/theme.slint\";\n\nTTimeline {\n    items: [\n        { label: \"创建订单\", content: \"用户提交了订单,等待支付。\", theme: TThemeRole.primary },\n        { label: \"支付完成\", content: \"微信支付 ¥199.00,交易号 202610070001。\", theme: TThemeRole.success },\n    ];\n}";

        TTimeline {
            items: [
                { label: "创建订单", content: "用户提交了订单,等待支付。", theme: TThemeRole.primary },
                { label: "支付完成", content: "微信支付 ¥199.00,交易号 202610070001。", theme: TThemeRole.success },
                { label: "商品出库", content: "包裹已从杭州仓发出,预计明日送达。", theme: TThemeRole.default },
                { label: "确认收货", content: "", theme: TThemeRole.default },
            ];
        }
    }

    // ===================== TDescriptions ====================
    GallerySection {
        title: "描述列表 TDescriptions";
        code: "import { TDescriptions } from \"@tela-ui/display.slint\";\n\nTDescriptions {\n    bordered: true;\n    items: [\n        { label: \"订单编号\", value: \"TD202610070001\" },\n        { label: \"支付方式\", value: \"微信支付\" },\n        { label: \"配送方式\", value: \"顺丰速运\" },\n        { label: \"收货地址\", value: \"浙江省杭州市西湖区某某街道 88 号\" },\n        { label: \"商品数量\", value: \"3 件\" },\n        { label: \"订单金额\", value: \"¥199.00\" },\n    ];\n}\n\nTDescriptions {\n    columns: 1;\n    items: [\n        { label: \"订单编号\", value: \"TD202610070001\" },\n        { label: \"订单金额\", value: \"¥199.00\" },\n    ];\n}";

        VerticalLayout {
            spacing: 16px;

            TDescriptions {
                bordered: true;
                items: [
                    { label: "订单编号", value: "TD202610070001" },
                    { label: "支付方式", value: "微信支付" },
                    { label: "配送方式", value: "顺丰速运" },
                    { label: "收货地址", value: "浙江省杭州市西湖区某某街道 88 号" },
                    { label: "商品数量", value: "3 件" },
                    { label: "订单金额", value: "¥199.00" },
                ];
            }

            TDescriptions {
                columns: 1;
                items: [
                    { label: "订单编号", value: "TD202610070001" },
                    { label: "订单金额", value: "¥199.00" },
                ];
            }
        }
    }

    // ======================= TStatistic =====================
    GallerySection {
        title: "数值统计 TStatistic";
        code: "import { TStatistic } from \"@tela-ui/display.slint\";\n\nTStatistic { title: \"总销售额\"; value: \"¥ 286,860\"; }\nTStatistic { title: \"在线人数\"; loading: true; }";

        HorizontalLayout {
            spacing: 48px;

            TStatistic { title: "总销售额"; value: "¥ 286,860"; horizontal-stretch: 0; }
            TStatistic { title: "下载量"; value: "12,930"; suffix: "次"; theme: TThemeRole.success; horizontal-stretch: 0; }
            TStatistic { title: "在线人数"; loading: true; horizontal-stretch: 0; }
            Rectangle { }
        }
    }

    // ====================== TScrollBar ======================
    GallerySection {
        title: "滚动条 TScrollBar";
        code: "import { TScrollBar } from \"@tela-ui/display.slint\";\nimport { TParagraph } from \"@tela-ui/base.slint\";\nimport { TTheme } from \"@tela-ui/theme.slint\";\n\n// 自带视口与滚动进度的滚动容器 (替代 ScrollView):\nTScrollBar {\n    height: 220px;\n    border-radius: TTheme.radius-medium;\n    border-width: 1px;\n    border-color: TTheme.component-stroke;\n    clip: true;\n\n    VerticalLayout {\n        padding: TTheme.padding-lr-l;\n        spacing: TTheme.spacing-3;\n\n        for i in 16: TParagraph { text: \"滚动内容第 \\{i + 1} 行 — 滑块可拖拽、可点击定位。\"; }\n    }\n}\n// 滑块: 静止 gray-7, 悬停 gray-6, 按压 gray-5; 拖拽即时跟手\n// (滑块中心对齐指针), 点击轨道缓动定位, 滚轮直滚; 贴窗口边缘\n// 时设 thumb-inset 避开原生拉伸热区。";

        TScrollBar {
            height: 220px;
            border-radius: TTheme.radius-medium;
            border-width: 1px;
            border-color: TTheme.component-stroke;
            clip: true;

            VerticalLayout {
                padding: TTheme.padding-lr-l;
                spacing: TTheme.spacing-3;

                for i in 16: TParagraph { text: "滚动内容第 \{i + 1} 行 — 滑块可拖拽、可点击定位。"; }
            }
        }
    }

    // ======================= TComment =======================
    GallerySection {
        title: "评论 TComment";
        code: "import { TComment } from \"@tela-ui/display.slint\";\n\nproperty <string> status: \"暂无操作\";\n\nTComment {\n    author: \"龙背上的骑兵\";\n    avatar-text: \"龙\";\n    datetime: \"3 小时前\";\n    content: \"组件库的令牌体系很完整, 亮暗切换零成本。\";\n    likes: 12;\n}\n\nTComment {\n    author: \"TDesign\";\n    avatar-text: \"TD\";\n    datetime: \"昨天 14:20\";\n    content: \"收到反馈, 下个版本会补充键盘导航。\";\n    likes: 3;\n    liked: true;\n\n    like-changed(l) => { root.status = l ? \"已点赞\" : \"已取消点赞\"; }\n    reply-clicked => { root.status = \"打开回复框\"; }\n}";

        VerticalLayout {
            spacing: 16px;

            TComment {
                author: "龙背上的骑兵";
                avatar-text: "龙";
                datetime: "3 小时前";
                content: "组件库的令牌体系很完整, 亮暗切换零成本, 桌面端与移动端模式也能共用一套布局骨架。";
                likes: 12;
            }

            TComment {
                author: "TDesign";
                avatar-text: "TD";
                datetime: "昨天 14:20";
                content: "收到反馈, 下个版本会补充键盘导航与虚拟滚动说明。";
                likes: 3;
                liked: true;

                like-changed(l) => {
                    root.comment-status = l ? "TDesign 的评论已点赞" : "TDesign 的评论已取消点赞";
                }
                reply-clicked => {
                    root.comment-status = "打开 TDesign 评论的回复框";
                }
            }

            TComment {
                author: "游客";
                datetime: "刚刚";
                content: "纯展示组件, 回复列表由宿主自行嵌套。";
            }

            TCaption { text: "状态: \{root.comment-status}"; wrap: word-wrap; }
        }
    }

    // ======================= TCountDown =====================
    GallerySection {
        title: "倒计时 TCountDown";
        code: "import { TCountDown } from \"@tela-ui/display.slint\";\n\nproperty <duration> remaining: 90s;\nproperty <string> status: \"\";\n\n// 剩余时长驱动, 双向绑定后组件每秒递减:\nTCountDown {\n    remaining <=> root.remaining;\n    running: true;\n\n    finished() => { root.status = \"时间到\"; }\n}\n\n// 时位不按 24 回绕, 25h 显示为 25:00:00;\n// 无目标时刻解析 (Slint 不暴露当前日期)。";

        HorizontalLayout {
            spacing: 48px;

            TCountDown {
                remaining: 90s;
                running: true;
                horizontal-stretch: 0;
            }

            TCountDown {
                remaining: 90000s;
                horizontal-stretch: 0;
            }

            Rectangle { }
        }
    }
}
