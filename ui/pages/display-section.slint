// Gallery section: 展示 (TTag / TBadge / TAvatar / TAvatarGroup / TEmpty /
// TTimeline / TDescriptions / TStatistic / TScrollBar), 一个组件一张卡.

import { TTheme, TThemeRole, TSize } from "@tela-ui/theme.slint";
import { TText, TIcon, TIconSet, TButton, TCaption } from "@tela-ui/base.slint";
import { TTag, TTagVariant, TBadge, TAvatar, TAvatarSize, TAvatarShape, TAvatarGroup, TAvatarGroupItem, TEmpty, TTimeline, TDescriptions, TStatistic } from "@tela-ui/display.slint";
import { TMessage } from "@tela-ui/notice.slint";
import { TScrollBar } from "@tela-ui/display.slint";
import { TParagraph } from "@tela-ui/base.slint";
import { ScrollView } from "std-widgets.slint";
import { GallerySection } from "../gallery-section.slint";

export component DisplaySection inherits VerticalLayout {
    spacing: 28px;

    // ========================= TTag =========================
    GallerySection {
        title: "标签 TTag";
        code: "import { TTag } from \"@tela-ui/display.slint\";\n\nTTag { text: \"主要\"; theme: TThemeRole.primary; }\nTTag { text: \"可关闭\"; theme: TThemeRole.primary; closable: true; }\nTTag { text: \"描边\"; variant: TTagVariant.outline; }";

        HorizontalLayout {
            spacing: 8px;
            TTag { text: "默认"; }
            TTag { theme: TThemeRole.primary; text: "主要"; }
            TTag { theme: TThemeRole.success; text: "成功"; }
            TTag { theme: TThemeRole.warning; text: "警告"; }
            TTag { theme: TThemeRole.error; text: "危险"; }
            TTag { theme: TThemeRole.primary; variant: TTagVariant.dark; text: "深色"; }
            TTag { theme: TThemeRole.primary; variant: TTagVariant.outline; text: "描边"; }
            TTag { theme: TThemeRole.primary; text: "可关闭"; closable: true; }
            TTag { theme: TThemeRole.primary; size: TSize.small; text: "小"; }
            TTag { theme: TThemeRole.primary; size: TSize.large; text: "大"; }
            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ======================== TBadge ========================
    GallerySection {
        title: "徽标 TBadge";
        code: "import { TBadge } from \"@tela-ui/display.slint\";\nimport { TIcon } from \"@tela-ui/base.slint\";\n\nTBadge {\n    count: 6;\n    TIcon { icon: TIconSet.Bell; size: 24px; icon-color: TTheme.text-color-primary; }\n}\nTBadge {\n    count: 128;\n    TIcon { icon: TIconSet.Mail; size: 24px; icon-color: TTheme.text-color-primary; }\n}\nTBadge {\n    dot: true;\n    TIcon { icon: TIconSet.Settings; size: 24px; icon-color: TTheme.text-color-primary; }\n}";

        HorizontalLayout {
            spacing: 28px;

            TBadge {
                count: 6;
                TIcon { icon: TIconSet.Bell; size: 24px; icon-color: TTheme.text-color-primary; }
            }
            TBadge {
                count: 128;
                TIcon { icon: TIconSet.Mail; size: 24px; icon-color: TTheme.text-color-primary; }
            }
            TBadge {
                dot: true;
                TIcon { icon: TIconSet.Settings; size: 24px; icon-color: TTheme.text-color-primary; }
            }

            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ======================== TAvatar =======================
    GallerySection {
        title: "头像 TAvatar";
        code: "import { TAvatar } from \"@tela-ui/display.slint\";\n\nTAvatar { text: \"T\"; }\nTAvatar { size: TAvatarSize.small; text: \"TD\"; }\nTAvatar { size: TAvatarSize.large; text: \"龙\"; }\nTAvatar { size: TAvatarSize.extra-large; shape: TAvatarShape.square; text: \"\"; }";

        HorizontalLayout {
            spacing: 24px;

            TAvatar { text: "T"; }
            TAvatar { size: TAvatarSize.small; text: "TD"; }
            TAvatar { size: TAvatarSize.large; text: "龙"; }
            TAvatar { size: TAvatarSize.extra-large; shape: TAvatarShape.square; text: ""; }

            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ====================== TAvatarGroup ====================
    GallerySection {
        title: "头像组 TAvatarGroup";
        code: "import { TAvatarGroup } from \"@tela-ui/display.slint\";\n\nTAvatarGroup {\n    items: [\n        { text: \"龙\" },\n        { text: \"T\" },\n        { text: \"UI\" },\n        { text: \"D\" },\n    ];\n}\n\nTAvatarGroup {\n    max-count: 3;\n    items: [\n        { text: \"A\" },\n        { text: \"B\" },\n        { text: \"C\" },\n        { text: \"D\" },\n        { text: \"E\" },\n        { text: \"F\" },\n    ];\n\n    overflow-clicked => {\n        TMessage.info(\"还有 3 个成员\");\n    }\n}\n\nTAvatarGroup {\n    size: TAvatarSize.small;\n    shape: TAvatarShape.square;\n    items: [\n        { text: \"S\" },\n        { text: \"Q\" },\n        { text: \"R\" },\n    ];\n}";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 24px;

                TAvatarGroup {
                    items: [
                        { text: "龙" },
                        { text: "T" },
                        { text: "UI" },
                        { text: "D" },
                    ];
                }

                TAvatarGroup {
                    max-count: 3;
                    items: [
                        { text: "A" },
                        { text: "B" },
                        { text: "C" },
                        { text: "D" },
                        { text: "E" },
                        { text: "F" },
                    ];

                    overflow-clicked => {
                        TMessage.info("还有 3 个成员");
                    }
                }

                TAvatarGroup {
                    size: TAvatarSize.small;
                    shape: TAvatarShape.square;
                    items: [
                        { text: "S" },
                        { text: "Q" },
                        { text: "R" },
                    ];
                }

                Rectangle { }
            }

            TCaption { text: "成员按声明顺序叠放 (后者在上), 重叠量固定 spacing-4; max-count 截断并渲染 +N 尾像。"; wrap: word-wrap; }
        }
    }

    // ======================== TEmpty ========================
    GallerySection {
        title: "空状态 TEmpty";
        code: "import { TEmpty } from \"@tela-ui/display.slint\";\nimport { TButton } from \"@tela-ui/base.slint\";\n\nRectangle {\n    width: 240px;\n    height: 180px;\n    TEmpty { }\n}\n\nRectangle {\n    width: 240px;\n    height: 180px;\n    TEmpty {\n        description: \"暂无订单数据\";\n\n        TButton {\n            size: TSize.small;\n            text: \"立即创建\";\n        }\n    }\n}\n\nRectangle {\n    width: 240px;\n    height: 180px;\n    TEmpty {\n        icon: TIconSet.Search;\n        description: \"未找到相关结果\";\n    }\n}";

        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                width: 240px;
                height: 180px;
                TEmpty { }
            }

            Rectangle {
                width: 240px;
                height: 180px;
                TEmpty {
                    description: "暂无订单数据";

                    TButton {
                        size: TSize.small;
                        text: "立即创建";
                    }
                }
            }

            Rectangle {
                width: 240px;
                height: 180px;
                TEmpty {
                    icon: TIconSet.Search;
                    description: "未找到相关结果";
                }
            }

            // Absorbs the leftover row space.
            Rectangle { }
        }
    }

    // ======================= TTimeline ======================
    GallerySection {
        title: "时间线 TTimeline";
        code: "import { TTimeline } from \"@tela-ui/display.slint\";\n\nTTimeline {\n    items: [\n        { label: \"创建订单\", content: \"…\", theme: TThemeRole.primary },\n        { label: \"支付完成\", content: \"…\", theme: TThemeRole.success },\n    ];\n}";

        TTimeline {
            items: [
                { label: "创建订单", content: "用户提交了订单,等待支付。", theme: TThemeRole.primary },
                { label: "支付完成", content: "微信支付 ¥199.00,交易号 202610070001。", theme: TThemeRole.success },
                { label: "商品出库", content: "包裹已从杭州仓发出,预计明日送达。", theme: TThemeRole.default },
                { label: "确认收货", content: "", theme: TThemeRole.default },
            ];
        }
    }

    // ===================== TDescriptions ====================
    GallerySection {
        title: "描述列表 TDescriptions";
        code: "import { TDescriptions } from \"@tela-ui/display.slint\";\n\nTDescriptions {\n    bordered: true;\n    items: [\n        { label: \"订单编号\", value: \"TD202610070001\" },\n        { label: \"支付方式\", value: \"微信支付\" },\n        { label: \"配送方式\", value: \"顺丰速运\" },\n        { label: \"收货地址\", value: \"浙江省杭州市西湖区某某街道 88 号\" },\n        { label: \"商品数量\", value: \"3 件\" },\n        { label: \"订单金额\", value: \"¥199.00\" },\n    ];\n}\n\nTDescriptions {\n    columns: 1;\n    items: [\n        { label: \"订单编号\", value: \"TD202610070001\" },\n        { label: \"订单金额\", value: \"¥199.00\" },\n    ];\n}";

        VerticalLayout {
            spacing: 16px;

            TDescriptions {
                bordered: true;
                items: [
                    { label: "订单编号", value: "TD202610070001" },
                    { label: "支付方式", value: "微信支付" },
                    { label: "配送方式", value: "顺丰速运" },
                    { label: "收货地址", value: "浙江省杭州市西湖区某某街道 88 号" },
                    { label: "商品数量", value: "3 件" },
                    { label: "订单金额", value: "¥199.00" },
                ];
            }

            TDescriptions {
                columns: 1;
                items: [
                    { label: "订单编号", value: "TD202610070001" },
                    { label: "订单金额", value: "¥199.00" },
                ];
            }
        }
    }

    // ======================= TStatistic =====================
    GallerySection {
        title: "数值统计 TStatistic";
        code: "import { TStatistic } from \"@tela-ui/display.slint\";\n\nTStatistic { title: \"总销售额\"; value: \"¥ 286,860\"; }\nTStatistic { title: \"在线人数\"; loading: true; }";

        HorizontalLayout {
            spacing: 48px;

            TStatistic { title: "总销售额"; value: "¥ 286,860"; horizontal-stretch: 0; }
            TStatistic { title: "下载量"; value: "12,930"; suffix: "次"; theme: TThemeRole.success; horizontal-stretch: 0; }
            TStatistic { title: "在线人数"; loading: true; horizontal-stretch: 0; }
            Rectangle { }
        }
    }

    // ====================== TScrollBar ======================
    GallerySection {
        title: "滚动条 TScrollBar";
        code: "import { TScrollBar } from \"@tela-ui/display.slint\";\n\nRectangle {\n    height: 220px;\n    border-radius: TTheme.radius-medium;\n    border-width: 1px;\n    border-color: TTheme.component-stroke;\n    clip: true;\n\n    sv := ScrollView {\n        width: parent.width;\n        height: parent.height;\n        vertical-scrollbar-policy: ScrollBarPolicy.always-off;\n\n        VerticalLayout {\n            padding: TTheme.padding-lr-l;\n            spacing: TTheme.spacing-3;\n\n            for i in 16: TParagraph { text: \"滚动内容第 \\{i + 1} 行 — 滑块可拖拽、可点击定位。\"; }\n        }\n    }\n\n    TScrollBar {\n        width: 6px;\n        x: parent.width - self.width;\n        y: 0;\n        height: parent.height;\n        content-length: sv.content-height;\n        viewport-length: sv.visible-height;\n        content-offset <=> sv.content-y;\n    }\n}";

        Rectangle {
            height: 220px;
            border-radius: TTheme.radius-medium;
            border-width: 1px;
            border-color: TTheme.component-stroke;
            clip: true;

            sv := ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    padding: TTheme.padding-lr-l;
                    spacing: TTheme.spacing-3;

                    for i in 16: TParagraph { text: "滚动内容第 \{i + 1} 行 — 滑块可拖拽、可点击定位。"; }
                }
            }

            TScrollBar {
                width: 6px;
                x: parent.width - self.width;
                y: 0;
                height: parent.height;
                content-length: sv.content-height;
                viewport-length: sv.visible-height;
                content-offset <=> sv.content-y;
            }
        }
    }
}