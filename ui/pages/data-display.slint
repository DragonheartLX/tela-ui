// Demo section: 数据展示 (Tag / Badge / Avatar / Empty / Timeline /
// Descriptions / Statistic / Collapse / Tooltip / Carousel), 一个组件一张卡.

import { TelaTheme, Theme, Size } from "@tela-ui/theme.slint";
import { Icon, TIconSet, Button, Caption } from "@tela-ui/base.slint";
import { Tag, TagVariant, Badge, Avatar, AvatarSize, AvatarShape, Card, Empty, Timeline, Descriptions, Statistic, Collapse, Carousel, CodeBlock } from "@tela-ui/common.slint";
import { TooltipArea, TooltipPlacement } from "@tela-ui/data-display.slint";

export component DataDisplaySection inherits VerticalLayout {
    spacing: 28px;

    // ========================= Tag =========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "标签 Tag";

            HorizontalLayout {
                spacing: 8px;
                Tag { text: "默认"; }
                Tag { theme: Theme.primary; text: "主要"; }
                Tag { theme: Theme.success; text: "成功"; }
                Tag { theme: Theme.warning; text: "警告"; }
                Tag { theme: Theme.error; text: "危险"; }
                Tag { theme: Theme.primary; variant: TagVariant.dark; text: "深色"; }
                Tag { theme: Theme.primary; variant: TagVariant.outline; text: "描边"; }
                Tag { theme: Theme.primary; text: "可关闭"; closable: true; }
                Tag { theme: Theme.primary; size: Size.small; text: "小"; }
                Tag { theme: Theme.primary; size: Size.large; text: "大"; }
                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Tag } from \"@tela-ui/common.slint\";\n\nTag { text: \"主要\"; theme: Theme.primary; }\nTag { text: \"可关闭\"; theme: Theme.primary; closable: true; }\nTag { text: \"描边\"; variant: TagVariant.outline; }"; }
    }

    // ======================== Badge ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "徽标 Badge";

            HorizontalLayout {
                spacing: 28px;

                Badge {
                    count: 6;
                    Icon { icon: TIconSet.Bell; size: 24px; icon-color: TelaTheme.text-color-primary; }
                }
                Badge {
                    count: 128;
                    Icon { icon: TIconSet.Mail; size: 24px; icon-color: TelaTheme.text-color-primary; }
                }
                Badge {
                    dot: true;
                    Icon { icon: TIconSet.Settings; size: 24px; icon-color: TelaTheme.text-color-primary; }
                }

                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Badge } from \"@tela-ui/common.slint\";\nimport { Icon, TIconSet } from \"@tela-ui/base.slint\";\n\nBadge { count: 6; Icon { icon: TIconSet.Bell; } }\nBadge { dot: true; Icon { icon: TIconSet.Settings; } }"; }
    }

    // ======================== Avatar =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "头像 Avatar";

            HorizontalLayout {
                spacing: 24px;

                Avatar { text: "T"; }
                Avatar { size: AvatarSize.small; text: "TD"; }
                Avatar { size: AvatarSize.large; text: "龙"; }
                Avatar { size: AvatarSize.extra-large; shape: AvatarShape.square; text: ""; }

                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Avatar } from \"@tela-ui/common.slint\";\n\nAvatar { text: \"T\"; }\nAvatar { size: AvatarSize.large; shape: AvatarShape.square; text: \"\"; }"; }
    }

    // ======================== Empty ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "空状态 Empty";

            HorizontalLayout {
                spacing: 24px;

                Rectangle {
                    width: 240px;
                    height: 180px;
                    Empty { }
                }

                Rectangle {
                    width: 240px;
                    height: 180px;
                    Empty {
                        description: "暂无订单数据";

                        Button {
                            size: Size.small;
                            text: "立即创建";
                        }
                    }
                }

                Rectangle {
                    width: 240px;
                    height: 180px;
                    Empty {
                        icon: TIconSet.Search;
                        description: "未找到相关结果";
                    }
                }

                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Empty } from \"@tela-ui/common.slint\";\n\nEmpty { description: \"暂无数据\"; }\n\nEmpty {\n    icon: TIconSet.Search;\n    description: \"未找到相关结果\";\n    Button { text: \"立即创建\"; } // 子元素作为操作区\n}"; }
    }

    // ======================= Timeline ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "时间线 Timeline";

            Timeline {
                items: [
                    { label: "创建订单", content: "用户提交了订单,等待支付。", theme: Theme.primary },
                    { label: "支付完成", content: "微信支付 ¥199.00,交易号 202610070001。", theme: Theme.success },
                    { label: "商品出库", content: "包裹已从杭州仓发出,预计明日送达。", theme: Theme.default },
                    { label: "确认收货", content: "", theme: Theme.default },
                ];
            }
        }

        CodeBlock { code: "import { Timeline } from \"@tela-ui/common.slint\";\n\nTimeline {\n    items: [\n        { label: \"创建订单\", content: \"…\", theme: Theme.primary },\n        { label: \"支付完成\", content: \"…\", theme: Theme.success },\n    ];\n}"; }
    }

    // ===================== Descriptions ====================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "描述列表 Descriptions";

            VerticalLayout {
                spacing: 16px;

                Descriptions {
                    bordered: true;
                    items: [
                        { label: "订单编号", value: "TD202610070001" },
                        { label: "支付方式", value: "微信支付" },
                        { label: "配送方式", value: "顺丰速运" },
                        { label: "收货地址", value: "浙江省杭州市西湖区某某街道 88 号" },
                        { label: "商品数量", value: "3 件" },
                        { label: "订单金额", value: "¥199.00" },
                    ];
                }

                Descriptions {
                    columns: 1;
                    items: [
                        { label: "订单编号", value: "TD202610070001" },
                        { label: "订单金额", value: "¥199.00" },
                    ];
                }
            }
        }

        CodeBlock { code: "import { Descriptions } from \"@tela-ui/common.slint\";\n\nDescriptions {\n    bordered: true;\n    columns: 2;\n    items: [{ label: \"订单编号\", value: \"TD202610070001\" }, …];\n}"; }
    }

    // ======================= Statistic =====================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "数值统计 Statistic";

            HorizontalLayout {
                spacing: 48px;

                Statistic { title: "总销售额"; value: "¥ 286,860"; horizontal-stretch: 0; }
                Statistic { title: "下载量"; value: "12,930"; suffix: "次"; theme: Theme.success; horizontal-stretch: 0; }
                Statistic { title: "在线人数"; loading: true; horizontal-stretch: 0; }
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Statistic } from \"@tela-ui/common.slint\";\n\nStatistic { title: \"总销售额\"; value: \"¥ 286,860\"; }\nStatistic { title: \"在线人数\"; loading: true; }"; }
    }

    // ======================== Collapse =====================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "折叠面板 Collapse";

            HorizontalLayout {
                spacing: 24px;

                Collapse {
                    horizontal-stretch: 1;
                    accordion: true;
                    items: [
                        { label: "什么是 Tela UI?", content: "TDesign 风格的 Slint 第三方组件库,提供主题令牌、基础与常用组件,支持亮暗双主题。" },
                        { label: "如何自定义主题?", content: "通过 TelaTheme.light / TelaTheme.dark 预设逐项修改,或整体替换 theme 配置。" },
                        { label: "是否支持暗色模式?", content: "支持,preference 设为 dark 或直接跟随系统。" },
                    ];
                }

                Collapse {
                    horizontal-stretch: 1;
                    items: [
                        { label: "面板一", content: "非手风琴模式下多个面板可同时展开。" },
                        { label: "面板二", content: "每个面板独立开关,展开收起带高度过渡动画。" },
                        { label: "禁用面板", content: "这一项不可展开。", disabled: true },
                    ];
                }
            }
        }

        CodeBlock { code: "import { Collapse } from \"@tela-ui/common.slint\";\n\n// 手风琴: accordion: true, current-index 记录展开项\nCollapse { accordion: true; items: [{ label: \"面板一\", content: \"…\" }, …]; }"; }
    }

    // ======================== Tooltip ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "气泡提示 Tooltip";

            HorizontalLayout {
                spacing: 24px;

                // TooltipArea fills its parent, wires the hover and reports
                // to the window-level overlay — no clipping worries.
                TooltipArea {
                    width: 120px;
                    height: TelaTheme.height-m;
                    background: TelaTheme.bg-color-secondarycontainer;
                    border-radius: TelaTheme.radius-default;
                    text: "我是 Tooltip, 鼠标移开即消失, 250ms 延迟出现";
                    placement: TooltipPlacement.top;

                    Text {
                        text: "上方提示";
                        font-size: TelaTheme.font-size-m;
                        color: TelaTheme.text-color-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                TooltipArea {
                    width: 120px;
                    height: TelaTheme.height-m;
                    background: TelaTheme.bg-color-secondarycontainer;
                    border-radius: TelaTheme.radius-default;
                    text: "placement: TooltipPlacement.bottom";
                    placement: TooltipPlacement.bottom;

                    Text {
                        text: "下方提示";
                        font-size: TelaTheme.font-size-m;
                        color: TelaTheme.text-color-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Caption { text: "渲染在窗口级 (TooltipOverlay), 不受卡片或滚动容器裁剪; 亮暗均为深色气泡。"; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
            }
        }

        CodeBlock { code: "import { TooltipArea, TooltipOverlay } from \"@tela-ui/common.slint\";\n\n// 窗口根部放置一次:\nTooltipOverlay { }\n\nTooltipArea {\n    text: \"提示\"; placement: TooltipPlacement.top;\n    Text { text: \"目标\"; }\n}"; }
    }

    // ======================== Carousel =====================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "走马灯 Carousel";

            Carousel {
                height: 240px;
                autoplay: true;
                interval: 3s;
                items: [
                    { image: @image-url("../assets/slide-1.svg") },
                    { image: @image-url("../assets/slide-2.svg") },
                    { image: @image-url("../assets/slide-3.svg") },
                ];
            }
        }

        CodeBlock { code: "import { Carousel } from \"@tela-ui/common.slint\";\n\nCarousel {\n    height: 240px;\n    autoplay: true;\n    items: [{ image: @image-url(\"slide-1.svg\") }, …];\n}"; }
    }
}
