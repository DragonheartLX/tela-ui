// Demo section: 数据展示 (Tag / Badge / Avatar / Loading / Divider /
// Progress / Empty), 一个组件一张卡.

import { TelaTheme, Theme, Size } from "@tela-ui/theme.slint";
import { Icon, TIconSet, Divider, DividerAlign, Tag, TagVariant, Loading, Button } from "@tela-ui/base.slint";
import { Badge, Avatar, AvatarSize, AvatarShape, Card, Progress, ProgressVariant, Slider, Empty , CodeBlock} from "@tela-ui/common.slint";

export component DataDisplaySection inherits VerticalLayout {
    spacing: 28px;

    // Own state: the slider drives both progress variants.
    in-out property <float> progress-value: 40;

    // ========================= Tag =========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "标签 Tag";

            HorizontalLayout {
                spacing: 8px;
                Tag { text: "默认"; }
                Tag { theme: Theme.primary; text: "主要"; }
                Tag { theme: Theme.success; text: "成功"; }
                Tag { theme: Theme.warning; text: "警告"; }
                Tag { theme: Theme.error; text: "危险"; }
                Tag { theme: Theme.primary; variant: TagVariant.dark; text: "深色"; }
                Tag { theme: Theme.primary; variant: TagVariant.outline; text: "描边"; }
                Tag { theme: Theme.primary; text: "可关闭"; closable: true; }
                Tag { theme: Theme.primary; size: Size.small; text: "小"; }
                Tag { theme: Theme.primary; size: Size.large; text: "大"; }
                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Tag } from \"@tela-ui/base.slint\";\n\nTag { text: \"主要\"; theme: Theme.primary; }\nTag { text: \"可关闭\"; theme: Theme.primary; closable: true; }\nTag { text: \"描边\"; variant: TagVariant.outline; }"; }
    }

    // ======================== Badge ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "徽标 Badge";

            HorizontalLayout {
                spacing: 28px;

                Badge {
                    count: 6;
                    Icon { icon: TIconSet.Bell; size: 24px; icon-color: TelaTheme.text-color-primary; }
                }
                Badge {
                    count: 128;
                    Icon { icon: TIconSet.Mail; size: 24px; icon-color: TelaTheme.text-color-primary; }
                }
                Badge {
                    dot: true;
                    Icon { icon: TIconSet.Settings; size: 24px; icon-color: TelaTheme.text-color-primary; }
                }

                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Badge } from \"@tela-ui/common.slint\";\nimport { Icon, TIconSet } from \"@tela-ui/base.slint\";\n\nBadge { count: 6; Icon { icon: TIconSet.Bell; } }\nBadge { dot: true; Icon { icon: TIconSet.Settings; } }"; }
    }

    // ======================== Avatar =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "头像 Avatar";

            HorizontalLayout {
                spacing: 24px;

                Avatar { text: "T"; }
                Avatar { size: AvatarSize.small; text: "TD"; }
                Avatar { size: AvatarSize.large; text: "龙"; }
                Avatar { size: AvatarSize.extra-large; shape: AvatarShape.square; text: ""; }

                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Avatar } from \"@tela-ui/common.slint\";\n\nAvatar { text: \"T\"; }\nAvatar { size: AvatarSize.large; shape: AvatarShape.square; text: \"\"; }"; }
    }

    // ======================== Loading ======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "加载 Loading";

            HorizontalLayout {
                spacing: 28px;
                // stretch: 0 — the label's Text leaves the layout's max
                // width unbounded, so the row would otherwise stretch them.
                Loading { size: 16px; horizontal-stretch: 0; }
                Loading { size: 24px; text: "加载中…"; horizontal-stretch: 0; }
                Loading { size: 32px; theme: Theme.success; text: "上传中…"; horizontal-stretch: 0; }
                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Loading } from \"@tela-ui/base.slint\";\n\nLoading { size: 24px; text: \"加载中…\"; }\nLoading { size: 32px; theme: Theme.success; }"; }
    }

    // ======================= Divider =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "分割线 Divider";

            VerticalLayout {
                spacing: 4px;

                Divider { text: "居中文字"; }
                Divider { text: "左方文字"; align: DividerAlign.left; }
                Divider { text: "右方文字"; align: DividerAlign.right; }
                Divider { }
            }
        }

        CodeBlock { code: "import { Divider } from \"@tela-ui/base.slint\";\n\nDivider { text: \"居中文字\"; }\nDivider { text: \"左方文字\"; align: DividerAlign.left; }\nDivider { orientation: Orientation.vertical; }"; }
    }

    // ====================== Progress =======================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "进度 Progress(拖动滑块实时变化)";

            VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 32px;

                    Progress { value: root.progress-value; theme: Theme.primary; horizontal-stretch: 1; }
                    Progress { value: 66; theme: Theme.success; horizontal-stretch: 1; }
                    Progress { value: 30; theme: Theme.warning; horizontal-stretch: 1; }
                    Progress { value: 90; theme: Theme.error; horizontal-stretch: 1; show-label: false; }
                }

                HorizontalLayout {
                    spacing: 32px;
                    Progress { variant: ProgressVariant.circle; value: root.progress-value; theme: Theme.primary; }
                    Progress { variant: ProgressVariant.circle; value: 66; theme: Theme.success; }
                    Progress { variant: ProgressVariant.circle; value: 30; theme: Theme.warning; }
                    Progress { variant: ProgressVariant.circle; value: 100; theme: Theme.error; }
                    // Absorbs the leftover row space.
                    Rectangle { }
                }

                Slider {
                    value <=> root.progress-value;
                }
            }
        }

        CodeBlock { code: "import { Progress } from \"@tela-ui/common.slint\";\n\nProgress { value: 40; theme: Theme.primary; }\nProgress { value: 66; theme: Theme.success; variant: ProgressVariant.circle; }\nProgress { value: 90; theme: Theme.error; show-label: false; }"; }
    }

    // ======================== Empty ========================
    VerticalLayout {
        spacing: 8px;

        Card {
            title: "空状态 Empty";

            HorizontalLayout {
                spacing: 24px;

                Rectangle {
                    width: 240px;
                    height: 180px;
                    Empty { }
                }

                Rectangle {
                    width: 240px;
                    height: 180px;
                    Empty {
                        description: "暂无订单数据";

                        Button {
                            size: Size.small;
                            text: "立即创建";
                        }
                    }
                }

                Rectangle {
                    width: 240px;
                    height: 180px;
                    Empty {
                        icon: TIconSet.Search;
                        description: "未找到相关结果";
                    }
                }

                // Absorbs the leftover row space.
                Rectangle { }
            }
        }

        CodeBlock { code: "import { Empty } from \"@tela-ui/common.slint\";\n\nEmpty { description: \"暂无数据\"; }\n\nEmpty {\n    icon: TIconSet.Search;\n    description: \"未找到相关结果\";\n    Button { text: \"立即创建\"; } // 子元素作为操作区\n}"; }
    }
}
